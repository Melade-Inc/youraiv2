+-- All clock/retirement simulations are confined to this disposable database.
+begin;
+\ir ../../supabase/tests/source-revision-fixtures.sql
+create function pg_temp.content_revision_fixture(p_patch jsonb default null)returns jsonb language plpgsql as $$
+declare actor uuid:=gen_random_uuid();login uuid:=gen_random_uuid();workspace uuid;artifact uuid;v uuid:=gen_random_uuid();o uuid;t uuid;upload uuid;base jsonb;patch jsonb;h text:=encode(sha256(convert_to('Original source','UTF8')),'hex');
