@@ -0,0 +1,47 @@
+begin;
+do $$
+declare actor uuid:=gen_random_uuid();outsider uuid:=gen_random_uuid();login uuid:=gen_random_uuid();other_login uuid:=gen_random_uuid();second_login uuid:=gen_random_uuid();reader uuid:=gen_random_uuid();writer uuid:=gen_random_uuid();workspace uuid;other_workspace uuid;artifact uuid;version uuid;v2 uuid;pub uuid;deadline timestamptz:=clock_timestamp()+interval '1 hour';
+begin
+ insert into auth.users(id,email,email_confirmed_at) values(actor,'delivery-read-owner@example.test',now()),(outsider,'delivery-read-other@example.test',now());
+ insert into auth.sessions(id,user_id) values(login,actor),(second_login,actor),(other_login,outsider);
+ workspace:=live_ensure_workspace(actor);other_workspace:=live_ensure_workspace(outsider);
+ artifact:=live_create_artifact(actor,workspace,'Delivery check','app','test');
+ version:=live_finalize_version(actor,workspace,artifact,'{"schemaVersion":1,"kind":"app","title":"Delivery check","files":[{"path":"index.html","mediaType":"text/html","content":"<h1>Test</h1>","encoding":"utf8"}]}',repeat('a',64),null,'delivery-read-one','test');
+ insert into agent_credentials(id,workspace_id,name,token_hash,scopes) values(reader,workspace,'Reader','delivery-read-proof',array['artifact:read']),(writer,workspace,'Writer','delivery-write-proof',array['artifact:write']);
+ perform live_assert_delivery_access(workspace,artifact,version,null,actor,login,null,deadline,true);
+ perform live_assert_delivery_access(workspace,artifact,version,null,actor,null,reader,deadline,true);
+ begin perform live_assert_delivery_access(workspace,artifact,version,null,actor,null,writer,deadline,true);raise exception 'write-only preview allowed';exception when raise_exception then assert sqlerrm='AUTH_REVOKED';end;
+ begin perform live_assert_delivery_access(workspace,artifact,version,null,outsider,other_login,null,deadline,true);raise exception 'outsider preview allowed';exception when raise_exception then assert sqlerrm='FORBIDDEN';end;
+ begin perform live_assert_delivery_access(other_workspace,artifact,version,null,actor,login,null,deadline,true);raise exception 'wrong workspace allowed';exception when raise_exception then assert sqlerrm='NOT_FOUND';end;
+ begin perform live_assert_delivery_access(workspace,artifact,gen_random_uuid(),null,actor,login,null,deadline,true);raise exception 'wrong version allowed';exception when raise_exception then assert sqlerrm='NOT_FOUND';end;
+ begin perform live_assert_delivery_access(workspace,artifact,version,null,actor,login,null,clock_timestamp()-interval '1 second',true);raise exception 'expired preview allowed';exception when raise_exception then assert sqlerrm='AUTH_REVOKED';end;
+ begin perform live_assert_delivery_access(workspace,artifact,version,null,actor,login,null,deadline,null);raise exception 'null preview allowed';exception when raise_exception then assert sqlerrm='FORBIDDEN';end;
+ pub:=live_publish(actor,workspace,artifact,version,'delivery-proof-check','public','{}',null,null,'test');
+ perform live_assert_delivery_access(workspace,artifact,version,pub,null,null,null,deadline,false);
+ begin perform live_assert_delivery_access(workspace,artifact,version,pub,actor,null,reader,deadline,false);raise exception 'agent became public reader';exception when raise_exception then assert sqlerrm='AUTH_REVOKED';end;
+ begin perform live_assert_delivery_access(workspace,artifact,version,pub,actor,login,null,deadline,true);raise exception 'publication became preview';exception when raise_exception then assert sqlerrm='FORBIDDEN';end;
+ perform live_publish(actor,workspace,artifact,version,'delivery-proof-check','recipients',array['delivery-read-other@example.test'],null,version,'test');
+ perform live_assert_delivery_access(workspace,artifact,version,pub,outsider,other_login,null,deadline,false);
+ begin perform live_assert_delivery_access(workspace,artifact,version,pub,null,null,null,deadline,false);raise exception 'anonymous private read allowed';exception when raise_exception then assert sqlerrm='FORBIDDEN';end;
+ perform live_publish(actor,workspace,artifact,version,'delivery-proof-check','owner','{}',null,version,'test');
+ begin perform live_assert_delivery_access(workspace,artifact,version,pub,outsider,other_login,null,deadline,false);raise exception 'removed recipient allowed';exception when raise_exception then assert sqlerrm='FORBIDDEN';end;
+ -- Another active login must never revive the originating capability.
+ delete from auth.sessions where id=login;
+ begin perform live_assert_delivery_access(workspace,artifact,version,null,actor,login,null,deadline,true);raise exception 'ended preview allowed';exception when raise_exception then assert sqlerrm='AUTH_REVOKED';end;
+ begin perform live_assert_delivery_access(workspace,artifact,version,pub,actor,login,null,deadline,false);raise exception 'ended reader allowed';exception when raise_exception then assert sqlerrm='AUTH_REVOKED';end;
+ update agent_credentials set revoked_at=now() where id=reader;
+ begin perform live_assert_delivery_access(workspace,artifact,version,null,actor,null,reader,deadline,true);raise exception 'revoked agent allowed';exception when raise_exception then assert sqlerrm='AUTH_REVOKED';end;
+ perform live_assert_delivery_access(workspace,artifact,version,null,actor,second_login,null,deadline,true);
+ v2:=live_finalize_version(actor,workspace,artifact,'{"schemaVersion":1,"kind":"app","title":"New","files":[{"path":"index.html","mediaType":"text/html","content":"<h1>New</h1>","encoding":"utf8"}]}',repeat('b',64),version,'delivery-read-two','test');
+ perform live_publish(actor,workspace,artifact,v2,'delivery-proof-check','public','{}',null,version,'test');
+ begin perform live_assert_delivery_access(workspace,artifact,version,pub,null,null,null,deadline,false);raise exception 'stale publication allowed';exception when raise_exception then assert sqlerrm='PUBLICATION_CHANGED';end;
+ perform live_assert_delivery_access(workspace,artifact,v2,pub,null,null,null,deadline,false);
+ perform live_revoke(actor,workspace,artifact,false,'test');
+ begin perform live_assert_delivery_access(workspace,artifact,v2,pub,null,null,null,deadline,false);raise exception 'revoked publication allowed';exception when raise_exception then assert sqlerrm='PUBLICATION_CHANGED';end;
+ perform live_revoke(actor,workspace,artifact,true,'test');
+ begin perform live_assert_delivery_access(workspace,artifact,v2,null,actor,second_login,null,deadline,true);raise exception 'deleted artifact allowed';exception when raise_exception then assert sqlerrm='NOT_FOUND';end;
+ assert not has_function_privilege('anon','public.live_assert_delivery_access(uuid,uuid,uuid,uuid,uuid,uuid,uuid,timestamptz,boolean,integer)','execute');
+ assert not has_function_privilege('authenticated','public.live_assert_delivery_access(uuid,uuid,uuid,uuid,uuid,uuid,uuid,timestamptz,boolean,integer)','execute');
+ assert has_function_privilege('service_role','public.live_assert_delivery_access(uuid,uuid,uuid,uuid,uuid,uuid,uuid,timestamptz,boolean,integer)','execute');
+end $$;
+rollback;
