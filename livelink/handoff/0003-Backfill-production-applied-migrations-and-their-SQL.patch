+ update artifacts set latest_version_id=null where id=(f->>'artifact')::uuid;
+ begin perform live_complete_core_revision(o,'revision-run',t);raise exception 'stale base finalized';exception when raise_exception then if sqlerrm<>'VERSION_CONFLICT' then raise;end if;end;
+ assert not live_core_source_active(o,'revision-run',(f->>'base')::uuid);
+ assert not has_table_privilege('service_role','core_revision_saves','SELECT');assert not has_table_privilege('authenticated','core_revision_objects','SELECT');
+ assert not has_function_privilege('service_role','live_core_revision_manifest(uuid)','EXECUTE');assert not has_function_privilege('authenticated','live_prepare_core_revision(uuid,text,uuid)','EXECUTE');
+end $$;
+rollback;
+select 'Stored revisions: source retention, review, quota, funded dispatch, interruption, stale versions and isolation passed' as result;
