+ -- Same grant cannot admit two streams. Completion is reconciled by private HEAD.
+ if v_prior.id is not null then raise exception 'TRANSFER_ALREADY_ADMITTED';end if;
+ if exists(select 1 from artifact_upload_transfers t where t.upload_id=p_upload_id and t.file_index=p_file_index and t.status='admitted' and t.expires_at>clock_timestamp()) then raise exception 'UPLOAD_IN_PROGRESS';end if;
