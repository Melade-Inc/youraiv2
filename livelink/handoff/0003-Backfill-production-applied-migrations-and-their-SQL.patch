+ for funding in select * from runtime_reservations where artifact_id=a.id and workspace_id=a.workspace_id and status='reserved'loop
+  perform live_close_runtime(funding.id,funding.workspace_id,funding.request_hash,'cancelled');
+ end loop;
+ insert into audit_events(workspace_id,actor_id,action,target_id,trace_id,metadata)values(a.workspace_id,p_actor_id,'artifact.removed',a.id,p_trace_id,jsonb_build_object('removalId',r.id,'recoverableUntil',r.recoverable_until,'accessEpoch',r.access_epoch));
+ return live_removal_summary(r.id);
+end $$;
+create function public.live_remove_project(p_actor_id uuid,p_workspace_id uuid,p_artifact_id uuid,p_expected_epoch integer,p_key text,p_auth_session_id uuid,p_agent_credential_id uuid,p_trace_id text)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
