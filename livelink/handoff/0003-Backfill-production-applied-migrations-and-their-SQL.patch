+begin;
+do $$
+declare actor uuid:=gen_random_uuid();other_actor uuid:=gen_random_uuid();workspace uuid;other_workspace uuid;artifact uuid;other_artifact uuid;operation uuid:=gen_random_uuid();other_operation uuid:=gen_random_uuid();parallel_operation uuid:=gen_random_uuid();
+ period date:=date_trunc('month',now()at time zone 'UTC')::date;result jsonb;replayed jsonb;reservation uuid;second uuid;third uuid;event uuid;available bigint;expired uuid:=gen_random_uuid();
+begin
+ insert into auth.users(id,email,email_confirmed_at)values(actor,'runtime@example.test',now()),(other_actor,'runtime-other@example.test',now());
+ workspace:=live_ensure_workspace(actor);other_workspace:=live_ensure_workspace(other_actor);
+ artifact:=live_create_artifact(actor,workspace,'Runtime test','app','test');other_artifact:=live_create_artifact(actor,workspace,'Runtime second','app','test');
+ insert into operations(id,workspace_id,actor_id,artifact_id,kind,prompt,idempotency_key,request_hash)values
+ (operation,workspace,actor,artifact,'app','Make a counter','runtime-operation',repeat('a',64)),
+ (other_operation,workspace,actor,artifact,'app','Another request','runtime-other-operation',repeat('b',64)),
+ (parallel_operation,workspace,actor,other_artifact,'app','Different project','runtime-parallel-operation',repeat('c',64));
+ assert live_runtime_available(workspace,'platform',period)=100000000000;
+ assert live_runtime_available(workspace,'prepaid',period)=0;
+ result:=live_reserve_runtime(workspace,artifact,null,'runtime-first',repeat('a',64),'platform','r2-read',null,'r2-test',1000000000);reservation:=(result->>'id')::uuid;
+ assert result->>'maximumCostNanos'='1000000000';assert live_runtime_available(workspace,'platform',period)=99000000000;
+ assert live_reserve_runtime(workspace,artifact,null,'runtime-first',repeat('a',64),'platform','r2-read',null,'r2-test',1000000000)=result;
+ begin perform live_reserve_runtime(workspace,artifact,null,'runtime-first',repeat('b',64),'platform','r2-read',null,'r2-test',1000000000);raise exception 'different intent reused funds';exception when raise_exception then if sqlerrm<>'IDEMPOTENCY_CONFLICT' then raise;end if;end;
+ begin perform live_dispatch_runtime(reservation,other_workspace,repeat('a',64));raise exception 'cross-workspace dispatch';exception when raise_exception then if sqlerrm<>'RUNTIME_DISPATCH_DENIED' then raise;end if;end;
+ assert live_dispatch_runtime(reservation,workspace,repeat('a',64));assert not live_dispatch_runtime(reservation,workspace,repeat('a',64));
+ result:=live_close_runtime(reservation,workspace,repeat('a',64),'unknown');assert result->>'status'='unknown';
+ begin perform live_close_runtime(reservation,workspace,repeat('a',64),'cancelled');raise exception 'uncertain outcome released funds';exception when raise_exception then if sqlerrm<>'RUNTIME_OUTCOME_UNKNOWN' then raise;end if;end;
+ assert live_runtime_available(workspace,'platform',period)=99000000000;
+ result:=live_close_runtime(reservation,workspace,repeat('a',64),'settled',repeat('d',64),250000000,'provider-first');
+ assert result->>'actualCostNanos'='250000000';assert result->>'chargedActualNanos'='250000000';assert live_runtime_available(workspace,'platform',period)=99750000000;
+ assert live_close_runtime(reservation,workspace,repeat('a',64),'settled',repeat('d',64),250000000,'provider-first')=result;
+ begin perform live_close_runtime(reservation,workspace,repeat('a',64),'settled',repeat('e',64),0,'different');raise exception 'changed settled outcome';exception when raise_exception then if sqlerrm<>'IDEMPOTENCY_CONFLICT' then raise;end if;end;
+ begin update runtime_reservations set actual_cost_nanos=0,charged_actual_nanos=0 where id=reservation;raise exception 'rewrote receipt';exception when raise_exception then if sqlerrm<>'RUNTIME_HISTORY_IMMUTABLE' then raise;end if;end;
+
+ -- Existing QA cannot spend beyond the shared platform pool during migration.
+ available:=live_runtime_available(workspace,'platform',period);
+ reservation:=(live_reserve_runtime(workspace,artifact,null,'runtime-last-funds',repeat('a',64),'platform','r2-read',null,'r2-test',available-20000000)->>'id')::uuid;
+ begin perform live_reserve_ai(workspace,'qa','runtime-legacy-denied','reader',null,4000);raise exception 'legacy beta bypassed platform cap';exception when raise_exception then if sqlerrm<>'AI_BUDGET_EXHAUSTED' then raise;end if;end;
+ assert live_runtime_available(workspace,'platform',period)=20000000;
+ perform live_close_runtime(reservation,workspace,repeat('a',64),'cancelled');
+ perform live_reserve_ai(workspace,'qa','runtime-legacy-approved','reader',null,4000);
+ assert live_runtime_available(workspace,'platform',period)=available-50000000;
+ begin perform live_reserve_runtime(workspace,artifact,null,'runtime-too-expensive',repeat('a',64),'platform','r2-read',null,'r2-test',available);raise exception 'runtime bypassed legacy obligation';exception when raise_exception then if sqlerrm<>'RUNTIME_BUDGET_EXHAUSTED' then raise;end if;end;
+
+ -- Net subscription revenue contributes exactly 60%; replay cannot mint more.
+ available:=live_runtime_available(workspace,'platform',period);
+ event:=live_record_runtime_funding(workspace,'subscription','balance-subscription',repeat('a',64),500,period);
+ assert live_record_runtime_funding(workspace,'subscription','balance-subscription',repeat('a',64),500,period)=event;
+ assert live_runtime_available(workspace,'platform',period)=available+3000000000;
+ begin perform live_record_runtime_funding(other_workspace,'subscription','balance-subscription',repeat('a',64),500,period);raise exception 'funding transferred workspace';exception when raise_exception then if sqlerrm<>'IDEMPOTENCY_CONFLICT' then raise;end if;end;
+ perform live_record_runtime_funding(workspace,'subscription','balance-subscription-refund',repeat('b',64),-500,period);
+ assert live_runtime_available(workspace,'platform',period)=available;
+ begin update runtime_funding_events set net_cents=1000,amount_nanos=6000000000 where id=event;raise exception 'funding was edited';exception when raise_exception then if sqlerrm<>'RUNTIME_HISTORY_IMMUTABLE' then raise;end if;end;
+
+ -- Purchased credits are isolated by workspace, survive a month boundary,
+ -- and reserve/charge 2x actual supplier cost, releasing the unused difference.
+ perform live_record_runtime_funding(workspace,'prepaid','balance-prepaid',repeat('c',64),1000,(period-interval '1 month')::date);
+ assert live_runtime_available(workspace,'prepaid',period)=10000000000;assert live_runtime_available(other_workspace,'prepaid',period)=0;
+ assert live_runtime_available(workspace,'platform',period)=available;
+ result:=live_reserve_runtime(workspace,artifact,null,'runtime-prepaid',repeat('a',64),'prepaid','browser-run',null,'browser-test',2000000000);reservation:=(result->>'id')::uuid;
+ assert result->>'chargedMaximumNanos'='4000000000';assert live_runtime_available(workspace,'prepaid',period)=6000000000;
+ assert live_dispatch_runtime(reservation,workspace,repeat('a',64));
+ result:=live_close_runtime(reservation,workspace,repeat('a',64),'settled',repeat('d',64),250000000,'prepaid-provider');
+ assert result->>'chargedActualNanos'='500000000';assert live_runtime_available(workspace,'prepaid',period)=9500000000;
+ reservation:=(live_reserve_runtime(workspace,artifact,null,'runtime-refund-pause',repeat('a',64),'prepaid','browser-run',null,'browser-test',1000000000)->>'id')::uuid;
+ perform live_record_runtime_funding(workspace,'prepaid','balance-prepaid-refund',repeat('d',64),-1000,period);
+ assert live_runtime_available(workspace,'prepaid',period)=-2500000000;assert not live_dispatch_runtime(reservation,workspace,repeat('a',64));
+ perform live_close_runtime(reservation,workspace,repeat('a',64),'cancelled');assert live_runtime_available(workspace,'prepaid',period)=-500000000;
+ begin perform live_reserve_runtime(workspace,artifact,null,'runtime-refund-overage',repeat('a',64),'prepaid','browser-run',null,'browser-test',1);raise exception 'automatically funded credit overage';exception when raise_exception then if sqlerrm<>'RUNTIME_BUDGET_EXHAUSTED' then raise;end if;end;
+
+ -- Three core tasks per platform, one operation per project; no helper fallback.
+ begin perform live_reserve_runtime(workspace,artifact,operation,'runtime-wrong-model',repeat('a',64),'platform','coder','anthropic/claude-sonnet-4.6','astra-test',1000);raise exception 'fallback core model admitted';exception when raise_exception then if sqlerrm<>'CORE_MODEL_REQUIRED' then raise;end if;end;
+ reservation:=(live_reserve_runtime(workspace,artifact,operation,'runtime-planner',repeat('a',64),'platform','planner','openai/gpt-6-astra','astra-test',1000000000)->>'id')::uuid;
+ begin perform live_reserve_runtime(workspace,artifact,other_operation,'runtime-project-race',repeat('b',64),'platform','coder','openai/gpt-6-astra','astra-test',1000000000);raise exception 'two operations in one project';exception when raise_exception then if sqlerrm<>'RUNTIME_PROJECT_BUSY' then raise;end if;end;
+ second:=(live_reserve_runtime(workspace,artifact,operation,'runtime-coder',repeat('b',64),'platform','coder','openai/gpt-6-astra','astra-test',1000000000)->>'id')::uuid;
+ third:=(live_reserve_runtime(workspace,artifact,operation,'runtime-reviewer',repeat('c',64),'platform','reviewer','openai/gpt-6-astra','astra-test',1000000000)->>'id')::uuid;
+ begin perform live_reserve_runtime(workspace,other_artifact,parallel_operation,'runtime-fourth',repeat('d',64),'platform','planner','openai/gpt-6-astra','astra-test',1000000000);raise exception 'four simultaneous core tasks';exception when raise_exception then if sqlerrm<>'RUNTIME_MODEL_BUSY' then raise;end if;end;
+ update operations set status='cancelled' where id=operation;assert not live_dispatch_runtime(reservation,workspace,repeat('a',64));
+ assert (select status='released'from runtime_reservations where id=reservation);
+ perform live_close_runtime(second,workspace,repeat('b',64),'cancelled');perform live_close_runtime(third,workspace,repeat('c',64),'cancelled');
+
+ -- Late dispatch can never use an expired hold; expiry reclaim is bounded and
+ -- automatic during a later reservation, without touching dispatched work.
+ insert into runtime_reservations(id,workspace_id,artifact_id,idempotency_key,request_hash,source,purpose,policy,period,maximum_cost_nanos,charged_maximum_nanos,expires_at)
+ values(expired,workspace,artifact,'runtime-expired-fixture',repeat('a',64),'platform','r2-read','r2-test',period,1000,1000,now()-interval '1 second');
+ reservation:=(live_reserve_runtime(workspace,artifact,null,'runtime-expiry-trigger',repeat('a',64),'platform','r2-read',null,'r2-test',1000)->>'id')::uuid;
+ assert (select status='released'from runtime_reservations where id=expired);assert not live_dispatch_runtime(expired,workspace,repeat('a',64));
+ perform live_close_runtime(reservation,workspace,repeat('a',64),'cancelled');
+
+ reservation:=(live_reserve_runtime(workspace,artifact,null,'runtime-sandbox-one',repeat('a',64),'platform','sandbox',null,'sandbox-test',1000)->>'id')::uuid;
+ second:=(live_reserve_runtime(workspace,artifact,null,'runtime-sandbox-two',repeat('b',64),'platform','sandbox',null,'sandbox-test',1000)->>'id')::uuid;
+ begin perform live_reserve_runtime(workspace,artifact,null,'runtime-sandbox-three',repeat('c',64),'platform','sandbox',null,'sandbox-test',1000);raise exception 'three sandboxes';exception when raise_exception then if sqlerrm<>'RUNTIME_SANDBOX_BUSY' then raise;end if;end;
+ perform live_close_runtime(reservation,workspace,repeat('a',64),'cancelled');perform live_close_runtime(second,workspace,repeat('b',64),'cancelled');
+
+ -- A real overrun is recorded in full and pauses the price policy. It is not
+ -- hidden by clamping the bill or by issuing a fresh idempotency key.
+ reservation:=(live_reserve_runtime(workspace,artifact,null,'runtime-overrun',repeat('a',64),'platform','r2-read',null,'overrun-test',1000)->>'id')::uuid;
+ assert live_dispatch_runtime(reservation,workspace,repeat('a',64));
+ available:=live_runtime_available(workspace,'platform',period);
+ result:=live_close_runtime(reservation,workspace,repeat('a',64),'settled',repeat('b',64),10000,'overrun-provider');
+ assert result->>'exceededReservation'='true';assert live_runtime_available(workspace,'platform',period)=available-9000;
+ begin perform live_reserve_runtime(workspace,artifact,null,'runtime-overrun-again',repeat('c',64),'platform','r2-read',null,'overrun-test',1000);raise exception 'overrun policy dispatched again';exception when raise_exception then if sqlerrm<>'RUNTIME_POLICY_PAUSED' then raise;end if;end;
+end $$;
+set local role authenticated;
+do $$begin
+ begin perform * from public.runtime_reservations;raise exception 'raw funding exposed';exception when insufficient_privilege then null;end;
+ begin perform public.live_runtime_available(gen_random_uuid(),'platform',date_trunc('month',now())::date);raise exception 'funding helper exposed';exception when insufficient_privilege then null;end;
+ begin perform public.live_record_runtime_funding(gen_random_uuid(),'prepaid','forged-payment',repeat('a',64),1000,date_trunc('month',now())::date);raise exception 'client minted credits';exception when insufficient_privilege then null;end;
+ begin perform public.live_reserve_runtime(null,null,null,null,null,null,null,null,null,null);raise exception 'client admitted expense';exception when insufficient_privilege then null;end;
+end $$;
+reset role;
+set local role service_role;
+do $$begin
+ begin perform * from public.runtime_reservations;raise exception 'service bypassed financial RPCs';exception when insufficient_privilege then null;end;
+ begin perform public.live_reserve_runtime(null,null,null,null,null,null,null,null,null,null);raise exception 'null request admitted';exception when raise_exception then if sqlerrm<>'RUNTIME_INTENT_INVALID' then raise;end if;end;
+end $$;
+reset role;
+rollback;
diff --git a/tests/sql/runtime-schema-shadow.sql b/tests/sql/runtime-schema-shadow.sql
new file mode 100644
index 0000000..72bdff3
--- /dev/null
+++ b/tests/sql/runtime-schema-shadow.sql
@@ -0,0 +1,28 @@
+-- An explicitly last pg_temp prevents a caller's temporary relation/type from
+-- replacing canonical financial records inside SECURITY DEFINER functions.
+begin;
+create temp table runtime_funding_events(like public.runtime_funding_events including all);
+create temp table runtime_reservations(like public.runtime_reservations including all);
+create temp table runtime_policy_pauses(like public.runtime_policy_pauses including all);
+create temp table ai_budget_months(like public.ai_budget_months including all);
+do $$
+declare actor uuid:=gen_random_uuid();workspace uuid;event uuid;reservation uuid;period date:=date_trunc('month',now())::date;
+begin
+ insert into auth.users(id,email,email_confirmed_at)values(actor,'runtime-shadow@example.test',now());workspace:=public.live_ensure_workspace(actor);
+ insert into pg_temp.runtime_funding_events(event_key,event_hash,source,workspace_id,period,net_cents,amount_nanos)values('fake-credit',repeat('f',64),'prepaid',workspace,period,100000,1000000000000);
+ assert public.live_runtime_available(workspace,'prepaid',period)=0;
+ begin perform public.live_reserve_runtime(workspace,null,null,'forged-spend',repeat('a',64),'prepaid','r2-read',null,'test-shadow',1);raise exception 'temporary ledger granted real funds';exception when raise_exception then if sqlerrm<>'RUNTIME_BUDGET_EXHAUSTED'then raise;end if;end;
+ event:=public.live_record_runtime_funding(workspace,'prepaid','real-credit',repeat('a',64),10,period);
+ assert exists(select 1 from public.runtime_funding_events where id=event);
+ assert not exists(select 1 from pg_temp.runtime_funding_events where id=event);
+ reservation:=(public.live_reserve_runtime(workspace,null,null,'real-spend',repeat('a',64),'prepaid','r2-read',null,'test-shadow',50000000)->>'id')::uuid;
+ assert exists(select 1 from public.runtime_reservations where id=reservation);
+ assert not exists(select 1 from pg_temp.runtime_reservations where id=reservation);
+ assert public.live_dispatch_runtime(reservation,workspace,repeat('a',64));
+ perform public.live_close_runtime(reservation,workspace,repeat('a',64),'settled',repeat('b',64),10000000,'shadow-test-provider');
+ assert public.live_runtime_available(workspace,'prepaid',period)=80000000;
+ perform public.live_reserve_ai(workspace,'qa','shadow-legacy','reader-shadow',null,4000);
+ assert exists(select 1 from public.ai_budget_months where month=period and reserved_cents=5);
+ assert not exists(select 1 from pg_temp.ai_budget_months);
+end $$;
+rollback;
diff --git a/tests/sql/source-revisions.sql b/tests/sql/source-revisions.sql
new file mode 100644
index 0000000..137969f
--- /dev/null
+++ b/tests/sql/source-revisions.sql
@@ -0,0 +1,75 @@
+begin;
+\ir ../../supabase/tests/source-revision-fixtures.sql
+do $$
+declare f jsonb:=pg_temp.revision_fixture();o uuid:=(f->>'op')::uuid;t uuid:=(f->>'task')::uuid;w uuid:=(f->>'workspace')::uuid;a uuid:=(f->>'artifact')::uuid;b uuid:=(f->>'base')::uuid;s jsonb;s2 jsonb;v uuid;bytes bigint;used bigint;h text:=encode(sha256(convert_to('<button>Revised</button>','UTF8')),'hex');r jsonb;
+begin
+ assert live_core_source_active(o,'revision-run',b);assert not live_core_source_active(o,'other-run',b);assert not live_core_source_active(o,'revision-run',gen_random_uuid());
+ begin perform live_prepare_core_revision(o,'revision-run',t);raise exception 'unreviewed revision saved';exception when raise_exception then if sqlerrm<>'CORE_REVIEW_REQUIRED' then raise;end if;end;
+ perform pg_temp.revision_review(o,t);
+ -- Capacity is checked before any save/object record is created.
+ select storage_bytes into used from workspaces where id=w;update workspaces set storage_bytes=250*1024*1024 where id=w;
+ begin perform live_prepare_core_revision(o,'revision-run',t);raise exception 'quota bypassed';exception when raise_exception then if sqlerrm<>'STORAGE_LIMIT' then raise;end if;end;
+ assert not exists(select 1 from core_revision_saves where task_id=t);update workspaces set storage_bytes=used where id=w;
+ s:=live_prepare_core_revision(o,'revision-run',t);s2:=live_prepare_core_revision(o,'revision-run',t);assert s=s2;bytes:=(s->>'reserved_bytes')::bigint;
+ assert (select upload_reserved_bytes=bytes and storage_bytes=used from workspaces where id=w);
+ assert jsonb_array_length(s->'objects')=1;
+ assert s->'manifest'->'files'->0=f->'manifest'->'files'->1;assert s->'manifest'->'files'->1=f->'manifest'->'files'->2;
+ assert s->'manifest'->'files'->2->'storage'->>'versionId'=t::text;
+ assert(select latest_version_id=b from artifacts where id=a);assert not exists(select 1 from publications where artifact_id=a);
+ begin perform live_complete_core_revision(o,'revision-run',t);raise exception 'unverified write finalized';exception when raise_exception then if sqlerrm<>'CORE_OBJECT_UNVERIFIED' then raise;end if;end;
+ begin perform live_confirm_core_revision_object(o,'revision-run',t,'index.html',repeat('a',64),24);raise exception 'wrong object accepted';exception when raise_exception then if sqlerrm<>'CORE_OBJECT_INVALID' then raise;end if;end;
+ -- Scope/grant admission is atomic with runtime dispatch. An unrelated object
+ -- and a different runner cannot consume an authorized reservation.
+ r:=live_reserve_r2_runtime('preview',w,a,t,h,'text/html',24,repeat('f',32),repeat('f',64),'r2-upload');
+ assert not live_dispatch_core_storage(o,'other-run',(r->>'id')::uuid,repeat('f',64),t,h,'text/html','r2-upload');
+ assert not live_dispatch_core_storage(o,'revision-run',(r->>'id')::uuid,repeat('f',64),gen_random_uuid(),h,'text/html','r2-upload');
+ assert live_dispatch_core_storage(o,'revision-run',(r->>'id')::uuid,repeat('f',64),t,h,'text/html','r2-upload');
+ assert not live_dispatch_core_storage(o,'revision-run',(r->>'id')::uuid,repeat('f',64),t,h,'text/html','r2-upload');
+ assert live_confirm_core_revision_object(o,'revision-run',t,'index.html',h,24);assert live_confirm_core_revision_object(o,'revision-run',t,'index.html',h,24);
+ s2:=live_prepare_core_revision(o,'revision-run',t);assert s2->'objects'->0->>'verified_at' is not null;
+ v:=live_complete_core_revision(o,'revision-run',t);assert live_complete_core_revision(o,'revision-run',t)=v;
+ assert (live_prepare_core_revision(o,'revision-run',t)->>'version_id')::uuid=v;
+ assert (select count(*) from artifact_versions where artifact_id=a)=2;
+ assert(select upload_reserved_bytes=0 and storage_bytes=used+bytes from workspaces where id=w);
+ assert(select manifest=s->'manifest' from artifact_versions where id=v);assert(select latest_version_id=v from artifacts where id=a);
+ assert not live_core_grant_active(o);assert not exists(select 1 from publications where artifact_id=a);
+ assert (select status='dispatched' and actual_cost_nanos is null from runtime_reservations where id=(r->>'id')::uuid),'storage success must not settle supplier liability';
+end $$;
+do $$
+declare f jsonb;o uuid;t uuid;w uuid;b uuid;s jsonb;patch jsonb;variant text;
+begin
+ foreach variant in array array['missing-type','wrong-hash','case-alias','delete-entrypoint','invalid-json','oversized','duplicate-path'] loop
+  f:=pg_temp.revision_fixture();o:=(f->>'op')::uuid;t:=(f->>'task')::uuid;patch:=f->'patch';
+  -- Use an independently created paid candidate per malformed patch. Never
+  -- mutate canonical model history even in this adversarial test.
+  perform live_cancel_operation((f->>'actor')::uuid,(f->>'workspace')::uuid,o,(f->>'login')::uuid,null);
+  patch:=patch-'baseVersionId';
+  if variant='missing-type' then patch:=jsonb_set(patch,'{changes,0}',(patch->'changes'->0)-'mediaType');
+  elsif variant='wrong-hash' then patch:=jsonb_set(patch,'{changes,0,previousSha256}',to_jsonb(repeat('f',64)));
+  elsif variant='case-alias' then patch:=jsonb_set(jsonb_set(patch,'{changes,0,path}','"INDEX.html"'),'{changes,0,previousSha256}','null');
+  elsif variant='delete-entrypoint' then patch:=jsonb_set(jsonb_set(patch,'{changes}','[]'),'{deletions}',jsonb_build_array(jsonb_build_object('path','index.html','previousSha256',f->'patch'->'changes'->0->>'previousSha256')));
+  elsif variant='invalid-json' then patch:=jsonb_set(patch,'{changes}',jsonb_build_array(jsonb_build_object('path','bad.json','mediaType','application/json','content','{','previousSha256',null)));
+  elsif variant='oversized' then patch:=jsonb_set(patch,'{changes,0,content}',to_jsonb(repeat('x',96001)));
