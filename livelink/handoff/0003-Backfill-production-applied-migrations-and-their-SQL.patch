+ insert into artifact_upload_transfers(id,upload_id,file_index,generation) values(p_transfer_id,p_upload_id,p_file_index,p_generation) returning artifact_upload_transfers.expires_at into v_until;
+ insert into audit_events(workspace_id,action,target_id,trace_id,metadata) values(v_file.workspace_id,'upload.transfer.admitted',p_transfer_id,p_transfer_id::text,jsonb_build_object('uploadId',p_upload_id,'fileIndex',p_file_index));
+ return query select v_file.object_version_id,v_file.workspace_id,v_file.artifact_id,v_file.byte_size,v_file.sha256,v_file.media_type,false,v_until;
+end $$;
+
+create function public.live_complete_upload_transfer(p_upload_id uuid,p_file_index integer,p_generation integer,p_transfer_id uuid,p_sha256 text,p_byte_size bigint)
+returns void language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_file artifact_upload_files;v_transfer artifact_upload_transfers;
+begin
+ select * into v_file from live_authorize_upload_file(p_upload_id,p_file_index,p_generation);
+ select * into v_transfer from artifact_upload_transfers where id=p_transfer_id and upload_id=p_upload_id and file_index=p_file_index and generation=p_generation for update;
+ if not found then raise exception 'UPLOAD_GRANT_INVALID';end if;
+ if v_file.sha256 is distinct from p_sha256 or v_file.byte_size is distinct from p_byte_size then raise exception 'UPLOAD_INTEGRITY_FAILED';end if;
+ if v_transfer.status='completed' then return;end if;
+ if v_transfer.status<>'admitted' or v_transfer.expires_at<=clock_timestamp() then raise exception 'UPLOAD_TRANSFER_EXPIRED';end if;
+ perform live_confirm_upload_file(p_upload_id,p_file_index,p_generation,p_sha256,p_byte_size);
+ update artifact_upload_transfers set status='completed',finished_at=clock_timestamp() where id=p_transfer_id;
+ insert into audit_events(workspace_id,action,target_id,trace_id,metadata) values(v_file.workspace_id,'upload.transfer.completed',p_transfer_id,p_transfer_id::text,jsonb_build_object('uploadId',p_upload_id,'fileIndex',p_file_index));
+end $$;
+
+-- Failure closes an existing attempt only; it never authorizes or refunds bytes.
+create function public.live_fail_upload_transfer(p_upload_id uuid,p_file_index integer,p_generation integer,p_transfer_id uuid)
+returns void language plpgsql volatile security definer set search_path=public,pg_temp as $$
