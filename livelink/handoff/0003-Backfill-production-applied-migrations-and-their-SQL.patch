+ if not found or o.runner_id is distinct from p_runner_id or o.status not in ('queued','running')then return;end if;
+ update operations set status=case when p_terminal then 'failed'else 'paused'end,pause_reason=p_reason,error=p_message,updated_at=now()where id=o.id;
+ for r in select * from runtime_reservations where operation_id=o.id and status='reserved'loop
+  perform live_close_runtime(r.id,r.workspace_id,r.request_hash,'cancelled');
