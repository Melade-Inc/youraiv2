+create or replace function public.live_core_revision_history()returns trigger language plpgsql security definer set search_path=public,pg_temp as $$
+begin
+ if tg_op='UPDATE'and live_content_redaction_allowed(tg_table_name,to_jsonb(old),to_jsonb(new))then return new;end if;
+ if tg_op='DELETE'then raise exception 'CORE_REVISION_IMMUTABLE';end if;
