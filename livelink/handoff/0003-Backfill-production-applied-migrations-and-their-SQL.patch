+create function pg_temp.revision_task(p_op uuid,p_ordinal integer,p_output jsonb,p_candidate uuid default null)returns uuid language plpgsql as $$
+declare t jsonb;role text:=case when p_ordinal=0 then 'planner' when p_ordinal%2=1 then 'coder' else 'reviewer' end;hash text:=encode(sha256(convert_to(gen_random_uuid()::text,'UTF8')),'hex');o operations;
+begin
+ select * into o from operations where id=p_op;
+ t:=live_prepare_core_task(p_op,'revision-run',p_ordinal,'[{"role":"user","content":"Revision fixture"}]',jsonb_build_object('model','openai/gpt-6-astra','policy','astra-20260905-v2','role',role,'requestHash',hash,'maximumCostNanos','100000000','maximumInputTokens',5000,'maximumOutputTokens',1024),p_candidate);
+ assert live_dispatch_core_runtime((t->>'reservation_id')::uuid,o.workspace_id,o.artifact_id,p_op,hash,'openai/gpt-6-astra','astra-20260905-v2',role,100000000);
+ perform live_record_core_result((t->>'id')::uuid,'revision-run',jsonb_build_object('model','openai/gpt-6-astra','requestHash',hash,'receiptHash',repeat('d',64),'responseHash',repeat('e',64),'actualCostNanos','1000000','providerRequestId',gen_random_uuid()),p_output);
+ return (t->>'id')::uuid;
+end $$;
+create function pg_temp.revision_review(p_op uuid,p_task uuid)returns void language plpgsql as $$begin perform pg_temp.revision_task(p_op,2,jsonb_build_object('reviewedTaskId',p_task,'passed',true,'summary','Passed','issues','[]'::jsonb),p_task);end$$;
+create function pg_temp.revision_fixture(p_patch jsonb default null)returns jsonb language plpgsql as $$
+declare actor uuid:=gen_random_uuid();login uuid:=gen_random_uuid();workspace uuid;artifact uuid;v uuid:=gen_random_uuid();o uuid;t uuid;base jsonb;patch jsonb;h text:=encode(sha256(convert_to('Original source','UTF8')),'hex');
+begin
+ insert into auth.users(id,email,email_confirmed_at)values(actor,actor::text||'@revision.test',now());insert into auth.sessions(id,user_id)values(login,actor);workspace:=live_ensure_workspace(actor);
+ artifact:=live_create_artifact(actor,workspace,'Source preservation','app','revision-fixture','fixture');
+ base:=jsonb_build_object('schemaVersion',2,'kind','app','title','Original','description','','entrypoint','index.html','blocks','[]'::jsonb,'files',jsonb_build_array(
+ jsonb_build_object('path','index.html','mediaType','text/html','size',15,'sha256',h,'encoding','r2','content','','storage',jsonb_build_object('versionId',v)),
+ jsonb_build_object('path','photo.png','mediaType','image/png','size',1000000,'sha256',repeat('b',64),'encoding','r2','content','','storage',jsonb_build_object('versionId',v)),
+ jsonb_build_object('path','large.txt','mediaType','text/plain','size',100000,'sha256',repeat('c',64),'encoding','r2','content','','storage',jsonb_build_object('versionId',v))));
+ insert into artifact_versions(id,workspace_id,artifact_id,number,manifest,content_hash,idempotency_key)values(v,workspace,artifact,1,base,repeat('a',64),'revision-base');
+ update artifacts set latest_version_id=v where id=artifact;update workspaces set storage_bytes=1100015+octet_length(base::text) where id=workspace;
+ o:=live_create_core_operation(actor,workspace,artifact,v,'app','Improve the primary button','revision-start',repeat('e',64),'platform',login,null);assert live_claim_operation(o,'revision-run');
+ perform pg_temp.revision_task(o,0,'{"title":"Revised","goal":"Improve the button","audience":"Visitors","acceptance":["Usable button"],"constraints":[],"sourcePaths":["index.html"]}');
+ patch:=coalesce(p_patch,jsonb_build_object('mode','stored-revision','title','Revised','description','','entrypoint','index.html','blocks','[]'::jsonb,'changes',jsonb_build_array(jsonb_build_object('path','index.html','mediaType','text/html','previousSha256',h,'content','<button>Revised</button>')),'deletions','[]'::jsonb))||jsonb_build_object('baseVersionId',v);
+ t:=pg_temp.revision_task(o,1,patch);
+ return jsonb_build_object('actor',actor,'login',login,'workspace',workspace,'artifact',artifact,'base',v,'op',o,'task',t,'manifest',base,'patch',patch);
+end $$;
