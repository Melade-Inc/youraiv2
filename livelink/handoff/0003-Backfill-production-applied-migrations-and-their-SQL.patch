+ return new;
+end $$;
+create trigger project_storage_insert_guard before insert on public.cloudflare_storage_objects for each row execute function public.live_project_storage_insert_guard();
+
+-- Expiry is a time check until the first cleanup claim. After that claim the
+-- recovery boundary is irreversible, even if the wall clock moves backward.
+-- A trigger also protects privileged callers that bypass the recovery RPC.
+create function public.live_project_storage_recovery_guard()returns trigger language plpgsql security definer set search_path=public,pg_temp as $$
+begin
+ if (new.deleted_at is distinct from old.deleted_at or new.access_epoch<>old.access_epoch)
+  and exists(select 1 from project_storage_purges where workspace_id=old.workspace_id and artifact_id=old.id)
+ then raise exception 'RECOVERY_EXPIRED';end if;
+ return new;
+end $$;
+create trigger project_storage_recovery_guard before update of deleted_at,access_epoch on public.artifacts for each row execute function public.live_project_storage_recovery_guard();
+
+create or replace function public.live_removal_summary(p_id uuid)returns jsonb language sql stable set search_path=public,pg_temp as $$
+ select jsonb_build_object('id',r.id,'artifactId',r.artifact_id,'title',a.title,'kind',a.kind,'accessEpoch',r.access_epoch,
+  'removedAt',r.removed_at,'recoverableUntil',r.recoverable_until,'restoredAt',r.restored_at,
+  'recoverable',r.restored_at is null and r.recoverable_until>clock_timestamp()and not exists(select 1 from project_storage_purges where removal_id=r.id),
+  'status',case when r.restored_at is not null then 'recovered'when r.recoverable_until>clock_timestamp()and not exists(select 1 from project_storage_purges where removal_id=r.id)then 'recoverable'else 'awaiting-cleanup'end,'observedAt',clock_timestamp())
+ from artifact_removals r join artifacts a on a.id=r.artifact_id and a.workspace_id=r.workspace_id where r.id=p_id
+$$;
+
+-- Internal, transaction-scoped authority. Deliberately independent of a login
+-- session that will usually have expired long before the retention deadline.
+create function public.live_lock_project_storage_authority(p_removal_id uuid)
+returns public.artifact_removals language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare r artifact_removals;a artifacts;
+begin
+ select * into r from artifact_removals where id=p_removal_id;
+ if not found then raise exception 'PROJECT_CLEANUP_DENIED';end if;
+ perform 1 from workspaces where id=r.workspace_id for update;
+ select * into a from artifacts where id=r.artifact_id and workspace_id=r.workspace_id for update;
+ select * into r from artifact_removals where id=p_removal_id for share;
+ if a.id is null or r.restored_at is not null or r.recoverable_until>clock_timestamp()
+  or a.deleted_at is distinct from r.removed_at or a.access_epoch<>r.access_epoch
+  or exists(select 1 from publications where artifact_id=a.id and revoked_at is null)
+  or exists(select 1 from operation_grants where artifact_id=a.id and revoked_at is null)
+  or exists(select 1 from operations where artifact_id=a.id and status in ('queued','running','paused'))
+  or exists(select 1 from artifact_uploads where artifact_id=a.id and status='uploading')
+  or exists(select 1 from artifact_upload_transfers t join artifact_uploads u on u.id=t.upload_id
+    where u.artifact_id=a.id and t.status='admitted'and t.expires_at>clock_timestamp())
+ then raise exception 'PROJECT_CLEANUP_DENIED';end if;
+ return r;
+end $$;
+
+create function public.live_project_storage_reference(p_object_id uuid)returns jsonb language sql stable set search_path=public,pg_temp as $$
+ select jsonb_strip_nulls(jsonb_build_object('workspaceId',workspace_id,'artifactId',artifact_id,'versionId',object_version_id,
+  'sha256',sha256,'mediaType',nullif(media_type,''),'byteSize',byte_size))from project_storage_purge_objects where id=p_object_id
