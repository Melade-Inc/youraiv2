+-- Historical removals keep their original deadline. This is not a purge.
+update public.artifacts set access_epoch=1 where deleted_at is not null;
+insert into public.artifact_removals(workspace_id,artifact_id,access_epoch,removed_at,recoverable_until,removed_by,idempotency_key,source)
+ select a.workspace_id,a.id,a.access_epoch,a.deleted_at,a.deleted_at+interval '720 hours',w.owner_id,'legacy:'||a.id::text,'legacy'
+ from public.artifacts a join public.workspaces w on w.id=a.workspace_id where a.deleted_at is not null;
