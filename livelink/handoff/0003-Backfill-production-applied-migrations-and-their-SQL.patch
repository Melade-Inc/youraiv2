+begin;
+do $$
+declare actor uuid:=gen_random_uuid();login uuid:=gen_random_uuid();new_login uuid:=gen_random_uuid();workspace uuid;artifact uuid;upload uuid;other_upload uuid;t uuid:=gen_random_uuid();next_t uuid;manifest jsonb;
+begin
+ insert into auth.users(id,email,email_confirmed_at) values(actor,'upload-transfers@example.test',now());
+ insert into auth.sessions(id,user_id) values(login,actor),(new_login,actor);
+ workspace:=live_ensure_workspace(actor);artifact:=live_create_artifact(actor,workspace,'Transfer test','app','transfer-test');
+ manifest:='{"schemaVersion":2,"kind":"app","title":"Transfer test","entrypoint":"index.html","blocks":[],"files":[{"path":"index.html","mediaType":"text/html","size":100,"sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}';
+ upload:=live_begin_upload(actor,workspace,artifact,manifest,null,'transfer-test',login,null,'test');
+ assert not (select already_verified from live_admit_upload_transfer(upload,0,1,t));
+ begin perform live_admit_upload_transfer(upload,0,1,t);raise exception 'replayed admission accepted';exception when raise_exception then if sqlerrm<>'TRANSFER_ALREADY_ADMITTED' then raise;end if;end;
+ begin perform live_admit_upload_transfer(upload,0,1,gen_random_uuid());raise exception 'parallel transfer accepted';exception when raise_exception then if sqlerrm<>'UPLOAD_IN_PROGRESS' then raise;end if;end;
+ begin perform live_complete_upload_transfer(upload,0,1,t,repeat('b',64),100);raise exception 'bad digest completed';exception when raise_exception then if sqlerrm<>'UPLOAD_INTEGRITY_FAILED' then raise;end if;end;
+ begin perform live_complete_upload_transfer(upload,0,1,t,repeat('a',64),101);raise exception 'bad length completed';exception when raise_exception then if sqlerrm<>'UPLOAD_INTEGRITY_FAILED' then raise;end if;end;
+ assert (select verified_at from artifact_upload_files where upload_id=upload) is null;
+ perform live_complete_upload_transfer(upload,0,1,t,repeat('a',64),100);
+ perform live_complete_upload_transfer(upload,0,1,t,repeat('a',64),100);
+ perform live_fail_upload_transfer(upload,0,1,t);
+ assert (select status from artifact_upload_transfers where id=t)='completed';
+ assert (select count(*) from audit_events where target_id=t and action='upload.transfer.completed')=1;
+ assert (select already_verified from live_admit_upload_transfer(upload,0,1,t));
+ assert (select already_verified from live_admit_upload_transfer(upload,0,1,gen_random_uuid()));
+ assert (select count(*) from artifact_upload_transfers where upload_id=upload)=1;
+ begin update artifact_upload_transfers set status='admitted' where id=t;raise exception 'completed transfer reopened';exception when raise_exception then if sqlerrm<>'IMMUTABLE_TRANSFER' then raise;end if;end;
+ begin delete from artifact_upload_transfers where id=t;raise exception 'transfer deleted';exception when raise_exception then if sqlerrm<>'IMMUTABLE_TRANSFER' then raise;end if;end;
+
+ other_upload:=live_begin_upload(actor,workspace,artifact,manifest,null,'transfer-attempts',login,null,'test');
+ begin perform live_admit_upload_transfer(other_upload,0,1,t);raise exception 'grant used for different upload';exception when raise_exception then if sqlerrm<>'UPLOAD_GRANT_INVALID' then raise;end if;end;
+ for attempt in 1..5 loop
+  next_t:=gen_random_uuid();perform live_admit_upload_transfer(other_upload,0,1,next_t);
+  perform live_fail_upload_transfer(other_upload,0,1,next_t);perform live_fail_upload_transfer(other_upload,0,1,next_t);
+  begin perform live_complete_upload_transfer(other_upload,0,1,next_t,repeat('a',64),100);raise exception 'failed transfer completed';exception when raise_exception then if sqlerrm<>'UPLOAD_TRANSFER_EXPIRED' then raise;end if;end;
