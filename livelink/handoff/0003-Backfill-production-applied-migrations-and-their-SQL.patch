+-- Bounded, single-admission transport attempts; Supabase remains the authority.
+create function public.live_upload_session_limit() returns trigger language plpgsql set search_path=public,pg_temp as $$
+begin
+ perform 1 from workspaces where id=new.workspace_id for update;
+ -- Cancelled/expired reservations remain outstanding until verified cleanup.
+ if (select count(*) from artifact_uploads where workspace_id=new.workspace_id and status<>'finalized')>=50 then raise exception 'UPLOAD_SESSION_LIMIT';end if;
+ return new;
+end $$;
+create trigger upload_session_limit before insert on public.artifact_uploads for each row execute function public.live_upload_session_limit();
+revoke all on function public.live_upload_session_limit() from public,anon,authenticated;
+grant execute on function public.live_upload_session_limit() to service_role;
+
+create table public.artifact_upload_transfers (
+ id uuid primary key,upload_id uuid not null,file_index integer not null,generation integer not null check(generation>0),
+ status text not null default 'admitted' check(status in ('admitted','completed','failed')),
+ created_at timestamptz not null default clock_timestamp(),expires_at timestamptz not null default clock_timestamp()+interval '10 minutes',
+ finished_at timestamptz,
