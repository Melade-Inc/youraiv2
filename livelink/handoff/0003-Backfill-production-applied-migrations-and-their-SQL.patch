+
+create function pg_temp.expire_content(p_ws uuid,p_artifact uuid,p_actor uuid)returns uuid language plpgsql as $$
+declare r uuid:=gen_random_uuid();removed timestamptz:=clock_timestamp()-interval '721 hours';
+begin
+ update operations set status='cancelled'where artifact_id=p_artifact and status in('queued','running','paused');
+ update operation_grants set revoked_at=clock_timestamp()where artifact_id=p_artifact and revoked_at is null;
+ update artifact_uploads set status='cancelled',generation=generation+1 where artifact_id=p_artifact and status='uploading';
+ update publications set revoked_at=clock_timestamp()where artifact_id=p_artifact and revoked_at is null;
+ insert into artifact_removals(id,workspace_id,artifact_id,access_epoch,removed_at,recoverable_until,removed_by,idempotency_key,source)values(r,p_ws,p_artifact,1,removed,removed+interval '720 hours',p_actor,r::text,'legacy');
+ update artifacts set deleted_at=removed,access_epoch=1 where id=p_artifact;
+ return r;
+end $$;
+create function pg_temp.finish_content(p_r uuid)returns jsonb language plpgsql as $$
+declare result jsonb;
+begin
+ for i in 1..100 loop
+  result:=live_advance_project_content_purge(p_r);
+  assert result is not null,'eligible cleanup must progress';
+  assert(result->>'processedRecords')::int<=10,'bounded batch';
+  if result->>'status'='content-removed'then return result;end if;
+  assert result->>'status'in('checking','removing-content'),'unexpected reconciliation block';
+ end loop;raise exception 'cleanup did not converge';
+end $$;
+do $$
+declare actor uuid:=gen_random_uuid();login uuid:=gen_random_uuid();w uuid;a uuid;other uuid;v uuid;r uuid;u uuid;old_u uuid;op uuid;t jsonb;v_receipt jsonb;result jsonb;stored bigint;reserved bigint;other_bytes bigint;claim uuid:=gen_random_uuid();
+ v_manifest jsonb:='{"schemaVersion":1,"kind":"document","title":"Private notes","blocks":[{"type":"markdown","text":"Confidential content"}]}';
+ upload_manifest jsonb:='{"schemaVersion":2,"kind":"document","title":"Never uploaded","blocks":[{"type":"markdown","text":"Private upload notes"}],"files":[]}';
+begin
+ insert into auth.users(id,email,email_confirmed_at)values(actor,'content-purge@example.test',now());insert into auth.sessions(id,user_id)values(login,actor);w:=live_ensure_workspace(actor);
+ a:=live_create_artifact(actor,w,'Private notes','document','content-test','original-create-key');other:=live_create_artifact(actor,w,'Other project','document','content-test');
+ perform live_finalize_version(actor,w,other,v_manifest,repeat('b',64),null,'other-saved','test');select storage_bytes into other_bytes from workspaces where id=w;
+ -- More versions than one reconciliation or redaction batch.
+ for i in 1..9 loop v:=live_finalize_version(actor,w,a,v_manifest,repeat('a',64),v,'content-version-'||i,'test');end loop;
+ perform live_publish(actor,w,a,v,'content-test','recipients',array['private@example.test'],null,null,'test');
+ insert into runtime_records(workspace_id,artifact_id,version_id,action_id,reader_id,data,idempotency_key)values(w,a,v,'submit','reader','{"email":"private@example.test"}','original-response-key');
+ old_u:=live_begin_upload(actor,w,a,upload_manifest,v,'old-upload-cleaned',login,null,'test');perform live_cancel_upload(old_u,actor,w,login,null,'test');
+ perform live_claim_upload_cleanup(claim,old_u);perform live_finish_upload_cleanup(old_u,claim);
+ u:=live_begin_upload(actor,w,a,upload_manifest,v,'new-upload-reserved',login,null,'test');
+ op:=live_create_core_operation(actor,w,a,v,'document','Private customer request','late-plan-task',repeat('c',64),'platform',login,null);assert live_claim_operation(op,'late-result');
+ t:=live_prepare_core_task(op,'late-result',0,'[{"role":"user","content":"Private customer request"}]',jsonb_build_object('model','openai/gpt-6-astra','policy','astra-20260905-v2','role','planner','requestHash',repeat('d',64),'maximumCostNanos','100000000'));
+ assert live_dispatch_core_runtime((t->>'reservation_id')::uuid,w,a,op,repeat('d',64),'openai/gpt-6-astra','astra-20260905-v2','planner',100000000);
+ select storage_bytes-other_bytes,upload_reserved_bytes into stored,reserved from workspaces where id=w;
+ r:=pg_temp.expire_content(w,a,actor);assert not(live_removal_summary(r)?'contentRemovedAt'),'unchanged summaries stay compatible before cleanup';result:=live_advance_project_content_purge(r);assert result->>'status'='checking';assert live_removal_summary(r)->>'status'='cleanup-running';
+ assert live_claim_upload_cleanup(gen_random_uuid(),u)is null,'old collector cannot race quota closure';
+ begin update artifacts set title='Resurrected'where id=a;raise exception 'late title accepted';exception when raise_exception then if sqlerrm<>'PROJECT_CONTENT_PURGING'then raise;end if;end;
+ begin update runtime_records set artifact_id=other where artifact_id=a;raise exception 'content scope moved';exception when raise_exception then if sqlerrm<>'CONTENT_SCOPE_IMMUTABLE'then raise;end if;end;
+ begin update artifacts set content_purged_at=clock_timestamp()where id=other;raise exception 'fabricated redaction';exception when raise_exception then if sqlerrm<>'CONTENT_PURGE_DENIED'then raise;end if;end;
+ assert(select storage_bytes=stored+other_bytes and upload_reserved_bytes=reserved from workspaces where id=w),'no partial quota release';
+ result:=pg_temp.finish_content(r);assert(result->>'releasedStoredBytes')::bigint=stored and(result->>'releasedReservedBytes')::bigint=reserved;
+ assert live_advance_project_content_purge(r)=result,'complete retry is identical';
+ assert(select storage_bytes=other_bytes and upload_reserved_bytes=0 from workspaces where id=w),'other project retains quota';
+ assert not exists(select 1 from artifact_versions where artifact_id=a and(manifest<>'{}'or content_purged_at is null));
+ assert not exists(select 1 from artifact_uploads where artifact_id=a and(manifest<>'{}'or request_manifest<>'{}'or content_purged_at is null));
+ assert(select recipients='{}'and revoked_at is not null from publications where artifact_id=a);
+ assert(select data='{}'from runtime_records where artifact_id=a);
+ assert(select messages='[]'and output is null and output_error is null and discarded and completed_at is null from operation_model_tasks where id=(t->>'id')::uuid);
+ assert(select prompt='[removed]'and generated_manifest is null and error is null from operations where id=op);
+ assert(select title='Removed project'and creation_payload is null and creation_key='original-create-key'from artifacts where id=a);
+ assert(select project_removal_id=r and completed_at is not null and released_bytes=reserved from artifact_upload_cleanup where upload_id=u);
+ assert(select project_removal_id is null from artifact_upload_cleanup where upload_id=old_u),'earlier upload release preserved';
+ assert live_removal_summary(r)->>'status'='content-removed'and live_removal_summary(r)->>'recoverable'='false';
+ assert(select count(*)from audit_events where action='project.saved_content_removed'and target_id=a)=1;
+ -- Receipt arrival after redaction still settles once; error text is discarded.
+ v_receipt:=jsonb_build_object('requestHash',repeat('d',64),'receiptHash',repeat('e',64),'responseHash',repeat('f',64),'actualCostNanos','1000000','providerRequestId','late-provider');
+ perform live_record_core_result((t->>'id')::uuid,'late-result',v_receipt,null,'Late private provider error');
+ perform live_record_core_result((t->>'id')::uuid,'late-result',v_receipt,null,'Late private provider error');
+ assert(select status='settled'and actual_cost_nanos=1000000 from runtime_reservations where id=(t->>'reservation_id')::uuid);
+ assert(select messages='[]'and output_error is null and discarded and receipt=v_receipt from operation_model_tasks where id=(t->>'id')::uuid);
+ begin update artifact_versions set manifest=manifest||'{"restored":true}'where artifact_id=a;raise exception 'resurrected version';exception when raise_exception then if sqlerrm not in('IMMUTABLE_VERSION','PROJECT_CONTENT_PURGING')then raise;end if;end;
+ begin update project_content_purges set phase='checking'where removal_id=r;raise exception 'reopened closure';exception when raise_exception then if sqlerrm<>'CONTENT_PURGE_HISTORY_IMMUTABLE'then raise;end if;end;
+ assert not has_table_privilege('service_role','project_content_purges','SELECT');assert not has_table_privilege('service_role','project_content_purge_items','UPDATE');
+ assert not has_function_privilege('authenticated','live_advance_project_content_purge(uuid)','EXECUTE');assert has_function_privilege('service_role','live_advance_project_content_purge(uuid)','EXECUTE');
+end $$;
+create function pg_temp.retire_content_storage(p_r uuid,p_environment text)returns void language plpgsql as $$
+declare claim uuid:=gen_random_uuid();batch jsonb;obj jsonb;admission jsonb;invocation uuid;
+begin
+ batch:=live_claim_project_storage_purge(p_environment,claim,p_r);assert batch is not null;
+ for obj in select value from jsonb_array_elements(batch->'objects')loop
+  invocation:=gen_random_uuid();admission:=live_authorize_project_storage_retirement(p_r,p_environment,claim,(obj->>'objectId')::uuid,invocation,repeat('a',64));
+  perform live_confirm_project_storage_retirement(jsonb_build_object('retired',true,'removalId',p_r,'environment',p_environment,'claimId',claim,'objectId',obj->'objectId','invocationId',invocation,'reference',admission->'reference','reservationId',admission->'funding'->'reservationId','requestHash',repeat('a',64)));
+ end loop;
+ assert live_finish_project_storage_purge(p_r,p_environment,claim)->>'knownStorageRetired'='true';
+end $$;
+do $$
+declare f jsonb;w uuid;a uuid;t uuid;o uuid;r uuid;s jsonb;file jsonb;env text;completed boolean;stored bigint;reserved bigint;result jsonb;financial jsonb;
+begin
+ perform live_begin_cloudflare_hosting();
+ foreach completed in array array[false,true]loop
+  f:=pg_temp.content_revision_fixture();w:=(f->>'workspace')::uuid;a:=(f->>'artifact')::uuid;t:=(f->>'task')::uuid;o:=(f->>'op')::uuid;
+  for file in select value from jsonb_array_elements(f->'manifest'->'files')loop
+   foreach env in array array['preview','production']loop perform live_track_cloudflare_object(env,w,a,(file->'storage'->>'versionId')::uuid,file->>'sha256',file->>'mediaType',(file->>'size')::bigint);end loop;
+  end loop;
+  perform pg_temp.revision_review(o,t);s:=live_prepare_core_revision(o,'revision-run',t);
+  if completed then
+   file:=s->'objects'->0;
+   perform live_track_cloudflare_object('preview',w,a,t,file->>'sha256',file->>'media_type',(file->>'byte_size')::bigint);
+   perform live_confirm_core_revision_object(o,'revision-run',t,file->>'path',file->>'sha256',(file->>'byte_size')::bigint);perform live_complete_core_revision(o,'revision-run',t);
+  end if;
+  select storage_bytes,upload_reserved_bytes into stored,reserved from workspaces where id=w;
+  r:=pg_temp.expire_content(w,a,(f->>'actor')::uuid);
+  assert live_advance_project_content_purge(r)->>'status'='waiting-for-storage';
+  perform pg_temp.retire_content_storage(r,'preview');update project_content_purges set next_attempt_at=clock_timestamp()where removal_id=r;
+  assert live_advance_project_content_purge(r)->>'status'='waiting-for-storage','every recorded environment must retire';
+  perform pg_temp.retire_content_storage(r,'production');update project_content_purges set next_attempt_at=clock_timestamp()where removal_id=r;
+  select jsonb_agg(to_jsonb(x)order by id)into financial from runtime_reservations x where workspace_id=w;
+  result:=pg_temp.finish_content(r);
+  assert(result->>'releasedStoredBytes')::bigint=stored and(result->>'releasedReservedBytes')::bigint=reserved;
+  assert(select storage_bytes=0 and upload_reserved_bytes=0 from workspaces where id=w);
+  assert(select manifest='{}'and content_purged_at is not null from core_revision_saves where task_id=t);
+  assert not exists(select 1 from core_revision_objects where task_id=t and(path not like '[purged]:%'or content_purged_at is null));
+  assert not exists(select 1 from artifact_upload_files where artifact_id=a and(path not like '[purged]:%'or content_purged_at is null));
+  assert financial=(select jsonb_agg(to_jsonb(x)order by id)from runtime_reservations x where workspace_id=w),'redaction never changes financial history';
+  assert live_advance_project_content_purge(r)=result;
+ end loop;
+ -- Missing commitment is not a never-written proof for a finalized upload.
