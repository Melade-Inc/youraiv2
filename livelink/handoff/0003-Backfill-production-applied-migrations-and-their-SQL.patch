+begin;
+do $$
+declare actor uuid:=gen_random_uuid();workspace uuid;artifact uuid;reservation uuid;receipt jsonb;policy text:='cloudflare-standard-2026-09-05-v1';purpose text;
+begin
+ insert into auth.users(id,email,email_confirmed_at)values(actor,'dedicated-upload@example.test',now());workspace:=live_ensure_workspace(actor);artifact:=live_create_artifact(actor,workspace,'Dedicated upload','app','test');
+ foreach purpose in array array['r2-upload','r2-read','r2-cleanup'] loop
+  reservation:=(live_reserve_runtime(workspace,artifact,null,'dedicated-'||purpose,repeat('a',64),'platform',purpose,null,policy,case when purpose='r2-upload' then 610020 else 6520 end)->>'id')::uuid;
+  assert live_dispatch_runtime(reservation,workspace,repeat('a',64));
+  receipt:=jsonb_build_object('schemaVersion',1,'environment','production','scriptName','live-link-upload-production','scriptVersion','11111111-0000-4000-8000-000000000003','eventTimestamp',floor(extract(epoch from now())*1000),'reservationId',reservation,'requestHash',repeat('a',64),'policy',policy,'purpose',purpose,'outcome','ok','cpuMs',3,'wallMs',28,'complete',true,'attemptedClassA',1,'attemptedClassB',0,'listPriceCostNanos','4860','exceedsQuote',false,'costBasis','metered-list-price-before-inclusions-and-billing-rounding');
+  begin perform live_record_cloudflare_usage('preview',receipt);raise exception 'cross-environment producer';exception when raise_exception then if sqlerrm<>'CLOUDFLARE_RECEIPT_INVALID' then raise;end if;end;
+  if purpose='r2-upload' then
+   assert live_record_cloudflare_usage('production',receipt)->>'recorded'='true';
+   assert (select status='unknown' and actual_cost_nanos is null from runtime_reservations where id=reservation);
+  else
+   begin perform live_record_cloudflare_usage('production',receipt);raise exception 'upload producer reported other purpose';exception when raise_exception then if sqlerrm<>'CLOUDFLARE_RECEIPT_INVALID' then raise;end if;end;
+   assert not exists(select 1 from cloudflare_usage_observations where reservation_id=reservation);
+   assert live_record_cloudflare_usage('production',receipt||'{"scriptName":"live-link-r2-production"}') ->>'recorded'='true';
+  end if;
+ end loop;
+end $$;
+rollback;
diff --git a/tests/sql/delivery-read-check.sql b/tests/sql/delivery-read-check.sql
