+ -- The task history trigger still verifies unchanged identity and receipt.
+ if tg_table_name='operation_model_tasks'and to_jsonb(old)->>'completed_at'is null and row_data->>'completed_at'is not null
+  and(row_data-array['receipt','output','output_error','discarded','completed_at'])is not distinct from(to_jsonb(old)-array['receipt','output','output_error','discarded','completed_at'])
+  and row_data->'output'='null'::jsonb and row_data->'output_error'='null'::jsonb and row_data->'discarded'='true'::jsonb then return new;end if;
+ if row_data=to_jsonb(old)then return new;end if;
+ raise exception 'PROJECT_CONTENT_PURGING';
+end $$;
+do $$declare name text;begin
+ foreach name in array array['artifacts','artifact_versions','artifact_uploads','artifact_upload_files','core_revision_saves','core_revision_objects','operation_model_tasks','operations','runtime_records','publications','artifact_upload_transfers']loop
+  execute format('create trigger content_write_guard before insert or update on public.%I for each row execute function public.live_content_write_guard()',name);
+ end loop;
+end $$;
