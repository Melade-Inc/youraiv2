+);
+create index upload_transfer_file_idx on public.artifact_upload_transfers(upload_id,file_index,created_at);
+alter table public.artifact_upload_transfers enable row level security;
+revoke all on public.artifact_upload_transfers from public,anon,authenticated;
+grant all on public.artifact_upload_transfers to service_role;
+
+create function public.live_admit_upload_transfer(p_upload_id uuid,p_file_index integer,p_generation integer,p_transfer_id uuid)
+returns table(object_version_id uuid,workspace_id uuid,artifact_id uuid,byte_size bigint,sha256 text,media_type text,already_verified boolean,expires_at timestamptz)
+language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_file artifact_upload_files;v_prior artifact_upload_transfers;v_until timestamptz;
+begin
+ if p_transfer_id is null then raise exception 'UPLOAD_GRANT_INVALID';end if;
+ select * into v_file from live_authorize_upload_file(p_upload_id,p_file_index,p_generation);
+ select * into v_prior from artifact_upload_transfers where id=p_transfer_id;
+ if found and (v_prior.upload_id<>p_upload_id or v_prior.file_index<>p_file_index or v_prior.generation<>p_generation) then raise exception 'UPLOAD_GRANT_INVALID';end if;
+ if v_file.verified_at is not null then
+  return query select v_file.object_version_id,v_file.workspace_id,v_file.artifact_id,v_file.byte_size,v_file.sha256,v_file.media_type,true,null::timestamptz;return;
