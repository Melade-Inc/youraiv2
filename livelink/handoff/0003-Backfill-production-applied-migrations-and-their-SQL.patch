+
+-- The exceptional update is limited to an exact blank payload, unchanged
+-- identity and the canonical redaction timestamp. It cannot edit a receipt,
+-- hash, quota reservation, idempotency key, removal cycle or publication.
+create function public.live_content_redaction_allowed(p_table text,p_old jsonb,p_new jsonb)
+returns boolean language plpgsql stable security definer set search_path=public,pg_temp as $$
+declare artifact uuid;workspace uuid;c project_content_purges;fields text[];v_kind text;source uuid;expected jsonb;
+begin
+ if p_old->>'content_purged_at'is not null or p_new->>'content_purged_at'is null then return false;end if;
+ if p_table='core_revision_objects'then select artifact_id,workspace_id into artifact,workspace from core_revision_saves where task_id=(p_old->>'task_id')::uuid;
+ else artifact:=case when p_table='artifacts'then(p_old->>'id')::uuid else(p_old->>'artifact_id')::uuid end;workspace:=(p_old->>'workspace_id')::uuid;end if;
+ select * into c from project_content_purges where artifact_id=artifact and workspace_id=workspace and phase='redacting';
+ if not found or(p_new->>'content_purged_at')::timestamptz is distinct from c.redaction_started_at then return false;end if;
+ case p_table
+ when 'artifact_versions'then fields:=array['manifest'];expected:='{"manifest":{}}';v_kind:='version';source:=(p_old->>'id')::uuid;
+ when 'artifact_uploads'then fields:=array['manifest','request_manifest'];expected:='{"manifest":{},"request_manifest":{}}';v_kind:='upload';source:=(p_old->>'id')::uuid;
+ when 'artifact_upload_files'then fields:=array['path'];expected:=jsonb_build_object('path','[purged]:'||(p_old->>'file_index'));v_kind:='upload';source:=(p_old->>'upload_id')::uuid;
+ when 'core_revision_saves'then fields:=array['manifest'];expected:='{"manifest":{}}';v_kind:='revision';source:=(p_old->>'task_id')::uuid;
+ when 'core_revision_objects'then fields:=array['path'];expected:=jsonb_build_object('path','[purged]:'||encode(sha256(convert_to(p_old->>'path','UTF8')),'hex'));v_kind:='revision';source:=(p_old->>'task_id')::uuid;
+ when 'operation_model_tasks'then fields:=array['messages','output','output_error','discarded'];expected:='{"messages":[],"output":null,"output_error":null,"discarded":true}';
+ when 'operations'then fields:=array['prompt','generated_manifest','error'];expected:='{"prompt":"[removed]","generated_manifest":null,"error":null}';
+ when 'runtime_records'then fields:=array['data'];expected:='{"data":{}}';
+ when 'publications'then fields:=array['recipients'];expected:='{"recipients":[]}';
+ when 'artifacts'then fields:=array['title','creation_payload'];expected:='{"title":"Removed project","creation_payload":null}';
