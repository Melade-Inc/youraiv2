+begin;
+do $$
+declare actor uuid:=gen_random_uuid();other_actor uuid:=gen_random_uuid();login uuid:=gen_random_uuid();new_login uuid:=gen_random_uuid();other_login uuid:=gen_random_uuid();writer uuid:=gen_random_uuid();reader uuid:=gen_random_uuid();workspace uuid;other_workspace uuid;artifact uuid;other_artifact uuid;upload uuid;t uuid:=gen_random_uuid();status jsonb;prepared jsonb;manifest jsonb;version uuid;last_version uuid;over_limit uuid;
+begin
+ insert into auth.users(id,email,email_confirmed_at) values(actor,'upload-management@example.test',now()),(other_actor,'upload-other@example.test',now());
+ insert into auth.sessions(id,user_id) values(login,actor),(new_login,actor),(other_login,other_actor);
+ workspace:=live_ensure_workspace(actor);other_workspace:=live_ensure_workspace(other_actor);
+ artifact:=live_create_artifact(actor,workspace,'Management test','app','test');other_artifact:=live_create_artifact(actor,workspace,'Separate project','app','test');
+ insert into agent_credentials(id,workspace_id,name,token_hash,scopes) values(writer,workspace,'Writer','management-writer',array['artifact:write']),(reader,workspace,'Reader','management-reader',array['artifact:read']);
+ manifest:='{"schemaVersion":2,"kind":"app","title":"Management test","entrypoint":"index.html","blocks":[],"files":[{"path":"index.html","mediaType":"text/html","size":100,"sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}';
+ upload:=live_begin_upload(actor,workspace,artifact,manifest,null,'management-test',login,null,'test');
+ status:=live_get_upload_status(upload,artifact,actor,workspace,login,null);
+ assert status->>'id'=upload::text and status->>'fileCount'='1' and status->>'verifiedCount'='0';
+ assert status->>'requiresReauthorization'='false' and status->>'expired'='false';
+ assert status->'manifest'=manifest;
+ assert not status ?| array['auth_session_id','authSessionId','agentCredentialId','workspaceId','secret','authorization'];
+ assert status->'files'->0->>'attempts'='0' and status->'files'->0->>'maxAttempts'='5' and status->'files'->0->'activeUntil'='null'::jsonb;
+ assert (live_list_uploads(artifact,actor,workspace,login,null)->0->>'id')=upload::text;
+ assert not (live_list_uploads(artifact,actor,workspace,login,null)->0) ? 'manifest';
+ begin perform live_get_upload_status(upload,other_artifact,actor,workspace,login,null);raise exception 'wrong artifact status returned';exception when raise_exception then if sqlerrm<>'NOT_FOUND' then raise;end if;end;
+ begin perform live_get_upload_status(upload,artifact,other_actor,other_workspace,other_login,null);raise exception 'cross-workspace status returned';exception when raise_exception then if sqlerrm<>'NOT_FOUND' then raise;end if;end;
+ begin perform live_get_upload_status(upload,artifact,actor,workspace,null,reader);raise exception 'read-only token saw pending upload';exception when raise_exception then if sqlerrm<>'AUTH_REVOKED' then raise;end if;end;
+ assert (live_get_upload_status(upload,artifact,actor,workspace,null,writer)->>'requiresReauthorization')='true';
+ prepared:=live_prepare_upload_file(upload,artifact,actor,workspace,login,null,0);
+ assert prepared->>'generation'='1' and prepared->'file'->>'path'='index.html';
+ begin perform live_prepare_upload_file(upload,artifact,actor,workspace,login,null,1);raise exception 'unknown file prepared';exception when raise_exception then if sqlerrm<>'NOT_FOUND' then raise;end if;end;
+ perform live_admit_upload_transfer(upload,0,1,t);
+ status:=live_get_upload_status(upload,artifact,actor,workspace,login,null);
+ assert status->'files'->0->>'attempts'='1' and status->'files'->0->>'activeUntil' is not null;
+ perform live_revoke_auth_session(actor,login);
+ begin perform live_list_uploads(artifact,actor,workspace,login,null);raise exception 'ended session listed uploads';exception when raise_exception then if sqlerrm<>'AUTH_REVOKED' then raise;end if;end;
+ begin perform live_get_upload_status(upload,artifact,actor,workspace,login,null);raise exception 'ended session saw upload';exception when raise_exception then if sqlerrm<>'AUTH_REVOKED' then raise;end if;end;
+ status:=live_get_upload_status(upload,artifact,actor,workspace,new_login,null);assert status->>'requiresReauthorization'='true';
+ assert live_find_upload_retry(actor,workspace,artifact,manifest,null,'management-test',new_login,null)=upload;
+ assert live_begin_upload(actor,workspace,artifact,manifest,null,'management-test',new_login,null,'test')=upload;
+ assert (select generation from artifact_uploads where id=upload)=1;
+ begin perform live_prepare_upload_file(upload,artifact,actor,workspace,new_login,null,0);raise exception 'new login implicitly adopted upload';exception when raise_exception then if sqlerrm<>'UPLOAD_REBIND_REQUIRED' then raise;end if;end;
+ perform live_rebind_upload(upload,actor,workspace,new_login,null,'test');
+ prepared:=live_prepare_upload_file(upload,artifact,actor,workspace,new_login,null,0);assert prepared->>'generation'='2';
+ begin perform live_reconcile_upload_file(upload,0,1,repeat('a',64),100,'test');raise exception 'old generation reconciled';exception when raise_exception then if sqlerrm<>'UPLOAD_GRANT_STALE' then raise;end if;end;
+ begin perform live_reconcile_upload_file(upload,0,2,repeat('b',64),100,'test');raise exception 'wrong hash reconciled';exception when raise_exception then if sqlerrm<>'UPLOAD_INTEGRITY_FAILED' then raise;end if;end;
+ -- Trusted HEAD may find complete bytes even while a lost transfer is unresolved.
+ perform live_reconcile_upload_file(upload,0,2,repeat('a',64),100,'test');
+ perform live_reconcile_upload_file(upload,0,2,repeat('a',64),100,'test');
+ assert (select count(*)from audit_events where target_id=upload and action='upload.file.reconciled')=1;
+ status:=live_get_upload_status(upload,artifact,actor,workspace,new_login,null);assert status->>'verifiedCount'='1';
+ version:=live_finalize_upload(upload,actor,workspace,new_login,null,'test');
+ assert live_list_uploads(artifact,actor,workspace,new_login,null)='[]';
+ status:=live_get_upload_status(upload,artifact,actor,workspace,null,writer);
+ assert status->>'status'='finalized' and status->>'versionId'=version::text and status->>'requiresReauthorization'='false';
+ assert live_find_upload_retry(actor,workspace,artifact,manifest,null,'management-test',null,writer)=upload;
+ assert not exists(select 1 from publications where artifact_id=artifact);
+ for n in 2..100 loop
+  insert into artifact_versions(workspace_id,artifact_id,number,manifest,content_hash,idempotency_key)
+  select v.workspace_id,v.artifact_id,n,v.manifest,v.content_hash,'history-limit-'||n from artifact_versions v where v.id=version returning id into last_version;
+ end loop;
+ update artifacts set latest_version_id=last_version where id=artifact;
+ over_limit:=live_begin_upload(actor,workspace,artifact,manifest,last_version,'management-history-limit',new_login,null,'test');
+ begin perform live_finalize_upload(over_limit,actor,workspace,new_login,null,'test');raise exception 'history limit bypassed';exception when raise_exception then if sqlerrm<>'VERSION_LIMIT' then raise;end if;end;
+ assert (select latest_version_id from artifacts where id=artifact)=last_version;
+ assert live_finalize_upload(upload,actor,workspace,new_login,null,'test')=version;
+ update agent_credentials set revoked_at=clock_timestamp() where id=writer;
+ begin perform live_get_upload_status(upload,artifact,actor,workspace,null,writer);raise exception 'revoked agent saw completed upload';exception when raise_exception then if sqlerrm<>'AUTH_REVOKED' then raise;end if;end;
+ assert not has_function_privilege('authenticated','live_get_upload_status(uuid,uuid,uuid,uuid,uuid,uuid)','execute');
+ assert not has_function_privilege('anon','live_upload_summary(uuid,uuid,uuid)','execute');
+ assert not has_function_privilege('authenticated','live_prepare_upload_file(uuid,uuid,uuid,uuid,uuid,uuid,integer)','execute');
+ assert not has_function_privilege('authenticated','live_reconcile_upload_file(uuid,integer,integer,text,bigint,text)','execute');
+ assert not has_column_privilege('authenticated','public.workspaces','plan_code','UPDATE');
+ assert not has_column_privilege('authenticated','public.workspaces','upload_reserved_bytes','UPDATE');
+ assert not has_column_privilege('anon','public.workspaces','plan_code','UPDATE');
+ assert not has_function_privilege('authenticated','live_find_upload_retry(uuid,uuid,uuid,jsonb,uuid,text,uuid,uuid)','execute');
+end $$;
+rollback;
+select 'Upload management: ownership, metadata boundaries, revocation, explicit resume and verified reconciliation passed' as result;
diff --git a/tests/sql/upload-transfers.sql b/tests/sql/upload-transfers.sql
