+create function public.live_authorize_project_storage_retirement(p_removal_id uuid,p_environment text,p_claim_id uuid,p_object_id uuid,p_invocation_id uuid,p_request_hash text)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare o project_storage_purge_objects;f jsonb;reservation uuid;
+begin
+ if p_invocation_id is null or p_request_hash is null or p_request_hash!~'^[a-f0-9]{64}$'then raise exception 'PROJECT_CLEANUP_DENIED';end if;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ o:=live_lock_project_storage_object(p_removal_id,p_environment,p_claim_id,p_object_id);
+ if o.retired_at is not null or exists(select 1 from project_storage_purge_dispatches where invocation_id=p_invocation_id)
+  or (select count(*)from project_storage_purge_dispatches where claim_id=p_claim_id)>=20 then raise exception 'PROJECT_CLEANUP_DENIED';end if;
+ perform live_begin_cloudflare_hosting();
+ f:=live_reserve_runtime(o.workspace_id,o.artifact_id,null,'project-cleanup:'||p_invocation_id,p_request_hash,'platform','r2-cleanup',null,'cloudflare-standard-2026-09-05-v1',6520);
+ if f->>'status' is distinct from 'reserved'then raise exception 'RUNTIME_DISPATCH_DENIED';end if;
+ reservation:=(f->>'id')::uuid;
+ if not live_dispatch_runtime(reservation,o.workspace_id,p_request_hash)then raise exception 'RUNTIME_DISPATCH_DENIED';end if;
