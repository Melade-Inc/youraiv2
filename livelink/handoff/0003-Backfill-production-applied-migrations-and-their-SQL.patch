+  and not exists(select 1 from operation_grants where artifact_id=a.id and revoked_at is null)
+  and not exists(select 1 from operations where artifact_id=a.id and status in ('queued','running','paused'))
+  and not exists(select 1 from artifact_uploads where artifact_id=a.id and status='uploading')
+  and (c0.removal_id is not null or exists(select 1 from cloudflare_storage_objects s where s.environment=p_environment and s.workspace_id=a.workspace_id and s.artifact_id=a.id and s.retired_at is null))
+  and not exists(select 1 from artifact_upload_transfers t join artifact_uploads u on u.id=t.upload_id where u.artifact_id=a.id and t.status='admitted'and t.expires_at>clock_timestamp())
