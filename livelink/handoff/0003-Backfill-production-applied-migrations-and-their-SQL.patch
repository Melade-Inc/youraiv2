+ insert into audit_events(workspace_id,actor_id,action,target_id,trace_id,metadata)values(a.workspace_id,p_actor_id,'artifact.recovered',a.id,p_trace_id,jsonb_build_object('removalId',r.id,'accessEpoch',r.access_epoch,'published',false));
+ return live_removal_summary(r.id);
+end $$;
+create function public.live_list_removed_projects(p_actor_id uuid,p_workspace_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid,p_before_time timestamptz default null,p_before_id uuid default null,p_limit integer default 50)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare items jsonb;v_more boolean;v_last uuid;v_time timestamptz;
+begin
+ if (p_before_time is null)<>(p_before_id is null)or p_limit is null or p_limit not between 1 and 100 then raise exception 'REMOVAL_INVALID';end if;
+ if not live_project_proof_active(p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id,'artifact:read')then raise exception 'AUTH_REVOKED';end if;
+ with selected as materialized(
+  select r.id,r.removed_at from artifact_removals r join artifacts a on a.id=r.artifact_id and a.workspace_id=r.workspace_id
