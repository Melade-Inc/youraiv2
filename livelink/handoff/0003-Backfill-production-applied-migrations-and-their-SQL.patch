+  reader_status=0;wait "$reader_pid" || reader_status=$?;removal_status=0;wait "$removal_pid" || removal_status=$?
+  if [ "$removal_status" -ne 0 ]; then cat "$db_dir/reader-remove.log";exit 1;fi
+  if [ "$reader_status" -ne 0 ] && ! rg -q NOT_FOUND "$db_dir/reader-race.log";then cat "$db_dir/reader-race.log";exit 1;fi
+  "${pg_cmd[@]}" -c "do \$\$ declare f test_project_recovery_race;begin select * into f from test_project_recovery_race;assert (select deleted_at is not null and access_epoch=f.reader_epoch+1 from artifacts where id=f.artifact);assert (select revoked_at is not null from publications where artifact_id=f.artifact);assert (select count(*)from live_consume_ticket(md5('mint'||f.reader_epoch)||md5('mint'||f.reader_epoch)))=0;assert (select count(*)from live_consume_ticket(md5('consume'||f.reader_epoch)||md5('consume'||f.reader_epoch)))=0;end \$\$;" >/dev/null
+  echo "Concurrent project removal and reader $reader_operation: no deadlock or surviving access."
+done
+
+# Cross-layer service adapter/SQL/Worker proof hashes must agree. Keep this
+# fixture in a separate database so it cannot change earlier race balances.
+"$pg_bin/createdb" -h 127.0.0.1 -p "$port" live_link_storage_audit_test
+sed '/^create role /d' "$repo_root/supabase/tests/bootstrap.sql" | "$pg_bin/psql" -X -h 127.0.0.1 -p "$port" -d live_link_storage_audit_test -v ON_ERROR_STOP=1 >/dev/null
+for migration in "$repo_root"/supabase/migrations/*.sql; do
+  "$pg_bin/psql" -X -h 127.0.0.1 -p "$port" -d live_link_storage_audit_test -v ON_ERROR_STOP=1 -f "$migration" >/dev/null
+done
+"$pg_bin/createdb" -h 127.0.0.1 -p "$port" live_link_project_purge_test
+sed '/^create role /d' "$repo_root/supabase/tests/bootstrap.sql" | "$pg_bin/psql" -X -h 127.0.0.1 -p "$port" -d live_link_project_purge_test -v ON_ERROR_STOP=1 >/dev/null
+for migration in "$repo_root"/supabase/migrations/*.sql; do
+  "$pg_bin/psql" -X -h 127.0.0.1 -p "$port" -d live_link_project_purge_test -v ON_ERROR_STOP=1 -f "$migration" >/dev/null
+done
+pg_cmd=("$pg_bin/psql" -X -h 127.0.0.1 -p "$port" -d live_link_project_purge_test -v ON_ERROR_STOP=1)
+"${pg_cmd[@]}" -f "$repo_root/supabase/tests/project-purge-race-setup.sql" >/dev/null
+for purge_action in claim dispatch finish; do
+  "${pg_cmd[@]}" -f "$repo_root/supabase/tests/concurrent-project-purge-$purge_action.sql" >"$db_dir/purge-one.log" 2>&1 & purge_one=$!
+  "${pg_cmd[@]}" -f "$repo_root/supabase/tests/concurrent-project-purge-$purge_action.sql" >"$db_dir/purge-two.log" 2>&1 & purge_two=$!
+  purge_one_status=0; wait "$purge_one" || purge_one_status=$?
+  purge_two_status=0; wait "$purge_two" || purge_two_status=$?
+  if [ "$purge_action" = dispatch ]; then
+    if [ "$purge_one_status" -eq 0 ] && [ "$purge_two_status" -ne 0 ]; then purge_failed="$db_dir/purge-two.log";
+    elif [ "$purge_two_status" -eq 0 ] && [ "$purge_one_status" -ne 0 ]; then purge_failed="$db_dir/purge-one.log";
+    else cat "$db_dir/purge-one.log" "$db_dir/purge-two.log"; exit 1; fi
+    if ! rg -q PROJECT_CLEANUP_DENIED "$purge_failed"; then cat "$purge_failed"; exit 1; fi
+  elif [ "$purge_action" = finish ]; then
+    # Either receipt confirmation can serialize after the first closure. A
+    # stale lease is then correctly denied; there is still exactly one result.
+    if [ "$purge_one_status" -ne 0 ] && ! rg -q PROJECT_CLEANUP_DENIED "$db_dir/purge-one.log"; then cat "$db_dir/purge-one.log"; exit 1; fi
+    if [ "$purge_two_status" -ne 0 ] && ! rg -q PROJECT_CLEANUP_DENIED "$db_dir/purge-two.log"; then cat "$db_dir/purge-two.log"; exit 1; fi
+    if [ "$purge_one_status" -ne 0 ] && [ "$purge_two_status" -ne 0 ]; then cat "$db_dir/purge-one.log" "$db_dir/purge-two.log"; exit 1; fi
+  elif [ "$purge_one_status" -ne 0 ] || [ "$purge_two_status" -ne 0 ]; then cat "$db_dir/purge-one.log" "$db_dir/purge-two.log"; exit 1; fi
+  if [ "$purge_action" = claim ]; then
+    "${pg_cmd[@]}" -c "do \$\$begin assert(select count(*)from test_project_purge_claims where batch is not null)=1;end\$\$;update test_project_purge_race set claim=(batch->>'claimId')::uuid,object_id=(batch->'objects'->0->>'objectId')::uuid from test_project_purge_claims where batch is not null;" >/dev/null
+  elif [ "$purge_action" = dispatch ]; then
+    "${pg_cmd[@]}" -c "update test_project_purge_race set admission=a.admission from test_project_purge_admissions a;" >/dev/null
+    "${pg_cmd[@]}" -c "update test_project_purge_race set receipt=jsonb_build_object('retired',true,'removalId',removal,'environment','preview','claimId',claim,'objectId',object_id,'invocationId',invocation,'reference',admission->'reference','reservationId',admission->'funding'->'reservationId','requestHash',repeat('e',64));" >/dev/null
+  else
+    "${pg_cmd[@]}" -c "do \$\$declare f test_project_purge_race;begin select * into f from test_project_purge_race;assert(select count(*)from project_storage_purge_dispatches where object_id=f.object_id)=1;assert(select confirmed_at is not null from project_storage_purge_dispatches where invocation_id=f.invocation);assert(select count(*)from audit_events where target_id=f.removal and action='project.known_storage_retired')=1;assert(select status='dispatched'and maximum_cost_nanos=6520 and actual_cost_nanos is null from runtime_reservations where id=(f.admission->'funding'->>'reservationId')::uuid);end\$\$;" >/dev/null
+  fi
+done
+echo "Concurrent expired-project cleanup: one global claim, one paid dispatch, one retirement closure and no supplier refund."
+"${pg_cmd[@]}" -f "$repo_root/supabase/tests/content-purge-race-setup.sql" >/dev/null
+"${pg_cmd[@]}" -f "$repo_root/supabase/tests/concurrent-content-purge.sql" >"$db_dir/content-one.log" 2>&1 & content_one=$!
+"${pg_cmd[@]}" -f "$repo_root/supabase/tests/concurrent-content-purge.sql" >"$db_dir/content-two.log" 2>&1 & content_two=$!
+"${pg_cmd[@]}" -f "$repo_root/supabase/tests/concurrent-content-upload-cleanup.sql" >"$db_dir/content-upload.log" 2>&1 & content_upload=$!
+content_failed=0
+wait "$content_one" || content_failed=1
+wait "$content_two" || content_failed=1
+wait "$content_upload" || content_failed=1
+if [ "$content_failed" -ne 0 ]; then cat "$db_dir/content-one.log" "$db_dir/content-two.log" "$db_dir/content-upload.log"; exit 1; fi
+"${pg_cmd[@]}" -f "$repo_root/supabase/tests/content-purge-race-assert.sql" >/dev/null
+echo "Concurrent content cleanup and upload cleanup: one closure, exact quota release and preserved other-project accounting."
+echo "Physical audit integration: service-only PostgreSQL admission, native Worker/R2 metadata, exact proof hashes and retained holds verified."
+echo "Expired-project storage integration: bounded claims, native retirement, lost-reply recovery, environment isolation, retained quota and unsettled funding verified."
 # Publication revision is checked only after a conflicting canonical revoke commits.
