+ perform live_assert_owner(p_actor_id,p_workspace_id);
+ perform 1 from workspaces where id=p_workspace_id for update;
+ select * into a from artifacts where id=p_artifact_id and workspace_id=p_workspace_id for update;if not found then raise exception 'NOT_FOUND';end if;
+ if p_key is null or length(p_key)not between 8 and 100 or p_expected_epoch is null or p_expected_epoch<0 then raise exception 'REMOVAL_INVALID';end if;
+ select * into r from artifact_removals where workspace_id=p_workspace_id and idempotency_key=p_key;
+ if found then
+  if r.artifact_id<>a.id or r.access_epoch<>p_expected_epoch+1 then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+  if r.restored_at is not null or a.access_epoch<>r.access_epoch then raise exception 'PROJECT_CHANGED';end if;
+  return live_removal_summary(r.id);
+ end if;
+ if a.access_epoch<>p_expected_epoch or a.deleted_at is not null then raise exception 'PROJECT_CHANGED';end if;
+ v_time:=clock_timestamp();
+ insert into artifact_removals(workspace_id,artifact_id,access_epoch,removed_at,recoverable_until,removed_by,idempotency_key,source)
+  values(a.workspace_id,a.id,a.access_epoch+1,v_time,v_time+interval '720 hours',p_actor_id,p_key,p_source)returning * into r;
+ update artifacts set deleted_at=v_time,access_epoch=r.access_epoch,updated_at=v_time where id=a.id;
+ update publications set revoked_at=coalesce(revoked_at,v_time),updated_at=v_time where artifact_id=a.id;
+ update operation_grants set revoked_at=v_time where artifact_id=a.id and workspace_id=a.workspace_id and revoked_at is null;
+ update operations set status='cancelled',pause_reason=null,error=null,updated_at=v_time where artifact_id=a.id and workspace_id=a.workspace_id and status in ('queued','running','paused');
