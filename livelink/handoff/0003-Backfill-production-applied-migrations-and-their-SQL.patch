+ perform live_cancel_upload(other_upload,actor,workspace,login,null,'test');assert live_claim_upload_cleanup(next_claim,other_upload) is null;
+ begin perform live_authorize_upload_cleanup(upload,next_claim,1);raise exception 'wrong cleanup claim accepted';exception when raise_exception then if sqlerrm<>'CLEANUP_DENIED' then raise;end if;end;
+ begin perform live_authorize_upload_cleanup(upload,null,1);raise exception 'null cleanup claim accepted';exception when raise_exception then if sqlerrm<>'CLEANUP_DENIED' then raise;end if;end;
+ begin perform live_authorize_upload_cleanup(upload,claim,0);raise exception 'saved reused file retired';exception when raise_exception then if sqlerrm<>'CLEANUP_DENIED' then raise;end if;end;
+ begin perform live_authorize_upload_cleanup(other_upload,claim,0);raise exception 'other upload accepted claim';exception when raise_exception then if sqlerrm<>'CLEANUP_DENIED' then raise;end if;end;
+ begin perform live_confirm_upload_retirement(upload,claim,1,repeat('d',64));raise exception 'wrong retirement checksum';exception when raise_exception then if sqlerrm<>'CLEANUP_DENIED' then raise;end if;end;
+ perform live_confirm_upload_retirement(upload,claim,1,repeat('b',64));perform live_confirm_upload_retirement(upload,claim,1,repeat('b',64));
+ assert (select count(*)from artifact_upload_retirements where upload_id=upload)=2;
+ result:=live_finish_upload_cleanup(upload,claim,true);assert result='{"completed":false,"releasedBytes":0}'::jsonb;
+ assert (select upload_reserved_bytes from workspaces where id=workspace)=before_reserved;
+ assert (select next_attempt_at>clock_timestamp() and failures=1 from artifact_upload_cleanup where upload_id=upload);
+ assert live_claim_upload_cleanup(next_claim,upload) is null;
+ -- Advance the retry fixture clock without bypassing upload immutability.
+ update artifact_upload_cleanup set next_attempt_at=clock_timestamp()-interval '1 second' where upload_id=upload;
+ batch:=live_claim_upload_cleanup(next_claim,upload);assert jsonb_array_length(batch->'files')=1 and batch->'files'->0->>'fileIndex'='3';
+ begin perform live_authorize_upload_cleanup(upload,claim,3);raise exception 'stale claim accepted';exception when raise_exception then if sqlerrm<>'CLEANUP_DENIED' then raise;end if;end;
+ update artifact_upload_cleanup set lease_until=clock_timestamp()-interval '1 second' where upload_id=upload;
+ begin perform live_authorize_upload_cleanup(upload,next_claim,3);raise exception 'expired claim accepted';exception when raise_exception then if sqlerrm<>'CLEANUP_DENIED' then raise;end if;end;
+ claim:=gen_random_uuid();batch:=live_claim_upload_cleanup(claim,upload);assert batch is not null;
+ perform live_confirm_upload_retirement(upload,claim,3,repeat('c',64));result:=live_finish_upload_cleanup(upload,claim);
+ assert result->>'completed'='true' and (result->>'releasedBytes')::bigint=original_reserved;
+ assert (select upload_reserved_bytes from workspaces where id=workspace)=before_reserved-original_reserved;
+ assert (select storage_bytes from workspaces where id=workspace)=before_stored;
+ assert live_finish_upload_cleanup(upload,gen_random_uuid())=result;
+ assert (select count(*)from audit_events where target_id=upload and action='upload.cleaned')=1;
+ assert (live_upload_summary(upload,login,null)->>'reservedBytes')='0';assert (select reserved_bytes from artifact_uploads where id=upload)=original_reserved;
+ assert (select latest_version_id from artifacts where id=artifact)=version;assert (select version_id from publications where artifact_id=artifact)=version;
+ assert live_claim_upload_cleanup(gen_random_uuid(),upload) is null;
+ begin update artifact_upload_cleanup set released_bytes=0 where upload_id=upload;raise exception 'completed accounting changed';exception when raise_exception then if sqlerrm<>'IMMUTABLE_CLEANUP' then raise;end if;end;
+ begin delete from artifact_upload_retirements where upload_id=upload;raise exception 'retirement removed';exception when raise_exception then if sqlerrm<>'IMMUTABLE_CLEANUP' then raise;end if;end;
+ begin update artifact_uploads set status='uploading' where id=upload;raise exception 'cancelled upload resurrected';exception when raise_exception then if sqlerrm<>'IMMUTABLE_UPLOAD' then raise;end if;end;
+ claim:=gen_random_uuid();batch:=live_claim_upload_cleanup(claim,other_upload);assert batch is not null;
+ perform live_confirm_upload_retirement(other_upload,claim,0,repeat('a',64));perform live_finish_upload_cleanup(other_upload,claim);
+ -- Expiry is seeded before immutable upload lifetime; it contains no object bytes.
+ expired:=gen_random_uuid();insert into artifact_uploads(id,workspace_id,artifact_id,actor_id,auth_session_id,idempotency_key,request_manifest,manifest,reserved_bytes,expires_at)
+ values(expired,workspace,artifact,actor,login,'cleanup-expired',manifest,manifest,0,clock_timestamp()-interval '1 second');
+ claim:=gen_random_uuid();batch:=live_claim_upload_cleanup(claim,expired);assert batch is not null and batch->'files'='[]';
+ assert (select status from artifact_uploads where id=expired)='cancelled';assert live_finish_upload_cleanup(expired,claim)->>'completed'='true';
+ -- Completed cleanup history does not permanently consume the pending-session limit.
+ old_pending:=live_begin_upload(actor,workspace,artifact,manifest,version,'cleanup-old-pending',login,null,'test');
+ for n in 1..51 loop
+  upload:=live_begin_upload(actor,workspace,artifact,manifest,version,'cleanup-capacity-'||n,login,null,'test');perform live_cancel_upload(upload,actor,workspace,login,null,'test');
+  claim:=gen_random_uuid();batch:=live_claim_upload_cleanup(claim,upload);assert batch->'files'='[]';assert live_finish_upload_cleanup(upload,claim)->>'completed'='true';
+ end loop;
+ result:=live_list_uploads(artifact,actor,workspace,login,null);assert jsonb_array_length(result)=1 and result->0->>'id'=old_pending::text;
+ -- Removed projects retain unfinished bytes during recovery, even after logout.
+ deleted:=live_begin_upload(actor,workspace,other_artifact,manifest,null,'cleanup-deleted',login,null,'test');perform live_revoke(actor,workspace,other_artifact,true,'test');perform live_revoke_auth_session(actor,login);
+ claim:=gen_random_uuid();batch:=live_claim_upload_cleanup(claim,deleted);assert batch is null;
+ assert not exists(select 1 from artifact_upload_cleanup where upload_id=deleted);
+ assert not has_function_privilege('anon','live_claim_upload_cleanup(uuid,uuid)','execute');
+ assert not has_function_privilege('authenticated','live_authorize_upload_cleanup(uuid,uuid,integer)','execute');
+ assert not has_function_privilege('authenticated','live_confirm_upload_retirement(uuid,uuid,integer,text)','execute');
+ assert not has_table_privilege('authenticated','artifact_upload_cleanup','select');
+ assert not has_table_privilege('anon','artifact_upload_retirements','insert');
+end $$;
+rollback;
