+ begin perform live_confirm_upload_file(upload,0,1,repeat('b',64),4096000);raise exception 'bad checksum accepted';exception when raise_exception then if sqlerrm<>'UPLOAD_INTEGRITY_FAILED' then raise;end if;end;
