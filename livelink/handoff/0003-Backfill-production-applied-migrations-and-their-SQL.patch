+create function public.live_removal_history_guard()returns trigger language plpgsql set search_path=public,pg_temp as $$
+begin
+ if tg_op='DELETE' then raise exception 'REMOVAL_HISTORY_IMMUTABLE';end if;
+ if old.restored_at is not null or new.restored_at is null or (to_jsonb(new)-array['restored_at','restored_by','recovery_key']) is distinct from (to_jsonb(old)-array['restored_at','restored_by','recovery_key']) then raise exception 'REMOVAL_HISTORY_IMMUTABLE';end if;
+ return new;
+end $$;
+create trigger artifact_removal_history before update or delete on public.artifact_removals for each row execute function public.live_removal_history_guard();
+create function public.live_artifact_epoch_guard()returns trigger language plpgsql set search_path=public,pg_temp as $$
+begin
+ if new.access_epoch<old.access_epoch or new.access_epoch>old.access_epoch+1 or new.access_epoch<>old.access_epoch and (old.deleted_at is not null or new.deleted_at is null) then raise exception 'PROJECT_EPOCH_INVALID';end if;
