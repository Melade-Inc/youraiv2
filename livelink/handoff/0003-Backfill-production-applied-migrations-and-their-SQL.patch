+-- Owner-scoped metadata snapshots. No signing headers, proof IDs or object URLs.
+create function public.live_upload_summary(p_upload_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid)
+returns jsonb language sql stable set search_path=public,pg_temp as $$
+ select jsonb_build_object(
+  'id',u.id,'artifactId',u.artifact_id,'versionId',u.version_id,'baseVersionId',u.base_version_id,
+  'title',u.request_manifest->>'title','status',u.status,'generation',u.generation,'expiresAt',u.expires_at,'createdAt',u.created_at,'observedAt',clock_timestamp(),
+  'reservedBytes',u.reserved_bytes,'expired',u.expires_at<=clock_timestamp(),
+  'requiresReauthorization',u.status='uploading' and (u.auth_session_id is distinct from p_auth_session_id or u.agent_credential_id is distinct from p_agent_credential_id),
+  'fileCount',(select count(*)from artifact_upload_files f where f.upload_id=u.id),
+  'verifiedCount',(select count(*)from artifact_upload_files f where f.upload_id=u.id and f.verified_at is not null)
+ ) from artifact_uploads u where u.id=p_upload_id
+$$;
+create function public.live_upload_file_status(p_upload_id uuid,p_file_index integer)
+returns jsonb language sql stable set search_path=public,pg_temp as $$
+ select jsonb_build_object('index',f.file_index,'path',f.path,'mediaType',f.media_type,'size',f.byte_size,'sha256',f.sha256,
+  'verified',f.verified_at is not null,'reused',f.object_version_id<>u.version_id,
+  'attempts',(select count(*)from artifact_upload_transfers t where t.upload_id=f.upload_id and t.file_index=f.file_index),'maxAttempts',5,
+  'activeUntil',(select max(t.expires_at)from artifact_upload_transfers t where t.upload_id=f.upload_id and t.file_index=f.file_index and t.status='admitted' and t.expires_at>clock_timestamp())
+ ) from artifact_upload_files f join artifact_uploads u on u.id=f.upload_id where f.upload_id=p_upload_id and f.file_index=p_file_index
+$$;
+create function public.live_get_upload_status(p_upload_id uuid,p_artifact_id uuid,p_actor_id uuid,p_workspace_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare u artifact_uploads;files jsonb;
+begin
+ u:=live_lock_upload(p_upload_id,p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id,true);
+ if u.artifact_id is distinct from p_artifact_id then raise exception 'NOT_FOUND';end if;
+ select coalesce(jsonb_agg(live_upload_file_status(f.upload_id,f.file_index) order by f.file_index),'[]') into files from artifact_upload_files f where f.upload_id=u.id;
+ return live_upload_summary(u.id,p_auth_session_id,p_agent_credential_id)||jsonb_build_object('manifest',u.request_manifest,'files',files);
+end $$;
+create function public.live_list_uploads(p_artifact_id uuid,p_actor_id uuid,p_workspace_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare result jsonb;
+begin
+ perform live_assert_owner(p_actor_id,p_workspace_id);
+ perform 1 from workspaces where id=p_workspace_id for share;
+ perform 1 from artifacts where id=p_artifact_id and workspace_id=p_workspace_id and deleted_at is null for share;
+ if not found then raise exception 'NOT_FOUND';end if;
+ if not live_upload_proof_active(p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id) then raise exception 'AUTH_REVOKED';end if;
+ select coalesce(jsonb_agg(live_upload_summary(u.id,p_auth_session_id,p_agent_credential_id) order by u.created_at desc,u.id desc),'[]') into result
+ from (select id,created_at from artifact_uploads where artifact_id=p_artifact_id and workspace_id=p_workspace_id and actor_id=p_actor_id and status<>'finalized' order by created_at desc,id desc limit 50) u;
+ return result;
+end $$;
+-- Full proof check for a single file; avoids returning a large manifest per grant.
+create function public.live_prepare_upload_file(p_upload_id uuid,p_artifact_id uuid,p_actor_id uuid,p_workspace_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid,p_file_index integer)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare u artifact_uploads;f artifact_upload_files;state jsonb;
+begin
+ u:=live_lock_upload(p_upload_id,p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id);
+ if u.artifact_id is distinct from p_artifact_id then raise exception 'NOT_FOUND';end if;
+ if u.status<>'uploading' then raise exception 'UPLOAD_NOT_ACTIVE';end if;
+ if u.expires_at<=clock_timestamp() then raise exception 'UPLOAD_EXPIRED';end if;
+ select * into f from artifact_upload_files where upload_id=u.id and file_index=p_file_index;
+ if not found then raise exception 'NOT_FOUND';end if;
+ state:=live_upload_file_status(u.id,f.file_index);
+ return jsonb_build_object('generation',u.generation,'file',state,'objectVersionId',f.object_version_id);
+end $$;
+create function public.live_reconcile_upload_file(p_upload_id uuid,p_file_index integer,p_generation integer,p_sha256 text,p_byte_size bigint,p_trace_id text)
+returns void language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare f artifact_upload_files;
+begin
+ select * into f from live_authorize_upload_file(p_upload_id,p_file_index,p_generation);
+ -- The caller has checked private HEAD, including the validated media type.
+ perform live_confirm_upload_file(p_upload_id,p_file_index,p_generation,p_sha256,p_byte_size);
+ if f.verified_at is null then
+  insert into audit_events(workspace_id,action,target_id,trace_id,metadata) values(f.workspace_id,'upload.file.reconciled',p_upload_id,p_trace_id,jsonb_build_object('fileIndex',p_file_index));
+ end if;
+end $$;
+revoke all on function public.live_upload_summary(uuid,uuid,uuid),public.live_upload_file_status(uuid,integer),public.live_get_upload_status(uuid,uuid,uuid,uuid,uuid,uuid),public.live_list_uploads(uuid,uuid,uuid,uuid,uuid),public.live_prepare_upload_file(uuid,uuid,uuid,uuid,uuid,uuid,integer),public.live_reconcile_upload_file(uuid,integer,integer,text,bigint,text) from public,anon,authenticated;
+grant execute on function public.live_upload_summary(uuid,uuid,uuid),public.live_upload_file_status(uuid,integer),public.live_get_upload_status(uuid,uuid,uuid,uuid,uuid,uuid),public.live_list_uploads(uuid,uuid,uuid,uuid,uuid),public.live_prepare_upload_file(uuid,uuid,uuid,uuid,uuid,uuid,integer),public.live_reconcile_upload_file(uuid,integer,integer,text,bigint,text) to service_role;
+
+-- Preserve the existing history limit across both inline and staged saves.
+create or replace function public.live_finalize_upload(p_upload_id uuid,p_actor_id uuid,p_workspace_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid,p_trace_id text)
+returns uuid language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_upload artifact_uploads;v_number integer;v_latest uuid;
+begin
+ v_upload:=live_lock_upload(p_upload_id,p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id);
+ if v_upload.status='finalized' then return v_upload.version_id;end if;
+ if v_upload.status<>'uploading' then raise exception 'UPLOAD_NOT_ACTIVE';end if;
+ if v_upload.expires_at<=clock_timestamp() then raise exception 'UPLOAD_EXPIRED';end if;
+ if exists(select 1 from artifact_upload_files where upload_id=p_upload_id and verified_at is null) then raise exception 'UPLOAD_INCOMPLETE';end if;
+ select latest_version_id into v_latest from artifacts where id=v_upload.artifact_id;
+ if v_latest is distinct from v_upload.base_version_id then raise exception 'VERSION_CONFLICT';end if;
+ select coalesce(max(number),0)+1 into v_number from artifact_versions where artifact_id=v_upload.artifact_id;
+ if v_number>100 then raise exception 'VERSION_LIMIT';end if;
+ insert into artifact_versions(id,workspace_id,artifact_id,number,manifest,content_hash,idempotency_key)
+  values(v_upload.version_id,p_workspace_id,v_upload.artifact_id,v_number,v_upload.manifest,encode(digest(convert_to(v_upload.manifest::text,'UTF8'),'sha256'),'hex'),'upload:'||v_upload.id::text);
+ update workspaces set storage_bytes=storage_bytes+v_upload.reserved_bytes,upload_reserved_bytes=upload_reserved_bytes-v_upload.reserved_bytes where id=p_workspace_id;
+ update artifacts set latest_version_id=v_upload.version_id,updated_at=clock_timestamp() where id=v_upload.artifact_id;
+ update artifact_uploads set status='finalized',finalized_at=clock_timestamp() where id=p_upload_id;
+ insert into audit_events(workspace_id,actor_id,action,target_id,trace_id,metadata) values(p_workspace_id,p_actor_id,'version.created',v_upload.version_id,p_trace_id,jsonb_build_object('artifactId',v_upload.artifact_id,'uploadId',v_upload.id,'number',v_number));
+ return v_upload.version_id;
+end $$;
