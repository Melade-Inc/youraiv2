+ if p_invocation_id is null or p_request_hash is null or p_request_hash!~'^[a-f0-9]{64}$' then raise exception 'RUNTIME_INTENT_INVALID';end if;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ v_ref:=live_authorize_upload_cleanup(p_upload_id,p_claim_id,p_file_index);
+ v_workspace:=(v_ref->>'workspaceId')::uuid;
+ v_funding:=live_reserve_runtime(v_workspace,(v_ref->>'artifactId')::uuid,null,'cleanup:'||p_invocation_id,p_request_hash,'platform','r2-cleanup',null,'cloudflare-standard-2026-09-05-v1',6520);
+ if v_funding->>'status' is distinct from 'reserved' then raise exception 'RUNTIME_DISPATCH_DENIED';end if;
+ v_id:=(v_funding->>'id')::uuid;
+ if not live_dispatch_runtime(v_id,v_workspace,p_request_hash) then raise exception 'RUNTIME_DISPATCH_DENIED';end if;
+ return jsonb_build_object('reference',v_ref,'funding',jsonb_build_object('reservationId',v_id,'requestHash',p_request_hash,'policy','cloudflare-standard-2026-09-05-v1','purpose','r2-cleanup'));
+end $$;
+revoke all on function public.live_admit_funded_upload_transfer(uuid,integer,integer,uuid,text),public.live_authorize_funded_cleanup(uuid,uuid,integer,uuid,text) from public,anon,authenticated;
+grant execute on function public.live_admit_funded_upload_transfer(uuid,integer,integer,uuid,text),public.live_authorize_funded_cleanup(uuid,uuid,integer,uuid,text) to service_role;
