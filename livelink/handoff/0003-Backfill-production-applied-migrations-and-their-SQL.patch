+ if p_publication_id is not null or not exists(select 1 from workspaces where id=p_workspace_id and owner_id=p_user_id) then raise exception 'FORBIDDEN';end if;
+ if not exists(select 1 from artifact_versions where id=p_version_id and artifact_id=p_artifact_id and workspace_id=p_workspace_id) then raise exception 'NOT_FOUND';end if;
+ if p_reader_expires_at is null or p_reader_expires_at<=clock_timestamp() or not live_access_proof_active(p_user_id,p_auth_session_id,p_agent_credential_id,p_workspace_id) then raise exception 'AUTH_REVOKED';end if;
+end $$;
+
+revoke all on function public.live_assert_delivery_access(uuid,uuid,uuid,uuid,uuid,uuid,uuid,timestamptz,boolean,integer) from public,anon,authenticated;
+grant execute on function public.live_assert_delivery_access(uuid,uuid,uuid,uuid,uuid,uuid,uuid,timestamptz,boolean,integer) to service_role;
+
+create or replace function public.live_mint_reader_ticket(p_workspace_id uuid,p_artifact_id uuid,p_version_id uuid,p_publication_id uuid,p_user_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid,p_token_hash text,p_preview boolean)
+returns void language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_epoch integer;
+begin
+ perform 1 from public.workspaces where id=p_workspace_id for share;
+ select access_epoch into v_epoch from public.artifacts where id=p_artifact_id and workspace_id=p_workspace_id and deleted_at is null for share;
+ if not found then raise exception 'NOT_FOUND';end if;
+ if not public.live_access_proof_active(p_user_id,p_auth_session_id,p_agent_credential_id,p_workspace_id)then raise exception 'AUTH_REVOKED';end if;
+ if not exists(select 1 from public.artifact_versions where id=p_version_id and artifact_id=p_artifact_id and workspace_id=p_workspace_id)then raise exception 'NOT_FOUND';end if;
+ if p_preview then
+  if p_publication_id is not null or not exists(select 1 from public.workspaces where id=p_workspace_id and owner_id=p_user_id) then raise exception 'FORBIDDEN';end if;
+ else
+  if p_agent_credential_id is not null or not exists(select 1 from public.publications p join public.workspaces w on w.id=p.workspace_id join auth.users u on u.id=p_user_id where p.id=p_publication_id and p.workspace_id=p_workspace_id and p.artifact_id=p_artifact_id and p.version_id=p_version_id and p.revoked_at is null and (p.expires_at is null or p.expires_at>clock_timestamp()) and (p.audience='public' or w.owner_id=p_user_id or (p.audience='recipients' and lower(u.email)=any(p.recipients)))) then raise exception 'FORBIDDEN';end if;
+ end if;
+ if p_token_hash is null or p_token_hash!~'^[a-f0-9]{64}$' then raise exception 'INVALID_TICKET';end if;
+ insert into public.reader_tickets(workspace_id,artifact_id,version_id,publication_id,user_id,auth_session_id,agent_credential_id,token_hash,preview,expires_at,access_epoch)values(p_workspace_id,p_artifact_id,p_version_id,p_publication_id,p_user_id,p_auth_session_id,p_agent_credential_id,p_token_hash,p_preview,clock_timestamp()+interval '1 minute',v_epoch);
+end $$;
+
+create or replace function public.live_consume_ticket(p_token_hash text)
+returns setof public.reader_tickets language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_ticket public.reader_tickets;
+begin
+ select * into v_ticket from public.reader_tickets where token_hash=p_token_hash;
+ if not found or v_ticket.consumed_at is not null or v_ticket.expires_at<=clock_timestamp() then return;end if;
+ -- Workspace -> artifact -> proof -> ticket agrees with project removal.
+ perform 1 from public.workspaces where id=v_ticket.workspace_id for share;
+ perform 1 from public.artifacts where id=v_ticket.artifact_id and workspace_id=v_ticket.workspace_id and deleted_at is null and access_epoch=v_ticket.access_epoch for share;
+ if not found then return;end if;
+ if not public.live_access_proof_active(v_ticket.user_id,v_ticket.auth_session_id,v_ticket.agent_credential_id,v_ticket.workspace_id) then return;end if;
+ return query update public.reader_tickets set consumed_at=clock_timestamp() where id=v_ticket.id and consumed_at is null and expires_at>clock_timestamp() returning *;
+end $$;
+
+create or replace function public.live_begin_upload(p_actor_id uuid,p_workspace_id uuid,p_artifact_id uuid,p_manifest jsonb,p_base_version_id uuid,p_idempotency_key text,p_auth_session_id uuid,p_agent_credential_id uuid,p_trace_id text)
+returns uuid language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_workspace workspaces;v_artifact artifacts;v_existing artifact_uploads;v_limits record;v_file jsonb;v_ref uuid;
+ v_files jsonb:='[]';v_manifest jsonb;v_id uuid:=gen_random_uuid();v_version uuid:=gen_random_uuid();v_total bigint:=0;v_reserve bigint;v_size bigint;v_path text;v_seen text[]:='{}';
+begin
+ perform live_assert_owner(p_actor_id,p_workspace_id);
+ select * into v_workspace from workspaces where id=p_workspace_id for update;
+ select * into v_artifact from artifacts where id=p_artifact_id and workspace_id=p_workspace_id and deleted_at is null for update;
+ if not found then raise exception 'NOT_FOUND';end if;
+ if not live_upload_proof_active(p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id) then raise exception 'AUTH_REVOKED';end if;
+ if p_idempotency_key is null or length(p_idempotency_key) not between 8 and 100 then raise exception 'INVALID_UPLOAD';end if;
+ select * into v_existing from artifact_uploads where workspace_id=p_workspace_id and artifact_id=p_artifact_id and idempotency_key=p_idempotency_key;
+ if found then
+  if v_existing.access_epoch<>v_artifact.access_epoch then raise exception 'UPLOAD_PROJECT_REMOVED';end if;
+  if v_existing.request_manifest is distinct from p_manifest or v_existing.base_version_id is distinct from p_base_version_id or v_existing.actor_id<>p_actor_id then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+  -- Returning metadata does not reauthorize the saved proof or issue a grant.
+  if v_existing.status='cancelled' then raise exception 'UPLOAD_CANCELLED';end if;
+  if v_existing.status<>'finalized' and v_existing.expires_at<=clock_timestamp() then raise exception 'UPLOAD_EXPIRED';end if;
+  return v_existing.id;
+ end if;
+ if v_artifact.latest_version_id is distinct from p_base_version_id then raise exception 'VERSION_CONFLICT';end if;
+ if p_manifest is null or p_manifest->>'schemaVersion' is distinct from '2' or p_manifest->>'kind' is distinct from v_artifact.kind
+  or jsonb_typeof(p_manifest->'files') is distinct from 'array' or jsonb_typeof(p_manifest->'blocks') is distinct from 'array'
+  or coalesce(length(p_manifest->>'title'),0) not between 1 and 120 or octet_length(p_manifest::text)>1048576 then raise exception 'INVALID_MANIFEST';end if;
+ select * into v_limits from live_storage_limits(v_workspace.plan_code);
+ if jsonb_array_length(p_manifest->'files')>v_limits.file_count then raise exception 'UPLOAD_FILE_LIMIT';end if;
+ for v_file in select value from jsonb_array_elements(p_manifest->'files') loop
+  v_path:=v_file->>'path';
+  if jsonb_typeof(v_file) is distinct from 'object' or jsonb_typeof(v_file->'path') is distinct from 'string'
+   or coalesce(length(v_path),0) not between 1 and 200 or v_path like '/%' or v_path like '%/' or position('//' in v_path)>0
+   or v_path~'(^|/)[.]' or v_path~'[[:cntrl:]?#%:]' or position(chr(92) in v_path)>0 or lower(v_path)='__live' or lower(v_path) like '__live/%'
+   or lower(v_path)=any(v_seen) or jsonb_typeof(v_file->'size') is distinct from 'number' or coalesce(v_file->>'size','')!~'^[0-9]{1,10}$'
+   or coalesce(v_file->>'sha256','')!~'^[a-f0-9]{64}$' or jsonb_typeof(v_file->'mediaType') is distinct from 'string'
+   or coalesce(length(v_file->>'mediaType'),0) not between 1 and 100 or (v_file-array['path','mediaType','size','sha256'])<>'{}'::jsonb then raise exception 'INVALID_UPLOAD_FILE';end if;
+  v_seen:=array_append(v_seen,lower(v_path));v_size:=(v_file->>'size')::bigint;
+  if v_size>v_limits.file_bytes then raise exception 'UPLOAD_FILE_TOO_LARGE';end if;
+  v_total:=v_total+v_size;
+  select f.object_version_id into v_ref from artifact_upload_files f join artifact_uploads u on u.id=f.upload_id
+   where f.workspace_id=p_workspace_id and f.artifact_id=p_artifact_id and f.sha256=v_file->>'sha256' and f.byte_size=v_size
+    and f.media_type=v_file->>'mediaType' and f.verified_at is not null and u.status='finalized' order by u.created_at,f.file_index limit 1;
+  v_files:=v_files||jsonb_build_array(v_file||jsonb_build_object('encoding','r2','content','','storage',jsonb_build_object('versionId',coalesce(v_ref,v_version))));
+ end loop;
+ if v_total>v_limits.version_bytes then raise exception 'VERSION_TOO_LARGE';end if;
+ if v_artifact.kind='document' and jsonb_array_length(p_manifest->'blocks')=0 then raise exception 'INVALID_MANIFEST';end if;
+ if v_artifact.kind<>'document' and not exists(select 1 from jsonb_array_elements(v_files) f where f->>'path'=p_manifest->>'entrypoint' and (v_artifact.kind<>'app' or f->>'mediaType'='text/html')) then raise exception 'INVALID_MANIFEST';end if;
+ v_manifest:=jsonb_set(p_manifest,'{files}',v_files);v_reserve:=v_total+octet_length(v_manifest::text);
+ if v_workspace.storage_bytes+v_workspace.upload_reserved_bytes+v_reserve>v_limits.storage_bytes then raise exception 'STORAGE_LIMIT';end if;
+ insert into artifact_uploads(id,workspace_id,artifact_id,version_id,base_version_id,actor_id,auth_session_id,agent_credential_id,idempotency_key,request_manifest,manifest,reserved_bytes,access_epoch)
+  values(v_id,p_workspace_id,p_artifact_id,v_version,p_base_version_id,p_actor_id,p_auth_session_id,p_agent_credential_id,p_idempotency_key,p_manifest,v_manifest,v_reserve,v_artifact.access_epoch);
+ insert into artifact_upload_files(upload_id,workspace_id,artifact_id,file_index,path,media_type,byte_size,sha256,object_version_id,verified_at)
+  select v_id,p_workspace_id,p_artifact_id,(ordinality-1)::integer,value->>'path',value->>'mediaType',(value->>'size')::bigint,value->>'sha256',(value->'storage'->>'versionId')::uuid,
+   case when (value->'storage'->>'versionId')::uuid<>v_version then clock_timestamp() else null end from jsonb_array_elements(v_files) with ordinality;
+ update workspaces set upload_reserved_bytes=upload_reserved_bytes+v_reserve where id=p_workspace_id;
+ insert into audit_events(workspace_id,actor_id,action,target_id,trace_id,metadata) values(p_workspace_id,p_actor_id,'upload.created',v_id,p_trace_id,jsonb_build_object('artifactId',p_artifact_id,'reservedBytes',v_reserve));
+ return v_id;
+end $$;
+
+create or replace function public.live_lock_upload(p_upload_id uuid,p_actor_id uuid,p_workspace_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid,p_allow_rebind boolean default false)
+returns public.artifact_uploads language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_upload artifact_uploads;
+begin
+ perform live_assert_owner(p_actor_id,p_workspace_id);
+ select * into v_upload from artifact_uploads where id=p_upload_id and workspace_id=p_workspace_id and actor_id=p_actor_id;
+ if not found then raise exception 'NOT_FOUND';end if;
+ perform 1 from workspaces where id=p_workspace_id for update;
+ perform 1 from artifacts where id=v_upload.artifact_id and workspace_id=p_workspace_id and deleted_at is null for update;
+ if not found then raise exception 'NOT_FOUND';end if;
+ if not exists(select 1 from artifacts where id=v_upload.artifact_id and access_epoch=v_upload.access_epoch)then raise exception 'UPLOAD_PROJECT_REMOVED';end if;
+ if not live_upload_proof_active(p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id) then raise exception 'AUTH_REVOKED';end if;
+ select * into v_upload from artifact_uploads where id=p_upload_id for update;
+ if p_allow_rebind is not true and (v_upload.auth_session_id is distinct from p_auth_session_id or v_upload.agent_credential_id is distinct from p_agent_credential_id) then raise exception 'UPLOAD_REBIND_REQUIRED';end if;
+ return v_upload;
+end $$;
+
+create function public.live_project_retention_active(p_workspace_id uuid,p_artifact_id uuid)returns boolean language sql volatile set search_path=public,pg_temp as $$
+ select exists(select 1 from artifacts a where a.id=p_artifact_id and a.workspace_id=p_workspace_id and a.deleted_at is not null
+  and not exists(select 1 from artifact_removals r where r.artifact_id=a.id and r.workspace_id=a.workspace_id and r.access_epoch=a.access_epoch and r.removed_at=a.deleted_at and r.restored_at is null and r.recoverable_until<=clock_timestamp()))
+$$;
+revoke all on function public.live_project_retention_active(uuid,uuid) from public,anon,authenticated,service_role;
+
+create or replace function public.live_lock_upload_cleanup(p_upload_id uuid,p_claim_id uuid)
+returns public.artifact_uploads language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare u artifact_uploads;c artifact_upload_cleanup;
+begin
+ select * into u from artifact_uploads where id=p_upload_id;
+ if not found then raise exception 'CLEANUP_DENIED';end if;
+ perform 1 from workspaces where id=u.workspace_id for update;
+ perform 1 from artifacts where id=u.artifact_id and workspace_id=u.workspace_id for update;
+ select * into u from artifact_uploads where id=p_upload_id for update;
+ select * into c from artifact_upload_cleanup where upload_id=p_upload_id for update;
+ if not found or p_claim_id is null or c.claim_id is null or c.lease_until is null or c.completed_at is not null or c.claim_id is distinct from p_claim_id or c.lease_until<=clock_timestamp()
+  or live_project_retention_active(u.workspace_id,u.artifact_id)
+  or u.status<>'cancelled' or exists(select 1 from artifact_versions where id=u.version_id)
+  or exists(select 1 from artifact_upload_transfers where upload_id=u.id and status='admitted' and expires_at>clock_timestamp())
+  or exists(select 1 from artifact_upload_files where object_version_id=u.version_id and upload_id<>u.id)
+ then raise exception 'CLEANUP_DENIED';end if;
+ return u;
+end $$;
+
+create or replace function public.live_claim_upload_cleanup(p_claim_id uuid,p_upload_id uuid default null)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare selected_id uuid;u artifact_uploads;c artifact_upload_cleanup;
+begin
+ if p_claim_id is null then raise exception 'CLEANUP_DENIED';end if;
+ -- One live cleanup batch globally bounds duplicate cron dispatch. This lock
+ -- protects claim admission only; no transaction waits on object-storage I/O.
+ perform pg_advisory_xact_lock(9350120);
+ select upload_id into selected_id from artifact_upload_cleanup where claim_id=p_claim_id and lease_until>clock_timestamp() and completed_at is null;
+ if found then
+  if p_upload_id is not null and p_upload_id<>selected_id then raise exception 'CLEANUP_DENIED';end if;
+  return live_upload_cleanup_batch(selected_id,p_claim_id);
+ end if;
+ if exists(select 1 from artifact_upload_cleanup where lease_until>clock_timestamp() and completed_at is null) then return null;end if;
+ select u0.id into selected_id from artifact_uploads u0 join artifacts a on a.id=u0.artifact_id and a.workspace_id=u0.workspace_id
+  left join artifact_upload_cleanup c0 on c0.upload_id=u0.id
+ where (p_upload_id is null or u0.id=p_upload_id) and u0.status<>'finalized'
+  and not live_project_retention_active(a.workspace_id,a.id)
+  and (u0.status='cancelled' or u0.expires_at<=clock_timestamp() or a.deleted_at is not null)
+  and c0.completed_at is null and coalesce(c0.next_attempt_at,clock_timestamp())<=clock_timestamp()
+  and not exists(select 1 from artifact_upload_transfers t where t.upload_id=u0.id and t.status='admitted' and t.expires_at>clock_timestamp())
+ order by coalesce(c0.next_attempt_at,u0.created_at),u0.id limit 1;
+ if not found then return null;end if;
+ select * into u from artifact_uploads where id=selected_id;
+ perform 1 from workspaces where id=u.workspace_id for update;
+ perform 1 from artifacts where id=u.artifact_id and workspace_id=u.workspace_id for update;
+ select * into u from artifact_uploads where id=selected_id for update;
+ -- Revalidate after waiting on a concurrent finalization or admission.
+ if live_project_retention_active(u.workspace_id,u.artifact_id) or u.status='finalized' or (u.status<>'cancelled' and u.expires_at>clock_timestamp() and exists(select 1 from artifacts where id=u.artifact_id and deleted_at is null))
+  or exists(select 1 from artifact_upload_transfers where upload_id=u.id and status='admitted' and expires_at>clock_timestamp())
+ then return null;end if;
+ if u.status='uploading' then
+  update artifact_uploads set status='cancelled',generation=generation+1 where id=u.id;
+  insert into audit_events(workspace_id,action,target_id,trace_id) values(u.workspace_id,'upload.expired_or_deleted',u.id,p_claim_id::text);
+ end if;
+ insert into artifact_upload_cleanup(upload_id)values(u.id)on conflict do nothing;
+ select * into c from artifact_upload_cleanup where upload_id=u.id for update;
+ if c.completed_at is not null then return null;end if;
+ update artifact_upload_cleanup set claim_id=p_claim_id,lease_until=clock_timestamp()+interval '120 seconds',attempts=attempts+1 where upload_id=u.id;
+ return live_upload_cleanup_batch(u.id,p_claim_id);
+end $$;
+
+create or replace function public.live_find_upload_retry(p_actor_id uuid,p_workspace_id uuid,p_artifact_id uuid,p_manifest jsonb,p_base_version_id uuid,p_idempotency_key text,p_auth_session_id uuid,p_agent_credential_id uuid)
+returns uuid language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare u artifact_uploads;
+begin
+ perform live_assert_owner(p_actor_id,p_workspace_id);
+ perform 1 from workspaces where id=p_workspace_id for share;
+ perform 1 from artifacts where id=p_artifact_id and workspace_id=p_workspace_id and deleted_at is null for share;
+ if not found then raise exception 'NOT_FOUND';end if;
+ if not live_upload_proof_active(p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id) then raise exception 'AUTH_REVOKED';end if;
+ if p_idempotency_key is null or length(p_idempotency_key) not between 8 and 100 then raise exception 'INVALID_UPLOAD';end if;
+ select * into u from artifact_uploads where workspace_id=p_workspace_id and artifact_id=p_artifact_id and idempotency_key=p_idempotency_key;
+ if not found then return null;end if;
+ if not exists(select 1 from artifacts where id=u.artifact_id and workspace_id=u.workspace_id and access_epoch=u.access_epoch)then raise exception 'UPLOAD_PROJECT_REMOVED';end if;
+ if u.request_manifest is distinct from p_manifest or u.base_version_id is distinct from p_base_version_id or u.actor_id<>p_actor_id then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+ if u.status='cancelled' then raise exception 'UPLOAD_CANCELLED';end if;
+ if u.status<>'finalized' and u.expires_at<=clock_timestamp() then raise exception 'UPLOAD_EXPIRED';end if;
+ return u.id;
+end $$;
+
+create or replace function public.live_list_uploads(p_artifact_id uuid,p_actor_id uuid,p_workspace_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare result jsonb;
+begin
+ perform live_assert_owner(p_actor_id,p_workspace_id);
+ perform 1 from workspaces where id=p_workspace_id for share;
+ perform 1 from artifacts where id=p_artifact_id and workspace_id=p_workspace_id and deleted_at is null for share;
+ if not found then raise exception 'NOT_FOUND';end if;
+ if not live_upload_proof_active(p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id) then raise exception 'AUTH_REVOKED';end if;
+ select coalesce(jsonb_agg(live_upload_summary(u.id,p_auth_session_id,p_agent_credential_id) order by u.created_at desc,u.id desc),'[]') into result
+ from (select u0.id,u0.created_at from artifact_uploads u0 where u0.artifact_id=p_artifact_id and u0.workspace_id=p_workspace_id and u0.actor_id=p_actor_id and u0.status<>'finalized' and u0.access_epoch=(select access_epoch from artifacts where id=p_artifact_id)
+  and not exists(select 1 from artifact_upload_cleanup c where c.upload_id=u0.id and c.completed_at is not null)
+  order by u0.created_at desc,u0.id desc limit 50) u;
+ return result;
+end $$;
+
+drop function public.live_publish(uuid,uuid,uuid,uuid,text,text,text[],timestamptz,uuid,text);
+
+create or replace function public.live_publish(p_actor_id uuid,p_workspace_id uuid,p_artifact_id uuid,p_version_id uuid,p_slug text,p_audience text,p_recipients text[],p_expires_at timestamptz,p_expected_version_id uuid,p_trace_id text,p_access_epoch integer default 0) returns uuid language plpgsql security definer set search_path=public,pg_temp as $$
+declare v_current publications;v_id uuid;
+begin
+ perform live_assert_owner(p_actor_id,p_workspace_id);
+ perform 1 from workspaces where id=p_workspace_id for update;
+ perform 1 from artifacts where id=p_artifact_id and workspace_id=p_workspace_id and deleted_at is null for update;
+ if not found then raise exception 'NOT_FOUND' using errcode='P0002'; end if;
+ if p_access_epoch is null or not exists(select 1 from artifacts where id=p_artifact_id and workspace_id=p_workspace_id and access_epoch=p_access_epoch)then raise exception 'PROJECT_CHANGED';end if;
+ perform 1 from artifact_versions where id=p_version_id and artifact_id=p_artifact_id and workspace_id=p_workspace_id;
+ if not found then raise exception 'NOT_FOUND' using errcode='P0002'; end if;
+ if p_slug like 'preview-%' or p_slug=any(array['www','app','api','admin','auth','login','signup','docs','help','support','status','mail','email','smtp','cdn','assets','static','preview','delivery','billing','account','dashboard','live','melade','vercel','ns1','ns2']) then raise exception 'RESERVED_SLUG' using errcode='P0001'; end if;
+ if p_audience='recipients' and coalesce(cardinality(p_recipients),0)=0 then raise exception 'RECIPIENTS_REQUIRED' using errcode='P0001'; end if;
+ if coalesce(cardinality(p_recipients),0)>50 or (p_expires_at is not null and p_expires_at<=now()) then raise exception 'INVALID_PUBLICATION' using errcode='P0001'; end if;
+ select * into v_current from publications where artifact_id=p_artifact_id for update;
+ -- A retry of an identical current publication is harmless, even after its expected pointer moved.
+ if v_current.id is not null and v_current.revoked_at is null and v_current.version_id=p_version_id and v_current.slug=p_slug and v_current.audience=p_audience and v_current.recipients=p_recipients and v_current.expires_at is not distinct from p_expires_at then return v_current.id; end if;
+ if v_current.version_id is distinct from p_expected_version_id then raise exception 'PUBLICATION_CONFLICT' using errcode='P0001'; end if;
+ insert into publications(artifact_id,workspace_id,version_id,slug,audience,recipients,expires_at) values(p_artifact_id,p_workspace_id,p_version_id,p_slug,p_audience,p_recipients,p_expires_at)
+ on conflict(artifact_id) do update set version_id=excluded.version_id,slug=excluded.slug,audience=excluded.audience,recipients=excluded.recipients,expires_at=excluded.expires_at,revoked_at=null,updated_at=now() returning id into v_id;
