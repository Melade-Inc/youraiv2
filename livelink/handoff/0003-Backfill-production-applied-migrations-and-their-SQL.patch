+begin
+ insert into auth.users(id,email,email_confirmed_at)values(actor,'core-dispatch@example.test',now());workspace:=live_ensure_workspace(actor);artifact:=live_create_artifact(actor,workspace,'Core gate','app','test');
+ insert into operations(id,workspace_id,actor_id,artifact_id,kind,prompt,idempotency_key,request_hash)values(operation,workspace,actor,artifact,'app','Counter','core-gate-operation',repeat('a',64));
+ reservation:=(live_reserve_runtime(workspace,artifact,operation,'core-gate-reserve',repeat('a',64),'platform','coder',model,'core-price-v1',1000000000)->>'id')::uuid;
+ for case_number in 1..8 loop
+  begin
+   perform live_dispatch_core_runtime(reservation,case when case_number=1 then gen_random_uuid()else workspace end,case when case_number=2 then gen_random_uuid()else artifact end,case when case_number=3 then gen_random_uuid()else operation end,case when case_number=4 then repeat('b',64)else repeat('a',64)end,case when case_number=5 then 'another/model'else model end,case when case_number=6 then 'different-policy'else 'core-price-v1'end,case when case_number=7 then 'reviewer'else 'coder'end,case when case_number=8 then 999999999 else 1000000000 end);
+   raise exception 'mismatched core quote dispatched: %',case_number;
+  exception when raise_exception then if sqlerrm<>'RUNTIME_DISPATCH_DENIED'then raise;end if;end;
+  assert (select status='reserved' from runtime_reservations where id=reservation);
+ end loop;
+ other:=(live_reserve_runtime(workspace,artifact,operation,'core-gate-nonmodel',repeat('a',64),'platform','r2-read',null,'core-price-v1',1000000000)->>'id')::uuid;
+ begin perform live_dispatch_core_runtime(other,workspace,artifact,operation,repeat('a',64),model,'core-price-v1','coder',1000000000);raise exception 'non-model hold dispatched as Astra';exception when raise_exception then if sqlerrm<>'RUNTIME_DISPATCH_DENIED'then raise;end if;end;
+ assert live_dispatch_core_runtime(reservation,workspace,artifact,operation,repeat('a',64),model,'core-price-v1','coder',1000000000);
+ assert not live_dispatch_core_runtime(reservation,workspace,artifact,operation,repeat('a',64),model,'core-price-v1','coder',1000000000);
+ perform live_close_runtime(reservation,workspace,repeat('a',64),'unknown');
+ assert not live_dispatch_core_runtime(reservation,workspace,artifact,operation,repeat('a',64),model,'core-price-v1','coder',1000000000);
+ reservation:=(live_reserve_runtime(workspace,artifact,operation,'core-gate-cancelled',repeat('a',64),'platform','reviewer',model,'core-price-v1',1000000000)->>'id')::uuid;
+ update operations set status='cancelled'where id=operation;
+ assert not live_dispatch_core_runtime(reservation,workspace,artifact,operation,repeat('a',64),model,'core-price-v1','reviewer',1000000000);
+ assert (select status='released' from runtime_reservations where id=reservation);
+end $$;
+set local role authenticated;
+do $$begin
+ begin perform live_dispatch_core_runtime(gen_random_uuid(),gen_random_uuid(),gen_random_uuid(),gen_random_uuid(),repeat('a',64),'openai/gpt-6-astra','core-price-v1','coder',1);raise exception 'browser dispatched a paid task';exception when insufficient_privilege then null;end;
