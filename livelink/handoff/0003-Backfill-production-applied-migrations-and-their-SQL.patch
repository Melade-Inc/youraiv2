diff --git a/supabase/tests/content-purge-race-assert.sql b/supabase/tests/content-purge-race-assert.sql
new file mode 100644
index 0000000..8a84cf5
--- /dev/null
+++ b/supabase/tests/content-purge-race-assert.sql
@@ -0,0 +1,13 @@
+do $$
+declare f test_content_purge_race;result jsonb;upload_release bigint;
+begin
+ select *into f from test_content_purge_race;
+ for i in 1..12 loop result:=live_advance_project_content_purge(f.removal);exit when result->>'status'='content-removed';end loop;
+ assert result->>'status'='content-removed';assert live_advance_project_content_purge(f.removal)=result;
+ assert(select storage_bytes=0 and upload_reserved_bytes=0 from workspaces where id=f.workspace);
+ assert(result->>'releasedStoredBytes')::bigint=f.stored;
+ select case when project_removal_id is null then released_bytes else 0 end into upload_release from artifact_upload_cleanup where upload_id=f.upload;
+ assert(result->>'releasedReservedBytes')::bigint+upload_release=f.reserved,'exactly one quota release across both collectors';
+ assert(select count(*)from audit_events where action='project.saved_content_removed'and target_id=f.artifact)=1;
+ assert not exists(select 1 from artifact_versions where artifact_id=f.artifact and manifest<>'{}');
+end $$;
diff --git a/supabase/tests/content-purge-race-setup.sql b/supabase/tests/content-purge-race-setup.sql
new file mode 100644
index 0000000..ac8a66f
--- /dev/null
+++ b/supabase/tests/content-purge-race-setup.sql
@@ -0,0 +1,14 @@
+create table test_content_purge_race(workspace uuid,artifact uuid,removal uuid,upload uuid,stored bigint,reserved bigint);
+grant select on test_content_purge_race to service_role;
+do $$
+declare actor uuid:=gen_random_uuid();login uuid:=gen_random_uuid();w uuid;a uuid;v uuid;u uuid;r uuid:=gen_random_uuid();removed timestamptz:=clock_timestamp()-interval '721 hours';
+begin
+ insert into auth.users(id,email,email_confirmed_at)values(actor,'content-race@example.test',now());insert into auth.sessions(id,user_id)values(login,actor);w:=live_ensure_workspace(actor);
+ a:=live_create_artifact(actor,w,'Content race','document','test');
+ v:=live_finalize_version(actor,w,a,'{"schemaVersion":1,"kind":"document","title":"Race","files":[],"blocks":[{"type":"markdown","text":"Private race content"}]}',repeat('a',64),null,'content-race-version','test');
+ u:=live_begin_upload(actor,w,a,'{"schemaVersion":2,"kind":"document","title":"Pending","files":[],"blocks":[{"type":"markdown","text":"Private unfinished upload"}]}',v,'content-race-upload',login,null,'test');
+ perform live_cancel_upload(u,actor,w,login,null,'test');
+ insert into artifact_removals(id,workspace_id,artifact_id,access_epoch,removed_at,recoverable_until,removed_by,idempotency_key,source)values(r,w,a,1,removed,removed+interval '720 hours',actor,r::text,'legacy');
+ update artifacts set deleted_at=removed,access_epoch=1 where id=a;
+ insert into test_content_purge_race select w,a,r,u,storage_bytes,upload_reserved_bytes from workspaces where id=w;
+end $$;
