+  if p_manifest ? 'files'and jsonb_typeof(p_manifest->'files')is distinct from'array'then return 'reconciliation-required';end if;
+  if exists(select 1 from jsonb_array_elements(p_manifest->'files')inline_file where inline_file->>'encoding'not in('utf8','base64')or inline_file->>'encoding'is null or inline_file ? 'storage')then return 'reconciliation-required';end if;
+  return null;
+ end if;
+ if p_manifest->>'schemaVersion'is distinct from'2'or jsonb_typeof(p_manifest->'files')is distinct from'array'then return 'reconciliation-required';end if;
+ for f in select value from jsonb_array_elements(p_manifest->'files')loop
+  if f->>'encoding'is distinct from'r2'then return 'reconciliation-required';end if;
+  begin version:=(f->'storage'->>'versionId')::uuid;state:=live_purge_reference_state(p_workspace,p_artifact,version,f->>'sha256',f->>'mediaType',(f->>'size')::bigint);exception when invalid_text_representation or numeric_value_out_of_range then return 'reconciliation-required';end;
+  if state='reconciliation-required'and p_revision_task is not null and version=p_revision_task
+   and exists(select 1 from core_revision_objects where task_id=p_revision_task and path=f->>'path'and sha256=f->>'sha256'and media_type=f->>'mediaType'and byte_size=(f->>'size')::bigint and verified_at is null)
+   and not exists(select 1 from cloudflare_storage_objects where workspace_id=p_workspace and artifact_id=p_artifact and object_version_id=version and sha256=f->>'sha256'and media_type=f->>'mediaType')then
+   -- Stored-source writes have always required atomic funded commitments.
+   -- Without a commitment or verification, this candidate was never written.
+   state:=null;
+  end if;
+  if state is not null then return state;end if;
+ end loop;return null;
+end $$;
