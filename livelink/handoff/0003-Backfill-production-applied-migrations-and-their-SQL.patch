+ foreach value in array array[receipt||'{"listPriceCostNanos":"0"}'::jsonb,receipt||'{"headers":"secret"}'::jsonb,receipt||'{"cpuMs":null}'::jsonb,receipt-'scriptName',receipt||'{"exceedsQuote":true}'::jsonb] loop
