+-- Commit authority, a bounded transfer lease, and runtime funding atomically.
+-- Global budget lock comes first, matching core-operation lock ordering.
+create function public.live_admit_funded_upload_transfer(p_upload_id uuid,p_file_index integer,p_generation integer,p_transfer_id uuid,p_request_hash text)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_file record;v_funding jsonb;v_id uuid;
+begin
+ if p_request_hash is null or p_request_hash!~'^[a-f0-9]{64}$' then raise exception 'RUNTIME_INTENT_INVALID';end if;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into strict v_file from live_admit_upload_transfer(p_upload_id,p_file_index,p_generation,p_transfer_id);
+ v_funding:=live_reserve_runtime(v_file.workspace_id,v_file.artifact_id,null,'upload:'||p_transfer_id,p_request_hash,'platform','r2-upload',null,'cloudflare-standard-2026-09-05-v1',610020);
+ if v_funding->>'status' is distinct from 'reserved' then raise exception 'TRANSFER_ALREADY_ADMITTED';end if;
+ v_id:=(v_funding->>'id')::uuid;
+ if not live_dispatch_runtime(v_id,v_file.workspace_id,p_request_hash) then raise exception 'RUNTIME_DISPATCH_DENIED';end if;
+ return to_jsonb(v_file)||jsonb_build_object('funding',jsonb_build_object('reservationId',v_id,'requestHash',p_request_hash,'policy','cloudflare-standard-2026-09-05-v1','purpose','r2-upload'));
+end $$;
