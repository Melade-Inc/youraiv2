+create function public.live_pause_core_operation(p_operation_id uuid,p_runner_id text,p_reason text,p_message text,p_terminal boolean default false)
+returns void language plpgsql security definer set search_path=public,pg_temp as $$
+declare o operations;r runtime_reservations;
+begin
