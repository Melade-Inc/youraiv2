diff --git a/tests/sql/funded-upload-callbacks.sql b/tests/sql/funded-upload-callbacks.sql
new file mode 100644
index 0000000..d77c2ac
--- /dev/null
+++ b/tests/sql/funded-upload-callbacks.sql
@@ -0,0 +1,92 @@
+begin;
+do $$
+declare actor uuid:=gen_random_uuid();login uuid:=gen_random_uuid();workspace uuid;artifact uuid;upload uuid;other_upload uuid;
+ transfer uuid:=gen_random_uuid();retry uuid:=gen_random_uuid();claim uuid:=gen_random_uuid();invocation uuid:=gen_random_uuid();
+ hold uuid;funding uuid;manifest jsonb;admission jsonb;receipt jsonb;available bigint;count_before bigint;
+ policy text:='cloudflare-standard-2026-09-05-v1';purpose text;maximum bigint;
+begin
+ insert into auth.users(id,email,email_confirmed_at)values(actor,'funded-callbacks@example.test',now());insert into auth.sessions(id,user_id)values(login,actor);
+ workspace:=live_ensure_workspace(actor);artifact:=live_create_artifact(actor,workspace,'Funded callbacks','app','test');
+ manifest:='{"schemaVersion":2,"kind":"app","title":"Funded callbacks","entrypoint":"index.html","blocks":[],"files":[{"path":"index.html","mediaType":"text/html","size":100,"sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}';
+ upload:=live_begin_upload(actor,workspace,artifact,manifest,null,'funded-first',login,null,'test');
+ available:=live_runtime_available(workspace,'platform',date_trunc('month',now())::date);
+ hold:=(live_reserve_runtime(workspace,artifact,null,'funded-exhaustion',repeat('b',64),'platform','r2-upload',null,policy,available-610019)->>'id')::uuid;
+ begin perform live_admit_funded_upload_transfer(upload,0,1,transfer,repeat('a',64));raise exception 'unfunded transfer admitted';exception when raise_exception then if sqlerrm<>'RUNTIME_BUDGET_EXHAUSTED' then raise;end if;end;
+ assert not exists(select 1 from artifact_upload_transfers where id=transfer);
+ assert not exists(select 1 from audit_events where target_id=transfer);
+ assert not exists(select 1 from runtime_reservations where idempotency_key='upload:'||transfer);
+ assert live_runtime_available(workspace,'platform',date_trunc('month',now())::date)=610019;
+ perform live_close_runtime(hold,workspace,repeat('b',64),'cancelled');
+ -- A paused policy also rolls back the transfer and its audit event.
+ begin
+  insert into runtime_policy_pauses(policy,reservation_id,reason)values(policy,hold,'cost-overrun');
+  begin perform live_admit_funded_upload_transfer(upload,0,1,transfer,repeat('a',64));raise exception 'paused policy admitted';exception when raise_exception then if sqlerrm<>'RUNTIME_POLICY_PAUSED' then raise;end if;end;
+  assert not exists(select 1 from artifact_upload_transfers where id=transfer);
+  raise exception 'ROLLBACK_PAUSE';
+ exception when raise_exception then if sqlerrm<>'ROLLBACK_PAUSE' then raise;end if;end;
+ admission:=live_admit_funded_upload_transfer(upload,0,1,transfer,repeat('a',64));funding:=(admission->'funding'->>'reservationId')::uuid;
+ assert admission->>'workspace_id'=workspace::text and admission->>'artifact_id'=artifact::text and admission->>'already_verified'='false';
+ assert admission->'funding'->>'purpose'='r2-upload' and admission->'funding'->>'policy'=policy;
+ assert (select status='dispatched' and maximum_cost_nanos=610020 and artifact_id=artifact and workspace_id=workspace from runtime_reservations where id=funding);
+ assert live_runtime_available(workspace,'platform',date_trunc('month',now())::date)=available-610020;
+ begin perform live_admit_funded_upload_transfer(upload,0,1,transfer,repeat('a',64));raise exception 'callback replay admitted';exception when raise_exception then if sqlerrm<>'TRANSFER_ALREADY_ADMITTED' then raise;end if;end;
+ begin perform live_admit_funded_upload_transfer(upload,0,1,retry,repeat('a',64));raise exception 'parallel transfer admitted';exception when raise_exception then if sqlerrm<>'UPLOAD_IN_PROGRESS' then raise;end if;end;
+ assert not exists(select 1 from runtime_reservations where idempotency_key='upload:'||retry);
+ perform live_complete_upload_transfer(upload,0,1,transfer,repeat('a',64),100);
+ -- The legacy verified-file shortcut must not reuse an already spent grant.
+ begin perform live_admit_funded_upload_transfer(upload,0,1,transfer,repeat('a',64));raise exception 'verified replay admitted';exception when raise_exception then if sqlerrm<>'TRANSFER_ALREADY_ADMITTED' then raise;end if;end;
+ admission:=live_admit_funded_upload_transfer(upload,0,1,retry,repeat('c',64));assert admission->>'already_verified'='true';
+ assert (select count(*)=1 from artifact_upload_transfers where upload_id=upload);
+ assert (select count(*)=2 from runtime_reservations where workspace_id=workspace and status='dispatched');
+ -- Admission resolves ownership from the authorized manifest, not caller IDs.
+ other_upload:=live_begin_upload(actor,workspace,artifact,manifest,null,'funded-other',login,null,'test');
+ begin perform live_admit_funded_upload_transfer(other_upload,0,1,transfer,repeat('a',64));raise exception 'grant transferred';exception when raise_exception then if sqlerrm<>'UPLOAD_GRANT_INVALID' then raise;end if;end;
+ begin perform live_admit_funded_upload_transfer(other_upload,0,2,gen_random_uuid(),repeat('a',64));raise exception 'stale generation admitted';exception when raise_exception then if sqlerrm<>'UPLOAD_GRANT_STALE' then raise;end if;end;
+ perform live_cancel_upload(upload,actor,workspace,login,null,'test');assert live_claim_upload_cleanup(claim,upload) is not null;
+ count_before:=(select count(*)from runtime_reservations);
+ begin perform live_authorize_funded_cleanup(other_upload,claim,0,invocation,repeat('d',64));raise exception 'cleanup crossed upload';exception when raise_exception then if sqlerrm<>'CLEANUP_DENIED' then raise;end if;end;
+ begin perform live_authorize_funded_cleanup(upload,gen_random_uuid(),0,invocation,repeat('d',64));raise exception 'wrong claim funded';exception when raise_exception then if sqlerrm<>'CLEANUP_DENIED' then raise;end if;end;
+ assert (select count(*)from runtime_reservations)=count_before;
+ available:=live_runtime_available(workspace,'platform',date_trunc('month',now())::date);
+ hold:=(live_reserve_runtime(workspace,artifact,null,'cleanup-exhaustion',repeat('b',64),'platform','r2-upload',null,policy,available-6519)->>'id')::uuid;
+ begin perform live_authorize_funded_cleanup(upload,claim,0,invocation,repeat('d',64));raise exception 'unfunded cleanup admitted';exception when raise_exception then if sqlerrm<>'RUNTIME_BUDGET_EXHAUSTED' then raise;end if;end;
+ assert not exists(select 1 from runtime_reservations where idempotency_key='cleanup:'||invocation);
+ assert not exists(select 1 from artifact_upload_retirements where upload_id=upload);
+ perform live_close_runtime(hold,workspace,repeat('b',64),'cancelled');
+ admission:=live_authorize_funded_cleanup(upload,claim,0,invocation,repeat('d',64));funding:=(admission->'funding'->>'reservationId')::uuid;
+ assert admission->'reference'->>'workspaceId'=workspace::text and admission->'funding'->>'purpose'='r2-cleanup';
+ assert (select status='dispatched' and maximum_cost_nanos=6520 from runtime_reservations where id=funding);
+ begin perform live_authorize_funded_cleanup(upload,claim,0,invocation,repeat('d',64));raise exception 'cleanup replay spent twice';exception when raise_exception then if sqlerrm<>'RUNTIME_DISPATCH_DENIED' then raise;end if;end;
+ perform live_authorize_funded_cleanup(upload,claim,0,gen_random_uuid(),repeat('e',64));
+ update artifact_upload_cleanup set lease_until=clock_timestamp()-interval '1 second' where upload_id=upload;
+ count_before:=(select count(*)from runtime_reservations);
+ begin perform live_authorize_funded_cleanup(upload,claim,0,gen_random_uuid(),repeat('e',64));raise exception 'expired claim funded';exception when raise_exception then if sqlerrm<>'CLEANUP_DENIED' then raise;end if;end;
+ perform live_revoke_auth_session(actor,login);
+ begin perform live_admit_funded_upload_transfer(other_upload,0,1,gen_random_uuid(),repeat('a',64));raise exception 'ended login funded';exception when raise_exception then if sqlerrm<>'AUTH_REVOKED' then raise;end if;end;
+ assert (select count(*)from runtime_reservations)=count_before;
+ -- Tail starts before the upload/cleanup callback commits; reads still need
+ -- pre-dispatch funding. No timestamp amendment releases any financial hold.
+ foreach purpose in array array['r2-upload','r2-cleanup','r2-read'] loop
+  maximum:=case when purpose='r2-upload' then 610020 else 6520 end;
+  funding:=(live_reserve_runtime(workspace,artifact,null,'callback-time-'||purpose,repeat('f',64),'platform',purpose,null,policy,maximum)->>'id')::uuid;
+  assert live_dispatch_runtime(funding,workspace,repeat('f',64));
+  receipt:=jsonb_build_object('schemaVersion',1,'environment','production','scriptName','live-link-r2-production','scriptVersion','11111111-0000-4000-8000-000000000002','eventTimestamp',floor(extract(epoch from now())*1000)-66000,'reservationId',funding,'requestHash',repeat('f',64),'policy',policy,'purpose',purpose,'outcome','ok','cpuMs',3,'wallMs',30000,'complete',true,'attemptedClassA',1,'attemptedClassB',2,'listPriceCostNanos','5580','exceedsQuote',false,'costBasis','metered-list-price-before-inclusions-and-billing-rounding');
+  begin perform live_record_cloudflare_usage('production',receipt);raise exception 'unbounded callback correlation';exception when raise_exception then if sqlerrm<>'CLOUDFLARE_RESERVATION_MISMATCH' then raise;end if;end;
+  receipt:=receipt||jsonb_build_object('eventTimestamp',floor(extract(epoch from now())*1000)-30000);
+  if purpose='r2-read' then
+   begin perform live_record_cloudflare_usage('production',receipt);raise exception 'read funded after dispatch';exception when raise_exception then if sqlerrm<>'CLOUDFLARE_RESERVATION_MISMATCH' then raise;end if;end;
+  else
+   available:=live_runtime_available(workspace,'platform',date_trunc('month',now())::date);
+   assert live_record_cloudflare_usage('production',receipt)->>'recorded'='true';
+   assert live_runtime_available(workspace,'platform',date_trunc('month',now())::date)=available;
+  end if;
+ end loop;
+ assert not has_function_privilege('anon','live_admit_funded_upload_transfer(uuid,integer,integer,uuid,text)','execute');
+ assert not has_function_privilege('authenticated','live_admit_funded_upload_transfer(uuid,integer,integer,uuid,text)','execute');
