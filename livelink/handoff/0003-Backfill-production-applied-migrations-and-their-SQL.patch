+-- Each required reference needs matching original bytes in every recorded
+-- environment, and at least one recorded retirement. An absent commitment is
+-- not evidence of deletion. Never-written candidates have separate proofs.
+create function public.live_purge_reference_state(p_workspace uuid,p_artifact uuid,p_version uuid,p_hash text,p_media text,p_size bigint)
+returns text language plpgsql stable set search_path=public,pg_temp as $$
+begin
+ if p_version is null or p_hash is null or p_hash!~'^[a-f0-9]{64}$'or p_media is null or p_size is null or p_size<0 then return 'reconciliation-required';end if;
+ if not exists(select 1 from cloudflare_storage_objects where workspace_id=p_workspace and artifact_id=p_artifact and object_version_id=p_version and sha256=p_hash and media_type=p_media)then return 'reconciliation-required';end if;
+ if exists(select 1 from cloudflare_storage_objects where workspace_id=p_workspace and artifact_id=p_artifact and object_version_id=p_version and sha256=p_hash and media_type=p_media and byte_size<>p_size)then return 'reconciliation-required';end if;
+ if exists(select 1 from cloudflare_storage_objects where workspace_id=p_workspace and artifact_id=p_artifact and object_version_id=p_version and sha256=p_hash and media_type=p_media and retired_at is null)then return 'storage-pending';end if;
+ return null;
+end $$;
+create function public.live_purge_manifest_state(p_workspace uuid,p_artifact uuid,p_manifest jsonb,p_revision_task uuid default null)
+returns text language plpgsql stable set search_path=public,pg_temp as $$
+declare f jsonb;state text;version uuid;
+begin
