@@ -0,0 +1,233 @@
+-- Canonical staged-upload state. No browser/agent directly writes these tables.
+alter table public.workspaces add column plan_code text not null default 'free' check(plan_code in ('free','starter','pro'));
+alter table public.workspaces add column upload_reserved_bytes bigint not null default 0 check(upload_reserved_bytes>=0);
+
+create function public.live_storage_limits(p_plan text)
+returns table(file_bytes bigint,version_bytes bigint,file_count integer,storage_bytes bigint)
+language sql immutable set search_path=public,pg_temp as $$
+ select file_bytes,version_bytes,file_count,storage_bytes from (values
+ ('free',26214400::bigint,52428800::bigint,200,262144000::bigint),
+ ('starter',52428800::bigint,104857600::bigint,500,2147483648::bigint),
+ ('pro',104857600::bigint,262144000::bigint,1000,10737418240::bigint)
+ ) as limits(plan,file_bytes,version_bytes,file_count,storage_bytes) where plan=p_plan
+$$;
+
+create function public.live_guard_storage_reservation() returns trigger language plpgsql set search_path=public,pg_temp as $$
+declare v_limit bigint;
+begin
+ select storage_bytes into v_limit from live_storage_limits(new.plan_code);
+ -- A downgrade can leave existing bytes above a plan; it cannot admit more bytes.
+ if new.storage_bytes+new.upload_reserved_bytes>v_limit and new.storage_bytes+new.upload_reserved_bytes>old.storage_bytes+old.upload_reserved_bytes then raise exception 'STORAGE_LIMIT';end if;
+ return new;
+end $$;
+create trigger workspace_storage_reservation_guard before update of storage_bytes,upload_reserved_bytes,plan_code on public.workspaces for each row execute function public.live_guard_storage_reservation();
+
+create table public.artifact_uploads (
+ id uuid primary key default gen_random_uuid(),workspace_id uuid not null,artifact_id uuid not null,
+ version_id uuid not null unique default gen_random_uuid(),base_version_id uuid,
+ actor_id uuid not null references auth.users(id),auth_session_id uuid,agent_credential_id uuid,
+ generation integer not null default 1 check(generation>0),
+ idempotency_key text not null check(length(idempotency_key) between 8 and 100),
+ request_manifest jsonb not null,manifest jsonb not null,
+ reserved_bytes bigint not null check(reserved_bytes>=0),
+ status text not null default 'uploading' check(status in ('uploading','finalized','cancelled')),
+ expires_at timestamptz not null default clock_timestamp()+interval '24 hours',
+ created_at timestamptz not null default clock_timestamp(),finalized_at timestamptz,
+ foreign key(artifact_id,workspace_id) references public.artifacts(id,workspace_id),
+ check((auth_session_id is null)<>(agent_credential_id is null)),
+ unique(workspace_id,artifact_id,idempotency_key),unique(id,artifact_id,workspace_id),unique(version_id,artifact_id,workspace_id)
+);
+create table public.artifact_upload_files (
+ upload_id uuid not null,workspace_id uuid not null,artifact_id uuid not null,
+ file_index integer not null check(file_index between 0 and 999),path text not null check(length(path) between 1 and 200),
+ media_type text not null check(length(media_type) between 1 and 100),
+ byte_size bigint not null check(byte_size between 0 and 104857600),sha256 text not null check(sha256~'^[a-f0-9]{64}$'),
+ object_version_id uuid not null,verified_at timestamptz,
+ primary key(upload_id,file_index),
+ foreign key(upload_id,artifact_id,workspace_id) references public.artifact_uploads(id,artifact_id,workspace_id),
+ foreign key(object_version_id,artifact_id,workspace_id) references public.artifact_uploads(version_id,artifact_id,workspace_id)
+);
+create unique index upload_paths_unique on public.artifact_upload_files(upload_id,lower(path));
+create index upload_files_reuse on public.artifact_upload_files(workspace_id,artifact_id,sha256,byte_size,media_type) where verified_at is not null;
+create index upload_workspace_state on public.artifact_uploads(workspace_id,status,expires_at);
+alter table public.artifact_uploads enable row level security;
+alter table public.artifact_upload_files enable row level security;
+revoke all on public.artifact_uploads,public.artifact_upload_files from public,anon,authenticated;
+grant all on public.artifact_uploads,public.artifact_upload_files to service_role;
+
+create function public.live_upload_proof_active(p_actor_id uuid,p_workspace_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid)
+returns boolean language plpgsql volatile security definer set search_path=public,pg_temp as $$
+begin
+ if p_actor_id is null or (p_auth_session_id is null)=(p_agent_credential_id is null) then return false;end if;
+ if not exists(select 1 from workspaces where id=p_workspace_id and owner_id=p_actor_id) then return false;end if;
+ if p_auth_session_id is not null then return live_access_proof_active(p_actor_id,p_auth_session_id,null,p_workspace_id);end if;
+ -- Write-only credentials are valid upload principals; read never implies write.
+ perform 1 from auth.users where id=p_actor_id and email_confirmed_at is not null and deleted_at is null and (banned_until is null or banned_until<=clock_timestamp()) for share;
+ if not found then return false;end if;
+ perform 1 from agent_credentials where id=p_agent_credential_id and workspace_id=p_workspace_id for share;
+ if not found then return false;end if;
+ return exists(select 1 from agent_credentials where id=p_agent_credential_id and workspace_id=p_workspace_id and revoked_at is null and 'artifact:write'=any(scopes));
+end $$;
+
+create function public.live_begin_upload(p_actor_id uuid,p_workspace_id uuid,p_artifact_id uuid,p_manifest jsonb,p_base_version_id uuid,p_idempotency_key text,p_auth_session_id uuid,p_agent_credential_id uuid,p_trace_id text)
+returns uuid language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_workspace workspaces;v_artifact artifacts;v_existing artifact_uploads;v_limits record;v_file jsonb;v_ref uuid;
+ v_files jsonb:='[]';v_manifest jsonb;v_id uuid:=gen_random_uuid();v_version uuid:=gen_random_uuid();v_total bigint:=0;v_reserve bigint;v_size bigint;v_path text;v_seen text[]:='{}';
+begin
+ perform live_assert_owner(p_actor_id,p_workspace_id);
+ select * into v_workspace from workspaces where id=p_workspace_id for update;
+ select * into v_artifact from artifacts where id=p_artifact_id and workspace_id=p_workspace_id and deleted_at is null for update;
+ if not found then raise exception 'NOT_FOUND';end if;
+ if not live_upload_proof_active(p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id) then raise exception 'AUTH_REVOKED';end if;
+ if p_idempotency_key is null or length(p_idempotency_key) not between 8 and 100 then raise exception 'INVALID_UPLOAD';end if;
+ select * into v_existing from artifact_uploads where workspace_id=p_workspace_id and artifact_id=p_artifact_id and idempotency_key=p_idempotency_key;
+ if found then
+  if v_existing.request_manifest is distinct from p_manifest or v_existing.base_version_id is distinct from p_base_version_id or v_existing.actor_id<>p_actor_id then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+  if v_existing.auth_session_id is distinct from p_auth_session_id or v_existing.agent_credential_id is distinct from p_agent_credential_id then raise exception 'UPLOAD_REBIND_REQUIRED';end if;
+  if v_existing.status='cancelled' then raise exception 'UPLOAD_CANCELLED';end if;
+  if v_existing.status<>'finalized' and v_existing.expires_at<=clock_timestamp() then raise exception 'UPLOAD_EXPIRED';end if;
+  return v_existing.id;
+ end if;
+ if v_artifact.latest_version_id is distinct from p_base_version_id then raise exception 'VERSION_CONFLICT';end if;
+ if p_manifest is null or p_manifest->>'schemaVersion' is distinct from '2' or p_manifest->>'kind' is distinct from v_artifact.kind
+  or jsonb_typeof(p_manifest->'files') is distinct from 'array' or jsonb_typeof(p_manifest->'blocks') is distinct from 'array'
+  or coalesce(length(p_manifest->>'title'),0) not between 1 and 120 or octet_length(p_manifest::text)>1048576 then raise exception 'INVALID_MANIFEST';end if;
+ select * into v_limits from live_storage_limits(v_workspace.plan_code);
+ if jsonb_array_length(p_manifest->'files')>v_limits.file_count then raise exception 'UPLOAD_FILE_LIMIT';end if;
+ for v_file in select value from jsonb_array_elements(p_manifest->'files') loop
+  v_path:=v_file->>'path';
+  if jsonb_typeof(v_file) is distinct from 'object' or jsonb_typeof(v_file->'path') is distinct from 'string'
+   or coalesce(length(v_path),0) not between 1 and 200 or v_path like '/%' or v_path like '%/' or position('//' in v_path)>0
+   or v_path~'(^|/)[.]' or v_path~'[[:cntrl:]?#%:]' or position(chr(92) in v_path)>0 or lower(v_path)='__live' or lower(v_path) like '__live/%'
+   or lower(v_path)=any(v_seen) or jsonb_typeof(v_file->'size') is distinct from 'number' or coalesce(v_file->>'size','')!~'^[0-9]{1,10}$'
+   or coalesce(v_file->>'sha256','')!~'^[a-f0-9]{64}$' or jsonb_typeof(v_file->'mediaType') is distinct from 'string'
+   or coalesce(length(v_file->>'mediaType'),0) not between 1 and 100 or (v_file-array['path','mediaType','size','sha256'])<>'{}'::jsonb then raise exception 'INVALID_UPLOAD_FILE';end if;
+  v_seen:=array_append(v_seen,lower(v_path));v_size:=(v_file->>'size')::bigint;
+  if v_size>v_limits.file_bytes then raise exception 'UPLOAD_FILE_TOO_LARGE';end if;
+  v_total:=v_total+v_size;
+  select f.object_version_id into v_ref from artifact_upload_files f join artifact_uploads u on u.id=f.upload_id
+   where f.workspace_id=p_workspace_id and f.artifact_id=p_artifact_id and f.sha256=v_file->>'sha256' and f.byte_size=v_size
+    and f.media_type=v_file->>'mediaType' and f.verified_at is not null and u.status='finalized' order by u.created_at,f.file_index limit 1;
+  v_files:=v_files||jsonb_build_array(v_file||jsonb_build_object('encoding','r2','content','','storage',jsonb_build_object('versionId',coalesce(v_ref,v_version))));
+ end loop;
+ if v_total>v_limits.version_bytes then raise exception 'VERSION_TOO_LARGE';end if;
+ if v_artifact.kind='document' and jsonb_array_length(p_manifest->'blocks')=0 then raise exception 'INVALID_MANIFEST';end if;
+ if v_artifact.kind<>'document' and not exists(select 1 from jsonb_array_elements(v_files) f where f->>'path'=p_manifest->>'entrypoint' and (v_artifact.kind<>'app' or f->>'mediaType'='text/html')) then raise exception 'INVALID_MANIFEST';end if;
+ v_manifest:=jsonb_set(p_manifest,'{files}',v_files);v_reserve:=v_total+octet_length(v_manifest::text);
+ if v_workspace.storage_bytes+v_workspace.upload_reserved_bytes+v_reserve>v_limits.storage_bytes then raise exception 'STORAGE_LIMIT';end if;
+ insert into artifact_uploads(id,workspace_id,artifact_id,version_id,base_version_id,actor_id,auth_session_id,agent_credential_id,idempotency_key,request_manifest,manifest,reserved_bytes)
+  values(v_id,p_workspace_id,p_artifact_id,v_version,p_base_version_id,p_actor_id,p_auth_session_id,p_agent_credential_id,p_idempotency_key,p_manifest,v_manifest,v_reserve);
+ insert into artifact_upload_files(upload_id,workspace_id,artifact_id,file_index,path,media_type,byte_size,sha256,object_version_id,verified_at)
+  select v_id,p_workspace_id,p_artifact_id,(ordinality-1)::integer,value->>'path',value->>'mediaType',(value->>'size')::bigint,value->>'sha256',(value->'storage'->>'versionId')::uuid,
+   case when (value->'storage'->>'versionId')::uuid<>v_version then clock_timestamp() else null end from jsonb_array_elements(v_files) with ordinality;
+ update workspaces set upload_reserved_bytes=upload_reserved_bytes+v_reserve where id=p_workspace_id;
+ insert into audit_events(workspace_id,actor_id,action,target_id,trace_id,metadata) values(p_workspace_id,p_actor_id,'upload.created',v_id,p_trace_id,jsonb_build_object('artifactId',p_artifact_id,'reservedBytes',v_reserve));
+ return v_id;
+end $$;
+
+-- Uniform workspace -> artifact -> proof -> upload lock order for all mutations.
+create function public.live_lock_upload(p_upload_id uuid,p_actor_id uuid,p_workspace_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid,p_allow_rebind boolean default false)
+returns public.artifact_uploads language plpgsql volatile security definer set search_path=public,pg_temp as $$
