+ restored_at timestamptz,restored_by uuid,recovery_key text,
+ foreign key(artifact_id,workspace_id) references public.artifacts(id,workspace_id),
+ unique(workspace_id,idempotency_key),unique(artifact_id,access_epoch),
+ check(recoverable_until=removed_at+interval '720 hours'),
