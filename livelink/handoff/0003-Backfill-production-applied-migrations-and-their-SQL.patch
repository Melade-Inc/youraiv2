+-- Internal transition; service callers use an authenticated wrapper below.
+create function public.live_remove_project_internal(p_actor_id uuid,p_workspace_id uuid,p_artifact_id uuid,p_expected_epoch integer,p_key text,p_trace_id text,p_source text default 'owner')
