diff --git a/supabase/migrations/20260905232132_cloudflare_hosting_commitments.sql b/supabase/migrations/20260905232132_cloudflare_hosting_commitments.sql
new file mode 100644
index 0000000..b72dd94
--- /dev/null
+++ b/supabase/migrations/20260905232132_cloudflare_hosting_commitments.sql
@@ -0,0 +1,163 @@
+-- Conservative hosting obligations share the same platform budget as AI.
+-- Estimates remain held; neither elapsed time nor successful cleanup settles
+-- a supplier invoice. R2 bills rounded GB-months using daily storage peaks.
+create table public.cloudflare_hosting_months (
+ period date primary key check(period=date_trunc('month',period)::date),
+ policy text not null default 'cloudflare-hosting-2026-09-05-v1' check(policy='cloudflare-hosting-2026-09-05-v1'),
+ overhead_allowance_nanos bigint not null default 10000000000 check(overhead_allowance_nanos=10000000000),
+ committed_bytes bigint not null default 0 check(committed_bytes>=0),
+ created_at timestamptz not null default clock_timestamp()
+);
+create table public.cloudflare_storage_objects (
+ environment text not null check(environment in ('preview','production')),
+ workspace_id uuid not null references public.workspaces(id),
+ artifact_id uuid not null references public.artifacts(id),
+ object_version_id uuid not null,
+ sha256 text not null check(sha256 ~ '^[a-f0-9]{64}$'),
+ media_type text not null check(media_type='' or length(media_type)<=100 and media_type ~ '^[a-z]+/[a-z0-9.+-]+$'),
+ byte_size bigint not null check(byte_size between 0 and 104857600),
+ created_at timestamptz not null default clock_timestamp(),
+ retired_at timestamptz check(retired_at>=created_at),
+ primary key(environment,workspace_id,artifact_id,object_version_id,sha256,media_type)
+);
+create index cloudflare_storage_retention on public.cloudflare_storage_objects(created_at,retired_at);
+alter table public.cloudflare_hosting_months enable row level security;
+alter table public.cloudflare_storage_objects enable row level security;
+revoke all on public.cloudflare_hosting_months,public.cloudflare_storage_objects from public,anon,authenticated,service_role;
+
+create function public.live_cloudflare_storage_history() returns trigger language plpgsql set search_path=public,pg_temp as $$
+begin
+ if tg_op='DELETE' then raise exception 'STORAGE_HISTORY_IMMUTABLE';end if;
+ if tg_table_name='cloudflare_hosting_months' then
+  if new.committed_bytes<=old.committed_bytes or (to_jsonb(new)-'committed_bytes') is distinct from (to_jsonb(old)-'committed_bytes') then raise exception 'STORAGE_HISTORY_IMMUTABLE';end if;
+  return new;
+ end if;
+ if old.retired_at is not null or new.retired_at is null or (to_jsonb(new)-'retired_at') is distinct from (to_jsonb(old)-'retired_at') then raise exception 'STORAGE_HISTORY_IMMUTABLE';end if;
+ return new;
+end $$;
+create trigger cloudflare_hosting_history before update or delete on public.cloudflare_hosting_months for each row execute function public.live_cloudflare_storage_history();
+create trigger cloudflare_storage_history before update or delete on public.cloudflare_storage_objects for each row execute function public.live_cloudflare_storage_history();
+
+-- Sum every object that could hold payload during the month, a conservative
+-- upper bound on average daily peak bytes. A retirement preserves this month's
+-- allowance and removes only future payload liability. Permanent R2 markers
+-- retain a 4 KiB metadata allowance. No free-tier capacity is assumed available.
+-- Historical intervals reconstruct missed calendar months even if cron was down.
+create function public.live_cloudflare_hosting_hold(p_period date)
+returns bigint language plpgsql stable security definer set search_path=public,pg_temp as $$
+declare v_bytes numeric;
+begin
+ if p_period is null or p_period<>date_trunc('month',p_period)::date then raise exception 'STORAGE_FUNDING_INVALID';end if;
+ select committed_bytes into v_bytes from cloudflare_hosting_months where period=p_period;
+ if found then return 10000000000+(ceil(v_bytes/1000000000)*15000000)::bigint;end if;
+ if not exists(select 1 from cloudflare_hosting_months where period<=p_period) then return 0;end if;
+ select coalesce(sum(4096+case when retired_at is null or retired_at >= (p_period::timestamp at time zone 'UTC') then byte_size else 0 end),0) into v_bytes
+ from cloudflare_storage_objects where created_at < ((p_period+interval '1 month')::timestamp at time zone 'UTC');
+ -- $10 monthly allowance includes R2 rounding and ingress/Tail/callback
+ -- overhead. It is reserved funding, not a hard provider traffic/cost limit.
+ return 10000000000+(ceil(v_bytes/1000000000)*15000000)::bigint;
+end $$;
+
+create function public.live_begin_cloudflare_hosting()
+returns void language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_period date:=date_trunc('month',now() at time zone 'UTC')::date;v_bytes bigint;
+begin
+ if exists(select 1 from cloudflare_hosting_months where period=v_period) then return;end if;
+ select coalesce(sum(4096+case when retired_at is null or retired_at >= (v_period::timestamp at time zone 'UTC') then byte_size else 0 end),0)::bigint into v_bytes from cloudflare_storage_objects;
+ insert into cloudflare_hosting_months(period,committed_bytes)values(v_period,v_bytes);
+end $$;
+
+create function public.live_track_cloudflare_object(p_environment text,p_workspace_id uuid,p_artifact_id uuid,p_version_id uuid,p_sha256 text,p_media_type text,p_byte_size bigint)
+returns void language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_old cloudflare_storage_objects;
+begin
+ if p_environment is null or p_environment not in ('preview','production') or p_workspace_id is null or p_artifact_id is null or p_version_id is null
+  or p_sha256 is null or p_sha256!~'^[a-f0-9]{64}$' or p_media_type is null or (p_media_type<>'' and (length(p_media_type)>100 or p_media_type!~'^[a-z]+/[a-z0-9.+-]+$'))
+  or p_byte_size is null or p_byte_size not between 0 and 104857600 then raise exception 'STORAGE_FUNDING_INVALID';end if;
+ perform 1 from artifacts where id=p_artifact_id and workspace_id=p_workspace_id;if not found then raise exception 'NOT_FOUND';end if;
+ select * into v_old from cloudflare_storage_objects where environment=p_environment and workspace_id=p_workspace_id and artifact_id=p_artifact_id and object_version_id=p_version_id and sha256=p_sha256 and media_type=p_media_type;
+ if found then
+  if v_old.byte_size<>p_byte_size then raise exception 'STORAGE_INTENT_CONFLICT';end if;
+  if v_old.retired_at is not null then raise exception 'STORAGE_OBJECT_RETIRED';end if;
+  return;
+ end if;
+ insert into cloudflare_storage_objects(environment,workspace_id,artifact_id,object_version_id,sha256,media_type,byte_size)
+ values(p_environment,p_workspace_id,p_artifact_id,p_version_id,p_sha256,p_media_type,p_byte_size);
+ update cloudflare_hosting_months set committed_bytes=committed_bytes+p_byte_size+4096 where period=date_trunc('month',now() at time zone 'UTC')::date;
+ if not found then raise exception 'STORAGE_FUNDING_INVALID';end if;
+end $$;
+
+create or replace function public.live_runtime_available(p_workspace_id uuid,p_source text,p_period date)
+returns bigint language plpgsql security definer set search_path=public,pg_temp as $$
+declare v_funds bigint;v_used bigint;v_legacy bigint;
+begin
+ if p_source is null or p_source not in ('platform','prepaid') or p_period is null or p_workspace_id is null then raise exception 'RUNTIME_FUNDING_INVALID';end if;
+ if p_source='platform' then
+  select 100000000000+coalesce(sum(amount_nanos),0) into v_funds from runtime_funding_events where source='subscription' and period=p_period;
+  select coalesce(sum(reserved_cents::bigint*10000000),0) into v_legacy from ai_budget_months where month=p_period;
+ else
+  select coalesce(sum(amount_nanos),0) into v_funds from runtime_funding_events where source='prepaid' and workspace_id=p_workspace_id;
+  v_legacy:=0;
+ end if;
+ select coalesce(sum(case when status in ('reserved','dispatched','unknown') then charged_maximum_nanos when status='settled' then charged_actual_nanos else 0 end),0)
+ into v_used from runtime_reservations where source=p_source and (p_source='platform' and period=p_period or p_source='prepaid' and workspace_id=p_workspace_id);
+ return v_funds-v_used-v_legacy-case when p_source='platform' then live_cloudflare_hosting_hold(p_period) else 0 end;
+end $$;
+
+
+-- The body length comes from the exact request hashed/signed by the server.
+-- A failed reservation rolls back the object commitment and monthly activation.
+create function public.live_reserve_r2_runtime(p_environment text,p_workspace_id uuid,p_artifact_id uuid,p_version_id uuid,p_sha256 text,p_media_type text,p_byte_size bigint,p_nonce text,p_request_hash text,p_purpose text)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+begin
+ if p_environment is null or p_environment not in ('preview','production') or p_nonce is null or p_nonce!~'^[a-f0-9]{32}$'
+  or p_purpose is null or p_purpose not in ('r2-upload','r2-read') or p_purpose='r2-read' and p_byte_size is not null then raise exception 'STORAGE_FUNDING_INVALID';end if;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ perform live_begin_cloudflare_hosting();
+ if p_purpose='r2-upload' then perform live_track_cloudflare_object(p_environment,p_workspace_id,p_artifact_id,p_version_id,p_sha256,p_media_type,p_byte_size);end if;
+ if live_runtime_available(p_workspace_id,'platform',date_trunc('month',now() at time zone 'UTC')::date)<0 then raise exception 'RUNTIME_BUDGET_EXHAUSTED';end if;
+ return live_reserve_runtime(p_workspace_id,p_artifact_id,null,'r2:'||p_nonce,p_request_hash,'platform',p_purpose,null,'cloudflare-standard-2026-09-05-v1',case when p_purpose='r2-upload' then 610020 else 6520 end);
+end $$;
+
+create function public.live_admit_hosted_upload_transfer(p_environment text,p_upload_id uuid,p_file_index integer,p_generation integer,p_transfer_id uuid,p_request_hash text)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_file artifact_upload_files;
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into strict v_file from live_authorize_upload_file(p_upload_id,p_file_index,p_generation);
+ perform live_begin_cloudflare_hosting();
+ perform live_track_cloudflare_object(p_environment,v_file.workspace_id,v_file.artifact_id,v_file.object_version_id,v_file.sha256,v_file.media_type,v_file.byte_size);
+ return live_admit_funded_upload_transfer(p_upload_id,p_file_index,p_generation,p_transfer_id,p_request_hash);
+end $$;
+
+create function public.live_authorize_hosted_cleanup(p_environment text,p_upload_id uuid,p_claim_id uuid,p_file_index integer,p_invocation_id uuid,p_request_hash text)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_ref jsonb;v_size bigint;
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ v_ref:=live_authorize_upload_cleanup(p_upload_id,p_claim_id,p_file_index);
+ perform live_begin_cloudflare_hosting();
+ select byte_size into strict v_size from artifact_upload_files where upload_id=p_upload_id and file_index=p_file_index;
+ -- A cleanup can create a retirement marker even when upload never reached R2.
+ -- Already-retired cleanup retries keep the marker allowance without reviving payload.
+ if not exists(select 1 from cloudflare_storage_objects where environment=p_environment and workspace_id=(v_ref->>'workspaceId')::uuid and artifact_id=(v_ref->>'artifactId')::uuid and object_version_id=(v_ref->>'versionId')::uuid and sha256=v_ref->>'sha256' and media_type=v_ref->>'mediaType' and retired_at is not null) then
+  perform live_track_cloudflare_object(p_environment,(v_ref->>'workspaceId')::uuid,(v_ref->>'artifactId')::uuid,(v_ref->>'versionId')::uuid,v_ref->>'sha256',v_ref->>'mediaType',v_size);
+ end if;
+ return live_authorize_funded_cleanup(p_upload_id,p_claim_id,p_file_index,p_invocation_id,p_request_hash);
+end $$;
+
+create function public.live_confirm_hosted_retirement(p_environment text,p_upload_id uuid,p_claim_id uuid,p_file_index integer,p_sha256 text)
+returns void language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_file artifact_upload_files;
+begin
+ if p_environment is null or p_environment not in ('preview','production') then raise exception 'STORAGE_FUNDING_INVALID';end if;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ perform live_confirm_upload_retirement(p_upload_id,p_claim_id,p_file_index,p_sha256);
+ select * into strict v_file from artifact_upload_files where upload_id=p_upload_id and file_index=p_file_index;
+ update cloudflare_storage_objects set retired_at=clock_timestamp() where environment=p_environment and workspace_id=v_file.workspace_id and artifact_id=v_file.artifact_id and object_version_id=v_file.object_version_id and sha256=v_file.sha256 and media_type=v_file.media_type and retired_at is null;
+ -- Absence is not a refund or a claim about the other environment's object.
+end $$;
+
+revoke all on function public.live_cloudflare_storage_history(),public.live_cloudflare_hosting_hold(date),public.live_begin_cloudflare_hosting(),public.live_track_cloudflare_object(text,uuid,uuid,uuid,text,text,bigint) from public,anon,authenticated,service_role;
+revoke all on function public.live_reserve_r2_runtime(text,uuid,uuid,uuid,text,text,bigint,text,text,text),public.live_admit_hosted_upload_transfer(text,uuid,integer,integer,uuid,text),public.live_authorize_hosted_cleanup(text,uuid,uuid,integer,uuid,text),public.live_confirm_hosted_retirement(text,uuid,uuid,integer,text) from public,anon,authenticated;
+grant execute on function public.live_reserve_r2_runtime(text,uuid,uuid,uuid,text,text,bigint,text,text,text),public.live_admit_hosted_upload_transfer(text,uuid,integer,integer,uuid,text),public.live_authorize_hosted_cleanup(text,uuid,uuid,integer,uuid,text),public.live_confirm_hosted_retirement(text,uuid,uuid,integer,text) to service_role;
diff --git a/supabase/migrations/20260906005033_core_stored_revisions.sql b/supabase/migrations/20260906005033_core_stored_revisions.sql
new file mode 100644
index 0000000..acdaa0d
--- /dev/null
+++ b/supabase/migrations/20260906005033_core_stored_revisions.sql
@@ -0,0 +1,179 @@
+-- Reviewed stored-source revisions preserve unchanged objects and reserve quota
+-- before writing. Abandoned saves retain obligations until verified retirement.
+create table public.core_revision_saves (
+ task_id uuid primary key references public.operation_model_tasks(id),
+ operation_id uuid not null unique references public.operations(id),
+ workspace_id uuid not null references public.workspaces(id),
+ artifact_id uuid not null references public.artifacts(id),
+ version_id uuid not null unique default gen_random_uuid(),
+ manifest jsonb not null, reserved_bytes bigint not null check(reserved_bytes>=0),
+ completed_at timestamptz,created_at timestamptz not null default clock_timestamp()
+);
+create table public.core_revision_objects (
+ task_id uuid not null references public.core_revision_saves(task_id),
+ path text not null,sha256 text not null check(sha256~'^[a-f0-9]{64}$'),
+ media_type text not null,byte_size bigint not null check(byte_size between 0 and 96000),
+ verified_at timestamptz,primary key(task_id,path)
+);
+alter table public.core_revision_saves enable row level security;
+alter table public.core_revision_objects enable row level security;
+revoke all on public.core_revision_saves,public.core_revision_objects from public,anon,authenticated,service_role;
+create function public.live_core_revision_history()returns trigger language plpgsql set search_path=public,pg_temp as $$
+begin
+ if tg_op='DELETE' then raise exception 'CORE_REVISION_IMMUTABLE';end if;
+ if tg_table_name='core_revision_saves' then
+  if old.completed_at is not null or new.completed_at is null or (to_jsonb(old)-'completed_at') is distinct from (to_jsonb(new)-'completed_at') then raise exception 'CORE_REVISION_IMMUTABLE';end if;
+ else
+  if old.verified_at is not null or new.verified_at is null or (to_jsonb(old)-'verified_at') is distinct from (to_jsonb(new)-'verified_at') then raise exception 'CORE_REVISION_IMMUTABLE';end if;
+ end if;return new;
+end $$;
+create trigger core_revision_save_history before update or delete on public.core_revision_saves for each row execute function public.live_core_revision_history();
+create trigger core_revision_object_history before update or delete on public.core_revision_objects for each row execute function public.live_core_revision_history();
+
+-- Derive the candidate from canonical paid output. Callers cannot substitute a
+-- storage reference, silently remove omitted files, or provide another base.
+create function public.live_core_revision_manifest(p_task_id uuid)returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare t operation_model_tasks;o operations;base jsonb;patch jsonb;f jsonb;old jsonb;files jsonb:='[]';paths text[]:='{}';path text;bytes bigint;changed_bytes bigint:=0;source_paths jsonb;result jsonb;
+begin
+ select * into t from operation_model_tasks where id=p_task_id and role='coder' and completed_at is not null and output_error is null and not discarded;
+ if not found then raise exception 'CORE_OUTPUT_INVALID';end if;
+ select * into o from operations where id=t.operation_id;
+ select manifest into base from artifact_versions where id=o.base_version_id and artifact_id=o.artifact_id and workspace_id=o.workspace_id;
+ patch:=t.output;
+ if base->>'schemaVersion' is distinct from '2' or patch->>'mode' is distinct from 'stored-revision' or patch->>'baseVersionId' is distinct from o.base_version_id::text
+  or jsonb_typeof(patch->'changes') is distinct from 'array' or jsonb_typeof(patch->'deletions') is distinct from 'array' or jsonb_array_length(patch->'changes')>30 or jsonb_array_length(patch->'deletions')>30
+  or (patch-array['mode','baseVersionId','title','description','entrypoint','blocks','brand','changes','deletions'])<>'{}'::jsonb
+  or jsonb_typeof(patch->'title') is distinct from 'string' or length(patch->>'title') not between 1 and 120
+  or jsonb_typeof(patch->'description') is distinct from 'string' or length(patch->>'description')>500
+  or jsonb_typeof(patch->'entrypoint') is distinct from 'string' or length(patch->>'entrypoint') not between 1 and 200
+  or jsonb_typeof(patch->'blocks') is distinct from 'array' or jsonb_array_length(patch->'blocks')>100 or octet_length((patch->'blocks')::text)>524288 then raise exception 'CORE_OUTPUT_INVALID';end if;
+ select output->'sourcePaths' into source_paths from operation_model_tasks where operation_id=o.id and ordinal=0 and completed_at is not null and output_error is null and not discarded order by attempt desc limit 1;
+ if jsonb_typeof(source_paths) is distinct from 'array' or jsonb_array_length(source_paths)>12 or exists(select 1 from jsonb_array_elements(source_paths) x where jsonb_typeof(x)<>'string') then raise exception 'CORE_OUTPUT_INVALID';end if;
+ for f in select value from jsonb_array_elements(patch->'changes') loop
+  path:=f->>'path';
+  if jsonb_typeof(f) is distinct from 'object' or jsonb_typeof(f->'path') is distinct from 'string' or coalesce(length(path),0) not between 1 and 200
+   or path like '/%' or path like '%/' or position('//' in path)>0 or path~'(^|/)[.]' or path~'[[:cntrl:]?#%:]' or position(chr(92) in path)>0 or lower(path)='__live' or left(lower(path),7)='__live/'
+   or lower(normalize(path,NFC))=any(paths) or jsonb_typeof(f->'content') is distinct from 'string'
+   or jsonb_typeof(f->'mediaType') is distinct from 'string' or not f?'previousSha256'
+   or (f-array['path','mediaType','content','previousSha256'])<>'{}'::jsonb then raise exception 'CORE_OUTPUT_INVALID';end if;
+  if not ((lower(path)~'[.](html|htm)$' and f->>'mediaType'='text/html') or (lower(path)~'[.]css$' and f->>'mediaType'='text/css') or (lower(path)~'[.](js|mjs)$' and f->>'mediaType' in ('text/javascript','application/javascript')) or (lower(path)~'[.]json$' and f->>'mediaType'='application/json') or (lower(path)~'[.]svg$' and f->>'mediaType'='image/svg+xml') or (lower(path)~'[.]md$' and f->>'mediaType' in ('text/plain','text/markdown')) or (lower(path)~'[.]txt$' and f->>'mediaType'='text/plain') or (lower(path)~'[.]csv$' and f->>'mediaType' in ('text/plain','text/csv'))) then raise exception 'CORE_OUTPUT_INVALID';end if;
+  select value into old from jsonb_array_elements(base->'files') where value->>'path'=path;
+  if old is not null and (f->>'previousSha256' is distinct from old->>'sha256' or not source_paths?path) or old is null and f->'previousSha256' is distinct from 'null'::jsonb then raise exception 'CORE_OUTPUT_INVALID';end if;
+  bytes:=octet_length(convert_to(f->>'content','UTF8'));changed_bytes:=changed_bytes+bytes;
+  if changed_bytes>96000 then raise exception 'AI_INPUT_TOO_LARGE';end if;
+  if f->>'mediaType'='application/json' then perform (f->>'content')::jsonb;end if;
+  if f->>'mediaType'='image/svg+xml' and f->>'content'!~*'<svg([[:space:]]|>)' then raise exception 'CORE_OUTPUT_INVALID';end if;
+  paths:=array_append(paths,lower(normalize(path,NFC)));
+  files:=files||jsonb_build_array(jsonb_build_object('path',path,'mediaType',f->>'mediaType','size',bytes,'sha256',encode(sha256(convert_to(f->>'content','UTF8')),'hex'),'encoding','r2','content','','storage',jsonb_build_object('versionId',t.id)));
+ end loop;
+ for f in select value from jsonb_array_elements(patch->'deletions') loop
+  path:=f->>'path';select value into old from jsonb_array_elements(base->'files') where value->>'path'=path;
+  if old is null or f->>'previousSha256' is distinct from old->>'sha256' or lower(normalize(path,NFC))=any(paths) or (f-array['path','previousSha256'])<>'{}'::jsonb then raise exception 'CORE_OUTPUT_INVALID';end if;
+  paths:=array_append(paths,lower(normalize(path,NFC)));
+ end loop;
+ -- Preserve original ordering for untouched files. Case/Unicode aliases cannot
+ -- replace a different original file under a new spelling.
+ for f in select value from jsonb_array_elements(base->'files') loop
+  if not exists(select 1 from jsonb_array_elements(patch->'changes') x where x->>'path'=f->>'path') and not exists(select 1 from jsonb_array_elements(patch->'deletions') x where x->>'path'=f->>'path') then
+   if lower(normalize(f->>'path',NFC))=any(paths) then raise exception 'CORE_OUTPUT_INVALID';end if;
+  end if;
+ end loop;
+ select coalesce(jsonb_agg(b.file order by b.ordinal),'[]'::jsonb)||files into files from jsonb_array_elements(base->'files') with ordinality b(file,ordinal) where not exists(select 1 from jsonb_array_elements(patch->'changes') x where x->>'path'=b.file->>'path') and not exists(select 1 from jsonb_array_elements(patch->'deletions') x where x->>'path'=b.file->>'path');
+ result:=(patch-array['mode','baseVersionId','changes','deletions'])||jsonb_build_object('schemaVersion',2,'kind',o.kind,'files',files);
+ if o.kind='app' and not exists(select 1 from jsonb_array_elements(files) x where x->>'path'=result->>'entrypoint' and x->>'mediaType'='text/html') or o.kind='document' and jsonb_array_length(result->'blocks')=0 then raise exception 'CORE_OUTPUT_INVALID';end if;
+ if octet_length(result::text)>1048576 then raise exception 'MANIFEST_TOO_LARGE';end if;return result;
+end $$;
+
+create function public.live_assert_core_revision(p_operation_id uuid,p_runner_id text,p_task_id uuid)returns public.operations language plpgsql security definer set search_path=public,pg_temp as $$
+declare o operations;
+begin
+ select * into o from operations where id=p_operation_id and engine='astra-v1' for update;
+ if not found or o.runner_id is distinct from p_runner_id then raise exception 'CORE_RUNNER_DENIED';end if;
+ if o.status<>'running' or not live_core_grant_active(o.id) then raise exception 'CORE_GRANT_REVOKED';end if;
+ perform 1 from workspaces where id=o.workspace_id for update;
+ perform 1 from artifacts where id=o.artifact_id and workspace_id=o.workspace_id and deleted_at is null and latest_version_id is not distinct from o.base_version_id for update;
+ if not found then raise exception 'VERSION_CONFLICT';end if;
+ if not exists(select 1 from operation_model_tasks where id=p_task_id and operation_id=o.id and role='coder' and completed_at is not null and output_error is null and not discarded) then raise exception 'CORE_OUTPUT_INVALID';end if;
+ if not exists(select 1 from operation_model_tasks where operation_id=o.id and candidate_task_id=p_task_id and role='reviewer' and completed_at is not null and output_error is null and not discarded and output->'passed'='true'::jsonb and output->>'reviewedTaskId'=p_task_id::text) then raise exception 'CORE_REVIEW_REQUIRED';end if;
+ return o;
+end $$;
+create function public.live_prepare_core_revision(p_operation_id uuid,p_runner_id text,p_task_id uuid)returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare o operations;s core_revision_saves;manifest jsonb;limits record;bytes bigint;f jsonb;
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into o from operations where id=p_operation_id and runner_id=p_runner_id and engine='astra-v1';
+ if not found then raise exception 'CORE_RUNNER_DENIED';end if;
+ select * into s from core_revision_saves where task_id=p_task_id and operation_id=o.id;
+ if found and s.completed_at is not null and o.status='succeeded' and o.version_id=s.version_id then return to_jsonb(s)||jsonb_build_object('objects',coalesce((select jsonb_agg(to_jsonb(obj) order by obj.path) from core_revision_objects obj where obj.task_id=s.task_id),'[]'::jsonb));end if;
+ o:=live_assert_core_revision(p_operation_id,p_runner_id,p_task_id);
+ if s.task_id is not null then return to_jsonb(s)||jsonb_build_object('objects',coalesce((select jsonb_agg(to_jsonb(obj) order by obj.path) from core_revision_objects obj where obj.task_id=s.task_id),'[]'::jsonb));end if;
+ manifest:=live_core_revision_manifest(p_task_id);
+ select l.* into limits from workspaces w cross join lateral live_storage_limits(w.plan_code) l where w.id=o.workspace_id;
+ select coalesce(sum((value->>'size')::bigint),0) into bytes from jsonb_array_elements(manifest->'files');
+ if bytes>limits.version_bytes or jsonb_array_length(manifest->'files')>limits.file_count or exists(select 1 from jsonb_array_elements(manifest->'files') x where (x->>'size')::bigint>limits.file_bytes) then raise exception 'VERSION_TOO_LARGE';end if;
+ if(select count(*) from artifact_versions where artifact_id=o.artifact_id)>=100 then raise exception 'VERSION_LIMIT';end if;
+ bytes:=bytes+octet_length(manifest::text);
+ update workspaces set upload_reserved_bytes=upload_reserved_bytes+bytes where id=o.workspace_id;
+ insert into core_revision_saves(task_id,operation_id,workspace_id,artifact_id,manifest,reserved_bytes) values(p_task_id,o.id,o.workspace_id,o.artifact_id,manifest,bytes) returning * into s;
+ for f in select value from jsonb_array_elements(manifest->'files') where value->'storage'->>'versionId'=p_task_id::text loop
+  insert into core_revision_objects(task_id,path,sha256,media_type,byte_size) values(p_task_id,f->>'path',f->>'sha256',f->>'mediaType',(f->>'size')::bigint);
+ end loop;
+ update operations set phase='saving',updated_at=clock_timestamp() where id=o.id;return to_jsonb(s)||jsonb_build_object('objects',coalesce((select jsonb_agg(to_jsonb(obj) order by obj.path) from core_revision_objects obj where obj.task_id=s.task_id),'[]'::jsonb));
+end $$;
+create function public.live_confirm_core_revision_object(p_operation_id uuid,p_runner_id text,p_task_id uuid,p_path text,p_sha256 text,p_byte_size bigint)returns boolean language plpgsql security definer set search_path=public,pg_temp as $$
+declare o operations;f core_revision_objects;
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));o:=live_assert_core_revision(p_operation_id,p_runner_id,p_task_id);
+ select * into f from core_revision_objects where task_id=p_task_id and path=p_path and sha256=p_sha256 and byte_size=p_byte_size for update;
+ if not found then raise exception 'CORE_OBJECT_INVALID';end if;
+ if f.verified_at is null then update core_revision_objects set verified_at=clock_timestamp() where task_id=p_task_id and path=p_path;end if;return true;
+end $$;
+create function public.live_complete_core_revision(p_operation_id uuid,p_runner_id text,p_task_id uuid)returns uuid language plpgsql security definer set search_path=public,pg_temp as $$
+declare o operations;s core_revision_saves;n integer;
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into o from operations where id=p_operation_id and runner_id=p_runner_id and engine='astra-v1';if not found then raise exception 'CORE_RUNNER_DENIED';end if;
+ select * into s from core_revision_saves where task_id=p_task_id and operation_id=o.id;
+ if not found then raise exception 'CORE_SAVE_REQUIRED';end if;
+ if s.completed_at is not null and o.status='succeeded' and o.version_id=s.version_id then return s.version_id;end if;
+ o:=live_assert_core_revision(p_operation_id,p_runner_id,p_task_id);
+ if exists(select 1 from core_revision_objects where task_id=p_task_id and verified_at is null) then raise exception 'CORE_OBJECT_UNVERIFIED';end if;
+ select coalesce(max(number),0)+1 into n from artifact_versions where artifact_id=o.artifact_id;if n>100 then raise exception 'VERSION_LIMIT';end if;
+ insert into artifact_versions(id,workspace_id,artifact_id,number,manifest,content_hash,idempotency_key) values(s.version_id,o.workspace_id,o.artifact_id,n,s.manifest,encode(sha256(convert_to(s.manifest::text,'UTF8')),'hex'),'ai-'||o.id::text);
+ update workspaces set storage_bytes=storage_bytes+s.reserved_bytes,upload_reserved_bytes=upload_reserved_bytes-s.reserved_bytes where id=o.workspace_id;
+ update artifacts set latest_version_id=s.version_id,updated_at=clock_timestamp() where id=o.artifact_id;
+ update core_revision_saves set completed_at=clock_timestamp() where task_id=p_task_id;
+ update operations set status='succeeded',version_id=s.version_id,error=null,pause_reason=null,updated_at=clock_timestamp() where id=o.id;
+ update operation_grants set revoked_at=clock_timestamp() where operation_id=o.id and revoked_at is null;
+ insert into audit_events(workspace_id,actor_id,action,target_id,trace_id,metadata) values(o.workspace_id,o.actor_id,'version.created',s.version_id,o.id::text,jsonb_build_object('artifactId',o.artifact_id,'taskId',p_task_id,'number',n,'sourcePreserved',true));return s.version_id;
+end $$;
+create function public.live_core_source_active(p_operation_id uuid,p_runner_id text,p_base_version_id uuid)returns boolean language plpgsql security definer set search_path=public,pg_temp as $$
+declare o operations;
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into o from operations where id=p_operation_id and engine='astra-v1' and runner_id=p_runner_id for update;
+ if not found or o.status<>'running' or o.base_version_id is distinct from p_base_version_id or not live_core_grant_active(o.id) then return false;end if;
+ perform 1 from workspaces where id=o.workspace_id for update;
+ perform 1 from artifacts where id=o.artifact_id and workspace_id=o.workspace_id and latest_version_id is not distinct from p_base_version_id and deleted_at is null for update;
+ return found;
+end $$;
+-- Paid storage dispatch is fenced by the same finite grant as model dispatch.
+create function public.live_dispatch_core_storage(p_operation_id uuid,p_runner_id text,p_reservation_id uuid,p_request_hash text,p_object_version_id uuid,p_sha256 text,p_media_type text,p_purpose text)returns boolean language plpgsql security definer set search_path=public,pg_temp as $$
+declare o operations;r runtime_reservations;base jsonb;
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into o from operations where id=p_operation_id and engine='astra-v1' and runner_id=p_runner_id for update;
+ if not found or o.status<>'running' or not live_core_grant_active(o.id) then return false;end if;
+ if not live_core_source_active(o.id,p_runner_id,o.base_version_id) then return false;end if;
+ select * into r from runtime_reservations where id=p_reservation_id and workspace_id=o.workspace_id and artifact_id=o.artifact_id and request_hash=p_request_hash and purpose=p_purpose for update;
+ if not found then return false;end if;
+ if p_purpose='r2-read' then
+  select manifest into base from artifact_versions where id=o.base_version_id and workspace_id=o.workspace_id and artifact_id=o.artifact_id;
+  if not exists(select 1 from jsonb_array_elements(base->'files') f where f->'storage'->>'versionId'=p_object_version_id::text and f->>'sha256'=p_sha256 and f->>'mediaType'=p_media_type) then return false;end if;
+ elsif p_purpose='r2-upload' then
+  if not exists(select 1 from core_revision_saves s join core_revision_objects f on f.task_id=s.task_id where s.operation_id=o.id and s.completed_at is null and s.task_id=p_object_version_id and f.sha256=p_sha256 and f.media_type=p_media_type) then return false;end if;
+ else return false;end if;
+ return live_dispatch_runtime(r.id,o.workspace_id,p_request_hash);
+end $$;
+revoke all on function public.live_core_source_active(uuid,text,uuid),public.live_core_revision_history(),public.live_core_revision_manifest(uuid),public.live_assert_core_revision(uuid,text,uuid),public.live_prepare_core_revision(uuid,text,uuid),public.live_confirm_core_revision_object(uuid,text,uuid,text,text,bigint),public.live_complete_core_revision(uuid,text,uuid),public.live_dispatch_core_storage(uuid,text,uuid,text,uuid,text,text,text) from public,anon,authenticated,service_role;
+grant execute on function public.live_core_source_active(uuid,text,uuid),public.live_prepare_core_revision(uuid,text,uuid),public.live_confirm_core_revision_object(uuid,text,uuid,text,text,bigint),public.live_complete_core_revision(uuid,text,uuid),public.live_dispatch_core_storage(uuid,text,uuid,text,uuid,text,text,text) to service_role;
diff --git a/supabase/migrations/20260906015831_storage_inventory.sql b/supabase/migrations/20260906015831_storage_inventory.sql
new file mode 100644
index 0000000..68e0856
--- /dev/null
+++ b/supabase/migrations/20260906015831_storage_inventory.sql
@@ -0,0 +1,57 @@
+-- Read-only canonical commitment inventory. This is neither an R2 key listing
+-- nor deletion authority. A later cleanup must recheck references atomically.
+create function public.live_storage_inventory(p_workspace_id uuid,p_environment text,p_after jsonb default null,p_limit integer default 25)
+returns jsonb language plpgsql stable security definer set search_path=public,pg_temp as $$
+declare result jsonb;cursor_artifact uuid;cursor_version uuid;cursor_hash text;cursor_type text;
+begin
+ if p_workspace_id is null or p_environment is null or p_environment not in ('preview','production') or p_limit is null or p_limit not between 1 and 100 then raise exception 'STORAGE_INVENTORY_INVALID';end if;
+ if p_after is not null then
+  if jsonb_typeof(p_after) is distinct from 'object' or (p_after-array['workspaceId','environment','artifactId','versionId','sha256','mediaType'])<>'{}'::jsonb
+   or p_after->>'workspaceId' is distinct from p_workspace_id::text or p_after->>'environment' is distinct from p_environment
+   or coalesce(p_after->>'artifactId','')!~'^[a-f0-9]{8}-([a-f0-9]{4}-){3}[a-f0-9]{12}$' or coalesce(p_after->>'versionId','')!~'^[a-f0-9]{8}-([a-f0-9]{4}-){3}[a-f0-9]{12}$'
+   or coalesce(p_after->>'sha256','')!~'^[a-f0-9]{64}$' or jsonb_typeof(p_after->'mediaType') is distinct from 'string'
+   or length(p_after->>'mediaType')>100 or (p_after->>'mediaType'<>'' and p_after->>'mediaType'!~'^[a-z]+/[a-z0-9.+-]+$') then raise exception 'STORAGE_INVENTORY_INVALID';end if;
+  cursor_artifact:=(p_after->>'artifactId')::uuid;cursor_version:=(p_after->>'versionId')::uuid;cursor_hash:=p_after->>'sha256';cursor_type:=p_after->>'mediaType';
+ end if;
+ if not exists(select 1 from public.workspaces where id=p_workspace_id) then raise exception 'STORAGE_INVENTORY_SCOPE_UNKNOWN';end if;
+ with candidates as materialized (
+  select s.* from public.cloudflare_storage_objects s
+  where s.workspace_id=p_workspace_id and s.environment=p_environment
+   and (p_after is null or (s.artifact_id,s.object_version_id,s.sha256,s.media_type)>(cursor_artifact,cursor_version,cursor_hash,cursor_type))
+  order by s.artifact_id,s.object_version_id,s.sha256,s.media_type limit p_limit+1
+ ), page as materialized (
+  select * from candidates order by artifact_id,object_version_id,sha256,media_type limit p_limit
+ ), saved_files as materialized (
+  -- Expand each relevant manifest once per page, instead of reparsing every
+  -- saved manifest separately for every object that shares an artifact.
+  select v.artifact_id,v.id version_id,f.value->>'sha256' sha256,f.value->>'mediaType' media_type,f.value->'storage'->>'versionId' object_version
+  from (select distinct artifact_id from page) a join public.artifact_versions v on v.artifact_id=a.artifact_id and v.workspace_id=p_workspace_id
+  cross join lateral jsonb_array_elements(v.manifest->'files') f
+  where v.manifest->>'schemaVersion'='2' and f.value->>'encoding'='r2'
+ ), saved_refs as materialized (
+  -- Aggregate once before joining objects. Underestimated statistics must not
+  -- cause a nested loop to recompute a spilled aggregate for every page row.
+  select artifact_id,object_version,sha256,media_type,count(distinct version_id) saved_references
+  from saved_files group by artifact_id,object_version,sha256,media_type
+ ), refs as (
+  select s.*,a.deleted_at artifact_deleted_at,a.id is not null artifact_scope_valid,coalesce(r.saved_references,0) saved_references,
+   (select count(*) from public.artifact_upload_files f join public.artifact_uploads u on u.id=f.upload_id where f.workspace_id=s.workspace_id and f.artifact_id=s.artifact_id and f.object_version_id=s.object_version_id and f.sha256=s.sha256 and f.media_type=s.media_type and u.status='uploading') unfinished_upload_references,
+   (select count(*) from public.core_revision_objects f join public.core_revision_saves r on r.task_id=f.task_id where r.workspace_id=s.workspace_id and r.artifact_id=s.artifact_id and f.task_id=s.object_version_id and f.sha256=s.sha256 and f.media_type=s.media_type and r.completed_at is null) unfinished_revision_references
+  from page s left join saved_refs r on r.artifact_id=s.artifact_id and r.object_version=s.object_version_id::text and r.sha256=s.sha256 and r.media_type=s.media_type
+  left join public.artifacts a on a.id=s.artifact_id and a.workspace_id=s.workspace_id
+ ), rows as (
+  select artifact_id,object_version_id,sha256,media_type,jsonb_build_object(
+   'reference',jsonb_build_object('workspaceId',workspace_id,'artifactId',artifact_id,'versionId',object_version_id,'sha256',sha256,'mediaType',media_type),
+   'committedBytes',byte_size,'createdAt',created_at,'retiredAt',retired_at,'artifactDeletedAt',artifact_deleted_at,
+   'savedVersionReferences',saved_references,'unfinishedUploadReferences',unfinished_upload_references,'unfinishedRevisionReferences',unfinished_revision_references,
+   'classification',case when not artifact_scope_valid then 'scope-conflict' when retired_at is not null then 'retired-marker' when artifact_deleted_at is not null then 'removed-artifact' when saved_references>0 then 'saved-version' when unfinished_upload_references>0 then 'unfinished-upload' when unfinished_revision_references>0 then 'unfinished-revision' else 'unreferenced-commitment' end,
+   'referenceConflict',not artifact_scope_valid or retired_at is not null and (saved_references>0 and artifact_deleted_at is null or unfinished_upload_references>0 or unfinished_revision_references>0)
+  ) value from refs
+ )
+ select jsonb_build_object('workspaceId',p_workspace_id,'environment',p_environment,'observedAt',statement_timestamp(),'coverage','tracked-commitments-only','providerState','unverified','deletionAuthorized',false,
+  'objects',coalesce((select jsonb_agg(value order by artifact_id,object_version_id,sha256,media_type) from rows),'[]'::jsonb),
+  'nextCursor',case when (select count(*) from candidates)>p_limit then (select jsonb_build_object('workspaceId',p_workspace_id,'environment',p_environment,'artifactId',artifact_id,'versionId',object_version_id,'sha256',sha256,'mediaType',media_type) from page order by artifact_id desc,object_version_id desc,sha256 desc,media_type desc limit 1) else null end) into result;
+ return result;
+end $$;
+revoke all on function public.live_storage_inventory(uuid,text,jsonb,integer) from public,anon,authenticated;
+grant execute on function public.live_storage_inventory(uuid,text,jsonb,integer) to service_role;
diff --git a/supabase/migrations/20260906023208_physical_storage_audit.sql b/supabase/migrations/20260906023208_physical_storage_audit.sql
new file mode 100644
index 0000000..30d8b74
--- /dev/null
+++ b/supabase/migrations/20260906023208_physical_storage_audit.sql
@@ -0,0 +1,212 @@
+-- Bounded service-only physical metadata inspection. No deletion or cost settlement.
+create table public.storage_audit_grants (
+ id uuid primary key default gen_random_uuid(),workspace_id uuid not null references public.workspaces(id),
+ idempotency_key text not null,scope jsonb not null,maximum_requests integer not null check(maximum_requests between 1 and 100),
+ requests_used integer not null default 0 check(requests_used between 0 and maximum_requests),ttl_seconds integer not null check(ttl_seconds between 120 and 900),
+ created_at timestamptz not null default now(),expires_at timestamptz not null,revoked_at timestamptz,
+ unique(workspace_id,idempotency_key)
+);
+create table public.storage_audit_invocations (
+ grant_id uuid not null references public.storage_audit_grants(id),nonce text not null check(nonce ~ '^[a-f0-9]{32}$'),
+ reservation_id uuid not null unique references public.runtime_reservations(id),request_hash text not null check(request_hash ~ '^[a-f0-9]{64}$'),
+ request_body text not null check(octet_length(request_body)<=8192),created_at timestamptz not null default now(),primary key(grant_id,nonce)
+);
+alter table public.storage_audit_grants enable row level security;
+alter table public.storage_audit_invocations enable row level security;
+revoke all on public.storage_audit_grants,public.storage_audit_invocations from public,anon,authenticated,service_role;
+
+create function public.live_storage_audit_guard() returns trigger language plpgsql set search_path=public,pg_temp as $$
+begin
+ if tg_op='DELETE' or tg_table_name='storage_audit_invocations' then raise exception 'STORAGE_AUDIT_IMMUTABLE';end if;
+ if (to_jsonb(new)-array['requests_used','revoked_at'])<>(to_jsonb(old)-array['requests_used','revoked_at'])
+  or new.requests_used not in (old.requests_used,old.requests_used+1) or old.revoked_at is not null and new is distinct from old
+  or new.requests_used<>old.requests_used and new.revoked_at is distinct from old.revoked_at then raise exception 'STORAGE_AUDIT_IMMUTABLE';end if;
+ return new;
+end $$;
+create trigger storage_audit_grant_guard before update or delete on public.storage_audit_grants for each row execute function public.live_storage_audit_guard();
+create trigger storage_audit_invocation_guard before update or delete on public.storage_audit_invocations for each row execute function public.live_storage_audit_guard();
+
+create function public.live_create_storage_audit(p_scope jsonb,p_key text,p_maximum_requests integer default 25,p_ttl_seconds integer default 600)
+returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare v_workspace uuid;v_grant storage_audit_grants;v_key text;
+begin
+ if p_scope is null or jsonb_typeof(p_scope) is distinct from 'object' or octet_length(p_scope::text)>1024
+  or not(p_scope?&array['environment','bucket','origin','audience','billingWorkspaceId','workspaceId']) or p_scope-array['environment','bucket','origin','audience','billingWorkspaceId','workspaceId']<>'{}'::jsonb
+  or p_key is null or p_key!~'^[a-zA-Z0-9:_-]{8,160}$' or p_maximum_requests is null or p_maximum_requests not between 1 and 100 or p_ttl_seconds is null or p_ttl_seconds not between 120 and 900 then raise exception 'STORAGE_AUDIT_INVALID';end if;
+ foreach v_key in array array['environment','bucket','origin','audience','billingWorkspaceId'] loop
+  if jsonb_typeof(p_scope->v_key) is distinct from 'string' then raise exception 'STORAGE_AUDIT_INVALID';end if;
+ end loop;
+ if p_scope->>'environment' not in ('preview','production') or p_scope->>'bucket'<>'live-link-artifacts-'||(p_scope->>'environment') or p_scope->>'audience'<>'live-link-r2-'||(p_scope->>'environment')
+  or p_scope->>'origin'!~'^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?$' or p_scope->>'origin'='https://unconfigured.invalid'
+  or p_scope->>'billingWorkspaceId'!~'^[a-f0-9]{8}-([a-f0-9]{4}-){3}[a-f0-9]{12}$'
+  or p_scope->'workspaceId'<>'null'::jsonb and p_scope->'workspaceId'<>p_scope->'billingWorkspaceId' then raise exception 'STORAGE_AUDIT_INVALID';end if;
+ v_workspace:=(p_scope->>'billingWorkspaceId')::uuid;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ perform 1 from workspaces where id=v_workspace for update;if not found then raise exception 'NOT_FOUND';end if;
+ select * into v_grant from storage_audit_grants where workspace_id=v_workspace and idempotency_key=p_key;
+ if found then
+  if v_grant.scope<>p_scope or v_grant.maximum_requests<>p_maximum_requests or v_grant.ttl_seconds<>p_ttl_seconds then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+ else
+  insert into storage_audit_grants(workspace_id,idempotency_key,scope,maximum_requests,ttl_seconds,expires_at)values(v_workspace,p_key,p_scope,p_maximum_requests,p_ttl_seconds,now()+make_interval(secs=>p_ttl_seconds))returning * into v_grant;
+  insert into audit_events(workspace_id,action,target_id,trace_id,metadata)values(v_workspace,'storage.audit-created',v_grant.id,p_key,jsonb_build_object('scope',p_scope,'maximumRequests',p_maximum_requests,'deletionAuthorized',false));
+ end if;
+ return jsonb_build_object('id',v_grant.id,'scope',v_grant.scope,'expiresAt',v_grant.expires_at,'maximumRequests',v_grant.maximum_requests,'maximumCostNanos',(v_grant.maximum_requests::bigint*20200)::text,'deletionAuthorized',false);
+end $$;
