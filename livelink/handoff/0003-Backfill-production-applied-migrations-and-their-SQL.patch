+create function public.live_project_storage_batch(p_removal_id uuid,p_environment text,p_claim_id uuid)
+returns jsonb language sql stable set search_path=public,pg_temp as $$
+ select jsonb_build_object('removalId',c.removal_id,'environment',c.environment,'claimId',c.claim_id,'leaseUntil',c.lease_until,
+ 'objects',coalesce((select jsonb_agg(jsonb_build_object('objectId',o.id,'reference',live_project_storage_reference(o.id))order by o.id)
+   from(select id from project_storage_purge_objects where removal_id=c.removal_id and environment=c.environment and retired_at is null order by id limit 20)o),'[]'))
+ from project_storage_purges c where c.removal_id=p_removal_id and c.environment=p_environment and c.claim_id=p_claim_id and c.lease_until>clock_timestamp()
