+  perform live_lock_project_storage_authority(c.removal_id);return live_project_storage_batch(c.removal_id,c.environment,p_claim_id);
+ end if;
+ if exists(select 1 from project_storage_purges where lease_until>clock_timestamp())
+  or exists(select 1 from artifact_upload_cleanup where lease_until>clock_timestamp()and completed_at is null)then return null;end if;
+ select r0.id into selected from artifact_removals r0 join artifacts a on a.id=r0.artifact_id and a.workspace_id=r0.workspace_id
+  left join project_storage_purges c0 on c0.removal_id=r0.id and c0.environment=p_environment
