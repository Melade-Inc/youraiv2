+ if a.access_epoch<>r.access_epoch or a.deleted_at is distinct from r.removed_at then raise exception 'PROJECT_CHANGED';end if;
+ v_time:=clock_timestamp();if r.recoverable_until<=v_time then raise exception 'RECOVERY_EXPIRED';end if;
