+create function public.live_project_proof_active(p_actor_id uuid,p_workspace_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid,p_scope text)
+returns boolean language plpgsql volatile security definer set search_path=public,pg_temp as $$
+begin
+ if p_scope is null or p_scope not in ('artifact:read','artifact:write','artifact:publish') or (p_auth_session_id is null)=(p_agent_credential_id is null) then return false;end if;
+ if not exists(select 1 from workspaces where id=p_workspace_id and owner_id=p_actor_id) then return false;end if;
+ if p_auth_session_id is not null then return live_access_proof_active(p_actor_id,p_auth_session_id,null,p_workspace_id);end if;
