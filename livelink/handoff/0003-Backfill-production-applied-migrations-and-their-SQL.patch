+create function public.live_check_content_purge_item(p_removal uuid,p_kind text,p_source uuid)
+returns text language plpgsql set search_path=public,pg_temp as $$
+declare c project_content_purges;v artifact_versions;u artifact_uploads;s core_revision_saves;f artifact_upload_files;
+ state text;stored bigint:=0;reserved bigint:=0;expected bigint;upload_count integer;revision_count integer;
+begin
+ select * into c from project_content_purges where removal_id=p_removal and phase='checking';if not found then raise exception 'CONTENT_PURGE_DENIED';end if;
+ if exists(select 1 from project_content_purge_items where removal_id=p_removal and kind=p_kind and source_id=p_source)then return null;end if;
+ if p_kind='version'then
+  select * into v from artifact_versions where id=p_source and artifact_id=c.artifact_id and workspace_id=c.workspace_id;
+  if not found or v.content_purged_at is not null then return 'accounting-mismatch';end if;
+  state:=live_purge_manifest_state(c.workspace_id,c.artifact_id,v.manifest);if state is not null then return state;end if;
+  select count(*)into upload_count from artifact_uploads where version_id=v.id;
+  select count(*)into revision_count from core_revision_saves where version_id=v.id;
+  if upload_count+revision_count>1 then return 'accounting-mismatch';end if;
+  expected:=octet_length(v.manifest::text);
+  if v.manifest->>'schemaVersion'='2'then select expected+coalesce(sum((value->>'size')::bigint),0)into expected from jsonb_array_elements(v.manifest->'files');end if;
+  if upload_count=1 then
+   select * into u from artifact_uploads where version_id=v.id;
+   if u.artifact_id<>c.artifact_id or u.workspace_id<>c.workspace_id or u.status<>'finalized'or u.manifest<>v.manifest or u.reserved_bytes<>expected then return 'accounting-mismatch';end if;
+  elsif revision_count=1 then
+   select * into s from core_revision_saves where version_id=v.id;
+   if s.artifact_id<>c.artifact_id or s.workspace_id<>c.workspace_id or s.completed_at is null or s.manifest<>v.manifest or s.reserved_bytes<>expected then return 'accounting-mismatch';end if;
+  elsif v.manifest->>'schemaVersion'<>'1'then return 'accounting-mismatch';
+  end if;stored:=expected;
+ elsif p_kind='upload'then
+  select * into u from artifact_uploads where id=p_source and artifact_id=c.artifact_id and workspace_id=c.workspace_id;
+  if not found or u.content_purged_at is not null or u.status='uploading'then return 'accounting-mismatch';end if;
+  for f in select *from artifact_upload_files where upload_id=u.id loop
+   state:=live_purge_reference_state(c.workspace_id,c.artifact_id,f.object_version_id,f.sha256,f.media_type,f.byte_size);
+   if state='reconciliation-required'and f.verified_at is null and f.object_version_id=u.version_id
+    and not exists(select 1 from cloudflare_storage_objects where workspace_id=c.workspace_id and artifact_id=c.artifact_id and object_version_id=f.object_version_id and sha256=f.sha256 and media_type=f.media_type)
+    and not exists(select 1 from artifact_upload_transfers t join artifact_upload_files d on d.upload_id=t.upload_id and d.file_index=t.file_index where d.workspace_id=c.workspace_id and d.artifact_id=c.artifact_id and d.object_version_id=f.object_version_id and d.sha256=f.sha256 and d.media_type=f.media_type)then
+    -- Both funded and legacy upload Workers recorded admission before PUT.
+    -- Check every descriptor sharing this key, not just this file index.
+    state:=null;
+   end if;
+   if state is not null then return state;end if;
+  end loop;
+  if u.status='finalized'then
+   if not exists(select 1 from artifact_versions where id=u.version_id and artifact_id=c.artifact_id and workspace_id=c.workspace_id)then return 'accounting-mismatch';end if;
+  elsif not exists(select 1 from artifact_upload_cleanup where upload_id=u.id and completed_at is not null)then reserved:=u.reserved_bytes;end if;
+ elsif p_kind='revision'then
+  select * into s from core_revision_saves where task_id=p_source and artifact_id=c.artifact_id and workspace_id=c.workspace_id;
+  if not found or s.content_purged_at is not null then return 'accounting-mismatch';end if;
+  state:=live_purge_manifest_state(c.workspace_id,c.artifact_id,s.manifest,case when s.completed_at is null then s.task_id else null end);if state is not null then return state;end if;
+  if s.completed_at is null then reserved:=s.reserved_bytes;
+  elsif not exists(select 1 from artifact_versions where id=s.version_id and artifact_id=c.artifact_id and workspace_id=c.workspace_id)then return 'accounting-mismatch';end if;
+ else raise exception 'CONTENT_PURGE_DENIED';end if;
+ insert into project_content_purge_items(removal_id,kind,source_id,stored_bytes,reserved_bytes)values(p_removal,p_kind,p_source,stored,reserved);
+ return null;
+exception when invalid_text_representation or numeric_value_out_of_range then return 'reconciliation-required';
+end $$;
+
+create function public.live_content_purge_result(p_removal uuid,p_processed integer default 0)
+returns jsonb language sql stable set search_path=public,pg_temp as $$
+ select jsonb_build_object('removalId',removal_id,'processedRecords',p_processed,'status',case when phase='complete'then 'content-removed'when phase='redacting'then 'removing-content'when block_reason='storage-pending'then 'waiting-for-storage'when block_reason is not null then 'needs-reconciliation'else 'checking'end,
+ 'releasedStoredBytes',released_stored_bytes,'releasedReservedBytes',released_reserved_bytes)
+ from project_content_purges where removal_id=p_removal
+$$;
+
+create function public.live_advance_project_content_purge(p_removal_id uuid default null)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare selected uuid;r artifact_removals;c project_content_purges;source record;state text;processed integer:=0;
+ v artifact_versions;u artifact_uploads;s core_revision_saves;t operation_model_tasks;o operations;response runtime_records;
+ stored bigint;reserved bigint;
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));perform pg_advisory_xact_lock(9350120);
+ if exists(select 1 from project_storage_purges where lease_until>clock_timestamp())or exists(select 1 from artifact_upload_cleanup where lease_until>clock_timestamp()and completed_at is null)then return null;end if;
+ select r0.id into selected from artifact_removals r0 join artifacts a on a.id=r0.artifact_id and a.workspace_id=r0.workspace_id
+ left join project_content_purges c0 on c0.removal_id=r0.id
+ where(p_removal_id is null or r0.id=p_removal_id)and r0.restored_at is null and r0.recoverable_until<=clock_timestamp()
+  and a.deleted_at=r0.removed_at and a.access_epoch=r0.access_epoch
+  and(c0.completed_at is null or p_removal_id is not null)and coalesce(c0.next_attempt_at,r0.recoverable_until)<=clock_timestamp()
+  and not exists(select 1 from publications where artifact_id=a.id and revoked_at is null)
+  and not exists(select 1 from operation_grants where artifact_id=a.id and revoked_at is null)
+  and not exists(select 1 from operations where artifact_id=a.id and status in ('queued','running','paused'))
+  and not exists(select 1 from artifact_uploads where artifact_id=a.id and status='uploading')
+  and not exists(select 1 from artifact_upload_transfers tr join artifact_uploads up on up.id=tr.upload_id where up.artifact_id=a.id and tr.status='admitted'and tr.expires_at>clock_timestamp())
+ order by coalesce(c0.next_attempt_at,r0.recoverable_until),r0.id limit 1;
+ if not found then return null;end if;
+ r:=live_lock_project_storage_authority(selected);
+ insert into project_content_purges(removal_id,workspace_id,artifact_id)values(r.id,r.workspace_id,r.artifact_id)on conflict do nothing;
+ select *into c from project_content_purges where removal_id=r.id for update;
+ if c.phase='complete'then return live_content_purge_result(r.id);end if;
+ if exists(select 1 from cloudflare_storage_objects where workspace_id=r.workspace_id and artifact_id=r.artifact_id and retired_at is null)then
+  update project_content_purges set block_reason='storage-pending',next_attempt_at=clock_timestamp()+interval '10 seconds'where removal_id=r.id;return live_content_purge_result(r.id);
+ end if;
+ if c.phase='checking'then
+  for source in
+   select kind,id from(
+    select 'version'::text kind,id from artifact_versions where workspace_id=r.workspace_id and artifact_id=r.artifact_id
+    union all select 'upload',id from artifact_uploads where workspace_id=r.workspace_id and artifact_id=r.artifact_id
+    union all select 'revision',task_id from core_revision_saves where workspace_id=r.workspace_id and artifact_id=r.artifact_id
+   )items where not exists(select 1 from project_content_purge_items i where i.removal_id=r.id and i.kind=items.kind and i.source_id=items.id)
+   order by kind,id limit 4
+  loop
+   state:=live_check_content_purge_item(r.id,source.kind,source.id);
+   if state is not null then
+    update project_content_purges set block_reason=state,next_attempt_at=clock_timestamp()+case when state='storage-pending'then interval '10 seconds'else interval '1 hour'end where removal_id=r.id;
+    return live_content_purge_result(r.id,processed);
+   end if;processed:=processed+1;
+  end loop;
+  if processed>0 then update project_content_purges set block_reason=null,next_attempt_at=clock_timestamp()where removal_id=r.id;return live_content_purge_result(r.id,processed);end if;
+  select coalesce(sum(stored_bytes),0),coalesce(sum(reserved_bytes),0)into stored,reserved from project_content_purge_items where removal_id=r.id;
+  if not exists(select 1 from workspaces where id=r.workspace_id and storage_bytes>=stored and upload_reserved_bytes>=reserved)then
+   update project_content_purges set block_reason='accounting-mismatch',next_attempt_at=clock_timestamp()+interval '1 hour'where removal_id=r.id;return live_content_purge_result(r.id);
+  end if;
+  update project_content_purges set phase='redacting',redaction_started_at=clock_timestamp(),block_reason=null,next_attempt_at=clock_timestamp()where removal_id=r.id returning *into c;
+  insert into audit_events(workspace_id,action,target_id,trace_id,metadata)values(r.workspace_id,'project.content_cleanup_started',r.artifact_id,r.id::text,jsonb_build_object('removalId',r.id));
+ end if;
+
+ -- Each category is bounded independently. No transaction loads all saved
+ -- source or model output, and a retry observes canonical purge timestamps.
+ for v in select *from artifact_versions where workspace_id=r.workspace_id and artifact_id=r.artifact_id and content_purged_at is null order by id limit 4 loop
+  update artifact_versions set manifest='{}',content_purged_at=c.redaction_started_at where id=v.id;processed:=processed+1;
+ end loop;
+ if processed>0 then return live_content_purge_result(r.id,processed);end if;
+ for u in select *from artifact_uploads where workspace_id=r.workspace_id and artifact_id=r.artifact_id and content_purged_at is null order by id limit 4 loop
+  update artifact_upload_files set path='[purged]:'||file_index,content_purged_at=c.redaction_started_at where upload_id=u.id and content_purged_at is null;
+  update artifact_uploads set manifest='{}',request_manifest='{}',content_purged_at=c.redaction_started_at where id=u.id;processed:=processed+1;
+ end loop;
+ if processed>0 then return live_content_purge_result(r.id,processed);end if;
+ for s in select *from core_revision_saves where workspace_id=r.workspace_id and artifact_id=r.artifact_id and content_purged_at is null order by task_id limit 4 loop
+  update core_revision_objects set path='[purged]:'||encode(sha256(convert_to(path,'UTF8')),'hex'),content_purged_at=c.redaction_started_at where task_id=s.task_id and content_purged_at is null;
+  update core_revision_saves set manifest='{}',content_purged_at=c.redaction_started_at where task_id=s.task_id;processed:=processed+1;
+ end loop;
+ if processed>0 then return live_content_purge_result(r.id,processed);end if;
+ for t in select *from operation_model_tasks where workspace_id=r.workspace_id and artifact_id=r.artifact_id and content_purged_at is null order by id limit 4 loop
+  update operation_model_tasks set messages='[]',output=null,output_error=null,discarded=true,content_purged_at=c.redaction_started_at where id=t.id;processed:=processed+1;
+ end loop;
+ if processed>0 then return live_content_purge_result(r.id,processed);end if;
+ for o in select *from operations where workspace_id=r.workspace_id and artifact_id=r.artifact_id and content_purged_at is null order by id limit 4 loop
+  update operations set prompt='[removed]',generated_manifest=null,error=null,content_purged_at=c.redaction_started_at where id=o.id;processed:=processed+1;
+ end loop;
+ if processed>0 then return live_content_purge_result(r.id,processed);end if;
+ for response in select *from runtime_records where workspace_id=r.workspace_id and artifact_id=r.artifact_id and content_purged_at is null order by id limit 10 loop
+  update runtime_records set data='{}',content_purged_at=c.redaction_started_at where id=response.id;processed:=processed+1;
+ end loop;
+ if processed>0 then return live_content_purge_result(r.id,processed);end if;
+ update publications set recipients='{}',content_purged_at=c.redaction_started_at where workspace_id=r.workspace_id and artifact_id=r.artifact_id and content_purged_at is null;
+ update artifacts set title='Removed project',creation_payload=null,content_purged_at=c.redaction_started_at where id=r.artifact_id and workspace_id=r.workspace_id and content_purged_at is null;
+ select coalesce(sum(stored_bytes),0),coalesce(sum(reserved_bytes),0)into stored,reserved from project_content_purge_items where removal_id=r.id;
+ if not exists(select 1 from workspaces where id=r.workspace_id and storage_bytes>=stored and upload_reserved_bytes>=reserved)then raise exception 'CONTENT_PURGE_ACCOUNTING';end if;
+ -- Close each outstanding upload's existing cleanup identity, so retries and
+ -- the upload-session limit both recognize the same exactly-once release.
+ for u in select *from artifact_uploads where workspace_id=r.workspace_id and artifact_id=r.artifact_id and status<>'finalized'loop
+  insert into artifact_upload_cleanup(upload_id)values(u.id)on conflict do nothing;
+  update artifact_upload_cleanup set claim_id=null,lease_until=null,completed_at=clock_timestamp(),released_bytes=u.reserved_bytes,project_removal_id=r.id where upload_id=u.id and completed_at is null;
+ end loop;
+ update workspaces set storage_bytes=storage_bytes-stored,upload_reserved_bytes=upload_reserved_bytes-reserved where id=r.workspace_id;
+ update project_content_purges set phase='complete',completed_at=clock_timestamp(),block_reason=null,released_stored_bytes=stored,released_reserved_bytes=reserved where removal_id=r.id;
+ insert into audit_events(workspace_id,action,target_id,trace_id,metadata)values(r.workspace_id,'project.saved_content_removed',r.artifact_id,r.id::text,jsonb_build_object('removalId',r.id,'releasedStoredBytes',stored,'releasedReservedBytes',reserved));
+ return live_content_purge_result(r.id);
+end $$;
+
+revoke all on function public.live_check_content_purge_item(uuid,text,uuid),public.live_content_purge_result(uuid,integer)from public,anon,authenticated,service_role;
+revoke all on function public.live_advance_project_content_purge(uuid)from public,anon,authenticated;
+grant execute on function public.live_advance_project_content_purge(uuid)to service_role;
+
+-- Content closure owns upload quota once its immutable ledger starts.
+create or replace function public.live_lock_upload_cleanup(p_upload_id uuid,p_claim_id uuid)
+returns public.artifact_uploads language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare u artifact_uploads;c artifact_upload_cleanup;
+begin
+ select * into u from artifact_uploads where id=p_upload_id;
+ if not found then raise exception 'CLEANUP_DENIED';end if;
+ perform 1 from workspaces where id=u.workspace_id for update;
+ perform 1 from artifacts where id=u.artifact_id and workspace_id=u.workspace_id for update;
+ select * into u from artifact_uploads where id=p_upload_id for update;
+ select * into c from artifact_upload_cleanup where upload_id=p_upload_id for update;
+ if not found or p_claim_id is null or c.claim_id is null or c.lease_until is null or c.completed_at is not null or c.claim_id is distinct from p_claim_id or c.lease_until<=clock_timestamp()
+  or exists(select 1 from project_content_purges where workspace_id=u.workspace_id and artifact_id=u.artifact_id)
+  or live_project_retention_active(u.workspace_id,u.artifact_id)
+  or u.status<>'cancelled' or exists(select 1 from artifact_versions where id=u.version_id)
+  or exists(select 1 from artifact_upload_transfers where upload_id=u.id and status='admitted' and expires_at>clock_timestamp())
+  or exists(select 1 from artifact_upload_files where object_version_id=u.version_id and upload_id<>u.id)
+ then raise exception 'CLEANUP_DENIED';end if;
+ return u;
+end $$;
+
+create or replace function public.live_claim_upload_cleanup_before_project_purge(p_claim_id uuid,p_upload_id uuid default null)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare selected_id uuid;u artifact_uploads;c artifact_upload_cleanup;
+begin
+ if p_claim_id is null then raise exception 'CLEANUP_DENIED';end if;
+ -- One live cleanup batch globally bounds duplicate cron dispatch. This lock
+ -- protects claim admission only; no transaction waits on object-storage I/O.
+ perform pg_advisory_xact_lock(9350120);
+ select upload_id into selected_id from artifact_upload_cleanup where claim_id=p_claim_id and lease_until>clock_timestamp() and completed_at is null;
+ if found then
+  if p_upload_id is not null and p_upload_id<>selected_id then raise exception 'CLEANUP_DENIED';end if;
+  return live_upload_cleanup_batch(selected_id,p_claim_id);
+ end if;
+ if exists(select 1 from artifact_upload_cleanup where lease_until>clock_timestamp() and completed_at is null) then return null;end if;
+ select u0.id into selected_id from artifact_uploads u0 join artifacts a on a.id=u0.artifact_id and a.workspace_id=u0.workspace_id
+  left join artifact_upload_cleanup c0 on c0.upload_id=u0.id
+ where (p_upload_id is null or u0.id=p_upload_id) and u0.status<>'finalized'
+  and not exists(select 1 from project_content_purges where workspace_id=a.workspace_id and artifact_id=a.id)
+  and not live_project_retention_active(a.workspace_id,a.id)
+  and (u0.status='cancelled' or u0.expires_at<=clock_timestamp() or a.deleted_at is not null)
+  and c0.completed_at is null and coalesce(c0.next_attempt_at,clock_timestamp())<=clock_timestamp()
+  and not exists(select 1 from artifact_upload_transfers t where t.upload_id=u0.id and t.status='admitted' and t.expires_at>clock_timestamp())
+ order by coalesce(c0.next_attempt_at,u0.created_at),u0.id limit 1;
+ if not found then return null;end if;
+ select * into u from artifact_uploads where id=selected_id;
+ perform 1 from workspaces where id=u.workspace_id for update;
+ perform 1 from artifacts where id=u.artifact_id and workspace_id=u.workspace_id for update;
+ select * into u from artifact_uploads where id=selected_id for update;
+ -- Revalidate after waiting on a concurrent finalization or admission.
+ if exists(select 1 from project_content_purges where workspace_id=u.workspace_id and artifact_id=u.artifact_id)or live_project_retention_active(u.workspace_id,u.artifact_id) or u.status='finalized' or (u.status<>'cancelled' and u.expires_at>clock_timestamp() and exists(select 1 from artifacts where id=u.artifact_id and deleted_at is null))
+  or exists(select 1 from artifact_upload_transfers where upload_id=u.id and status='admitted' and expires_at>clock_timestamp())
+ then return null;end if;
+ if u.status='uploading' then
+  update artifact_uploads set status='cancelled',generation=generation+1 where id=u.id;
+  insert into audit_events(workspace_id,action,target_id,trace_id) values(u.workspace_id,'upload.expired_or_deleted',u.id,p_claim_id::text);
+ end if;
+ insert into artifact_upload_cleanup(upload_id)values(u.id)on conflict do nothing;
+ select * into c from artifact_upload_cleanup where upload_id=u.id for update;
+ if c.completed_at is not null then return null;end if;
+ update artifact_upload_cleanup set claim_id=p_claim_id,lease_until=clock_timestamp()+interval '120 seconds',attempts=attempts+1 where upload_id=u.id;
+ return live_upload_cleanup_batch(u.id,p_claim_id);
+end $$;
+
+
+-- A late supplier receipt settles normally without retaining a late error.
+create or replace function public.live_record_core_result(p_task_id uuid,p_runner_id text,p_receipt jsonb,p_output jsonb,p_output_error text default null)
+returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare t operation_model_tasks;o operations;v_discard boolean;v_settled jsonb;
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into t from operation_model_tasks where id=p_task_id for update;
+ if not found or t.runner_id is distinct from p_runner_id then raise exception 'CORE_RUNNER_DENIED';end if;
+ if p_receipt is null or jsonb_typeof(p_receipt)<>'object'or octet_length(p_receipt::text)>4096 or p_receipt->>'requestHash'is distinct from t.quote->>'requestHash'or p_receipt->>'receiptHash'is null or p_receipt->>'receiptHash'!~'^[a-f0-9]{64}$'or p_receipt->>'responseHash'is null or p_receipt->>'responseHash'!~'^[a-f0-9]{64}$'or p_receipt->>'actualCostNanos'is null or p_receipt->>'actualCostNanos'!~'^[0-9]{1,16}$'or p_receipt->>'providerRequestId'is null or length(p_receipt->>'providerRequestId')not between 1 and 200 then raise exception 'CORE_RECEIPT_INVALID';end if;
+ if p_output_error is null and (p_output is null or jsonb_typeof(p_output)<>'object')or p_output_error is not null and(p_output is not null or length(p_output_error)not between 1 and 100)then raise exception 'CORE_OUTPUT_INVALID';end if;
+ if t.completed_at is not null then
+  if t.receipt is distinct from p_receipt or not t.discarded and(t.output is distinct from p_output or t.output_error is distinct from p_output_error)then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+  return to_jsonb(t);
+ end if;
+ select * into o from operations where id=t.operation_id for update;
+ -- Cost is settled even after cancellation, loss of permission or a later edit.
+ -- The result is dropped in that case and never revives or publishes stale work.
+ v_settled:=live_close_runtime(t.reservation_id,t.workspace_id,t.quote->>'requestHash','settled',p_receipt->>'receiptHash',(p_receipt->>'actualCostNanos')::bigint,p_receipt->>'providerRequestId');
+ v_discard:=o.status not in ('queued','running','paused')or not live_core_grant_active(o.id)or not exists(select 1 from artifacts where id=o.artifact_id and latest_version_id is not distinct from o.base_version_id and deleted_at is null);
+ update operation_model_tasks set receipt=p_receipt,output=case when v_discard then null else p_output end,output_error=case when exists(select 1 from project_content_purges where workspace_id=t.workspace_id and artifact_id=t.artifact_id)then null else p_output_error end,discarded=v_discard,completed_at=now()where id=t.id;
+ if v_discard and o.status in ('queued','running','paused')then
+  update operations set status='paused',pause_reason=case when not live_core_grant_active(o.id)then 'permission'else 'conflict'end,error='The task stopped because its permission or source version changed. Its supplier cost is recorded.',updated_at=now()where id=o.id;
+ elsif o.status='running'then update operations set updated_at=now()where id=o.id;end if;
+ return(select to_jsonb(task)from operation_model_tasks task where id=t.id);
+end $$;
+
+
+create or replace function public.live_removal_summary(p_id uuid)returns jsonb language sql stable set search_path=public,pg_temp as $$
+ select jsonb_build_object('id',r.id,'artifactId',r.artifact_id,'title',a.title,'kind',a.kind,'accessEpoch',r.access_epoch,
+ 'removedAt',r.removed_at,'recoverableUntil',r.recoverable_until,'restoredAt',r.restored_at,
+ 'recoverable',r.restored_at is null and r.recoverable_until>clock_timestamp()and c.removal_id is null and not exists(select 1 from project_storage_purges where removal_id=r.id),
+ 'status',case when r.restored_at is not null then 'recovered'when c.completed_at is not null then 'content-removed'when c.removal_id is not null then 'cleanup-running'when r.recoverable_until>clock_timestamp()and not exists(select 1 from project_storage_purges where removal_id=r.id)then 'recoverable'else 'awaiting-cleanup'end,
+ 'observedAt',clock_timestamp())||case when c.completed_at is null then '{}'::jsonb else jsonb_build_object('contentRemovedAt',c.completed_at)end
+ from artifact_removals r join artifacts a on a.id=r.artifact_id and a.workspace_id=r.workspace_id left join project_content_purges c on c.removal_id=r.id where r.id=p_id
+$$;
+
+create or replace function public.live_recover_project(p_actor_id uuid,p_workspace_id uuid,p_removal_id uuid,p_key text,p_auth_session_id uuid,p_agent_credential_id uuid,p_trace_id text)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare r artifact_removals;a artifacts;w workspaces;v_time timestamptz;
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into w from workspaces where id=p_workspace_id for update;
+ select * into r from artifact_removals where id=p_removal_id and workspace_id=p_workspace_id;if not found then raise exception 'NOT_FOUND';end if;
+ select * into a from artifacts where id=r.artifact_id and workspace_id=p_workspace_id for update;
+ if not live_project_proof_active(p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id,'artifact:write')then raise exception 'AUTH_REVOKED';end if;
+ if p_key is null or length(p_key)not between 8 and 100 then raise exception 'REMOVAL_INVALID';end if;
+ select * into r from artifact_removals where id=p_removal_id for update;
+ if r.restored_at is not null then
+  if r.recovery_key<>p_key or a.access_epoch<>r.access_epoch or a.deleted_at is not null then raise exception 'PROJECT_CHANGED';end if;
+  return live_removal_summary(r.id);
+ end if;
+ if a.access_epoch<>r.access_epoch or a.deleted_at is distinct from r.removed_at then raise exception 'PROJECT_CHANGED';end if;
+ v_time:=clock_timestamp();if r.recoverable_until<=v_time or exists(select 1 from project_content_purges where removal_id=r.id)or exists(select 1 from project_storage_purges where removal_id=r.id)then raise exception 'RECOVERY_EXPIRED';end if;
+ if (select count(*)from artifacts where workspace_id=p_workspace_id and deleted_at is null)>=(case w.plan_code when 'free'then 20 when 'starter'then 100 else 500 end)then raise exception 'PROJECT_RECOVERY_LIMIT';end if;
+ update artifact_removals set restored_at=v_time,restored_by=p_actor_id,recovery_key=p_key where id=r.id;
+ update artifacts set deleted_at=null,updated_at=v_time where id=a.id;
+ -- Keep the publication revoked; never rewrite its audience or reopen project grants.
+ insert into audit_events(workspace_id,actor_id,action,target_id,trace_id,metadata)values(a.workspace_id,p_actor_id,'artifact.recovered',a.id,p_trace_id,jsonb_build_object('removalId',r.id,'accessEpoch',r.access_epoch,'published',false));
+ return live_removal_summary(r.id);
+end $$;
+
+-- Cleanup history is modified only by its canonical RPCs.
+revoke insert,update,delete,truncate on public.artifact_upload_cleanup,public.artifact_upload_retirements from service_role;
