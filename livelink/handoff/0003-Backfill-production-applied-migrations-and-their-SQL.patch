+revoke all on function public.live_content_purge_history(),public.live_content_redaction_allowed(text,jsonb,jsonb),public.live_content_write_guard(),public.live_purge_reference_state(uuid,uuid,uuid,text,text,bigint),public.live_purge_manifest_state(uuid,uuid,jsonb,uuid)from public,anon,authenticated,service_role;
