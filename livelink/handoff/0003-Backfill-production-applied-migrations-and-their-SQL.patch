+begin;
+create function pg_temp.core_quote(p_role text,p_hash text,p_cost bigint default 100000000)returns jsonb language sql as $$select jsonb_build_object('model','openai/gpt-6-astra','policy','astra-20260905-v2','role',p_role,'requestHash',p_hash,'maximumCostNanos',p_cost::text,'maximumInputTokens',5000,'maximumOutputTokens',1024)$$;
+create function pg_temp.core_receipt(p_hash text,p_id text)returns jsonb language sql as $$select jsonb_build_object('model','openai/gpt-6-astra','requestHash',p_hash,'receiptHash',repeat('d',64),'responseHash',repeat('e',64),'actualCostNanos','10000000','providerRequestId',p_id)$$;
+do $$
+declare actor uuid:=gen_random_uuid();login uuid:=gen_random_uuid();new_login uuid:=gen_random_uuid();writer uuid:=gen_random_uuid();workspace uuid;artifact uuid;op uuid;task jsonb;planner jsonb;coder jsonb;reviewer jsonb;receipt jsonb;v_version uuid;res uuid;
+ messages jsonb:='[{"role":"user","content":"Make an estimate"}]';
+ manifest jsonb:='{"schemaVersion":1,"kind":"document","title":"Estimate","description":"","entrypoint":"index.html","files":[],"blocks":[{"type":"markdown","text":"Estimate details"}]}';
+begin
+ insert into auth.users(id,email,email_confirmed_at)values(actor,'core-creation@example.test',now());
+ insert into auth.sessions(id,user_id)values(login,actor),(new_login,actor);workspace:=live_ensure_workspace(actor);
+ insert into agent_credentials(id,workspace_id,name,token_hash,scopes)values(writer,workspace,'Core writer','core-writer-test',array['artifact:write']);
+ assert live_workspace_model_available(workspace,'platform')=1000000000;
+ op:=live_create_core_operation(actor,workspace,null,null,'document','Make an estimate','core-start',repeat('a',64),'platform',login,null);
+ assert op=live_create_core_operation(actor,workspace,null,null,'document','Make an estimate','core-start',repeat('a',64),'platform',new_login,null);
+ assert not exists(select 1 from ai_reservations where workspace_id=workspace),'no legacy flat charge';
+ select artifact_id into artifact from operations where id=op;
+ begin perform live_create_core_operation(actor,workspace,artifact,null,'document','Another estimate','core-other',repeat('b',64),'platform',login,null);raise exception 'parallel project request';exception when raise_exception then if sqlerrm<>'RUNTIME_PROJECT_BUSY'then raise;end if;end;
+ assert live_claim_operation(op,'core-run-1');assert not live_claim_operation(op,'losing-run');
+ begin perform live_complete_generation(op,'core-run-1',manifest,repeat('f',64));raise exception 'legacy finalize bypassed core review';exception when raise_exception then if sqlerrm<>'CORE_ENGINE_REQUIRED'then raise;end if;end;
+ begin perform live_prepare_core_task(op,'core-run-1',1,messages,pg_temp.core_quote('coder',repeat('b',64)));raise exception 'code skipped plan';exception when raise_exception then if sqlerrm<>'CORE_DEPENDENCY_REQUIRED'then raise;end if;end;
+ planner:=live_prepare_core_task(op,'core-run-1',0,messages,pg_temp.core_quote('planner',repeat('a',64)));
+ assert planner=live_prepare_core_task(op,'core-run-1',0,messages,pg_temp.core_quote('planner',repeat('a',64)));
+ assert live_workspace_model_available(workspace,'platform')=900000000;
+ res:=(planner->>'reservation_id')::uuid;
+ -- Explicit bounded background grant survives logout; reader proof does not.
+ perform live_revoke_auth_session(actor,login);assert not live_access_proof_active(actor,login,null,workspace);assert live_core_grant_active(op);
+ assert live_dispatch_core_runtime(res,workspace,artifact,op,repeat('a',64),'openai/gpt-6-astra','astra-20260905-v2','planner',100000000);
+ assert not live_dispatch_core_runtime(res,workspace,artifact,op,repeat('a',64),'openai/gpt-6-astra','astra-20260905-v2','planner',100000000);
+ receipt:=pg_temp.core_receipt(repeat('a',64),'core-plan');
+ perform live_record_core_result((planner->>'id')::uuid,'core-run-1',receipt,'{"title":"Estimate","goal":"Make an estimate","audience":"Homeowner","acceptance":["Readable"],"constraints":[]}');
+ assert live_workspace_model_available(workspace,'platform')=990000000;
+ coder:=live_prepare_core_task(op,'core-run-1',1,messages,pg_temp.core_quote('coder',repeat('b',64)));
+ -- Pausing a never-dispatched task releases its hold; resume makes a new
+ -- bounded attempt, retaining completed planning and its exact receipt.
+ perform live_pause_core_operation(op,'core-run-1','capacity','Waiting for a worker');
+ assert (select status='released'from runtime_reservations where id=(coder->>'reservation_id')::uuid);
+ assert live_resume_core_operation(actor,workspace,op,new_login,null)=op;
+ assert live_claim_operation(op,'core-run-2');
+ task:=live_prepare_core_task(op,'core-run-2',1,messages,pg_temp.core_quote('coder',repeat('b',64)));
+ assert task->>'attempt'='1'and task->>'id'<>coder->>'id';coder:=task;res:=(coder->>'reservation_id')::uuid;
+ assert live_dispatch_core_runtime(res,workspace,artifact,op,repeat('b',64),'openai/gpt-6-astra','astra-20260905-v2','coder',100000000);
+ perform live_pause_core_operation(op,'core-run-2','provider','Awaiting the exact provider result');
+ begin perform live_resume_core_operation(actor,workspace,op,new_login,null);raise exception 'unknown paid call repeated';exception when raise_exception then if sqlerrm<>'CORE_OUTCOME_UNKNOWN'then raise;end if;end;
+ assert not live_recover_core_operation(op,'core-run-2');
+ receipt:=pg_temp.core_receipt(repeat('b',64),'core-code');
+ perform live_record_core_result((coder->>'id')::uuid,'core-run-2',receipt,manifest);
+ perform live_record_core_result((coder->>'id')::uuid,'core-run-2',receipt,manifest);
+ assert live_workspace_model_available(workspace,'platform')=980000000;
+ assert not live_recover_core_operation(op,'losing-run');assert live_recover_core_operation(op,'core-run-2');assert live_claim_operation(op,'core-run-3');
+ begin perform live_complete_core_generation(op,'core-run-3',(coder->>'id')::uuid,manifest,repeat('f',64));raise exception 'unreviewed draft saved';exception when raise_exception then if sqlerrm<>'CORE_REVIEW_REQUIRED'then raise;end if;end;
+ reviewer:=live_prepare_core_task(op,'core-run-3',2,messages,pg_temp.core_quote('reviewer',repeat('c',64)),(coder->>'id')::uuid);
+ res:=(reviewer->>'reservation_id')::uuid;
+ assert live_dispatch_core_runtime(res,workspace,artifact,op,repeat('c',64),'openai/gpt-6-astra','astra-20260905-v2','reviewer',100000000);
+ perform live_record_core_result((reviewer->>'id')::uuid,'core-run-3',pg_temp.core_receipt(repeat('c',64),'core-review'),jsonb_build_object('reviewedTaskId',coder->>'id','passed',true,'summary','Passed','issues','[]'::jsonb));
