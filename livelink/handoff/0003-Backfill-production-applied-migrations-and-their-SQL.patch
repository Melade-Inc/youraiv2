+ end case;
+ if v_kind is not null and not exists(select 1 from project_content_purge_items where removal_id=c.removal_id and project_content_purge_items.kind=v_kind and source_id=source)then return false;end if;
+ if(p_old-(fields||'content_purged_at'::text))is distinct from(p_new-(fields||'content_purged_at'::text))then return false;end if;
+ return(p_new-(select array_agg(key)from jsonb_object_keys(p_new)key where not(key=any(fields))))=expected;
+end $$;
