+begin;
+do $$
+declare actor uuid:=gen_random_uuid();login uuid:=gen_random_uuid();workspace uuid;artifact uuid;other_artifact uuid;
+ saved uuid;version uuid;upload uuid;other_upload uuid;expired uuid;deleted uuid;old_pending uuid;claim uuid:=gen_random_uuid();next_claim uuid:=gen_random_uuid();transfer uuid:=gen_random_uuid();
+ manifest jsonb;revision jsonb;batch jsonb;result jsonb;original_reserved bigint;before_reserved bigint;before_stored bigint;
+begin
+ insert into auth.users(id,email,email_confirmed_at)values(actor,'cleanup@example.test',now());insert into auth.sessions(id,user_id)values(login,actor);
+ workspace:=live_ensure_workspace(actor);artifact:=live_create_artifact(actor,workspace,'Cleanup test','app','test');other_artifact:=live_create_artifact(actor,workspace,'Other draft','app','test');
+ manifest:='{"schemaVersion":2,"kind":"app","title":"Cleanup test","entrypoint":"index.html","blocks":[],"files":[{"path":"index.html","mediaType":"text/html","size":100,"sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}';
+ saved:=live_begin_upload(actor,workspace,artifact,manifest,null,'cleanup-saved',login,null,'test');
+ assert live_claim_upload_cleanup(claim,saved) is null;
+ perform live_reconcile_upload_file(saved,0,1,repeat('a',64),100,'test');version:=live_finalize_upload(saved,actor,workspace,login,null,'test');
+ assert live_claim_upload_cleanup(claim,saved) is null;
+ perform live_publish(actor,workspace,artifact,version,'cleanup-test','public','{}',null,null,'test');
+ revision:=jsonb_set(manifest,'{files}',manifest->'files'||jsonb_build_array(
+  jsonb_build_object('path','a.css','mediaType','text/css','size',20,'sha256',repeat('b',64)),
+  jsonb_build_object('path','b.css','mediaType','text/css','size',20,'sha256',repeat('b',64)),
+  jsonb_build_object('path','data.json','mediaType','application/json','size',30,'sha256',repeat('c',64))));
+ upload:=live_begin_upload(actor,workspace,artifact,revision,version,'cleanup-discard',login,null,'test');
+ other_upload:=live_begin_upload(actor,workspace,other_artifact,manifest,null,'cleanup-other',login,null,'test');
+ perform live_admit_upload_transfer(upload,1,1,transfer);perform live_cancel_upload(upload,actor,workspace,login,null,'test');
+ assert live_claim_upload_cleanup(claim,upload) is null; -- Wait for a known in-flight attempt.
