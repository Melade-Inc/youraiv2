+create function public.live_finish_project_storage_purge(p_removal_id uuid,p_environment text,p_claim_id uuid,p_failed boolean default false)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare c project_storage_purges;r artifact_removals;complete boolean;
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ r:=live_lock_project_storage_authority(p_removal_id);
+ select * into c from project_storage_purges where removal_id=r.id and environment=p_environment for update;
+ if not found then raise exception 'PROJECT_CLEANUP_DENIED';end if;
+ if c.storage_retired_at is not null then
+  if p_claim_id is distinct from c.retirement_claim_id then raise exception 'PROJECT_CLEANUP_DENIED';end if;
+  return jsonb_build_object('knownStorageRetired',true,'projectContentPurged',false,'releasedBytes',0);
+ end if;
+ if p_claim_id is null or c.claim_id is distinct from p_claim_id or c.lease_until<=clock_timestamp()then raise exception 'PROJECT_CLEANUP_DENIED';end if;
+ complete:=not exists(select 1 from project_storage_purge_objects where removal_id=r.id and environment=p_environment and retired_at is null)
+  and not exists(select 1 from cloudflare_storage_objects where environment=p_environment and workspace_id=r.workspace_id and artifact_id=r.artifact_id and retired_at is null);
+ update project_storage_purges set claim_id=null,lease_until=null,failures=failures+case when p_failed then 1 else 0 end,
+  next_attempt_at=clock_timestamp()+case when p_failed then interval '60 seconds'*least(60,power(2,least(failures,6)))else interval '1 second'end,
+  storage_retired_at=case when complete then clock_timestamp()else null end,retirement_claim_id=case when complete then p_claim_id else null end where removal_id=r.id and environment=p_environment;
+ if complete then insert into audit_events(workspace_id,action,target_id,trace_id,metadata)values(r.workspace_id,'project.known_storage_retired',r.id,p_claim_id::text,jsonb_build_object('environment',p_environment,'projectContentPurged',false,'releasedBytes',0));end if;
+ return jsonb_build_object('knownStorageRetired',complete,'projectContentPurged',false,'releasedBytes',0);
+end $$;
+
+revoke all on function public.live_project_storage_history(),public.live_project_storage_insert_guard(),public.live_lock_project_storage_authority(uuid),public.live_project_storage_reference(uuid),public.live_project_storage_batch(uuid,text,uuid),public.live_lock_project_storage_object(uuid,text,uuid,uuid) from public,anon,authenticated,service_role;
