+create function public.live_confirm_project_storage_retirement(p_receipt jsonb)
+returns void language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare o project_storage_purge_objects;d project_storage_purge_dispatches;expected jsonb;
+begin
+ if p_receipt is null or jsonb_typeof(p_receipt)is distinct from 'object'or octet_length(p_receipt::text)>4096 then raise exception 'PROJECT_CLEANUP_UNCONFIRMED';end if;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ o:=live_lock_project_storage_object((p_receipt->>'removalId')::uuid,p_receipt->>'environment',(p_receipt->>'claimId')::uuid,(p_receipt->>'objectId')::uuid);
+ select * into d from project_storage_purge_dispatches where invocation_id=(p_receipt->>'invocationId')::uuid and object_id=o.id and claim_id=(p_receipt->>'claimId')::uuid for update;
+ if not found then raise exception 'PROJECT_CLEANUP_UNCONFIRMED';end if;
+ expected:=jsonb_build_object('retired',true,'removalId',o.removal_id,'environment',o.environment,'objectId',o.id,'claimId',d.claim_id,
+  'invocationId',d.invocation_id,'reference',live_project_storage_reference(o.id),'reservationId',d.reservation_id,'requestHash',d.request_hash);
+ if p_receipt is distinct from expected then raise exception 'PROJECT_CLEANUP_UNCONFIRMED';end if;
+ if d.confirmed_at is not null then return;end if;
+ update cloudflare_storage_objects set retired_at=clock_timestamp()where environment=o.environment and workspace_id=o.workspace_id and artifact_id=o.artifact_id and object_version_id=o.object_version_id and sha256=o.sha256 and media_type=o.media_type and retired_at is null;
+ update project_storage_purge_objects set retired_at=clock_timestamp()where id=o.id and retired_at is null;
+ update project_storage_purge_dispatches set confirmed_at=clock_timestamp()where invocation_id=d.invocation_id;
+ -- Billing history, current-period hosting commitment and logical quota stay held.
+end $$;
