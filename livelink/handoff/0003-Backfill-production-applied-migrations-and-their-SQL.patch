+ order by s.object_version_id,s.sha256,s.media_type limit 20 on conflict do nothing;
+ update project_storage_purges set claim_id=p_claim_id,lease_until=clock_timestamp()+interval '120 seconds',attempts=attempts+1 where removal_id=r.id and environment=p_environment;
