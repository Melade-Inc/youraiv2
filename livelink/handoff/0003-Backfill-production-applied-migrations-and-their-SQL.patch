+create function public.live_project_storage_history()returns trigger language plpgsql set search_path=public,pg_temp as $$
+declare mutable text[];
+begin
+ if tg_op='DELETE'then raise exception 'PROJECT_STORAGE_HISTORY_IMMUTABLE';end if;
+ if tg_table_name='project_storage_purges'then
+  mutable:=array['claim_id','lease_until','next_attempt_at','attempts','failures','storage_retired_at','retirement_claim_id'];
+  if old.storage_retired_at is not null or new.attempts<old.attempts or new.failures<old.failures then raise exception 'PROJECT_STORAGE_HISTORY_IMMUTABLE';end if;
+ elsif tg_table_name='project_storage_purge_objects'then
+  mutable:=array['retired_at'];
+  if old.retired_at is not null or new.retired_at is null then raise exception 'PROJECT_STORAGE_HISTORY_IMMUTABLE';end if;
+ else
+  mutable:=array['confirmed_at'];
+  if old.confirmed_at is not null or new.confirmed_at is null then raise exception 'PROJECT_STORAGE_HISTORY_IMMUTABLE';end if;
+ end if;
+ if (to_jsonb(new)-mutable)is distinct from(to_jsonb(old)-mutable)then raise exception 'PROJECT_STORAGE_HISTORY_IMMUTABLE';end if;return new;
+end $$;
+create trigger project_storage_purge_history before update or delete on public.project_storage_purges for each row execute function public.live_project_storage_history();
+create trigger project_storage_object_history before update or delete on public.project_storage_purge_objects for each row execute function public.live_project_storage_history();
+create trigger project_storage_dispatch_history before update or delete on public.project_storage_purge_dispatches for each row execute function public.live_project_storage_history();
+
+-- Freeze the commitment set in all environments once physical cleanup starts.
+-- Normal requests already reject removed projects. This also blocks a stale
+-- trusted caller from reserving a different key after the purge snapshot.
+create function public.live_project_storage_insert_guard()returns trigger language plpgsql set search_path=public,pg_temp as $$
