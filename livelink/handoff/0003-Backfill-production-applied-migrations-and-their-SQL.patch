+ after_cursor:=live_storage_inventory(w,'preview',null,1)->'nextCursor';
+ begin perform live_storage_inventory(w2,'preview',after_cursor,1);raise exception 'foreign workspace cursor accepted';exception when raise_exception then if sqlerrm<>'STORAGE_INVENTORY_INVALID' then raise;end if;end;
+ begin perform live_storage_inventory(w,'production',after_cursor,1);raise exception 'foreign environment cursor accepted';exception when raise_exception then if sqlerrm<>'STORAGE_INVENTORY_INVALID' then raise;end if;end;
+ begin perform live_storage_inventory(w,'preview',after_cursor||'{"extra":true}',1);raise exception 'unknown cursor field accepted';exception when raise_exception then if sqlerrm<>'STORAGE_INVENTORY_INVALID' then raise;end if;end;
+ begin perform live_storage_inventory(w,'preview',null,101);raise exception 'unbounded page accepted';exception when raise_exception then if sqlerrm<>'STORAGE_INVENTORY_INVALID' then raise;end if;end;
+ begin perform live_storage_inventory(w,'preview','null',1);raise exception 'null JSON cursor accepted';exception when raise_exception then if sqlerrm<>'STORAGE_INVENTORY_INVALID' then raise;end if;end;
+ perform pg_temp.revision_review(o,t);perform live_prepare_core_revision(o,'revision-run',t);
+ perform live_track_cloudflare_object('preview',w,a,t,encode(sha256(convert_to('<button>Revised</button>','UTF8')),'hex'),'text/html',24);
