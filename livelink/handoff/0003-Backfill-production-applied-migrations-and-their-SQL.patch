+-- Guard ordinary inserts/updates as well as RPCs. Service-role table access
+-- must not resurrect content after the canonical purge starts.
+create function public.live_content_write_guard()returns trigger language plpgsql security definer set search_path=public,pg_temp as $$
+declare row_data jsonb:=to_jsonb(new);artifact uuid;workspace uuid;
+begin
+ if tg_table_name='core_revision_objects'then select artifact_id,workspace_id into artifact,workspace from core_revision_saves where task_id=(row_data->>'task_id')::uuid;
+ elsif tg_table_name='artifact_upload_transfers'then select artifact_id,workspace_id into artifact,workspace from artifact_uploads where id=(row_data->>'upload_id')::uuid;
+ else artifact:=case when tg_table_name='artifacts'then(row_data->>'id')::uuid else(row_data->>'artifact_id')::uuid end;workspace:=(row_data->>'workspace_id')::uuid;end if;
+ if tg_op='UPDATE'and(row_data->'artifact_id'is distinct from to_jsonb(old)->'artifact_id'or row_data->'workspace_id'is distinct from to_jsonb(old)->'workspace_id'or row_data->'upload_id'is distinct from to_jsonb(old)->'upload_id'or row_data->'task_id'is distinct from to_jsonb(old)->'task_id')then raise exception 'CONTENT_SCOPE_IMMUTABLE';end if;
+ -- Serialize source writes with canonical closure, including raw service writes.
+ perform 1 from workspaces where id=workspace for share;
+ if not exists(select 1 from project_content_purges where artifact_id=artifact and workspace_id=workspace)then
+  if row_data->>'content_purged_at'is not null then raise exception 'CONTENT_PURGE_DENIED';end if;
+  return new;
+ end if;
+ if tg_op='INSERT'then raise exception 'PROJECT_CONTENT_PURGING';end if;
+ if live_content_redaction_allowed(tg_table_name,to_jsonb(old),row_data)then return new;end if;
