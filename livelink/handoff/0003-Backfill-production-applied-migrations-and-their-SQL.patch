+ -- A malformed legacy commitment cannot silently disappear from an audit.
+ insert into cloudflare_storage_objects(environment,workspace_id,artifact_id,object_version_id,sha256,media_type,byte_size)values('preview',w,a2,gen_random_uuid(),repeat('1',64),'text/plain',5);
+ assert exists(select 1 from jsonb_array_elements(live_storage_inventory(w,'preview')->'objects') x where x->>'classification'='scope-conflict' and x->'referenceConflict'='true'::jsonb);
+ perform live_revoke((f->>'actor')::uuid,w,a,true,'inventory-remove');
+ assert exists(select 1 from jsonb_array_elements(live_storage_inventory(w,'preview')->'objects') x where x->>'classification'='removed-artifact' and x->>'savedVersionReferences'='1');
+ perform set_config('test.inventory_workspace',w::text,true);
+ assert not has_table_privilege('service_role','public.cloudflare_storage_objects','SELECT');
+ assert not has_function_privilege('anon','public.live_storage_inventory(uuid,text,jsonb,integer)','EXECUTE');
+ assert not has_function_privilege('authenticated','public.live_storage_inventory(uuid,text,jsonb,integer)','EXECUTE');
+ assert has_function_privilege('service_role','public.live_storage_inventory(uuid,text,jsonb,integer)','EXECUTE');
+end $$;
+-- Exercise the granted operator entry point while a caller shadows table names.
+create temporary table cloudflare_storage_objects(secret text);
+set local search_path=pg_temp,public;
+set local role service_role;
+do $$begin assert jsonb_array_length(public.live_storage_inventory(current_setting('test.inventory_workspace')::uuid,'preview')->'objects')=7;end $$;
+reset role;
+set local role anon;
+do $$begin begin perform public.live_storage_inventory(current_setting('test.inventory_workspace')::uuid,'preview');raise exception 'anonymous inventory access';exception when insufficient_privilege then null;end;end $$;
+reset role;
+set local role authenticated;
+do $$begin begin perform public.live_storage_inventory(current_setting('test.inventory_workspace')::uuid,'preview');raise exception 'authenticated inventory access';exception when insufficient_privilege then null;end;end $$;
+reset role;
+rollback;
+select 'Storage inventory: scope and cursor isolation, saved/unfinished/removed references, conflicts, read-only funding, bounded pages and role denial passed' as result;
