+create function public.live_removal_summary(p_id uuid)returns jsonb language sql stable set search_path=public,pg_temp as $$
+ select jsonb_build_object('id',r.id,'artifactId',r.artifact_id,'title',a.title,'kind',a.kind,'accessEpoch',r.access_epoch,
+  'removedAt',r.removed_at,'recoverableUntil',r.recoverable_until,'restoredAt',r.restored_at,'recoverable',r.restored_at is null and r.recoverable_until>clock_timestamp(),
