diff --git a/supabase/migrations/20260905210846_upload_retry_lookup.sql b/supabase/migrations/20260905210846_upload_retry_lookup.sql
new file mode 100644
index 0000000..7219161
--- /dev/null
+++ b/supabase/migrations/20260905210846_upload_retry_lookup.sql
@@ -0,0 +1,76 @@
+-- Recover an existing reservation before applying current-plan creation limits.
+create function public.live_find_upload_retry(p_actor_id uuid,p_workspace_id uuid,p_artifact_id uuid,p_manifest jsonb,p_base_version_id uuid,p_idempotency_key text,p_auth_session_id uuid,p_agent_credential_id uuid)
+returns uuid language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare u artifact_uploads;
+begin
+ perform live_assert_owner(p_actor_id,p_workspace_id);
+ perform 1 from workspaces where id=p_workspace_id for share;
+ perform 1 from artifacts where id=p_artifact_id and workspace_id=p_workspace_id and deleted_at is null for share;
+ if not found then raise exception 'NOT_FOUND';end if;
+ if not live_upload_proof_active(p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id) then raise exception 'AUTH_REVOKED';end if;
+ if p_idempotency_key is null or length(p_idempotency_key) not between 8 and 100 then raise exception 'INVALID_UPLOAD';end if;
+ select * into u from artifact_uploads where workspace_id=p_workspace_id and artifact_id=p_artifact_id and idempotency_key=p_idempotency_key;
+ if not found then return null;end if;
+ if u.request_manifest is distinct from p_manifest or u.base_version_id is distinct from p_base_version_id or u.actor_id<>p_actor_id then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+ if u.status='cancelled' then raise exception 'UPLOAD_CANCELLED';end if;
+ if u.status<>'finalized' and u.expires_at<=clock_timestamp() then raise exception 'UPLOAD_EXPIRED';end if;
+ return u.id;
+end $$;
+revoke all on function public.live_find_upload_retry(uuid,uuid,uuid,jsonb,uuid,text,uuid,uuid) from public,anon,authenticated;
+grant execute on function public.live_find_upload_retry(uuid,uuid,uuid,jsonb,uuid,text,uuid,uuid) to service_role;
+
+create or replace function public.live_begin_upload(p_actor_id uuid,p_workspace_id uuid,p_artifact_id uuid,p_manifest jsonb,p_base_version_id uuid,p_idempotency_key text,p_auth_session_id uuid,p_agent_credential_id uuid,p_trace_id text)
+returns uuid language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare v_workspace workspaces;v_artifact artifacts;v_existing artifact_uploads;v_limits record;v_file jsonb;v_ref uuid;
+ v_files jsonb:='[]';v_manifest jsonb;v_id uuid:=gen_random_uuid();v_version uuid:=gen_random_uuid();v_total bigint:=0;v_reserve bigint;v_size bigint;v_path text;v_seen text[]:='{}';
+begin
+ perform live_assert_owner(p_actor_id,p_workspace_id);
+ select * into v_workspace from workspaces where id=p_workspace_id for update;
+ select * into v_artifact from artifacts where id=p_artifact_id and workspace_id=p_workspace_id and deleted_at is null for update;
+ if not found then raise exception 'NOT_FOUND';end if;
+ if not live_upload_proof_active(p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id) then raise exception 'AUTH_REVOKED';end if;
+ if p_idempotency_key is null or length(p_idempotency_key) not between 8 and 100 then raise exception 'INVALID_UPLOAD';end if;
+ select * into v_existing from artifact_uploads where workspace_id=p_workspace_id and artifact_id=p_artifact_id and idempotency_key=p_idempotency_key;
+ if found then
+  if v_existing.request_manifest is distinct from p_manifest or v_existing.base_version_id is distinct from p_base_version_id or v_existing.actor_id<>p_actor_id then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+  -- Returning metadata does not reauthorize the saved proof or issue a grant.
+  if v_existing.status='cancelled' then raise exception 'UPLOAD_CANCELLED';end if;
+  if v_existing.status<>'finalized' and v_existing.expires_at<=clock_timestamp() then raise exception 'UPLOAD_EXPIRED';end if;
+  return v_existing.id;
+ end if;
+ if v_artifact.latest_version_id is distinct from p_base_version_id then raise exception 'VERSION_CONFLICT';end if;
+ if p_manifest is null or p_manifest->>'schemaVersion' is distinct from '2' or p_manifest->>'kind' is distinct from v_artifact.kind
+  or jsonb_typeof(p_manifest->'files') is distinct from 'array' or jsonb_typeof(p_manifest->'blocks') is distinct from 'array'
+  or coalesce(length(p_manifest->>'title'),0) not between 1 and 120 or octet_length(p_manifest::text)>1048576 then raise exception 'INVALID_MANIFEST';end if;
+ select * into v_limits from live_storage_limits(v_workspace.plan_code);
+ if jsonb_array_length(p_manifest->'files')>v_limits.file_count then raise exception 'UPLOAD_FILE_LIMIT';end if;
+ for v_file in select value from jsonb_array_elements(p_manifest->'files') loop
+  v_path:=v_file->>'path';
+  if jsonb_typeof(v_file) is distinct from 'object' or jsonb_typeof(v_file->'path') is distinct from 'string'
+   or coalesce(length(v_path),0) not between 1 and 200 or v_path like '/%' or v_path like '%/' or position('//' in v_path)>0
+   or v_path~'(^|/)[.]' or v_path~'[[:cntrl:]?#%:]' or position(chr(92) in v_path)>0 or lower(v_path)='__live' or lower(v_path) like '__live/%'
+   or lower(v_path)=any(v_seen) or jsonb_typeof(v_file->'size') is distinct from 'number' or coalesce(v_file->>'size','')!~'^[0-9]{1,10}$'
+   or coalesce(v_file->>'sha256','')!~'^[a-f0-9]{64}$' or jsonb_typeof(v_file->'mediaType') is distinct from 'string'
+   or coalesce(length(v_file->>'mediaType'),0) not between 1 and 100 or (v_file-array['path','mediaType','size','sha256'])<>'{}'::jsonb then raise exception 'INVALID_UPLOAD_FILE';end if;
+  v_seen:=array_append(v_seen,lower(v_path));v_size:=(v_file->>'size')::bigint;
+  if v_size>v_limits.file_bytes then raise exception 'UPLOAD_FILE_TOO_LARGE';end if;
+  v_total:=v_total+v_size;
+  select f.object_version_id into v_ref from artifact_upload_files f join artifact_uploads u on u.id=f.upload_id
+   where f.workspace_id=p_workspace_id and f.artifact_id=p_artifact_id and f.sha256=v_file->>'sha256' and f.byte_size=v_size
+    and f.media_type=v_file->>'mediaType' and f.verified_at is not null and u.status='finalized' order by u.created_at,f.file_index limit 1;
+  v_files:=v_files||jsonb_build_array(v_file||jsonb_build_object('encoding','r2','content','','storage',jsonb_build_object('versionId',coalesce(v_ref,v_version))));
+ end loop;
+ if v_total>v_limits.version_bytes then raise exception 'VERSION_TOO_LARGE';end if;
+ if v_artifact.kind='document' and jsonb_array_length(p_manifest->'blocks')=0 then raise exception 'INVALID_MANIFEST';end if;
+ if v_artifact.kind<>'document' and not exists(select 1 from jsonb_array_elements(v_files) f where f->>'path'=p_manifest->>'entrypoint' and (v_artifact.kind<>'app' or f->>'mediaType'='text/html')) then raise exception 'INVALID_MANIFEST';end if;
+ v_manifest:=jsonb_set(p_manifest,'{files}',v_files);v_reserve:=v_total+octet_length(v_manifest::text);
+ if v_workspace.storage_bytes+v_workspace.upload_reserved_bytes+v_reserve>v_limits.storage_bytes then raise exception 'STORAGE_LIMIT';end if;
+ insert into artifact_uploads(id,workspace_id,artifact_id,version_id,base_version_id,actor_id,auth_session_id,agent_credential_id,idempotency_key,request_manifest,manifest,reserved_bytes)
+  values(v_id,p_workspace_id,p_artifact_id,v_version,p_base_version_id,p_actor_id,p_auth_session_id,p_agent_credential_id,p_idempotency_key,p_manifest,v_manifest,v_reserve);
+ insert into artifact_upload_files(upload_id,workspace_id,artifact_id,file_index,path,media_type,byte_size,sha256,object_version_id,verified_at)
+  select v_id,p_workspace_id,p_artifact_id,(ordinality-1)::integer,value->>'path',value->>'mediaType',(value->>'size')::bigint,value->>'sha256',(value->'storage'->>'versionId')::uuid,
+   case when (value->'storage'->>'versionId')::uuid<>v_version then clock_timestamp() else null end from jsonb_array_elements(v_files) with ordinality;
+ update workspaces set upload_reserved_bytes=upload_reserved_bytes+v_reserve where id=p_workspace_id;
+ insert into audit_events(workspace_id,actor_id,action,target_id,trace_id,metadata) values(p_workspace_id,p_actor_id,'upload.created',v_id,p_trace_id,jsonb_build_object('artifactId',p_artifact_id,'reservedBytes',v_reserve));
+ return v_id;
+end $$;
diff --git a/supabase/migrations/20260905210847_delivery_read_check.sql b/supabase/migrations/20260905210847_delivery_read_check.sql
new file mode 100644
index 0000000..538e10b
--- /dev/null
+++ b/supabase/migrations/20260905210847_delivery_read_check.sql
@@ -0,0 +1,18 @@
+-- Recheck current publication/preview access after a potentially slow R2 read.
+-- No object path or caller-selected audience grants access through this helper.
+create function public.live_assert_delivery_access(p_workspace_id uuid,p_artifact_id uuid,p_version_id uuid,p_publication_id uuid,p_user_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid,p_reader_expires_at timestamptz,p_preview boolean)
+returns void language plpgsql volatile security definer set search_path=public,pg_temp as $$
+begin
+ if p_preview is null then raise exception 'FORBIDDEN';end if;
+ if not p_preview then
+  perform live_assert_reader_access(p_workspace_id,p_artifact_id,p_version_id,p_publication_id,p_user_id,p_auth_session_id,p_agent_credential_id,p_reader_expires_at);
+  return;
+ end if;
+ perform 1 from artifacts where id=p_artifact_id and workspace_id=p_workspace_id and deleted_at is null for share;
+ if not found then raise exception 'NOT_FOUND';end if;
+ if p_publication_id is not null or not exists(select 1 from workspaces where id=p_workspace_id and owner_id=p_user_id) then raise exception 'FORBIDDEN';end if;
+ if not exists(select 1 from artifact_versions where id=p_version_id and artifact_id=p_artifact_id and workspace_id=p_workspace_id) then raise exception 'NOT_FOUND';end if;
+ if p_reader_expires_at is null or p_reader_expires_at<=clock_timestamp() or not live_access_proof_active(p_user_id,p_auth_session_id,p_agent_credential_id,p_workspace_id) then raise exception 'AUTH_REVOKED';end if;
+end $$;
+revoke all on function public.live_assert_delivery_access(uuid,uuid,uuid,uuid,uuid,uuid,uuid,timestamptz,boolean) from public,anon,authenticated;
+grant execute on function public.live_assert_delivery_access(uuid,uuid,uuid,uuid,uuid,uuid,uuid,timestamptz,boolean) to service_role;
diff --git a/supabase/migrations/20260905210850_upload_cleanup.sql b/supabase/migrations/20260905210850_upload_cleanup.sql
new file mode 100644
index 0000000..5b07546
--- /dev/null
+++ b/supabase/migrations/20260905210850_upload_cleanup.sql
@@ -0,0 +1,190 @@
+-- Cleanup is canonical upload state, advanced by the existing reconciler.
+-- Original upload reservations/receipts remain immutable audit records.
+create table public.artifact_upload_cleanup (
+ upload_id uuid primary key references public.artifact_uploads(id),
+ claim_id uuid unique,lease_until timestamptz,next_attempt_at timestamptz not null default clock_timestamp(),
+ attempts integer not null default 0 check(attempts>=0),failures integer not null default 0 check(failures between 0 and 10),
+ created_at timestamptz not null default clock_timestamp(),completed_at timestamptz,
+ released_bytes bigint not null default 0 check(released_bytes>=0),
+ check((claim_id is null)=(lease_until is null)),check(completed_at is not null or released_bytes=0)
+);
+create table public.artifact_upload_retirements (
+ upload_id uuid not null,file_index integer not null,retired_at timestamptz not null default clock_timestamp(),
+ primary key(upload_id,file_index),foreign key(upload_id,file_index) references public.artifact_upload_files(upload_id,file_index)
+);
+create index upload_cleanup_live_lease on public.artifact_upload_cleanup(lease_until) where completed_at is null;
+create index upload_files_object_version on public.artifact_upload_files(object_version_id,upload_id);
+alter table public.artifact_upload_cleanup enable row level security;
+alter table public.artifact_upload_retirements enable row level security;
+revoke all on public.artifact_upload_cleanup,public.artifact_upload_retirements from public,anon,authenticated;
+grant all on public.artifact_upload_cleanup,public.artifact_upload_retirements to service_role;
+
+create or replace function public.live_upload_session_limit() returns trigger language plpgsql set search_path=public,pg_temp as $$
+begin
+ perform 1 from workspaces where id=new.workspace_id for update;
+ if (select count(*)from artifact_uploads u where u.workspace_id=new.workspace_id and u.status<>'finalized'
+  and not exists(select 1 from artifact_upload_cleanup c where c.upload_id=u.id and c.completed_at is not null))>=50 then raise exception 'UPLOAD_SESSION_LIMIT';end if;
+ return new;
+end $$;
+
+-- Closed cleanup history must not crowd an older resumable session out of the
+-- bounded picker. Exact upload IDs remain readable through the status RPC.
+create or replace function public.live_list_uploads(p_artifact_id uuid,p_actor_id uuid,p_workspace_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare result jsonb;
+begin
+ perform live_assert_owner(p_actor_id,p_workspace_id);
+ perform 1 from workspaces where id=p_workspace_id for share;
+ perform 1 from artifacts where id=p_artifact_id and workspace_id=p_workspace_id and deleted_at is null for share;
+ if not found then raise exception 'NOT_FOUND';end if;
+ if not live_upload_proof_active(p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id) then raise exception 'AUTH_REVOKED';end if;
+ select coalesce(jsonb_agg(live_upload_summary(u.id,p_auth_session_id,p_agent_credential_id) order by u.created_at desc,u.id desc),'[]') into result
+ from (select u0.id,u0.created_at from artifact_uploads u0 where u0.artifact_id=p_artifact_id and u0.workspace_id=p_workspace_id and u0.actor_id=p_actor_id and u0.status<>'finalized'
+  and not exists(select 1 from artifact_upload_cleanup c where c.upload_id=u0.id and c.completed_at is not null)
+  order by u0.created_at desc,u0.id desc limit 50) u;
+ return result;
+end $$;
+
+create function public.live_cleanup_immutable() returns trigger language plpgsql set search_path=public,pg_temp as $$
+begin
+ if tg_table_name='artifact_upload_retirements' or tg_op='DELETE' then raise exception 'IMMUTABLE_CLEANUP';end if;
+ if old.completed_at is not null
+  or new.upload_id<>old.upload_id or new.created_at<>old.created_at then raise exception 'IMMUTABLE_CLEANUP';end if;
+ return new;
+end $$;
+create trigger upload_cleanup_immutable before update or delete on public.artifact_upload_cleanup for each row execute function public.live_cleanup_immutable();
+create trigger upload_retirement_immutable before update or delete on public.artifact_upload_retirements for each row execute function public.live_cleanup_immutable();
+
+-- Background authority derives from an irreversible cancellation, expiry or
+-- deletion, not a user's current login. Lock order matches upload mutations.
+create function public.live_lock_upload_cleanup(p_upload_id uuid,p_claim_id uuid)
+returns public.artifact_uploads language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare u artifact_uploads;c artifact_upload_cleanup;
+begin
+ select * into u from artifact_uploads where id=p_upload_id;
+ if not found then raise exception 'CLEANUP_DENIED';end if;
+ perform 1 from workspaces where id=u.workspace_id for update;
+ perform 1 from artifacts where id=u.artifact_id and workspace_id=u.workspace_id for update;
+ select * into u from artifact_uploads where id=p_upload_id for update;
+ select * into c from artifact_upload_cleanup where upload_id=p_upload_id for update;
+ if not found or p_claim_id is null or c.claim_id is null or c.lease_until is null or c.completed_at is not null or c.claim_id is distinct from p_claim_id or c.lease_until<=clock_timestamp()
+  or u.status<>'cancelled' or exists(select 1 from artifact_versions where id=u.version_id)
+  or exists(select 1 from artifact_upload_transfers where upload_id=u.id and status='admitted' and expires_at>clock_timestamp())
+  or exists(select 1 from artifact_upload_files where object_version_id=u.version_id and upload_id<>u.id)
+ then raise exception 'CLEANUP_DENIED';end if;
+ return u;
+end $$;
+
+create function public.live_upload_cleanup_batch(p_upload_id uuid,p_claim_id uuid)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare u artifact_uploads;files jsonb;
+begin
+ u:=live_lock_upload_cleanup(p_upload_id,p_claim_id);
+ select coalesce(jsonb_agg(jsonb_build_object('fileIndex',f.file_index,'ref',jsonb_build_object('workspaceId',f.workspace_id,'artifactId',f.artifact_id,'versionId',f.object_version_id,'sha256',f.sha256,'mediaType',f.media_type)) order by f.file_index),'[]') into files
+ from (select distinct on (f.sha256,f.media_type) f.* from artifact_upload_files f
+  where f.upload_id=u.id and f.object_version_id=u.version_id
+   and not exists(select 1 from artifact_upload_retirements r where r.upload_id=f.upload_id and r.file_index=f.file_index)
+  order by f.sha256,f.media_type,f.file_index limit 20) f;
+ return jsonb_build_object('uploadId',u.id,'claimId',p_claim_id,'leaseUntil',(select lease_until from artifact_upload_cleanup where upload_id=u.id),'files',files);
+end $$;
+
+create function public.live_claim_upload_cleanup(p_claim_id uuid,p_upload_id uuid default null)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare selected_id uuid;u artifact_uploads;c artifact_upload_cleanup;
+begin
+ if p_claim_id is null then raise exception 'CLEANUP_DENIED';end if;
+ -- One live cleanup batch globally bounds duplicate cron dispatch. This lock
+ -- protects claim admission only; no transaction waits on object-storage I/O.
+ perform pg_advisory_xact_lock(9350120);
+ select upload_id into selected_id from artifact_upload_cleanup where claim_id=p_claim_id and lease_until>clock_timestamp() and completed_at is null;
+ if found then
+  if p_upload_id is not null and p_upload_id<>selected_id then raise exception 'CLEANUP_DENIED';end if;
+  return live_upload_cleanup_batch(selected_id,p_claim_id);
+ end if;
+ if exists(select 1 from artifact_upload_cleanup where lease_until>clock_timestamp() and completed_at is null) then return null;end if;
+ select u0.id into selected_id from artifact_uploads u0 join artifacts a on a.id=u0.artifact_id and a.workspace_id=u0.workspace_id
+  left join artifact_upload_cleanup c0 on c0.upload_id=u0.id
+ where (p_upload_id is null or u0.id=p_upload_id) and u0.status<>'finalized'
+  and (u0.status='cancelled' or u0.expires_at<=clock_timestamp() or a.deleted_at is not null)
+  and c0.completed_at is null and coalesce(c0.next_attempt_at,clock_timestamp())<=clock_timestamp()
+  and not exists(select 1 from artifact_upload_transfers t where t.upload_id=u0.id and t.status='admitted' and t.expires_at>clock_timestamp())
+ order by coalesce(c0.next_attempt_at,u0.created_at),u0.id limit 1;
+ if not found then return null;end if;
+ select * into u from artifact_uploads where id=selected_id;
+ perform 1 from workspaces where id=u.workspace_id for update;
+ perform 1 from artifacts where id=u.artifact_id and workspace_id=u.workspace_id for update;
+ select * into u from artifact_uploads where id=selected_id for update;
+ -- Revalidate after waiting on a concurrent finalization or admission.
+ if u.status='finalized' or (u.status<>'cancelled' and u.expires_at>clock_timestamp() and exists(select 1 from artifacts where id=u.artifact_id and deleted_at is null))
+  or exists(select 1 from artifact_upload_transfers where upload_id=u.id and status='admitted' and expires_at>clock_timestamp())
+ then return null;end if;
+ if u.status='uploading' then
+  update artifact_uploads set status='cancelled',generation=generation+1 where id=u.id;
+  insert into audit_events(workspace_id,action,target_id,trace_id) values(u.workspace_id,'upload.expired_or_deleted',u.id,p_claim_id::text);
+ end if;
+ insert into artifact_upload_cleanup(upload_id)values(u.id)on conflict do nothing;
+ select * into c from artifact_upload_cleanup where upload_id=u.id for update;
+ if c.completed_at is not null then return null;end if;
+ update artifact_upload_cleanup set claim_id=p_claim_id,lease_until=clock_timestamp()+interval '120 seconds',attempts=attempts+1 where upload_id=u.id;
+ return live_upload_cleanup_batch(u.id,p_claim_id);
+end $$;
+
+create function public.live_authorize_upload_cleanup(p_upload_id uuid,p_claim_id uuid,p_file_index integer)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare u artifact_uploads;f artifact_upload_files;
+begin
+ u:=live_lock_upload_cleanup(p_upload_id,p_claim_id);
+ select * into f from artifact_upload_files where upload_id=u.id and file_index=p_file_index and object_version_id=u.version_id;
+ if not found then raise exception 'CLEANUP_DENIED';end if;
+ return jsonb_build_object('workspaceId',f.workspace_id,'artifactId',f.artifact_id,'versionId',f.object_version_id,'sha256',f.sha256,'mediaType',f.media_type);
+end $$;
+
+create function public.live_confirm_upload_retirement(p_upload_id uuid,p_claim_id uuid,p_file_index integer,p_sha256 text)
+returns void language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare ref jsonb;u artifact_uploads;
+begin
+ ref:=live_authorize_upload_cleanup(p_upload_id,p_claim_id,p_file_index);
+ if ref->>'sha256' is distinct from p_sha256 then raise exception 'CLEANUP_DENIED';end if;
+ select * into u from artifact_uploads where id=p_upload_id;
+ -- Identical paths/bytes can share one typed object key. Record all its
+ -- descriptors, while leaving reused objects owned by saved versions alone.
+ insert into artifact_upload_retirements(upload_id,file_index)
+  select upload_id,file_index from artifact_upload_files where upload_id=u.id and object_version_id=u.version_id and sha256=p_sha256 and media_type=ref->>'mediaType'
+  on conflict do nothing;
+end $$;
+
+create function public.live_finish_upload_cleanup(p_upload_id uuid,p_claim_id uuid,p_failed boolean default false)
+returns jsonb language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare u artifact_uploads;c artifact_upload_cleanup;complete boolean;
+begin
+ select * into c from artifact_upload_cleanup where upload_id=p_upload_id;
+ if c.completed_at is not null then return jsonb_build_object('completed',true,'releasedBytes',c.released_bytes);end if;
+ u:=live_lock_upload_cleanup(p_upload_id,p_claim_id);
+ select * into c from artifact_upload_cleanup where upload_id=u.id;
+ complete:=not exists(select 1 from artifact_upload_files f where f.upload_id=u.id and f.object_version_id=u.version_id and not exists(select 1 from artifact_upload_retirements r where r.upload_id=f.upload_id and r.file_index=f.file_index));
+ if complete then
+  update workspaces set upload_reserved_bytes=upload_reserved_bytes-u.reserved_bytes where id=u.workspace_id;
+  update artifact_upload_cleanup set completed_at=clock_timestamp(),released_bytes=u.reserved_bytes,claim_id=null,lease_until=null where upload_id=u.id;
+  insert into audit_events(workspace_id,action,target_id,trace_id,metadata) values(u.workspace_id,'upload.cleaned',u.id,p_claim_id::text,jsonb_build_object('releasedBytes',u.reserved_bytes));
+ else
+  update artifact_upload_cleanup set claim_id=null,lease_until=null,failures=case when p_failed then least(10,failures+1) else 0 end,
+   next_attempt_at=clock_timestamp()+case when p_failed then make_interval(secs=>least(21600,30*power(2,least(10,failures+1)))::integer) else interval '0' end where upload_id=u.id;
+ end if;
+ return jsonb_build_object('completed',complete,'releasedBytes',case when complete then u.reserved_bytes else 0 end);
+end $$;
+
+-- Report current quota, preserving the original reservation as immutable data.
+create or replace function public.live_upload_summary(p_upload_id uuid,p_auth_session_id uuid,p_agent_credential_id uuid)
+returns jsonb language sql stable set search_path=public,pg_temp as $$
+ select jsonb_build_object(
+  'id',u.id,'artifactId',u.artifact_id,'versionId',u.version_id,'baseVersionId',u.base_version_id,
+  'title',u.request_manifest->>'title','status',u.status,'generation',u.generation,'expiresAt',u.expires_at,'createdAt',u.created_at,'observedAt',clock_timestamp(),
+  'reservedBytes',case when exists(select 1 from artifact_upload_cleanup c where c.upload_id=u.id and c.completed_at is not null) then 0 else u.reserved_bytes end,'expired',u.expires_at<=clock_timestamp(),
+  'requiresReauthorization',u.status='uploading' and (u.auth_session_id is distinct from p_auth_session_id or u.agent_credential_id is distinct from p_agent_credential_id),
+  'fileCount',(select count(*)from artifact_upload_files f where f.upload_id=u.id),
+  'verifiedCount',(select count(*)from artifact_upload_files f where f.upload_id=u.id and f.verified_at is not null)
+ ) from artifact_uploads u where u.id=p_upload_id
+$$;
+
+revoke all on function public.live_cleanup_immutable(),public.live_lock_upload_cleanup(uuid,uuid),public.live_upload_cleanup_batch(uuid,uuid),public.live_claim_upload_cleanup(uuid,uuid),public.live_authorize_upload_cleanup(uuid,uuid,integer),public.live_confirm_upload_retirement(uuid,uuid,integer,text),public.live_finish_upload_cleanup(uuid,uuid,boolean) from public,anon,authenticated;
+grant execute on function public.live_cleanup_immutable(),public.live_lock_upload_cleanup(uuid,uuid),public.live_upload_cleanup_batch(uuid,uuid),public.live_claim_upload_cleanup(uuid,uuid),public.live_authorize_upload_cleanup(uuid,uuid,integer),public.live_confirm_upload_retirement(uuid,uuid,integer,text),public.live_finish_upload_cleanup(uuid,uuid,boolean) to service_role;
diff --git a/supabase/migrations/20260905210852_runtime_funding.sql b/supabase/migrations/20260905210852_runtime_funding.sql
new file mode 100644
index 0000000..38d5c90
--- /dev/null
+++ b/supabase/migrations/20260905210852_runtime_funding.sql
@@ -0,0 +1,230 @@
+-- Supplier costs use integer USD nanodollars; prepaid customer charges are 2x
+-- supplier cost. Supabase owns funds and dispatch admission, never a process
+-- cache or a provider dashboard. These RPCs are for the trusted server only.
+create table public.runtime_funding_events (
+ id uuid primary key default gen_random_uuid(),
+ event_key text not null unique check(length(event_key) between 8 and 160),
+ event_hash text not null check(event_hash ~ '^[a-f0-9]{64}$'),
+ source text not null check(source in ('subscription','prepaid')),
+ workspace_id uuid not null references public.workspaces(id),
+ period date not null check(period=date_trunc('month',period)::date),
+ net_cents bigint not null check(net_cents<>0 and abs(net_cents)<=100000000),
+ amount_nanos bigint not null,
+ created_at timestamptz not null default now(),
+ check(amount_nanos=net_cents*case when source='subscription' then 6000000 else 10000000 end)
+);
+create table public.runtime_reservations (
+ id uuid primary key default gen_random_uuid(),
+ workspace_id uuid not null references public.workspaces(id),
+ artifact_id uuid references public.artifacts(id),
+ operation_id uuid references public.operations(id),
+ idempotency_key text not null check(length(idempotency_key) between 8 and 160),
+ request_hash text not null check(request_hash ~ '^[a-f0-9]{64}$'),
+ source text not null check(source in ('platform','prepaid')),
+ purpose text not null check(purpose in ('planner','coder','reviewer','qa','r2-upload','r2-read','r2-cleanup','browser-run','sandbox')),
+ model text,
+ policy text not null check(length(policy) between 3 and 100),
+ period date not null check(period=date_trunc('month',period)::date),
+ maximum_cost_nanos bigint not null check(maximum_cost_nanos between 1 and 100000000000),
+ charged_maximum_nanos bigint not null,
+ status text not null default 'reserved' check(status in ('reserved','dispatched','unknown','settled','released')),
+ expires_at timestamptz not null default(now()+interval '5 minutes'),
+ dispatched_at timestamptz,
+ receipt_hash text check(receipt_hash ~ '^[a-f0-9]{64}$'),
+ provider_request_id text check(length(provider_request_id) between 1 and 200),
+ actual_cost_nanos bigint check(actual_cost_nanos between 0 and 1000000000000000),
+ charged_actual_nanos bigint,
+ closed_reason text check(closed_reason in ('cancelled','expired','settled')),
+ created_at timestamptz not null default now(),
+ settled_at timestamptz,
+ unique(workspace_id,idempotency_key),
+ check(charged_maximum_nanos=maximum_cost_nanos*case when source='prepaid' then 2 else 1 end),
+ check(charged_actual_nanos is not distinct from actual_cost_nanos*case when source='prepaid' then 2 else 1 end),
+ check((purpose in ('planner','coder','reviewer') and model is not distinct from 'openai/gpt-6-astra' and operation_id is not null and artifact_id is not null) or (purpose not in ('planner','coder','reviewer') and model is null)),
+ check((status in ('settled','released'))=(settled_at is not null)),
+ check((status='settled')=(receipt_hash is not null)),
+ check((status='settled')=(actual_cost_nanos is not null)),
+ check(status not in ('dispatched','unknown','settled') or dispatched_at is not null)
+);
+create index runtime_reservations_fund on public.runtime_reservations(source,period,workspace_id,status);
+create index runtime_reservations_models on public.runtime_reservations(purpose,status) where purpose in ('planner','coder','reviewer');
+
+create table public.runtime_policy_pauses (
+ policy text primary key, reservation_id uuid not null references public.runtime_reservations(id),
+ reason text not null check(reason='cost-overrun'),created_at timestamptz not null default now()
+);
+alter table public.runtime_policy_pauses enable row level security;
+revoke all on public.runtime_policy_pauses from public,anon,authenticated,service_role;
+create index runtime_reserved_expiry on public.runtime_reservations(expires_at) where status='reserved';
+
+alter table public.runtime_funding_events enable row level security;
+alter table public.runtime_reservations enable row level security;
+revoke all on public.runtime_funding_events,public.runtime_reservations from public,anon,authenticated,service_role;
+
+create function public.live_runtime_history_guard() returns trigger language plpgsql set search_path=public,pg_temp as $$
+begin
+ if tg_table_name='runtime_funding_events' or tg_op='DELETE' then raise exception 'RUNTIME_HISTORY_IMMUTABLE';end if;
+ if (to_jsonb(new)-array['status','dispatched_at','receipt_hash','provider_request_id','actual_cost_nanos','charged_actual_nanos','closed_reason','settled_at']) is distinct from
+    (to_jsonb(old)-array['status','dispatched_at','receipt_hash','provider_request_id','actual_cost_nanos','charged_actual_nanos','closed_reason','settled_at']) then raise exception 'RUNTIME_INTENT_IMMUTABLE';end if;
+ if old.status in ('settled','released') or old.dispatched_at is not null and new.dispatched_at is distinct from old.dispatched_at then raise exception 'RUNTIME_HISTORY_IMMUTABLE';end if;
+ if not ((old.status='reserved' and new.status in ('dispatched','released')) or (old.status in ('dispatched','unknown') and new.status in ('unknown','settled'))) then raise exception 'RUNTIME_TRANSITION_DENIED';end if;
+ return new;
+end $$;
+create trigger runtime_funding_immutable before update or delete on public.runtime_funding_events for each row execute function public.live_runtime_history_guard();
+create trigger runtime_reservation_history before update or delete on public.runtime_reservations for each row execute function public.live_runtime_history_guard();
+
+-- A verified payment/balance-transaction handler is the only intended caller.
+-- Record net settled revenue, including negative refunds/disputes; checkout
+-- redirects and unverified webhook bodies must never reach this RPC.
+create function public.live_record_runtime_funding(p_workspace_id uuid,p_source text,p_event_key text,p_event_hash text,p_net_cents bigint,p_period date)
+returns uuid language plpgsql security definer set search_path=public,pg_temp as $$
+declare v_old runtime_funding_events;v_id uuid;
+begin
+ if p_workspace_id is null or p_source is null or p_source not in ('subscription','prepaid') or p_event_key is null or length(p_event_key) not between 8 and 160 or p_event_hash is null or p_event_hash !~ '^[a-f0-9]{64}$' or p_net_cents is null or p_net_cents=0 or abs(p_net_cents)>100000000 or p_period is null or p_period<>date_trunc('month',p_period)::date then raise exception 'RUNTIME_FUNDING_INVALID';end if;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into v_old from runtime_funding_events where event_key=p_event_key;
+ if found then
+  if v_old.workspace_id<>p_workspace_id or v_old.source<>p_source or v_old.event_hash<>p_event_hash or v_old.net_cents<>p_net_cents or v_old.period<>p_period then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+  return v_old.id;
+ end if;
+ insert into runtime_funding_events(workspace_id,source,event_key,event_hash,net_cents,period,amount_nanos)
+ values(p_workspace_id,p_source,p_event_key,p_event_hash,p_net_cents,p_period,p_net_cents*case when p_source='subscription' then 6000000 else 10000000 end) returning id into v_id;
+ return v_id;
+end $$;
+
+-- Baseline unused subsidy/revenue does not roll over. Open obligations retain
+-- their original period; prepaid funds are workspace-owned and do not expire.
+-- Legacy beta allowances share this same lock and are deducted during rollout.
+create function public.live_runtime_available(p_workspace_id uuid,p_source text,p_period date)
+returns bigint language plpgsql security definer set search_path=public,pg_temp as $$
+declare v_funds bigint;v_used bigint;v_legacy bigint;
+begin
+ if p_source is null or p_source not in ('platform','prepaid') or p_period is null or p_workspace_id is null then raise exception 'RUNTIME_FUNDING_INVALID';end if;
+ if p_source='platform' then
+  select 100000000000+coalesce(sum(amount_nanos),0) into v_funds from runtime_funding_events where source='subscription' and period=p_period;
+  select coalesce(sum(reserved_cents::bigint*10000000),0) into v_legacy from ai_budget_months where month=p_period;
+ else
+  select coalesce(sum(amount_nanos),0) into v_funds from runtime_funding_events where source='prepaid' and workspace_id=p_workspace_id;
+  v_legacy:=0;
+ end if;
+ select coalesce(sum(case when status in ('reserved','dispatched','unknown') then charged_maximum_nanos when status='settled' then charged_actual_nanos else 0 end),0)
+ into v_used from runtime_reservations where source=p_source and (p_source='platform' and period=p_period or p_source='prepaid' and workspace_id=p_workspace_id);
+ return v_funds-v_used-v_legacy;
+end $$;
+
+create function public.live_reserve_runtime(p_workspace_id uuid,p_artifact_id uuid,p_operation_id uuid,p_key text,p_request_hash text,p_source text,p_purpose text,p_model text,p_policy text,p_maximum_cost_nanos bigint)
+returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare v_old runtime_reservations;v_id uuid;v_period date:=date_trunc('month',now() at time zone 'UTC')::date;v_charge bigint;v_op operations;
+begin
+ if p_workspace_id is null or p_key is null or length(p_key) not between 8 and 160 or p_request_hash is null or p_request_hash !~ '^[a-f0-9]{64}$' or p_source is null or p_source not in ('platform','prepaid') or p_purpose is null or p_purpose not in ('planner','coder','reviewer','qa','r2-upload','r2-read','r2-cleanup','browser-run','sandbox') or p_policy is null or length(p_policy) not between 3 and 100 or p_maximum_cost_nanos is null or p_maximum_cost_nanos not between 1 and 100000000000 then raise exception 'RUNTIME_INTENT_INVALID';end if;
+ if p_purpose in ('planner','coder','reviewer') and (p_model is distinct from 'openai/gpt-6-astra' or p_operation_id is null or p_artifact_id is null) or p_purpose not in ('planner','coder','reviewer') and p_model is not null then raise exception 'CORE_MODEL_REQUIRED';end if;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ -- Reclaim only never-dispatched stale holds, in a bounded batch. A late
+ -- dispatch for one of these records sees released status and cannot run.
+ with expired as(select id from runtime_reservations where status='reserved' and (expires_at<=now() or source='platform' and period<>v_period) order by created_at limit 100)
+ update runtime_reservations r set status='released',closed_reason='expired',settled_at=now()from expired where r.id=expired.id;
+ select * into v_old from runtime_reservations where workspace_id=p_workspace_id and idempotency_key=p_key;
+ if found then
+  if v_old.request_hash<>p_request_hash or v_old.artifact_id is distinct from p_artifact_id or v_old.operation_id is distinct from p_operation_id or v_old.source<>p_source or v_old.purpose<>p_purpose or v_old.model is distinct from p_model or v_old.policy<>p_policy or v_old.maximum_cost_nanos<>p_maximum_cost_nanos then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+  return jsonb_build_object('id',v_old.id,'status',v_old.status,'maximumCostNanos',v_old.maximum_cost_nanos::text,'chargedMaximumNanos',v_old.charged_maximum_nanos::text);
+ end if;
+ if exists(select 1 from runtime_policy_pauses where policy=p_policy) then raise exception 'RUNTIME_POLICY_PAUSED';end if;
+ if (select count(*)from runtime_reservations where workspace_id=p_workspace_id and status in ('reserved','dispatched','unknown'))>=1000 then raise exception 'RUNTIME_BUSY';end if;
+ if p_purpose='sandbox' and (select count(*)from runtime_reservations where purpose='sandbox' and status in ('reserved','dispatched','unknown'))>=2 then raise exception 'RUNTIME_SANDBOX_BUSY';end if;
+ perform 1 from workspaces where id=p_workspace_id;if not found then raise exception 'NOT_FOUND';end if;
+ if p_artifact_id is not null then
+  perform 1 from artifacts where id=p_artifact_id and workspace_id=p_workspace_id and (deleted_at is null or p_purpose='r2-cleanup');
+  if not found then raise exception 'NOT_FOUND';end if;
+ end if;
+ if p_operation_id is not null then
+  select * into v_op from operations where id=p_operation_id and workspace_id=p_workspace_id and artifact_id=p_artifact_id and status in ('queued','running') for update;
+  if not found then raise exception 'RUNTIME_OPERATION_INACTIVE';end if;
+ end if;
+ if p_purpose in ('planner','coder','reviewer') then
+  if (select count(*) from runtime_reservations where purpose in ('planner','coder','reviewer') and status in ('reserved','dispatched','unknown'))>=3 then raise exception 'RUNTIME_MODEL_BUSY';end if;
+  if exists(select 1 from runtime_reservations where artifact_id=p_artifact_id and purpose in ('planner','coder','reviewer') and status in ('reserved','dispatched','unknown') and operation_id<>p_operation_id) then raise exception 'RUNTIME_PROJECT_BUSY';end if;
+ end if;
+ v_charge:=p_maximum_cost_nanos*case when p_source='prepaid' then 2 else 1 end;
+ if live_runtime_available(p_workspace_id,p_source,v_period)<v_charge then raise exception 'RUNTIME_BUDGET_EXHAUSTED';end if;
+ insert into runtime_reservations(workspace_id,artifact_id,operation_id,idempotency_key,request_hash,source,purpose,model,policy,period,maximum_cost_nanos,charged_maximum_nanos)
+ values(p_workspace_id,p_artifact_id,p_operation_id,p_key,p_request_hash,p_source,p_purpose,p_model,p_policy,v_period,p_maximum_cost_nanos,v_charge) returning id into v_id;
+ return jsonb_build_object('id',v_id,'status','reserved','maximumCostNanos',p_maximum_cost_nanos::text,'chargedMaximumNanos',v_charge::text);
+end $$;
+
+create function public.live_dispatch_runtime(p_reservation_id uuid,p_workspace_id uuid,p_request_hash text)
+returns boolean language plpgsql security definer set search_path=public,pg_temp as $$
+declare v_row runtime_reservations;v_period date:=date_trunc('month',now() at time zone 'UTC')::date;
+begin
+ if p_reservation_id is null or p_workspace_id is null or p_request_hash is null then raise exception 'RUNTIME_DISPATCH_DENIED';end if;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into v_row from runtime_reservations where id=p_reservation_id and workspace_id=p_workspace_id for update;
+ if not found or v_row.request_hash<>p_request_hash then raise exception 'RUNTIME_DISPATCH_DENIED';end if;
+ if v_row.status<>'reserved' then return false;end if;
+ if v_row.expires_at<=now() or v_row.source='platform' and v_row.period<>v_period then
+  update runtime_reservations set status='released',closed_reason='expired',settled_at=now()where id=v_row.id;return false;
+ end if;
+ if v_row.operation_id is not null then
+  perform 1 from operations where id=v_row.operation_id and workspace_id=v_row.workspace_id and artifact_id=v_row.artifact_id and status in ('queued','running') for update;
+  if not found then update runtime_reservations set status='released',closed_reason='cancelled',settled_at=now()where id=v_row.id;return false;end if;
+ end if;
+ -- Refunds or disputes can remove funding after reservation. Stop a request
+ -- that has not started; never silently convert an existing hold to new debt.
+ if live_runtime_available(v_row.workspace_id,v_row.source,v_row.period)<0 or exists(select 1 from runtime_policy_pauses where policy=v_row.policy) then return false;end if;
+ update runtime_reservations set status='dispatched',dispatched_at=now()where id=v_row.id;
+ return true;
+end $$;
+
+create function public.live_close_runtime(p_reservation_id uuid,p_workspace_id uuid,p_request_hash text,p_outcome text,p_receipt_hash text default null,p_actual_cost_nanos bigint default null,p_provider_request_id text default null)
+returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare v_row runtime_reservations;v_actual bigint;
+begin
+ if p_reservation_id is null or p_workspace_id is null or p_request_hash is null or p_outcome is null or p_outcome not in ('cancelled','unknown','settled') then raise exception 'RUNTIME_SETTLEMENT_INVALID';end if;
+ if p_outcome='settled' and (p_receipt_hash is null or p_receipt_hash !~ '^[a-f0-9]{64}$' or p_actual_cost_nanos is null or p_actual_cost_nanos not between 0 and 1000000000000000 or p_provider_request_id is null or length(p_provider_request_id) not between 1 and 200) or p_outcome<>'settled' and (p_receipt_hash is not null or p_actual_cost_nanos is not null or p_provider_request_id is not null) then raise exception 'RUNTIME_SETTLEMENT_INVALID';end if;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into v_row from runtime_reservations where id=p_reservation_id and workspace_id=p_workspace_id for update;
+ if not found or v_row.request_hash<>p_request_hash then raise exception 'RUNTIME_SETTLEMENT_INVALID';end if;
+ if v_row.status='settled' then
+  if p_outcome<>'settled' or v_row.receipt_hash<>p_receipt_hash or v_row.actual_cost_nanos<>p_actual_cost_nanos or v_row.provider_request_id<>p_provider_request_id then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+ elsif v_row.status='released' then
+  if p_outcome<>'cancelled' then raise exception 'RUNTIME_SETTLEMENT_INVALID';end if;
+ elsif p_outcome='cancelled' then
+  if v_row.status<>'reserved' then raise exception 'RUNTIME_OUTCOME_UNKNOWN';end if;
+  update runtime_reservations set status='released',closed_reason='cancelled',settled_at=now()where id=v_row.id;
+ elsif p_outcome='unknown' then
+  if v_row.status not in ('dispatched','unknown') then raise exception 'RUNTIME_SETTLEMENT_INVALID';end if;
+  if v_row.status='dispatched' then update runtime_reservations set status='unknown' where id=v_row.id;end if;
+ else
+  if v_row.status not in ('dispatched','unknown') then raise exception 'RUNTIME_SETTLEMENT_INVALID';end if;
+  v_actual:=p_actual_cost_nanos*case when v_row.source='prepaid' then 2 else 1 end;
+  -- Do not clamp a real overrun to its reservation: record the complete debt
+  -- and let subsequent admission pause. Replayed settlement never charges twice.
+  update runtime_reservations set status='settled',actual_cost_nanos=p_actual_cost_nanos,charged_actual_nanos=v_actual,receipt_hash=p_receipt_hash,provider_request_id=p_provider_request_id,closed_reason='settled',settled_at=now()where id=v_row.id;
+  if p_actual_cost_nanos>v_row.maximum_cost_nanos then insert into runtime_policy_pauses(policy,reservation_id,reason) values(v_row.policy,v_row.id,'cost-overrun')on conflict do nothing;end if;
+ end if;
+ select * into v_row from runtime_reservations where id=p_reservation_id;
+ return jsonb_build_object('id',v_row.id,'status',v_row.status,'actualCostNanos',v_row.actual_cost_nanos::text,'chargedActualNanos',v_row.charged_actual_nanos::text,'exceededReservation',coalesce(v_row.actual_cost_nanos>v_row.maximum_cost_nanos,false));
+end $$;
+
+revoke all on function public.live_runtime_history_guard(),public.live_runtime_available(uuid,text,date),public.live_record_runtime_funding(uuid,text,text,text,bigint,date),public.live_reserve_runtime(uuid,uuid,uuid,text,text,text,text,text,text,bigint),public.live_dispatch_runtime(uuid,uuid,text),public.live_close_runtime(uuid,uuid,text,text,text,bigint,text) from public,anon,authenticated;
+grant execute on function public.live_record_runtime_funding(uuid,text,text,text,bigint,date),public.live_reserve_runtime(uuid,uuid,uuid,text,text,text,text,text,text,bigint),public.live_dispatch_runtime(uuid,uuid,text),public.live_close_runtime(uuid,uuid,text,text,text,bigint,text) to service_role;
+
+-- Legacy QA/generation admission must share the platform cap during rollout.
+create or replace function public.live_reserve_ai(p_workspace_id uuid,p_kind text,p_key text,p_reader_id text,p_operation_id uuid,p_cap integer)
+returns uuid language plpgsql security definer set search_path=public,pg_temp as $$
+declare v_id uuid;v_month date:=date_trunc('month',now())::date;v_cents integer;v_used integer;
+begin
+ if p_cap<1 or p_cap>4000 then raise exception 'AI_BUDGET_CONFIG';end if;
+ v_cents:=case when p_kind='generation' then 60 when p_kind='qa' then 5 else null end;
+ if v_cents is null then raise exception 'AI_KIND_INVALID';end if;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select id into v_id from ai_reservations where workspace_id=p_workspace_id and kind=p_kind and idempotency_key=p_key;
+ if v_id is not null then return null;end if;
+ if p_kind='qa' and (select count(*) from ai_reservations where reader_id=p_reader_id and kind='qa' and created_at>now()-interval '1 day')>=10 then raise exception 'READER_AI_QUOTA';end if;
+ if (select count(*) from ai_reservations where workspace_id=p_workspace_id and kind=p_kind and created_at>now()-interval '1 day')>=(case when p_kind='generation' then 5 else 100 end) then raise exception 'WORKSPACE_AI_QUOTA';end if;
+ insert into ai_budget_months(month)values(v_month)on conflict do nothing;
+ select reserved_cents into v_used from ai_budget_months where month=v_month for update;
+ if v_used+v_cents>p_cap or live_runtime_available(p_workspace_id,'platform',v_month)<v_cents::bigint*10000000 then raise exception 'AI_BUDGET_EXHAUSTED';end if;
+ update ai_budget_months set reserved_cents=reserved_cents+v_cents where month=v_month;
+ insert into ai_reservations(workspace_id,operation_id,reader_id,idempotency_key,kind,cents)values(p_workspace_id,p_operation_id,p_reader_id,p_key,p_kind,v_cents)returning id into v_id;
+ return v_id;
+end $$;
diff --git a/supabase/migrations/20260905210854_core_dispatch_binding.sql b/supabase/migrations/20260905210854_core_dispatch_binding.sql
new file mode 100644
index 0000000..ee343c2
--- /dev/null
+++ b/supabase/migrations/20260905210854_core_dispatch_binding.sql
@@ -0,0 +1,14 @@
+-- The generic runtime gate is shared by many services. A model adapter must
+-- additionally prove its exact price, purpose and model contract so an R2 or
+-- smaller-cost reservation cannot be accidentally reused for a model request.
+create function public.live_dispatch_core_runtime(p_reservation_id uuid,p_workspace_id uuid,p_artifact_id uuid,p_operation_id uuid,p_request_hash text,p_model text,p_policy text,p_purpose text,p_maximum_cost_nanos bigint)
+returns boolean language plpgsql security definer set search_path=public,pg_temp as $$
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ if p_model is distinct from 'openai/gpt-6-astra' or p_purpose is null or p_purpose not in ('planner','coder','reviewer') or p_policy is null or p_maximum_cost_nanos is null then raise exception 'RUNTIME_DISPATCH_DENIED';end if;
+ perform 1 from runtime_reservations where id=p_reservation_id and workspace_id=p_workspace_id and artifact_id=p_artifact_id and operation_id=p_operation_id and request_hash=p_request_hash and model=p_model and policy=p_policy and purpose=p_purpose and maximum_cost_nanos=p_maximum_cost_nanos for update;
+ if not found then raise exception 'RUNTIME_DISPATCH_DENIED';end if;
+ return live_dispatch_runtime(p_reservation_id,p_workspace_id,p_request_hash);
+end $$;
+revoke all on function public.live_dispatch_core_runtime(uuid,uuid,uuid,uuid,text,text,text,text,bigint) from public,anon,authenticated;
+grant execute on function public.live_dispatch_core_runtime(uuid,uuid,uuid,uuid,text,text,text,text,bigint) to service_role;
diff --git a/supabase/migrations/20260905210855_core_operations.sql b/supabase/migrations/20260905210855_core_operations.sql
new file mode 100644
index 0000000..50d36bf
--- /dev/null
+++ b/supabase/migrations/20260905210855_core_operations.sql
@@ -0,0 +1,344 @@
+-- Core tasks extend the existing operation/outbox authority. Vercel Workflows
+-- remains the executor; these records are not another queue or scheduler.
+alter table public.operations add column core_reconciled_at timestamptz;
+alter table public.operations add column engine text not null default 'legacy' check(engine in ('legacy','astra-v1'));
+alter table public.operations add column phase text check(phase in ('planning','building','reviewing','saving'));
+alter table public.operations add column pause_reason text check(pause_reason in ('budget','provider','permission','conflict','capacity','review'));
+alter table public.operations drop constraint operations_status_check;
+alter table public.operations add constraint operations_status_check check(status in ('queued','running','paused','succeeded','failed','cancelled'));
+create table public.operation_grants (
+ operation_id uuid primary key references public.operations(id),workspace_id uuid not null references public.workspaces(id),
+ artifact_id uuid not null references public.artifacts(id),actor_id uuid not null references auth.users(id),request_hash text not null,
+ funding_source text not null check(funding_source in ('platform','prepaid')),
+ origin_session_id uuid,origin_credential_id uuid references public.agent_credentials(id),
+ expires_at timestamptz not null default(now()+interval '24 hours'),revoked_at timestamptz,created_at timestamptz not null default now(),
+ check((origin_session_id is null)<>(origin_credential_id is null))
+);
+create table public.operation_model_tasks (
+ id uuid primary key default gen_random_uuid(),operation_id uuid not null references public.operations(id),
+ workspace_id uuid not null references public.workspaces(id),artifact_id uuid not null references public.artifacts(id),
+ ordinal integer not null check(ordinal between 0 and 6),attempt integer not null default 0 check(attempt between 0 and 3),role text not null check(role in ('planner','coder','reviewer')),
+ runner_id text not null,reservation_id uuid not null unique references public.runtime_reservations(id),
+ candidate_task_id uuid references public.operation_model_tasks(id),
+ messages jsonb not null check(jsonb_typeof(messages)='array' and octet_length(messages::text)<=230000),
+ quote jsonb not null check(jsonb_typeof(quote)='object' and octet_length(quote::text)<=2000),
+ receipt jsonb,output jsonb,output_error text,discarded boolean not null default false,completed_at timestamptz,created_at timestamptz not null default now(),
+ unique(operation_id,ordinal,attempt),check(role=case when ordinal=0 then 'planner' when ordinal%2=1 then 'coder'else 'reviewer'end),
+ check((role='reviewer')=(candidate_task_id is not null)),
+ check((completed_at is not null)=(receipt is not null)),check(receipt is null or jsonb_typeof(receipt)='object'),
+ check(output is null or jsonb_typeof(output)='object'),check(output_error is null or length(output_error)between 1 and 100),
+ check(octet_length(coalesce(output,'{}')::text)<=2097152),check(not discarded or output is null)
+);
+alter table public.operation_grants enable row level security;
+alter table public.operation_model_tasks enable row level security;
+revoke all on public.operation_grants,public.operation_model_tasks from public,anon,authenticated,service_role;
+create index operation_grants_credential on public.operation_grants(origin_credential_id)where revoked_at is null;
+
+create function public.live_core_history_guard()returns trigger language plpgsql set search_path=public,pg_temp as $$
+begin
+ if tg_op='DELETE'then raise exception 'CORE_HISTORY_IMMUTABLE';end if;
+ if tg_table_name='operation_grants'then
+  if (to_jsonb(new)-array['revoked_at']) is distinct from (to_jsonb(old)-array['revoked_at'])or old.revoked_at is not null or new.revoked_at is null then raise exception 'CORE_GRANT_IMMUTABLE';end if;
+ else
+  if old.completed_at is not null or new.completed_at is null or (to_jsonb(new)-array['receipt','output','output_error','discarded','completed_at'])is distinct from(to_jsonb(old)-array['receipt','output','output_error','discarded','completed_at'])then raise exception 'CORE_TASK_IMMUTABLE';end if;
+ end if;return new;
+end $$;
+create trigger operation_grant_history before update or delete on public.operation_grants for each row execute function public.live_core_history_guard();
+create trigger operation_task_history before update or delete on public.operation_model_tasks for each row execute function public.live_core_history_guard();
+
+-- The finite creation request authorizes plan/code/review/save-draft only.
+-- Logging out ends reader capabilities, not this explicit background grant.
+-- Account suspension, credential revocation, expiry or cancellation stops it.
+create function public.live_core_grant_active(p_operation_id uuid)returns boolean language plpgsql volatile security definer set search_path=public,pg_temp as $$
+declare g operation_grants;o operations;
+begin
+ select * into g from operation_grants where operation_id=p_operation_id for share;
+ if not found or g.revoked_at is not null or g.expires_at<=clock_timestamp()then return false;end if;
+ select * into o from operations where id=p_operation_id;
+ if o.engine<>'astra-v1'or o.workspace_id<>g.workspace_id or o.artifact_id<>g.artifact_id or o.actor_id<>g.actor_id or o.request_hash<>g.request_hash then return false;end if;
+ perform 1 from auth.users where id=g.actor_id and email_confirmed_at is not null and deleted_at is null and (banned_until is null or banned_until<=clock_timestamp())for share;
+ if not found then return false;end if;
+ if not exists(select 1 from workspaces where id=g.workspace_id and owner_id=g.actor_id)or not exists(select 1 from artifacts where id=g.artifact_id and workspace_id=g.workspace_id and deleted_at is null)then return false;end if;
+ if g.origin_credential_id is not null then
+  perform 1 from agent_credentials where id=g.origin_credential_id and workspace_id=g.workspace_id and revoked_at is null and 'artifact:write'=any(scopes)for share;
+  if not found then return false;end if;
+ end if;
+ return true;
+end $$;
+
+-- Individual plan allowances are independent of the shared supplier-funding
+-- pool. Free is a lifetime trial; paid plan allowances reset by UTC month.
+create function public.live_workspace_model_available(p_workspace_id uuid,p_source text)returns bigint language plpgsql security definer set search_path=public,pg_temp as $$
+declare v_plan text;v_limit bigint;v_used bigint;v_legacy bigint;v_period date:=date_trunc('month',now()at time zone'UTC')::date;
+begin
+ if p_source='prepaid'then return greatest(0,live_runtime_available(p_workspace_id,'prepaid',v_period)/2);end if;
+ if p_source is distinct from 'platform'then raise exception 'RUNTIME_FUNDING_INVALID';end if;
+ select plan_code into v_plan from workspaces where id=p_workspace_id;if not found then raise exception 'NOT_FOUND';end if;
+ v_limit:=case v_plan when 'free'then 1000000000 when 'starter'then 2000000000 when 'pro'then 7000000000 end;
+ select coalesce(sum(case when status in ('reserved','dispatched','unknown')then maximum_cost_nanos when status='settled'then actual_cost_nanos else 0 end),0)into v_used from runtime_reservations where workspace_id=p_workspace_id and source='platform'and purpose in ('planner','coder','reviewer','qa')and(v_plan='free'or period=v_period);
+ select coalesce(sum(cents::bigint*10000000),0)into v_legacy from ai_reservations where workspace_id=p_workspace_id and(v_plan='free'or created_at>=v_period::timestamptz);
+ return v_limit-v_used-v_legacy;
+end $$;
+
+create function public.live_create_core_operation(p_actor_id uuid,p_workspace_id uuid,p_artifact_id uuid,p_base_version_id uuid,p_kind text,p_prompt text,p_key text,p_request_hash text,p_funding_source text,p_auth_session_id uuid,p_agent_credential_id uuid)
+returns uuid language plpgsql security definer set search_path=public,pg_temp as $$
+declare w workspaces;a artifacts;o operations;v_artifact uuid:=p_artifact_id;v_id uuid;
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into w from workspaces where id=p_workspace_id and owner_id=p_actor_id for update;if not found then raise exception 'FORBIDDEN';end if;
+ if not live_upload_proof_active(p_actor_id,p_workspace_id,p_auth_session_id,p_agent_credential_id)then raise exception 'AUTH_REVOKED';end if;
+ if p_kind is null or p_kind not in ('app','document')or p_prompt is null or length(trim(p_prompt))not between 3 and 6000 or p_key is null or length(p_key)not between 8 and 100 or p_request_hash is null or p_request_hash!~'^[a-f0-9]{64}$'or p_funding_source is null or p_funding_source not in ('platform','prepaid')then raise exception 'INVALID_OPERATION';end if;
+ select * into o from operations where workspace_id=p_workspace_id and idempotency_key=p_key;
+ if found then
+  if o.engine<>'astra-v1'or o.request_hash<>p_request_hash or o.actor_id<>p_actor_id or o.kind<>p_kind or o.prompt<>p_prompt or o.base_version_id is distinct from p_base_version_id or p_artifact_id is not null and o.artifact_id<>p_artifact_id or not exists(select 1 from operation_grants where operation_id=o.id and funding_source=p_funding_source)then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+  return o.id;
+ end if;
+ if live_workspace_model_available(w.id,p_funding_source)<=0 then raise exception 'RUNTIME_WORKSPACE_ALLOWANCE';end if;
+ if p_artifact_id is null then
+  if p_base_version_id is not null then raise exception 'VERSION_CONFLICT';end if;
+  if(select count(*)from artifacts where workspace_id=w.id and deleted_at is null)>=(case w.plan_code when 'free'then 20 when 'starter'then 100 else 500 end)then raise exception 'ARTIFACT_LIMIT';end if;
+  insert into artifacts(workspace_id,title,kind)values(w.id,left(p_prompt,80),p_kind)returning id into v_artifact;
+ else
+  select * into a from artifacts where id=p_artifact_id and workspace_id=w.id and deleted_at is null for update;
+  if not found then raise exception 'NOT_FOUND';end if;
+  if a.kind<>p_kind or a.latest_version_id is distinct from p_base_version_id then raise exception 'VERSION_CONFLICT';end if;
+ end if;
+ if exists(select 1 from operations where artifact_id=v_artifact and status in ('queued','running','paused'))then raise exception 'RUNTIME_PROJECT_BUSY';end if;
+ if(select count(*)from operations where workspace_id=w.id and status in ('queued','running','paused'))>=10 then raise exception 'AI_BUSY';end if;
+ insert into operations(workspace_id,actor_id,artifact_id,base_version_id,kind,prompt,idempotency_key,request_hash,engine,phase)values(w.id,p_actor_id,v_artifact,p_base_version_id,p_kind,p_prompt,p_key,p_request_hash,'astra-v1','planning')returning id into v_id;
+ insert into operation_grants(operation_id,workspace_id,artifact_id,actor_id,request_hash,funding_source,origin_session_id,origin_credential_id)values(v_id,w.id,v_artifact,p_actor_id,p_request_hash,p_funding_source,p_auth_session_id,p_agent_credential_id);
+ insert into operation_outbox(operation_id,workspace_id)values(v_id,w.id);
+ insert into audit_events(workspace_id,actor_id,action,target_id,trace_id,metadata)values(w.id,p_actor_id,'generation.queued',v_id,v_id::text,jsonb_build_object('engine','astra-v1','fundingSource',p_funding_source));
+ return v_id;
+end $$;
+
+create function public.live_core_task_snapshot(p_operation_id uuid,p_runner_id text)returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare o operations;g operation_grants;
+begin
+ select * into o from operations where id=p_operation_id and engine='astra-v1';
+ if not found or o.runner_id is distinct from p_runner_id then raise exception 'CORE_RUNNER_DENIED';end if;
+ select * into g from operation_grants where operation_id=o.id;
+ return jsonb_build_object('operation',to_jsonb(o),'fundingSource',g.funding_source,'availableCostNanos',least(live_workspace_model_available(o.workspace_id,g.funding_source),case when g.funding_source='prepaid'then live_runtime_available(o.workspace_id,g.funding_source,date_trunc('month',now())::date)/2 else live_runtime_available(o.workspace_id,g.funding_source,date_trunc('month',now())::date)end)::text,
+ 'grantActive',live_core_grant_active(o.id),'tasks',coalesce((select jsonb_agg(to_jsonb(t)||jsonb_build_object('reservationStatus',r.status)order by t.ordinal,t.attempt)from operation_model_tasks t join runtime_reservations r on r.id=t.reservation_id where t.operation_id=o.id),'[]'::jsonb));
+end $$;
+
+create function public.live_prepare_core_task(p_operation_id uuid,p_runner_id text,p_ordinal integer,p_messages jsonb,p_quote jsonb,p_candidate_task_id uuid default null)
+returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare o operations;g operation_grants;t operation_model_tasks;dependency operation_model_tasks;r jsonb;role text;v_id uuid;v_attempt integer:=0;v_state text;
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into o from operations where id=p_operation_id and engine='astra-v1'for update;
+ if not found or o.runner_id is distinct from p_runner_id or o.status<>'running'then raise exception 'CORE_RUNNER_DENIED';end if;
+ if not live_core_grant_active(o.id)then raise exception 'CORE_GRANT_REVOKED';end if;
+ if not exists(select 1 from artifacts where id=o.artifact_id and latest_version_id is not distinct from o.base_version_id and deleted_at is null)then raise exception 'VERSION_CONFLICT';end if;
+ if p_ordinal is null or p_ordinal not between 0 and 6 then raise exception 'CORE_TASK_INVALID';end if;
+ role:=case when p_ordinal=0 then 'planner'when p_ordinal%2=1 then 'coder'else 'reviewer'end;
+ if p_quote is null or jsonb_typeof(p_quote)<>'object'or p_quote->>'model'is distinct from 'openai/gpt-6-astra'or p_quote->>'role'is distinct from role or p_quote->>'requestHash'is null or p_quote->>'requestHash'!~'^[a-f0-9]{64}$'or p_quote->>'maximumCostNanos'is null or p_quote->>'maximumCostNanos'!~'^[0-9]{1,12}$'or p_quote->>'policy'is null or p_messages is null or jsonb_typeof(p_messages)<>'array'then raise exception 'CORE_TASK_INVALID';end if;
+ select * into t from operation_model_tasks where operation_id=o.id and ordinal=p_ordinal order by attempt desc limit 1;
+ if found then
+  select status into v_state from runtime_reservations where id=t.reservation_id;
+  if v_state<>'released' then
+   if t.messages is distinct from p_messages or t.quote is distinct from p_quote or t.candidate_task_id is distinct from p_candidate_task_id then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+   return to_jsonb(t)||jsonb_build_object('reservationStatus',v_state);
+  end if;
+  if t.attempt>=3 or exists(select 1 from runtime_reservations where id=t.reservation_id and dispatched_at is not null)then raise exception 'CORE_TASK_EXHAUSTED';end if;
+  v_attempt:=t.attempt+1;
+ end if;
+ if p_ordinal>0 then
+  if p_ordinal=1 then
+   select * into dependency from operation_model_tasks where operation_id=o.id and ordinal=0 and completed_at is not null and output_error is null and not discarded;
+  elsif role='reviewer'then
+   select * into dependency from operation_model_tasks where operation_id=o.id and ordinal=p_ordinal-1 and id=p_candidate_task_id and completed_at is not null and output_error is null and not discarded;
+  else
+   select * into dependency from operation_model_tasks where operation_id=o.id and ordinal=p_ordinal-1 and completed_at is not null and not discarded and(output_error is not null or output->>'passed'='false');
+   if not found then select * into dependency from operation_model_tasks where operation_id=o.id and ordinal=p_ordinal-2 and completed_at is not null and output_error is not null and not discarded;end if;
+  end if;
+  if dependency.id is null then raise exception 'CORE_DEPENDENCY_REQUIRED';end if;
+ end if;
+ if(role='reviewer')<>(p_candidate_task_id is not null)then raise exception 'CORE_TASK_INVALID';end if;
+ select * into g from operation_grants where operation_id=o.id;
+ if live_workspace_model_available(o.workspace_id,g.funding_source)<(p_quote->>'maximumCostNanos')::bigint then raise exception 'RUNTIME_WORKSPACE_ALLOWANCE';end if;
+ r:=live_reserve_runtime(o.workspace_id,o.artifact_id,o.id,'core-'||o.id::text||'-'||p_ordinal||'-'||v_attempt,p_quote->>'requestHash',g.funding_source,role,p_quote->>'model',p_quote->>'policy',(p_quote->>'maximumCostNanos')::bigint);
