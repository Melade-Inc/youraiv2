+ else
+  if old.completed_at is not null or new.completed_at is null or(to_jsonb(new)-array['receipt','output','output_error','discarded','completed_at'])is distinct from(to_jsonb(old)-array['receipt','output','output_error','discarded','completed_at'])then raise exception 'CORE_TASK_IMMUTABLE';end if;
+ end if;return new;
