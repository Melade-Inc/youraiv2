diff --git a/tests/sql/cloudflare-capacity.sql b/tests/sql/cloudflare-capacity.sql
new file mode 100644
index 0000000..e46d106
--- /dev/null
+++ b/tests/sql/cloudflare-capacity.sql
@@ -0,0 +1,27 @@
+begin;
+do $$
+declare actor uuid:=gen_random_uuid();workspace uuid;artifact uuid;reservation uuid;next_id uuid;available bigint;policy text:='cloudflare-standard-2026-09-05-v1';receipt jsonb;
+begin
+ insert into auth.users(id,email,email_confirmed_at)values(actor,'cloudflare-capacity@example.test',now());workspace:=live_ensure_workspace(actor);artifact:=live_create_artifact(actor,workspace,'Capacity test','app','test');
+ reservation:=(live_reserve_runtime(workspace,artifact,null,'capacity-observed',repeat('a',64),'platform','r2-read',null,policy,6520)->>'id')::uuid;
+ assert live_dispatch_runtime(reservation,workspace,repeat('a',64));
+ receipt:=jsonb_build_object('schemaVersion',1,'environment','production','scriptName','live-link-r2-production','scriptVersion','11111111-0000-4000-8000-000000000002','eventTimestamp',floor(extract(epoch from clock_timestamp())*1000),'reservationId',reservation,'requestHash',repeat('a',64),'policy',policy,'purpose','r2-read','outcome','ok','cpuMs',3,'wallMs',28,'complete',true,'attemptedClassA',1,'attemptedClassB',2,'listPriceCostNanos','5580','exceedsQuote',false,'costBasis','metered-list-price-before-inclusions-and-billing-rounding');
+ perform live_record_cloudflare_usage('production',receipt);
+ -- Fill the other 999 genuinely pending slots, without issuing provider calls.
+ insert into runtime_reservations(workspace_id,artifact_id,idempotency_key,request_hash,source,purpose,policy,period,maximum_cost_nanos,charged_maximum_nanos)
+ select workspace,artifact,'capacity-pending-'||n,repeat('b',64),'platform','r2-read',policy,date_trunc('month',now())::date,6520,6520 from generate_series(1,999)n;
+ available:=live_runtime_available(workspace,'platform',date_trunc('month',now())::date);
+ -- The completed invocation frees its slot, but never refunds its cost hold.
+ next_id:=(live_reserve_runtime(workspace,artifact,null,'capacity-next',repeat('c',64),'platform','r2-read',null,policy,6520)->>'id')::uuid;
+ assert next_id is not null;
+ assert live_runtime_available(workspace,'platform',date_trunc('month',now())::date)=available-6520;
+ assert (select status='unknown' and actual_cost_nanos is null and maximum_cost_nanos=6520 from runtime_reservations where id=reservation);
+ assert (select count(*)=1001 from runtime_reservations where workspace_id=workspace);
+ begin perform live_reserve_runtime(workspace,artifact,null,'capacity-full',repeat('d',64),'platform','r2-read',null,policy,6520);raise exception 'pending capacity bypass';exception when raise_exception then if sqlerrm<>'RUNTIME_BUSY' then raise;end if;end;
+ -- A partial observation proves no completion and retains its active slot.
+ assert live_dispatch_runtime(next_id,workspace,repeat('c',64));
+ perform live_record_cloudflare_usage('production',receipt||jsonb_build_object('reservationId',next_id,'requestHash',repeat('c',64),'complete',false,'attemptedClassA',null,'attemptedClassB',null,'listPriceCostNanos',null));
+ begin perform live_reserve_runtime(workspace,artifact,null,'capacity-partial',repeat('d',64),'platform','r2-read',null,policy,6520);raise exception 'partial capacity bypass';exception when raise_exception then if sqlerrm<>'RUNTIME_BUSY' then raise;end if;end;
+ assert live_runtime_available(workspace,'platform',date_trunc('month',now())::date)=available-6520;
+end $$;
+rollback;
