+create function public.live_admit_storage_audit(p_body text,p_timestamp bigint,p_nonce text)
+returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare v_input jsonb;v_grant storage_audit_grants;v_ref jsonb;v_key text;v_hash text;v_body_hash text;v_reservation jsonb;v_id uuid;
+begin
+ if p_body is null or octet_length(p_body)>8192 or p_timestamp is null or p_timestamp<floor(extract(epoch from clock_timestamp()))-5 or p_timestamp>floor(extract(epoch from clock_timestamp()))+5
+  or p_nonce is null or p_nonce!~'^[a-f0-9]{32}$' then raise exception 'STORAGE_AUDIT_INVALID';end if;
+ begin v_input:=p_body::jsonb;exception when others then raise exception 'STORAGE_AUDIT_INVALID';end;
+ if jsonb_typeof(v_input) is distinct from 'object' or coalesce(v_input->>'grantId','')!~'^[a-f0-9]{8}-([a-f0-9]{4}-){3}[a-f0-9]{12}$' then raise exception 'STORAGE_AUDIT_INVALID';end if;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into v_grant from storage_audit_grants where id=(v_input->>'grantId')::uuid for update;
+ if not found or v_grant.revoked_at is not null or v_grant.expires_at<clock_timestamp()+interval '65 seconds' or v_grant.requests_used>=v_grant.maximum_requests then raise exception 'STORAGE_AUDIT_DENIED';end if;
+ if v_input->'scope' is distinct from v_grant.scope then raise exception 'STORAGE_AUDIT_DENIED';end if;
+ if v_input->>'action'='list' then
+  if not(v_input?&array['grantId','scope','action','limit','cursor']) or v_input-array['grantId','scope','action','limit','cursor']<>'{}'::jsonb
+   or jsonb_typeof(v_input->'limit') is distinct from 'number' or (v_input->>'limit')!~'^[0-9]{1,3}$' then raise exception 'STORAGE_AUDIT_INVALID';end if;
+  if (v_input->>'limit')::integer not between 1 and 100 or v_input->'cursor'<>'null'::jsonb and (jsonb_typeof(v_input->'cursor') is distinct from 'string' or length(v_input->>'cursor') not between 1 and 4096 or (v_input->>'cursor')!~'^[!-~]+$') then raise exception 'STORAGE_AUDIT_INVALID';end if;
+ elsif v_input->>'action'='head' then
+  if not(v_input?&array['grantId','scope','action','reference']) or v_input-array['grantId','scope','action','reference']<>'{}'::jsonb then raise exception 'STORAGE_AUDIT_INVALID';end if;
+  v_ref:=v_input->'reference';
+  if jsonb_typeof(v_ref) is distinct from 'object' or not(v_ref?&array['workspaceId','artifactId','versionId','sha256']) or v_ref-array['workspaceId','artifactId','versionId','sha256','mediaType']<>'{}'::jsonb then raise exception 'STORAGE_AUDIT_INVALID';end if;
+  foreach v_key in array array['workspaceId','artifactId','versionId'] loop
+   if jsonb_typeof(v_ref->v_key) is distinct from 'string' or v_ref->>v_key!~'^[a-f0-9]{8}-([a-f0-9]{4}-){3}[a-f0-9]{12}$' then raise exception 'STORAGE_AUDIT_INVALID';end if;
+  end loop;
+  if jsonb_typeof(v_ref->'sha256') is distinct from 'string' or v_ref->>'sha256'!~'^[a-f0-9]{64}$' or v_ref?'mediaType' and (jsonb_typeof(v_ref->'mediaType') is distinct from 'string' or length(v_ref->>'mediaType')>100 or v_ref->>'mediaType'!~'^[a-z]+/[a-z0-9.+-]+$') then raise exception 'STORAGE_AUDIT_INVALID';end if;
+  if v_grant.scope->'workspaceId'<>'null'::jsonb and v_ref->'workspaceId'<>v_grant.scope->'workspaceId' then raise exception 'STORAGE_AUDIT_DENIED';end if;
+ else raise exception 'STORAGE_AUDIT_INVALID';end if;
+ if exists(select 1 from storage_audit_invocations where grant_id=v_grant.id and nonce=p_nonce)then raise exception 'STORAGE_AUDIT_ALREADY_DISPATCHED';end if;
+ v_body_hash:=encode(sha256(convert_to(p_body,'UTF8')),'hex');
+ v_hash:=encode(sha256(convert_to(concat_ws(E'\n','LiveLinkStorageAuditFunding/1',v_grant.scope->>'environment',v_grant.scope->>'bucket',v_grant.scope->>'origin',v_grant.scope->>'audience',p_timestamp::text,p_nonce,v_body_hash),'UTF8')),'hex');
+ -- The finite grant and the exact request share one budget transaction. No
+ -- request can reach the Worker twice after a lost admission response.
+ v_reservation:=live_reserve_runtime(v_grant.workspace_id,null,null,'inventory:'||v_grant.id::text||':'||p_nonce,v_hash,'platform','r2-inventory',null,'cloudflare-inventory-ceiling-2026-09-06-v1',20200);
+ v_id:=(v_reservation->>'id')::uuid;
+ if not live_dispatch_runtime(v_id,v_grant.workspace_id,v_hash)then raise exception 'STORAGE_AUDIT_DENIED';end if;
+ update storage_audit_grants set requests_used=requests_used+1 where id=v_grant.id;
+ insert into storage_audit_invocations(grant_id,nonce,reservation_id,request_hash,request_body)values(v_grant.id,p_nonce,v_id,v_hash,p_body);
+ return jsonb_build_object('funding',jsonb_build_object('reservationId',v_id,'requestHash',v_hash,'policy','cloudflare-inventory-ceiling-2026-09-06-v1','purpose','r2-inventory'),'maximumCostNanos','20200','dispatched',true);
+end $$;
+
+create function public.live_revoke_storage_audit(p_grant_id uuid,p_workspace_id uuid)
+returns boolean language plpgsql security definer set search_path=public,pg_temp as $$
+begin
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ perform 1 from storage_audit_grants where id=p_grant_id and workspace_id=p_workspace_id for update;if not found then raise exception 'STORAGE_AUDIT_DENIED';end if;
+ update storage_audit_grants set revoked_at=now()where id=p_grant_id and revoked_at is null;
+ return true;
+end $$;
+revoke all on function public.live_storage_audit_guard(),public.live_create_storage_audit(jsonb,text,integer,integer),public.live_admit_storage_audit(text,bigint,text),public.live_revoke_storage_audit(uuid,uuid) from public,anon,authenticated;
+grant execute on function public.live_create_storage_audit(jsonb,text,integer,integer),public.live_admit_storage_audit(text,bigint,text),public.live_revoke_storage_audit(uuid,uuid) to service_role;
+
+alter table public.runtime_reservations drop constraint runtime_reservations_purpose_check;
+alter table public.runtime_reservations add constraint runtime_reservations_purpose_check check(purpose in ('planner','coder','reviewer','qa','r2-upload','r2-read','r2-cleanup','r2-inventory','browser-run','sandbox'));
+
+create or replace function public.live_reserve_runtime(p_workspace_id uuid,p_artifact_id uuid,p_operation_id uuid,p_key text,p_request_hash text,p_source text,p_purpose text,p_model text,p_policy text,p_maximum_cost_nanos bigint)
+returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare v_old runtime_reservations;v_id uuid;v_period date:=date_trunc('month',now() at time zone 'UTC')::date;v_charge bigint;v_op operations;
+begin
+ if p_workspace_id is null or p_key is null or length(p_key) not between 8 and 160 or p_request_hash is null or p_request_hash !~ '^[a-f0-9]{64}$' or p_source is null or p_source not in ('platform','prepaid') or p_purpose is null or p_purpose not in ('planner','coder','reviewer','qa','r2-upload','r2-read','r2-cleanup','r2-inventory','browser-run','sandbox') or p_policy is null or length(p_policy) not between 3 and 100 or p_maximum_cost_nanos is null or p_maximum_cost_nanos not between 1 and 100000000000 then raise exception 'RUNTIME_INTENT_INVALID';end if;
+ if p_purpose in ('planner','coder','reviewer') and (p_model is distinct from 'openai/gpt-6-astra' or p_operation_id is null or p_artifact_id is null) or p_purpose not in ('planner','coder','reviewer') and p_model is not null then raise exception 'CORE_MODEL_REQUIRED';end if;
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ -- Reclaim only never-dispatched stale holds, in a bounded batch. A late
+ -- dispatch for one of these records sees released status and cannot run.
+ with expired as(select id from runtime_reservations where status='reserved' and (expires_at<=now() or source='platform' and period<>v_period) order by created_at limit 100)
+ update runtime_reservations r set status='released',closed_reason='expired',settled_at=now()from expired where r.id=expired.id;
+ select * into v_old from runtime_reservations where workspace_id=p_workspace_id and idempotency_key=p_key;
+ if found then
+  if v_old.request_hash<>p_request_hash or v_old.artifact_id is distinct from p_artifact_id or v_old.operation_id is distinct from p_operation_id or v_old.source<>p_source or v_old.purpose<>p_purpose or v_old.model is distinct from p_model or v_old.policy<>p_policy or v_old.maximum_cost_nanos<>p_maximum_cost_nanos then raise exception 'IDEMPOTENCY_CONFLICT';end if;
+  return jsonb_build_object('id',v_old.id,'status',v_old.status,'maximumCostNanos',v_old.maximum_cost_nanos::text,'chargedMaximumNanos',v_old.charged_maximum_nanos::text);
+ end if;
+ if exists(select 1 from runtime_policy_pauses where policy=p_policy) then raise exception 'RUNTIME_POLICY_PAUSED';end if;
+ -- A complete, authenticated Tail observation proves the invocation ended.
+ -- It releases only concurrency capacity; its full cost remains encumbered by
+ -- live_runtime_available until supplier reconciliation settles that cost.
+ if (select count(*)from runtime_reservations r where r.workspace_id=p_workspace_id and r.status in ('reserved','dispatched','unknown')
+  and not(r.status='unknown' and r.purpose in ('r2-upload','r2-read','r2-cleanup','r2-inventory') and exists(select 1 from cloudflare_usage_observations o where o.reservation_id=r.id and o.workspace_id=r.workspace_id and o.complete)))>=1000 then raise exception 'RUNTIME_BUSY';end if;
+ if p_purpose='sandbox' and (select count(*)from runtime_reservations where purpose='sandbox' and status in ('reserved','dispatched','unknown'))>=2 then raise exception 'RUNTIME_SANDBOX_BUSY';end if;
+ perform 1 from workspaces where id=p_workspace_id;if not found then raise exception 'NOT_FOUND';end if;
+ if p_artifact_id is not null then
+  perform 1 from artifacts where id=p_artifact_id and workspace_id=p_workspace_id and (deleted_at is null or p_purpose in ('r2-cleanup','r2-inventory'));
+  if not found then raise exception 'NOT_FOUND';end if;
+ end if;
+ if p_operation_id is not null then
+  select * into v_op from operations where id=p_operation_id and workspace_id=p_workspace_id and artifact_id=p_artifact_id and status in ('queued','running') for update;
+  if not found then raise exception 'RUNTIME_OPERATION_INACTIVE';end if;
+ end if;
+ if p_purpose in ('planner','coder','reviewer') then
+  if (select count(*) from runtime_reservations where purpose in ('planner','coder','reviewer') and status in ('reserved','dispatched','unknown'))>=3 then raise exception 'RUNTIME_MODEL_BUSY';end if;
+  if exists(select 1 from runtime_reservations where artifact_id=p_artifact_id and purpose in ('planner','coder','reviewer') and status in ('reserved','dispatched','unknown') and operation_id<>p_operation_id) then raise exception 'RUNTIME_PROJECT_BUSY';end if;
+ end if;
+ v_charge:=p_maximum_cost_nanos*case when p_source='prepaid' then 2 else 1 end;
+ if live_runtime_available(p_workspace_id,p_source,v_period)<v_charge then raise exception 'RUNTIME_BUDGET_EXHAUSTED';end if;
+ insert into runtime_reservations(workspace_id,artifact_id,operation_id,idempotency_key,request_hash,source,purpose,model,policy,period,maximum_cost_nanos,charged_maximum_nanos)
+ values(p_workspace_id,p_artifact_id,p_operation_id,p_key,p_request_hash,p_source,p_purpose,p_model,p_policy,v_period,p_maximum_cost_nanos,v_charge) returning id into v_id;
+ return jsonb_build_object('id',v_id,'status','reserved','maximumCostNanos',p_maximum_cost_nanos::text,'chargedMaximumNanos',v_charge::text);
+end $$;
+
+create or replace function public.live_record_cloudflare_usage(p_environment text,p_receipt jsonb)
+returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare v_runtime runtime_reservations;v_old cloudflare_usage_observations;v_id uuid;v_hash text;v_key text;
+ v_complete boolean;v_cpu bigint;v_wall bigint;v_event bigint;v_a bigint;v_b bigint;v_cost bigint;
+ v_cpu_limit bigint;v_a_limit bigint;v_b_limit bigint:=2;v_maximum bigint;v_exceeded boolean;
+ v_keys text[]:=array['schemaVersion','environment','scriptName','scriptVersion','eventTimestamp','reservationId','requestHash','policy','purpose','outcome','cpuMs','wallMs','complete','attemptedClassA','attemptedClassB','listPriceCostNanos','exceedsQuote','costBasis'];
+begin
+ if p_environment is null or p_environment not in ('preview','production') or p_receipt is null or jsonb_typeof(p_receipt) is distinct from 'object' or octet_length(p_receipt::text)>4096 then raise exception 'CLOUDFLARE_RECEIPT_INVALID';end if;
+ if not(p_receipt?&v_keys) or (p_receipt-v_keys)<>'{}'::jsonb then raise exception 'CLOUDFLARE_RECEIPT_INVALID';end if;
+ if p_receipt->'schemaVersion'<>'1'::jsonb or p_receipt->>'environment'<>p_environment or not (p_receipt->>'scriptName'='live-link-r2-'||p_environment or p_receipt->>'scriptName'='live-link-upload-'||p_environment and p_receipt->>'purpose'='r2-upload')
+  or p_receipt->>'policy'<>(case when p_receipt->>'purpose'='r2-inventory' then 'cloudflare-inventory-ceiling-2026-09-06-v1' else 'cloudflare-standard-2026-09-05-v1' end) or p_receipt->>'purpose' not in ('r2-upload','r2-read','r2-cleanup','r2-inventory')
+  or p_receipt->>'costBasis'<>(case when p_receipt->>'purpose'='r2-inventory' then 'metered-inventory-upper-bound-before-inclusions-and-billing-rounding' else 'metered-list-price-before-inclusions-and-billing-rounding' end)
+  or coalesce(p_receipt->>'reservationId','')!~'^[a-f0-9]{8}-([a-f0-9]{4}-){3}[a-f0-9]{12}$'
+  or coalesce(p_receipt->>'requestHash','')!~'^[a-f0-9]{64}$'
+  or coalesce(p_receipt->>'scriptVersion','')!~'^([a-f0-9]{32}|[a-f0-9]{8}-([a-f0-9]{4}-){3}[a-f0-9]{12})$'
+  or p_receipt->>'outcome' not in ('ok','exception','exceededCpu','exceededMemory','canceled','unknown','responseStreamDisconnected')
+  or jsonb_typeof(p_receipt->'complete') is distinct from 'boolean' or jsonb_typeof(p_receipt->'exceedsQuote') is distinct from 'boolean' then raise exception 'CLOUDFLARE_RECEIPT_INVALID';end if;
+ foreach v_key in array array['environment','scriptName','scriptVersion','reservationId','requestHash','policy','purpose','outcome','costBasis'] loop
+  if jsonb_typeof(p_receipt->v_key) is distinct from 'string' then raise exception 'CLOUDFLARE_RECEIPT_INVALID';end if;
+ end loop;
+ foreach v_key in array array['cpuMs','wallMs','eventTimestamp'] loop
+  if jsonb_typeof(p_receipt->v_key) is distinct from 'number' or coalesce(p_receipt->>v_key,'')!~'^[0-9]{1,16}$' then raise exception 'CLOUDFLARE_RECEIPT_INVALID';end if;
+ end loop;
+ v_cpu:=(p_receipt->>'cpuMs')::bigint;v_wall:=(p_receipt->>'wallMs')::bigint;v_event:=(p_receipt->>'eventTimestamp')::bigint;v_complete:=(p_receipt->>'complete')::boolean;
+ if v_cpu>900000 or v_wall>86400000 or v_event>9007199254740991 then raise exception 'CLOUDFLARE_RECEIPT_INVALID';end if;
+ v_cpu_limit:=case when p_receipt->>'purpose'='r2-upload' then 30000 else 50 end;
+ v_a_limit:=case when p_receipt->>'purpose' in ('r2-upload','r2-inventory') then 2 else 1 end;
+ v_b_limit:=case when p_receipt->>'purpose'='r2-inventory' then 1 else 2 end;
+ v_maximum:=300+v_cpu_limit*20+v_a_limit*(case when p_receipt->>'purpose'='r2-inventory' then 9000 else 4500 end)+v_b_limit*(case when p_receipt->>'purpose'='r2-inventory' then 900 else 360 end);
+ if v_complete then
+  foreach v_key in array array['attemptedClassA','attemptedClassB'] loop
+   if jsonb_typeof(p_receipt->v_key) is distinct from 'number' or coalesce(p_receipt->>v_key,'')!~'^[0-9]{1,5}$' then raise exception 'CLOUDFLARE_RECEIPT_INVALID';end if;
+  end loop;
+  v_a:=(p_receipt->>'attemptedClassA')::bigint;v_b:=(p_receipt->>'attemptedClassB')::bigint;
+  if v_a>10000 or v_b>10000 then raise exception 'CLOUDFLARE_RECEIPT_INVALID';end if;
+  v_cost:=300+v_cpu*20+v_a*(case when p_receipt->>'purpose'='r2-inventory' then 9000 else 4500 end)+v_b*(case when p_receipt->>'purpose'='r2-inventory' then 900 else 360 end);
+  if jsonb_typeof(p_receipt->'listPriceCostNanos') is distinct from 'string' or p_receipt->>'listPriceCostNanos' is distinct from v_cost::text then raise exception 'CLOUDFLARE_RECEIPT_INVALID';end if;
+ elsif p_receipt->'attemptedClassA'<>'null'::jsonb or p_receipt->'attemptedClassB'<>'null'::jsonb or p_receipt->'listPriceCostNanos'<>'null'::jsonb then raise exception 'CLOUDFLARE_RECEIPT_INVALID';
+ end if;
+ v_exceeded:=v_cpu>v_cpu_limit or (v_complete and (v_a>v_a_limit or v_b>v_b_limit));
+ if p_receipt->'exceedsQuote' is distinct from to_jsonb(v_exceeded) then raise exception 'CLOUDFLARE_RECEIPT_INVALID';end if;
+ v_id:=(p_receipt->>'reservationId')::uuid;v_hash:=encode(sha256(convert_to(p_receipt::text,'UTF8')),'hex');
+ perform pg_advisory_xact_lock(hashtextextended('live_ai_budget',0));
+ select * into v_runtime from runtime_reservations where id=v_id for update;
+ if not found or v_runtime.source<>'platform' or v_runtime.purpose<>p_receipt->>'purpose' or v_runtime.policy<>p_receipt->>'policy' or v_runtime.request_hash<>p_receipt->>'requestHash'
+  or v_runtime.model is not null or v_runtime.maximum_cost_nanos<>v_maximum or v_runtime.dispatched_at is null then raise exception 'CLOUDFLARE_RESERVATION_MISMATCH';end if;
+ if v_runtime.purpose='r2-inventory' and not exists(select 1 from storage_audit_invocations i join storage_audit_grants g on g.id=i.grant_id where i.reservation_id=v_id and i.request_hash=v_runtime.request_hash and g.workspace_id=v_runtime.workspace_id and g.scope->>'environment'=p_environment)then raise exception 'CLOUDFLARE_RESERVATION_MISMATCH';end if;
+ select * into v_old from cloudflare_usage_observations where reservation_id=v_id;
+ if found then
+  if v_old.receipt<>p_receipt or v_old.receipt_hash<>v_hash then raise exception 'CLOUDFLARE_RECEIPT_CONFLICT';end if;
+  return jsonb_build_object('reservationId',v_id,'recorded',true,'complete',v_old.complete,'requiresReconciliation',true);
+ end if;
+ if v_runtime.status not in ('dispatched','unknown') or v_event<extract(epoch from v_runtime.dispatched_at)*1000-(case when v_runtime.purpose in ('r2-upload','r2-cleanup') then 65000 else 5000 end)
+  or v_event>extract(epoch from v_runtime.expires_at)*1000+5000 or v_event>extract(epoch from clock_timestamp())*1000+5000 then raise exception 'CLOUDFLARE_RESERVATION_MISMATCH';end if;
+ insert into cloudflare_usage_observations(reservation_id,workspace_id,receipt,receipt_hash,complete,metered_list_price_nanos)
+ values(v_id,v_runtime.workspace_id,p_receipt,v_hash,v_complete,v_cost);
+ -- Even a complete observation does not establish billed supplier cost.
+ perform live_close_runtime(v_id,v_runtime.workspace_id,v_runtime.request_hash,'unknown');
+ if v_exceeded then insert into runtime_policy_pauses(policy,reservation_id,reason)values(v_runtime.policy,v_id,'cost-overrun')on conflict do nothing;end if;
+ return jsonb_build_object('reservationId',v_id,'recorded',true,'complete',v_complete,'requiresReconciliation',true);
+end $$;
