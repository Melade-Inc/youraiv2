+++ b/tests/sql/storage-inventory-history.sql
@@ -0,0 +1,22 @@
+-- Dense metadata fixture: 100 saved versions share 1,000 stored files. This is
+-- a local query observation, not provider CPU or full-workspace acceptance.
+begin;
+do $$
+declare actor uuid:=gen_random_uuid();workspace uuid;artifact uuid;object_version uuid:=gen_random_uuid();manifest jsonb;files jsonb;item jsonb;result jsonb;started timestamptz;elapsed numeric;
+begin
+ insert into auth.users(id,email,email_confirmed_at)values(actor,'inventory-dense-history@example.test',now());workspace:=live_ensure_workspace(actor);
+ update workspaces set plan_code='pro' where id=workspace;
+ artifact:=live_create_artifact(actor,workspace,'Dense history','app','inventory-history');
+ select jsonb_agg(jsonb_build_object('path',case when n=1 then 'index.html' else repeat('a',170)||'/file-'||lpad(n::text,4,'0')||'.txt' end,'mediaType',case when n=1 then 'text/html' else 'text/plain' end,'size',100,'sha256',encode(sha256(convert_to(n::text,'UTF8')),'hex'),'encoding','r2','content','','storage',jsonb_build_object('versionId',object_version)) order by n) into files from generate_series(1,1000) n;
+ manifest:=jsonb_build_object('schemaVersion',2,'kind','app','title','Dense history','description','','entrypoint','index.html','blocks','[]'::jsonb,'files',files);
+ assert octet_length(manifest::text)<1048576;
+ insert into artifact_versions(id,workspace_id,artifact_id,number,manifest,content_hash,idempotency_key)select gen_random_uuid(),workspace,artifact,n,manifest,encode(sha256(convert_to(n::text,'UTF8')),'hex'),'inventory-history-'||n from generate_series(1,100) n;
+ perform live_begin_cloudflare_hosting();
+ for item in select value from jsonb_array_elements(files) limit 100 loop perform live_track_cloudflare_object('preview',workspace,artifact,object_version,item->>'sha256',item->>'mediaType',100);end loop;
+ started:=clock_timestamp();result:=live_storage_inventory(workspace,'preview',null,100);elapsed:=extract(epoch from clock_timestamp()-started)*1000;
+ assert jsonb_array_length(result->'objects')=100 and result->'nextCursor'='null'::jsonb;
+ assert not exists(select 1 from jsonb_array_elements(result->'objects') x where x->>'savedVersionReferences'<>'100' or x->>'classification'<>'saved-version');
+ assert elapsed<10000,'Dense inventory exceeded the adapter request budget';
+ raise notice 'Dense inventory: 100 objects, 100 versions, 1000 files/version, % ms',round(elapsed,1);
+end $$;
+rollback;
