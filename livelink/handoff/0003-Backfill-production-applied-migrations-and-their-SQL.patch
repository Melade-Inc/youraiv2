+create table public.project_content_purges (
+ removal_id uuid primary key references public.artifact_removals(id),
+ workspace_id uuid not null,artifact_id uuid not null unique,
+ phase text not null default 'checking'check(phase in ('checking','redacting','complete')),
+ block_reason text check(block_reason in ('storage-pending','reconciliation-required','accounting-mismatch')),
+ next_attempt_at timestamptz not null default clock_timestamp(),created_at timestamptz not null default clock_timestamp(),
+ redaction_started_at timestamptz,completed_at timestamptz,
