+ assert live_complete_core_generation(op,'core-run-3',(coder->>'id')::uuid,manifest,repeat('f',64))=v_version;
+ assert(select latest_version_id=v_version and title='Estimate'from artifacts where id=artifact);
+ assert not live_core_grant_active(op);assert not exists(select 1 from publications where artifact_id=artifact);
+ assert live_workspace_model_available(workspace,'platform')=970000000;
+
+ -- Cancellation/revocation cannot refund a paid result or revive its output.
+ op:=live_create_core_operation(actor,workspace,null,null,'document','Cancelled estimate','core-cancel',repeat('d',64),'platform',null,writer);select artifact_id into artifact from operations where id=op;
+ assert live_claim_operation(op,'core-cancel-run');
+ task:=live_prepare_core_task(op,'core-cancel-run',0,messages,pg_temp.core_quote('planner',repeat('d',64)));res:=(task->>'reservation_id')::uuid;
+ assert live_dispatch_core_runtime(res,workspace,artifact,op,repeat('d',64),'openai/gpt-6-astra','astra-20260905-v2','planner',100000000);
+ perform live_cancel_operation(actor,workspace,op,new_login,null);
+ perform live_record_core_result((task->>'id')::uuid,'core-cancel-run',pg_temp.core_receipt(repeat('d',64),'cancel-cost'),'{}');
+ assert(select discarded and output is null from operation_model_tasks where id=(task->>'id')::uuid);assert(select status='cancelled'from operations where id=op);
+ assert(select status='settled'and actual_cost_nanos=10000000 from runtime_reservations where id=res);
+ op:=live_create_core_operation(actor,workspace,null,null,'document','Revoked estimate','core-revoke',repeat('e',64),'platform',null,writer);select artifact_id into artifact from operations where id=op;
+ assert live_claim_operation(op,'core-revoke-run');task:=live_prepare_core_task(op,'core-revoke-run',0,messages,pg_temp.core_quote('planner',repeat('e',64)));res:=(task->>'reservation_id')::uuid;
+ update agent_credentials set revoked_at=now()where id=writer;
+ assert not live_core_grant_active(op);assert not live_dispatch_core_runtime(res,workspace,artifact,op,repeat('e',64),'openai/gpt-6-astra','astra-20260905-v2','planner',100000000);
+ perform live_cancel_operation(actor,workspace,op,new_login,null);
+
+ -- Workspace allowance cannot be bypassed by a large single task, even with
+ -- ample global funding. Paid plans use their own server-controlled allowance.
+ op:=live_create_core_operation(actor,workspace,null,null,'document','Budget estimate','core-budget',repeat('f',64),'platform',new_login,null);assert live_claim_operation(op,'core-budget-run');
+ begin perform live_prepare_core_task(op,'core-budget-run',0,messages,pg_temp.core_quote('planner',repeat('f',64),1000000000));raise exception 'workspace budget bypassed';exception when raise_exception then if sqlerrm<>'RUNTIME_WORKSPACE_ALLOWANCE'then raise;end if;end;
+ update workspaces set plan_code='starter'where id=workspace;assert live_workspace_model_available(workspace,'platform')=1960000000;
+ update workspaces set plan_code='pro'where id=workspace;assert live_workspace_model_available(workspace,'platform')=6960000000;
+ assert not has_table_privilege('service_role','public.operation_model_tasks','SELECT');
