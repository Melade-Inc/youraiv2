@@ -0,0 +1,16 @@
+create table test_hosting_race_fixture(label text primary key,actor uuid,workspace uuid,artifact uuid,upload uuid,hold uuid);
+do $$
+declare actor uuid;login uuid;workspace uuid;artifact uuid;upload uuid;v_hold uuid;label text;available bigint;
+begin
+ foreach label in array array['one','two'] loop
+  actor:=gen_random_uuid();login:=gen_random_uuid();insert into auth.users(id,email,email_confirmed_at)values(actor,'hosting-race-'||label||'@example.test',now());insert into auth.sessions(id,user_id)values(login,actor);
+  workspace:=live_ensure_workspace(actor);artifact:=live_create_artifact(actor,workspace,'Hosting race','app','test');
+  upload:=live_begin_upload(actor,workspace,artifact,'{"schemaVersion":2,"kind":"app","title":"Hosting race","entrypoint":"index.html","blocks":[],"files":[{"path":"index.html","mediaType":"text/html","size":100,"sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}'::jsonb,null,'hosting-race-upload',login,null,'test');
+  insert into test_hosting_race_fixture values(label,actor,workspace,artifact,upload,null);
+ end loop;
+ select f.workspace,f.artifact into workspace,artifact from test_hosting_race_fixture f where f.label='one';
+ available:=live_runtime_available(workspace,'platform',date_trunc('month',now() at time zone 'UTC')::date);
+ assert not exists(select 1 from cloudflare_hosting_months);
+ v_hold:=(live_reserve_runtime(workspace,artifact,null,'hosting-race-exhaustion',repeat('f',64),'platform','qa',null,'hosting-race',available-10015000000-610020)->>'id')::uuid;
+ update test_hosting_race_fixture f set hold=v_hold where f.label='one';
+end $$;
