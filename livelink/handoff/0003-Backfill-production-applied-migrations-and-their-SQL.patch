+begin
+ select * into v_transfer from artifact_upload_transfers where id=p_transfer_id and upload_id=p_upload_id and file_index=p_file_index and generation=p_generation for update;
+ if not found then raise exception 'UPLOAD_GRANT_INVALID';end if;
+ if v_transfer.status<>'admitted' then return;end if;
+ update artifact_upload_transfers set status='failed',finished_at=clock_timestamp() where id=p_transfer_id;
+ select workspace_id into v_workspace from artifact_uploads where id=p_upload_id;
+ insert into audit_events(workspace_id,action,target_id,trace_id,metadata) values(v_workspace,'upload.transfer.failed',p_transfer_id,p_transfer_id::text,jsonb_build_object('uploadId',p_upload_id,'fileIndex',p_file_index));
+end $$;
+
+create function public.live_transfer_immutable() returns trigger language plpgsql set search_path=public,pg_temp as $$
+begin
+ if tg_op='DELETE' or old.status<>'admitted' or new.status not in ('completed','failed') or new.finished_at is null
+  or (to_jsonb(new)-array['status','finished_at']) is distinct from (to_jsonb(old)-array['status','finished_at']) then raise exception 'IMMUTABLE_TRANSFER';end if;
+ return new;
+end $$;
+create trigger upload_transfer_immutable before update or delete on public.artifact_upload_transfers for each row execute function public.live_transfer_immutable();
