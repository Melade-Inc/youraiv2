+ assert exists(select 1 from jsonb_array_elements(live_storage_inventory(w,'preview')->'objects') x where x->>'classification'='unfinished-revision' and x->>'unfinishedRevisionReferences'='1');
+ control:='{"schemaVersion":2,"kind":"app","title":"Pending inventory","entrypoint":"index.html","blocks":[],"files":[{"path":"index.html","mediaType":"text/html","size":100,"sha256":"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"}]}';
+ upload:=live_begin_upload((f->>'actor')::uuid,w,a,control,b,'inventory-upload',(f->>'login')::uuid,null,'test');
+ select object_version_id into upload_version from artifact_upload_files where upload_id=upload and file_index=0;
