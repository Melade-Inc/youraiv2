+ begin
+  insert into artifact_upload_files(upload_id,workspace_id,artifact_id,file_index,path,media_type,byte_size,sha256,object_version_id)
+   select saved,workspace,artifact,99,'defensive.css','text/css',20,repeat('b',64),version_id from artifact_uploads where id=upload;
+  begin perform live_claim_upload_cleanup(claim,upload);raise exception 'referenced object accepted';exception when raise_exception then if sqlerrm<>'CLEANUP_DENIED' then raise;end if;end;
+  raise exception 'ROLLBACK_DEFENSIVE_FIXTURE';
+ exception when raise_exception then if sqlerrm<>'ROLLBACK_DEFENSIVE_FIXTURE' then raise;end if;end;
+ original_reserved:=(select reserved_bytes from artifact_uploads where id=upload);before_reserved:=(select upload_reserved_bytes from workspaces where id=workspace);before_stored:=(select storage_bytes from workspaces where id=workspace);
+ batch:=live_claim_upload_cleanup(claim,upload);assert batch->>'uploadId'=upload::text and jsonb_array_length(batch->'files')=2;
