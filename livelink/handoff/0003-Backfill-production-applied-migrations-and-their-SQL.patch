+-- Physical retirement of canonical commitments after the approved recovery
+-- deadline. This stage does NOT redact database content or release quota.
+create table public.project_storage_purges (
+ removal_id uuid not null references public.artifact_removals(id),
+ environment text not null check(environment in ('preview','production')),
+ workspace_id uuid not null,artifact_id uuid not null,
+ claim_id uuid unique,lease_until timestamptz,next_attempt_at timestamptz not null default clock_timestamp(),
+ attempts integer not null default 0 check(attempts>=0),failures integer not null default 0 check(failures>=0),
+ created_at timestamptz not null default clock_timestamp(),storage_retired_at timestamptz,retirement_claim_id uuid,
+ primary key(removal_id,environment),
+ foreign key(artifact_id,workspace_id) references public.artifacts(id,workspace_id),
+ check((claim_id is null)=(lease_until is null)),check(storage_retired_at is null or claim_id is null),check((storage_retired_at is null)=(retirement_claim_id is null))
+);
+create table public.project_storage_purge_objects (
+ id uuid primary key default gen_random_uuid(),removal_id uuid not null,environment text not null,
+ workspace_id uuid not null,artifact_id uuid not null,object_version_id uuid not null,
+ sha256 text not null,media_type text not null,byte_size bigint not null,
+ created_at timestamptz not null default clock_timestamp(),retired_at timestamptz,
+ foreign key(removal_id,environment) references public.project_storage_purges(removal_id,environment),
+ foreign key(environment,workspace_id,artifact_id,object_version_id,sha256,media_type)
+  references public.cloudflare_storage_objects(environment,workspace_id,artifact_id,object_version_id,sha256,media_type),
+ unique(removal_id,environment,object_version_id,sha256,media_type)
+);
+create table public.project_storage_purge_dispatches (
+ invocation_id uuid primary key,object_id uuid not null references public.project_storage_purge_objects(id),
+ claim_id uuid not null,request_hash text not null check(request_hash~'^[a-f0-9]{64}$'),
+ reservation_id uuid not null unique references public.runtime_reservations(id),
+ created_at timestamptz not null default clock_timestamp(),confirmed_at timestamptz
+);
+create index project_storage_purge_schedule on public.project_storage_purges(next_attempt_at)where storage_retired_at is null;
+create index project_storage_purge_artifact on public.project_storage_purges(workspace_id,artifact_id);
