+  { name: 'ajv-formats', version: '3.0.1', license: 'MIT', homepage: 'https://github.com/ajv-validator/ajv-formats', licenseSha256: '9df3bb69929a3b650ed73b3bfa1756725aaff0ac296461605753547004eafeaf' },
