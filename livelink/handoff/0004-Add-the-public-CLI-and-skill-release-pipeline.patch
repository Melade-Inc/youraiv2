+/** The published CLI invocation, or null while distribution is unpublished so no page or guide can invent an install command. */
+export function cliCommand({ registry: source = registry } = {}) {
+  const d = source.distribution;
+  if (d.status !== 'published') return null;
+  return d.install ?? `npx -y ${d.package}@${d.version ?? 'latest'}`;
+}
+
+/** Honest CLI availability sentences for every guide, derived from distribution state. */
+function cliAvailability(source) {
+  const cli = cliCommand({ registry: source });
+  if (!cli) return 'Public distribution is not yet published. A reviewed source checkout includes packages/cli/bin/live-link.mjs; run node packages/cli/bin/live-link.mjs --help from that checkout. Do not ask users to clone the private monorepo or use an unverified npm package.';
+  const skill = source.distribution.skill ? ` Persistent skill for coding agents: \`${source.distribution.skill}\`.` : '';
+  return `Published CLI, Node ${source.distribution.node.replace(/^>=/, '')} or newer: \`${cli} --help\`.${skill} Verify the pin before use; never run an unpinned or unverified package.`;
+}
+
 export function agentDocument() {
   return {
     name: registry.name, version: registry.version,
@@ -48,14 +64,14 @@ Build frontend source locally in an isolated environment before upload. Only bui
 
