+  assert.equal(result.ok, true); assert.equal(result.executed, false);
+  assert.deepEqual(result.files.map(file => file.path), ['package/LICENSE']);
+  assert.throws(() => inspectPublishedPackage(bytes, 'sha1-invalid', expected), /INVALID_INTEGRITY/);
+  const changed = Buffer.from(bytes); changed[10] ^= 1;
+  assert.throws(() => inspectPublishedPackage(changed, sri(bytes), expected), /INTEGRITY_MISMATCH/);
+});
