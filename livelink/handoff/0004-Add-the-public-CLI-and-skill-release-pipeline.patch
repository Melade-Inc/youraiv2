+++ b/.github/workflows/release-cli.yml
@@ -0,0 +1,59 @@
+name: Release Live.link CLI
+# Tag the reviewed commit as cli-v<version> (matching packages/cli/package.json) to build the
+# public distribution tree and push it, with tag v<version>, to Melade-Inc/live-link-skill.
+# That repository's own publish.yml then publishes cli/ to npm with provenance.
+on:
+  push:
+    tags: ['cli-v*']
+permissions:
+  contents: read
+jobs:
+  release:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Require the distribution repository token
+        env:
+          DISTRIBUTION_REPO_TOKEN: ${{ secrets.DISTRIBUTION_REPO_TOKEN }}
+        run: |
+          if [ -z "${DISTRIBUTION_REPO_TOKEN}" ]; then
+            echo "::error::DISTRIBUTION_REPO_TOKEN is not configured. Add a fine-grained token with contents:write on Melade-Inc/live-link-skill as a repository secret, then re-run this tag." >&2
+            exit 1
+          fi
+      - uses: actions/checkout@v4
+      - uses: pnpm/action-setup@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24.20.0
+          cache: pnpm
+      - run: pnpm install --frozen-lockfile
+      - name: Check that the tag matches packages/cli/package.json
+        run: |
+          VERSION="$(node -p 'require("./packages/cli/package.json").version')"
+          test "${GITHUB_REF_NAME}" = "cli-v${VERSION}" || { echo "::error::Tag ${GITHUB_REF_NAME} does not match packages/cli version ${VERSION}" >&2; exit 1; }
+      - run: pnpm --filter @live-link/cli test
+      - run: node --test tests/ops/build-cli.test.mjs
+      - run: pnpm release:build
+      - name: Verify exact distribution tree and offline npm tarball
+        run: node scripts/release/verify-distribution.mjs --dry-run dist/distribution
+      - name: Push the distribution tree and tag
+        env:
+          DISTRIBUTION_REPO_TOKEN: ${{ secrets.DISTRIBUTION_REPO_TOKEN }}
+        run: |
+          set -eu
+          VERSION="$(cat dist/distribution/VERSION)"
+          REMOTE="https://x-access-token:${DISTRIBUTION_REPO_TOKEN}@github.com/Melade-Inc/live-link-skill.git"
+          if git ls-remote --exit-code --tags "${REMOTE}" "refs/tags/v${VERSION}" >/dev/null 2>&1; then
+            echo "::error::Tag v${VERSION} already exists in Melade-Inc/live-link-skill; bump packages/cli/package.json before releasing again." >&2
+            exit 1
+          fi
+          rm -rf target
+          git clone --depth 1 "${REMOTE}" target || { mkdir target && git -C target init -b main; }
+          find target -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
+          cp -R dist/distribution/. target/
+          cd target
+          git config user.name "live-link-release[bot]"
+          git config user.email "release@live.link"
+          git add -A
+          git commit -m "live-link ${VERSION}" --allow-empty
+          git tag "v${VERSION}"
+          git push "${REMOTE}" HEAD:main "v${VERSION}"
