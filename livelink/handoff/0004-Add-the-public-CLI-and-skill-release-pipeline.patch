+  { name: 'zod-to-json-schema', version: '3.25.2', license: 'ISC', homepage: 'https://github.com/StefanTerdell/zod-to-json-schema', licenseSha256: '80d3168ad2f70f6f5bb2ab22b23414707abf6f0a392034891481ae36a1a429d4' },
