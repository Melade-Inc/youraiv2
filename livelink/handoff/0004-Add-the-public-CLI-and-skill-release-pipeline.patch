+/** The exact THIRD_PARTY_NOTICES bytes for the reviewed list, given each package's LICENSE bytes. */
+export function composeThirdPartyNotices(licenses) {
+  const parts = [Buffer.from('Bundled third-party software\n\nThe public live-link bundle inlines the packages below. Each remains under its own license, reproduced here unchanged.\n\n')];
