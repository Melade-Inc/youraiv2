+  { name: '@modelcontextprotocol/sdk', version: '1.30.0', license: 'MIT', homepage: 'https://modelcontextprotocol.io', licenseSha256: '5e13dbbc1d120fc2a03cecde7c91424ae2d7de11b63d58ded2f4431e261ee50d' },
