diff --git a/scripts/release/build-cli.mjs b/scripts/release/build-cli.mjs
new file mode 100644
index 0000000..8e093fb
--- /dev/null
+++ b/scripts/release/build-cli.mjs
@@ -0,0 +1,138 @@
+#!/usr/bin/env node
+// Bundles packages/cli into one dependency-free ESM file for the public `live-link` package.
+import { build } from 'esbuild';
+import { chmod, copyFile, lstat, mkdir, readFile, realpath, rm, writeFile } from 'node:fs/promises';
+import { realpathSync } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { readReleaseLicenseFiles, releaseLicense, releaseLicenseNames, reviewedThirdParty, sha256 } from './release-licenses.mjs';
+import { cliVersion } from '../../packages/cli/src/version.mjs';
+
+export const repositoryRoot = path.resolve(fileURLToPath(new URL('../../', import.meta.url)));
+export const packageName = 'live-link';
+export const distributionRepository = 'https://github.com/Melade-Inc/live-link-skill';
+export const minimumNode = '>=22.12.0';
+const esbuildTarget = 'node22';
+
+export function isMain(meta) {
+  try { return !!process.argv[1] && realpathSync(process.argv[1]) === fileURLToPath(meta.url); } catch { return false; }
+}
+export async function readCliPackage() {
+  const pkg = JSON.parse(await readFile(path.join(repositoryRoot, 'packages/cli/package.json'), 'utf8'));
+  if (!/^\d+\.\d+\.\d+$/.test(pkg.version)) throw new Error(`packages/cli/package.json version must be an exact x.y.z pin, found ${pkg.version}`);
+  if (pkg.engines?.node !== minimumNode) throw new Error(`packages/cli/package.json engines.node must be ${minimumNode}`);
+  if (pkg.version !== cliVersion) throw new Error(`packages/cli/src/version.mjs says ${cliVersion} but packages/cli/package.json says ${pkg.version}; keep them equal`);
+  if (pkg.private !== true || pkg.license !== releaseLicense) throw new Error('Source CLI must remain private with Apache-2.0 metadata');
+  return pkg;
+}
+// Additions require an explicit source-license review; directory prefixes alone
+// would silently admit newly imported private helpers or additional packages.
+export const licensedOwnedInputs = Object.freeze([
+  'packages/cli/bin/live-link.mjs',
+  'packages/cli/src/connect.mjs',
+  'packages/cli/src/files.mjs',
+  'packages/cli/src/go.mjs',
+  'packages/cli/src/http.mjs',
+  'packages/cli/src/index.mjs',
+  'packages/cli/src/init.mjs',
+  'packages/cli/src/node-version.mjs',
+  'packages/cli/src/publish.mjs',
+  'packages/cli/src/safety.mjs',
+  'packages/cli/src/state.mjs',
+  'packages/cli/src/terminal-mcp.mjs',
+  'packages/cli/src/version.mjs',
+  'packages/agent-kit/src/index.js',
+]);
+const pnpmKey = entry => `${entry.name.replace('/', '+')}@${entry.version}`;
+
+/** Every bundle input is either licensed owned source or a file of one reviewed third-party package. */
+export async function checkBundleInputs(metafile, { sourceRoot = repositoryRoot } = {}) {
+  const root = await realpath(sourceRoot);
+  const owned = new Set(licensedOwnedInputs);
+  const inputs = Object.keys(metafile.inputs ?? {});
+  if (!inputs.length) throw new Error('Release bundle has no auditable inputs');
+  const used = new Map();
+  for (const input of inputs) {
+    if (path.isAbsolute(input) || input.includes('\\') || path.posix.normalize(input) !== input || input.startsWith('../')) throw new Error(`Unreviewed bundle input: ${input}`);
+    // Decide by name first, before any filesystem access, so an unknown package is
+    // rejected as unreviewed whether or not something exists at that path.
+    let entry = null, directory = null;
+    if (!owned.has(input)) {
+      const match = /^node_modules\/\.pnpm\/([^/]+)\/node_modules\/((?:@[^/]+\/)?[^/]+)\/(.+)$/.exec(input);
+      entry = match ? reviewedThirdParty.find(candidate => candidate.name === match[2] && (match[1] === pnpmKey(candidate) || match[1].startsWith(`${pnpmKey(candidate)}_`))) ?? null : null;
+      if (!entry || !/\.(?:m|c)?js$|\.json$/.test(match[3]) || match[3].split('/').includes('node_modules')) throw new Error(`Unreviewed bundle input: ${input}`);
+      directory = `node_modules/.pnpm/${match[1]}/node_modules/${entry.name}`;
+    }
+    const file = path.join(root, input);
+    if (await realpath(file) !== file) throw new Error(`Out-of-tree or linked bundle input: ${input}`);
+    const info = await lstat(file);
+    if (!info.isFile() || (owned.has(input) && info.nlink !== 1)) throw new Error(`Unsafe bundle input: ${input}`);
+    if (!entry) continue;
+    const record = used.get(entry.name) ?? { entry, directory, inputs: [] };
+    if (record.directory !== directory) throw new Error(`Unreviewed bundle input: ${input}`);
+    record.inputs.push(input); used.set(entry.name, record);
+  }
+  for (const { entry, directory } of used.values()) {
+    const packageRoot = path.join(root, directory);
+    for (const name of ['package.json', 'LICENSE']) if (await realpath(path.join(packageRoot, name)) !== path.join(packageRoot, name)) throw new Error(`Linked ${entry.name} metadata is not reviewed`);
+    const pkg = JSON.parse(await readFile(path.join(packageRoot, 'package.json'), 'utf8'));
+    const license = await readFile(path.join(packageRoot, 'LICENSE'));
+    if (pkg.name !== entry.name || pkg.version !== entry.version || pkg.license !== entry.license || sha256(license) !== entry.licenseSha256) throw new Error(`Bundled ${entry.name} version or license is not reviewed`);
+  }
+  return {
+    owned: inputs.filter(input => owned.has(input)).sort(),
+    thirdParty: [...used.values()].map(({ entry, inputs: files }) => ({ ...entry, inputs: files.sort() })).sort((a, b) => a.name.localeCompare(b.name)),
+  };
+}
+
+/** Refuses a bundle that would leak this machine's paths, keep workspace links or link node:sqlite eagerly. */
+export function checkBundle(bundle, metafile) {
+  const problems = [];
+  if (!bundle.startsWith('#!/usr/bin/env node\n')) problems.push('the bundle lost its #!/usr/bin/env node line');
+  // The pnpm protocol appears only as a quoted version spec such as "workspace:*"; object keys named workspace are fine.
+  if (/["']workspace:/.test(bundle)) problems.push('the bundle still references a workspace: dependency');
+  // A leaked machine path always continues with a separator; a bare short home like /root also occurs inside ordinary identifiers.
+  for (const secret of [repositoryRoot, os.homedir()]) if (bundle.includes(`${secret}/`) || bundle.includes(`${secret}"`) || bundle.includes(`${secret}'`)) problems.push(`the bundle contains the local path ${secret}`);
+  for (const match of bundle.matchAll(/^import\s[^\n]*?from\s*["']([^"']+)["'];?$/gm)) if (!match[1].startsWith('node:')) problems.push(`unexpected runtime import ${match[1]}`);
+  if (/^import\s[^\n]*["']node:sqlite["']/m.test(bundle)) problems.push('node:sqlite is imported statically; the Node version gate could not run on older runtimes');
+  for (const output of Object.values(metafile.outputs)) for (const entry of output.imports) if (!entry.external || !entry.path.startsWith('node:')) problems.push(`bundled output still imports ${entry.path}`);
+  if (problems.length) throw new Error(`Release bundle rejected: ${problems.join('; ')}`);
+}
+
+export async function buildCli({ outDir = path.join(repositoryRoot, 'dist/cli') } = {}) {
+  const pkg = await readCliPackage();
+  const licenses = await readReleaseLicenseFiles();
+  await rm(outDir, { recursive: true, force: true }); await mkdir(outDir, { recursive: true });
+  const outfile = path.join(outDir, 'live-link.mjs');
+  const result = await build({
+    absWorkingDir: repositoryRoot, entryPoints: [path.join(repositoryRoot, 'packages/cli/bin/live-link.mjs')], outfile,
+    bundle: true, platform: 'node', format: 'esm', target: esbuildTarget, external: ['node:*'],
+    write: false, legalComments: 'none', logLevel: 'silent', metafile: true, treeShaking: true,
+  });
+  const bundleInputs = await checkBundleInputs(result.metafile);
+  const bundle = result.outputFiles[0].text;
+  checkBundle(bundle, result.metafile);
+  await writeFile(outfile, bundle);
+  await chmod(outfile, 0o755);
+  for (const [name, body] of Object.entries(licenses)) await writeFile(path.join(outDir, name), body);
+  const manifest = {
+    name: packageName, version: pkg.version,
+    description: 'Publish a built folder or document to one stable Live.link address from any terminal agent: private draft by default, explicit guarded publishing, same link on every revision.',
+    type: 'module', bin: { 'live-link': './live-link.mjs' }, files: ['live-link.mjs', 'README.md', ...releaseLicenseNames],
+    engines: { node: minimumNode }, license: releaseLicense, homepage: 'https://live.link/start',
+    repository: { type: 'git', url: `git+${distributionRepository}.git` }, bugs: { url: `${distributionRepository}/issues` },
+    keywords: ['live.link', 'publish', 'deploy', 'static site', 'agent', 'skill', 'mcp'],
+    publishConfig: { access: 'public', provenance: true },
+  };
+  await writeFile(path.join(outDir, 'package.json'), `${JSON.stringify(manifest, null, 2)}\n`);
+  await copyFile(path.join(repositoryRoot, 'packages/cli/README.md'), path.join(outDir, 'README.md'));
+  for (const file of manifest.files.concat('package.json')) await chmod(path.join(outDir, file), file === 'live-link.mjs' ? 0o755 : 0o644);
+  return { outDir, version: pkg.version, bytes: Buffer.byteLength(bundle), licensePlaceholder: false, bundleInputs, files: manifest.files.concat('package.json') };
+}
+
+if (isMain(import.meta)) {
+  const outIndex = process.argv.indexOf('--out');
+  const built = await buildCli(outIndex === -1 ? {} : { outDir: path.resolve(process.argv[outIndex + 1] ?? '') });
+  process.stdout.write(`${JSON.stringify(built, null, 2)}\n`);
+}
diff --git a/scripts/release/build-distribution.mjs b/scripts/release/build-distribution.mjs
new file mode 100644
index 0000000..c88d7a7
--- /dev/null
+++ b/scripts/release/build-distribution.mjs
@@ -0,0 +1,134 @@
+#!/usr/bin/env node
+// Assembles the public Melade-Inc/live-link-skill repository tree from the reviewed source.
+import { chmod, mkdir, readFile, rm, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { readReleaseLicenseFiles, sha256 } from './release-licenses.mjs';
+import { renderGuide } from '../../packages/agent-kit/src/index.js';
+import { buildCli, distributionRepository, isMain, packageName, readCliPackage, repositoryRoot } from './build-cli.mjs';
+
+const wrapper = (pin, command) => `#!/usr/bin/env sh
+# Runs the pinned Live.link CLI without a global install. Requires Node 22.12 or newer.
+set -eu
+exec npx -y ${packageName}@${pin} ${command} "$@"
+`;
+
+const installScript = pin => `#!/usr/bin/env sh
+# Installs the pinned Live.link CLI globally and runs its diagnostics.
+# Requires Node 22.12 or newer; without one, publish over the HTTP API: https://live.link/start
+set -eu
+PIN="${pin}"
+if ! command -v node >/dev/null 2>&1; then
+  echo "Node 22.12 or newer is required: https://nodejs.org" >&2
+  exit 1
+fi
+VERSION="$(node -p 'process.versions.node')"
+MAJOR="\${VERSION%%.*}"
+REST="\${VERSION#*.}"
+MINOR="\${REST%%.*}"
+if [ "$MAJOR" -lt 22 ] || { [ "$MAJOR" -eq 22 ] && [ "$MINOR" -lt 12 ]; }; then
+  echo "Node $VERSION found; Live.link needs 22.12 or newer. Without a newer Node, publish over the HTTP API: https://live.link/start" >&2
+  exit 1
+fi
+npm install -g "${packageName}@$PIN"
+live-link doctor
+`;
+
+const publishWorkflow = checks => `name: Publish live-link to npm
+on:
+  push:
+    tags: ['v*']
+permissions:
+  contents: read
+  id-token: write
+jobs:
+  publish:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24.20.0
+          registry-url: https://registry.npmjs.org
+      - name: Check that the tag matches the pinned version
+        run: |
+          VERSION="$(cat VERSION)"
+          test "\${GITHUB_REF_NAME}" = "v\${VERSION}" || { echo "Tag \${GITHUB_REF_NAME} does not match VERSION \${VERSION}" >&2; exit 1; }
+          test "$(node -p 'require("./cli/package.json").version')" = "\${VERSION}" || { echo "cli/package.json does not match VERSION" >&2; exit 1; }
+      - name: Verify reviewed package and license bytes before execution
+        run: |
+          node --input-type=module <<'NODE'
+          import assert from 'node:assert/strict';
+          import { createHash } from 'node:crypto';
+          import { lstat, readFile, readdir } from 'node:fs/promises';
+          const checks = ${JSON.stringify(checks)};
+          assert.deepEqual((await readdir('cli')).sort(), Object.keys(checks).filter(p => p.startsWith('cli/')).map(p => p.slice(4)).sort());
+          for (const [file, expected] of Object.entries(checks)) {
+            const info = await lstat(file);
+            assert.ok(info.isFile() && !info.isSymbolicLink() && info.nlink === 1, file);
+            assert.equal(info.mode & 0o7777, expected.mode, file);
+            assert.equal(createHash('sha256').update(await readFile(file)).digest('hex'), expected.sha256, file);
+          }
+          const pkg = JSON.parse(await readFile('cli/package.json', 'utf8'));
+          assert.equal(pkg.license, 'Apache-2.0');
+          assert.equal(pkg.scripts, undefined);
+          assert.equal(pkg.dependencies, undefined);
+          NODE
+      - name: Smoke test the bundle
+        run: node cli/live-link.mjs --help >/dev/null
+      - name: Publish with provenance
+        working-directory: cli
+        run: npm publish --provenance --access public
+        env:
+          NODE_AUTH_TOKEN: \${{ secrets.NPM_TOKEN }}
+`;
+
+const readme = pin => `# Live.link skill and CLI
+
+Publish a built folder, an HTML file or a document to one stable live link. Private draft first; publish only after review. Guide for agents: https://live.link/start
+
+- Skill for coding agents: \`npx skills add Melade-Inc/live-link-skill --skill live-link\`
+- CLI (Node 22.12 or newer): \`npx -y ${packageName}@${pin} go ./dist\` saves a private draft; \`npx -y ${packageName}@${pin} go ./dist --yes --slug my-app --audience public\` publishes after approval, and later \`go ./dist --yes\` updates the same link
+- Local MCP for terminal agents: \`npx -y ${packageName}@${pin} connect ./dist\` prints a credential-free stdio server config
+- Global install: \`npm install -g ${packageName}@${pin}\` or \`sh install.sh\`
+
+Credentials stay in the host secret environment as LIVE_LINK_TOKEN (create one at https://app.live.link/settings). Never put a credential in chat, a project file or a command argument.
+
+Copyright 2026 Melade, Inc. Owned public distribution files are Apache-2.0 licensed; see LICENSE and NOTICE. Bundled third-party notices are in THIRD_PARTY_NOTICES. The private platform is outside this grant.
+
+This repository is generated from the reviewed Live.link source at release time; open issues here, but changes land upstream. Version: ${pin}.
+`;
+
+export async function buildDistribution({ outDir = path.join(repositoryRoot, 'dist/distribution') } = {}) {
+  const pin = (await readCliPackage()).version;
+  await rm(outDir, { recursive: true, force: true });
+  const skillDir = path.join(outDir, 'skills/live-link'), scriptsDir = path.join(skillDir, 'scripts');
+  await mkdir(scriptsDir, { recursive: true }); await mkdir(path.join(outDir, '.github/workflows'), { recursive: true });
+  const cli = await buildCli({ outDir: path.join(outDir, 'cli') });
+  const licenses = await readReleaseLicenseFiles();
+  const checks = {};
+  for (const file of cli.files) checks[`cli/${file}`] = { sha256: sha256(await readFile(path.join(outDir, 'cli', file))), mode: file === 'live-link.mjs' ? 0o755 : 0o644 };
+  for (const [file, body] of Object.entries(licenses)) checks[file] = { sha256: sha256(body), mode: 0o644 };
+  const files = {
+    ...licenses,
+    'skills/live-link/SKILL.md': renderGuide('skill'),
+    'skills/live-link/scripts/publish.sh': wrapper(pin, 'go'),
+    'skills/live-link/scripts/connect.sh': wrapper(pin, 'connect'),
+    'install.sh': installScript(pin),
+    'VERSION': `${pin}\n`,
+    '.github/workflows/publish.yml': publishWorkflow(checks),
+    'README.md': readme(pin),
+  };
+  for (const [name, content] of Object.entries(files)) {
+    await writeFile(path.join(outDir, name), content);
+    await chmod(path.join(outDir, name), name.endsWith('.sh') ? 0o755 : 0o644);
+  }
+  return { outDir, version: pin, repository: distributionRepository, licensePlaceholder: cli.licensePlaceholder, bundleBytes: cli.bytes, files: [...Object.keys(files), ...cli.files.map(file => `cli/${file}`)] };
+}
+
+export async function readVersionFile(outDir) { return (await readFile(path.join(outDir, 'VERSION'), 'utf8')).trim(); }
+
+if (isMain(import.meta)) {
+  const outIndex = process.argv.indexOf('--out');
+  const built = await buildDistribution(outIndex === -1 ? {} : { outDir: path.resolve(process.argv[outIndex + 1] ?? '') });
+  process.stdout.write(`${JSON.stringify(built, null, 2)}\n`);
+}
