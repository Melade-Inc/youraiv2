@@ -0,0 +1,173 @@
+// Offline preparation evidence only. This never establishes a published release.
+import { execFile } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { constants } from 'node:fs';
+import { chmod, lstat, mkdir, mkdtemp, open, readFile, readdir, realpath, rm, writeFile } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { promisify } from 'node:util';
+import { buildDistribution } from './build-distribution.mjs';
+import { readCliPackage } from './build-cli.mjs';
+
+const run = promisify(execFile);
+const sha256 = value => createHash('sha256').update(value).digest('hex');
+const pinPattern = /^\d+\.\d+\.\d+$/;
+
+const treeByteLimit = 16 * 1024 * 1024;
+const sameIdentity = (a, b) => a.dev === b.dev && a.ino === b.ino;
+const sameFile = (a, b) => sameIdentity(a, b) && a.size === b.size && a.mtimeMs === b.mtimeMs && a.ctimeMs === b.ctimeMs && a.mode === b.mode;
+
+// Capture through one no-follow descriptor, bound actual reads (not just the
+// earlier stat), and reject replacement/growth before any bytes are accepted.
+export async function captureTreeFile(file, expected, remaining, { openFile = open, checkParents = async () => {} } = {}) {
+  const handle = await openFile(file, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+  try {
+    const before = await handle.stat();
+    if (!before.isFile() || before.nlink !== 1 || !sameFile(before, expected)) throw new Error('TREE_CHANGED');
+    if (before.size > remaining) throw new Error('TREE_BYTE_LIMIT');
+    const mode = before.mode & 0o7777;
+    if (mode !== 0o644 && mode !== 0o755) throw new Error('TREE_UNSAFE_MODE');
+    await checkParents();
+    const chunks = []; let bytes = 0;
+    for (;;) {
+      const buffer = Buffer.alloc(Math.min(65536, remaining - bytes + 1));
+      const { bytesRead } = await handle.read(buffer, 0, buffer.length, null);
+      if (!bytesRead) break;
+      bytes += bytesRead;
+      if (bytes > remaining) throw new Error('TREE_BYTE_LIMIT');
+      chunks.push(buffer.subarray(0, bytesRead));
+    }
+    if (!sameFile(before, await handle.stat()) || bytes !== before.size) throw new Error('TREE_CHANGED');
+    const current = await lstat(file);
+    if (!current.isFile() || !sameFile(before, current)) throw new Error('TREE_CHANGED');
+    await checkParents();
+    return { body: Buffer.concat(chunks, bytes), mode, executable: !!(mode & 0o111) };
+  } finally { await handle.close(); }
+}
+
+// The caller supplies a stable local generated tree. Walked directory identities
+// are rechecked around each capture; symlink/file replacement and growth fail
+// closed. Like the local build itself, this is not a sandbox against a privileged
+// process concurrently rewriting ancestor directories or build dependencies.
+async function snapshot(directory) {
+  const given = await lstat(directory);
+  if (!given.isDirectory() || given.isSymbolicLink()) throw new Error('TREE_NOT_DIRECTORY');
+  directory = await realpath(directory);
+  const root = await lstat(directory);
+  if (!sameIdentity(root, given)) throw new Error('TREE_CHANGED');
+  const files = new Map(), directories = new Map([[directory, root]]);
+  let entries = 0, bytes = 0;
+  const checkParents = async () => {
+    for (const [name, original] of directories) {
+      const current = await lstat(name);
+      if (!current.isDirectory() || current.isSymbolicLink() || !sameIdentity(current, original) || await realpath(name) !== name) throw new Error('TREE_CHANGED');
+    }
+  };
+  async function walk(relative = '') {
+    await checkParents();
+    const children = await readdir(path.join(directory, relative), { withFileTypes: true });
+    if (relative && children.length === 0) throw new Error('TREE_EMPTY_DIRECTORY');
+    for (const entry of children) {
+      if (++entries > 64) throw new Error('TREE_ENTRY_LIMIT');
+      const name = path.posix.join(relative, entry.name), file = path.join(directory, name);
+      const info = await lstat(file);
+      if (info.isSymbolicLink() || (!info.isFile() && !info.isDirectory())) throw new Error('TREE_UNSAFE_ENTRY');
+      if (info.isDirectory()) { directories.set(file, info); await walk(name); continue; }
+      const captured = await captureTreeFile(file, info, treeByteLimit - bytes, { checkParents });
+      bytes += captured.body.length;
+      files.set(name, captured);
+    }
+  }
+  await walk(); await checkParents();
+  return files;
+}
+
+function compare(actual, expected) {
+  const problems = [];
+  for (const name of [...new Set([...actual.keys(), ...expected.keys()])].sort()) {
+    if (!expected.has(name)) problems.push({ file: name, reason: 'unexpected-file' });
+    else if (!actual.has(name)) problems.push({ file: name, reason: 'missing-file' });
+    else if (!actual.get(name).body.equals(expected.get(name).body)) problems.push({ file: name, reason: 'content-mismatch' });
+    else if (actual.get(name).mode !== expected.get(name).mode) problems.push({ file: name, reason: 'executable-bit-mismatch' });
+  }
+  return problems;
+}
+
+async function packAndSmoke(files, temporary, pin) {
+  const packageDir = path.join(temporary, 'package-input'), packedDir = path.join(temporary, 'packed');
+  const extractedDir = path.join(temporary, 'extracted'), emptyDir = path.join(temporary, 'empty');
+  const homeDir = path.join(temporary, 'home'), stateDir = path.join(temporary, 'state');
+  for (const directory of [packageDir, packedDir, extractedDir, emptyDir, homeDir]) await mkdir(directory);
+  const expectedPackage = new Map();
+  // Execute the inspected bytes, not a second read of a possibly changing tree.
+  for (const [name, value] of files) if (name.startsWith('cli/')) {
+    const packageName = name.slice(4);
+    await writeFile(path.join(packageDir, packageName), value.body, { mode: value.mode });
+    await chmod(path.join(packageDir, packageName), value.mode);
+    expectedPackage.set(`package/${packageName}`, value);
+  }
+  const userConfig = path.join(temporary, 'npm-user.conf'), globalConfig = path.join(temporary, 'npm-global.conf');
+  await writeFile(userConfig, ''); await writeFile(globalConfig, '');
+  // No inherited credentials, NODE_OPTIONS, npm configuration, proxy, home or
+  // workspace links. Offline mode and ignored lifecycle scripts prohibit registry
+  // resolution and package hooks; the input has no dependencies or npm scripts.
+  const env = { PATH: process.env.PATH, HOME: homeDir, LIVE_LINK_STATE_DIR: stateDir, npm_config_userconfig: userConfig, npm_config_globalconfig: globalConfig, npm_config_cache: path.join(temporary, 'npm-cache'), npm_config_offline: 'true', npm_config_ignore_scripts: 'true', npm_config_audit: 'false', npm_config_fund: 'false', npm_config_update_notifier: 'false' };
+  const options = { cwd: packageDir, env, timeout: 30000, maxBuffer: 1024 * 1024 };
+  const packed = await run('npm', ['pack', '--offline', '--ignore-scripts', '--json', '--pack-destination', packedDir], options);
+  const [metadata, ...extra] = JSON.parse(packed.stdout);
+  if (!metadata || extra.length || metadata.name !== 'live-link' || metadata.version !== pin || path.basename(metadata.filename) !== metadata.filename) throw new Error('PACK_IDENTITY_MISMATCH');
+  const packageFiles = metadata.files.map(file => `package/${file.path}`).sort();
+  if (JSON.stringify(packageFiles) !== JSON.stringify([...expectedPackage.keys()].sort())) throw new Error('PACK_FILE_MISMATCH');
+  const archive = path.join(packedDir, metadata.filename);
+  await run('tar', ['-xzpf', archive, '-C', extractedDir], options);
+  if (compare(await snapshot(extractedDir), expectedPackage).length) throw new Error('PACK_CONTENT_MISMATCH');
+  const bundle = path.join(extractedDir, 'package/live-link.mjs');
+  const smokeOptions = { ...options, cwd: emptyDir };
+  const help = await run(process.execPath, [bundle, '--help'], smokeOptions);
+  if (!help.stdout.includes('live-link go') || help.stderr) throw new Error('CLI_HELP_FAILED');
+  // A closed loopback port proves the offline/unconfigured doctor state without
+  // a dependency on npm, the public API, private credentials or provider access.
+  const doctor = await run(process.execPath, [bundle, 'doctor', '--api-base', 'http://127.0.0.1:1/api/v1', '--allow-localhost'], smokeOptions);
+  const diagnostics = JSON.parse(doctor.stdout);
+  if (doctor.stderr || diagnostics.cliVersion !== pin || diagnostics.nodeSupported !== true || diagnostics.credentialSource !== 'none' || diagnostics.discovery !== 'unavailable') throw new Error('CLI_DOCTOR_FAILED');
+  // Test npm's bin mapping as installed, still from the inspected local archive
+  // with scripts, dependencies and registry access disabled.
+  const installed = path.join(temporary, 'installed');
+  await run('npm', ['install', '--offline', '--ignore-scripts', '--no-audit', '--no-fund', '--prefix', installed, archive], smokeOptions);
+  const installedBin = path.join(installed, 'node_modules/.bin/live-link');
+  const installedHelp = await run(installedBin, ['--help'], smokeOptions);
+  if (!installedHelp.stdout.includes('live-link go') || installedHelp.stderr) throw new Error('CLI_INSTALLED_BIN_FAILED');
+  if (compare(await snapshot(path.join(installed, 'node_modules/live-link')), new Map([...expectedPackage].map(([name, value]) => [name.slice(8), value]))).length) throw new Error('PACK_INSTALLED_CONTENT_MISMATCH');
+  if ((await readdir(emptyDir)).length) throw new Error('CLI_CHANGED_WORKING_DIRECTORY');
+  return { ok: true, offline: true, lifecycleScripts: false, dependencyInstall: false, localPackageInstall: true, files: packageFiles, tarballSha256: sha256(await readFile(archive)), smoke: { help: 'passed', doctor: 'passed', installedBin: 'passed', credentials: 'none', discovery: 'unavailable', nodeVersion: process.versions.node } };
+}
+
+export async function verifyDistributionTree(outDir, { pin } = {}) {
+  const sourcePin = (await readCliPackage()).version;
+  pin ??= sourcePin;
+  if (!pinPattern.test(pin)) throw new Error('An exact x.y.z pin is required.');
+  const result = { mode: 'dry-run', pin, ok: false, releaseReady: false, checks: {}, release: { license: { status: 'not-checked' }, npm: { status: 'not-checked' }, tag: { status: 'not-checked' }, skill: { status: 'not-checked' }, limitations: ['Local build and pack evidence only; run the published verifier after an authorized release.', 'Apache-2.0 was selected; source review and publication approval remain separate requirements.', 'This dry run does not establish host, hosted API or public distribution acceptance.'] } };
+  if (pin !== sourcePin) { result.checks.pin = { ok: false, expected: sourcePin, found: pin }; return result; }
+  result.checks.pin = { ok: true, expected: sourcePin };
+  const temporary = await mkdtemp(path.join(os.tmpdir(), 'live-link-distribution-verify-'));
+  try {
+    const expectedDir = path.join(temporary, 'expected');
+    await buildDistribution({ outDir: expectedDir });
+    result.release.license = { status: 'selected', selected: 'Apache-2.0', releaseApproved: false };
+    let files;
+    try { files = await snapshot(path.resolve(outDir)); }
+    catch (error) { result.checks.tree = { ok: false, error: error.code === 'ENOENT' ? 'TREE_MISSING' : /^TREE_[A-Z_]+$/.test(error.message) ? error.message : 'TREE_UNREADABLE' }; return result; }
+    const problems = compare(files, await snapshot(expectedDir));
+    result.checks.tree = { ok: problems.length === 0, problems, files: [...files].sort(([a], [b]) => a.localeCompare(b)).map(([name, value]) => ({ path: name, sha256: sha256(value.body), bytes: value.body.length, mode: value.mode, executable: value.executable })) };
+    if (problems.length) return result;
+    try { result.checks.package = await packAndSmoke(files, temporary, pin); }
+    catch (error) {
+      const command = ['npm', 'tar'].includes(error.path) ? error.path : error.path === process.execPath ? 'node' : undefined;
+      result.checks.package = { ok: false, error: /^(PACK|CLI)_[A-Z_]+$/.test(error.message) ? error.message : error.code === 'ENOENT' ? 'REQUIRED_COMMAND_UNAVAILABLE' : error.killed ? 'COMMAND_TIMEOUT' : 'PACK_OR_SMOKE_FAILED', ...(command ? { command } : {}) };
+      return result;
+    }
+    result.release.license.status = 'selected-artifact-verified';
+    result.ok = true;
+    return result;
+  } finally { await rm(temporary, { recursive: true, force: true }); }
+}
