+#!/usr/bin/env node
+// Proves that a published pin exists on npm and in the public repository with the exact SKILL.md
+// this source renders. Published mode is network-dependent; --dry-run checks a
+// generated public tree offline and never establishes release acceptance.
+import { execFile } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { promisify } from 'node:util';
+import { mkdtemp, readFile, rm } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { renderGuide } from '../../packages/agent-kit/src/index.js';
+import { buildCli, distributionRepository, isMain, packageName, readCliPackage } from './build-cli.mjs';
+
+import { releaseLicense, releaseLicenseNames } from './release-licenses.mjs';
+import { compressedPackageLimit, fetchBounded, inspectPublishedPackage } from './published-package.mjs';
+
+const run = promisify(execFile);
+const sha256 = value => createHash('sha256').update(value).digest('hex');
+const pinPattern = /^\d+\.\d+\.\d+$/;
+
+export async function verifyDistribution(pin, { execFileImpl = run, fetchImpl = fetch } = {}) {
+  if (!pinPattern.test(pin ?? '')) throw new Error(`Provide an exact version pin such as 1.0.0, not ${JSON.stringify(pin)}`);
+  const sourcePin = (await readCliPackage()).version;
+  if (pin !== sourcePin) throw new Error('Verify a published release against its exact reviewed source version.');
+  const checks = {}, temporary = await mkdtemp(path.join(os.tmpdir(), 'live-link-published-verify-'));
+  try {
+    // Build reviewed expected bytes locally, but never execute downloaded code.
+    const built = await buildCli({ outDir: path.join(temporary, 'cli') });
+    const expectedFiles = new Map(await Promise.all(built.files.map(async name => [name, await readFile(path.join(built.outDir, name))])));
+    let metadata;
+    const tarball = `https://registry.npmjs.org/live-link/-/live-link-${pin}.tgz`;
+    try {
+      const body = await fetchBounded(`https://registry.npmjs.org/live-link/${pin}`, { fetchImpl });
+      metadata = JSON.parse(body.toString('utf8'));
+      checks.npm = { ok: metadata.name === packageName && metadata.version === pin && metadata.license === releaseLicense && metadata.dist?.tarball === tarball,
+        expected: pin, versionMatches: metadata.version === pin, licenseMatches: metadata.license === releaseLicense };
+    } catch { checks.npm = { ok: false, expected: pin, error: 'NPM_METADATA_UNAVAILABLE' }; }
+    try {
+      const { stdout } = await execFileImpl('git', ['ls-remote', '--tags', `${distributionRepository}.git`, `refs/tags/v${pin}`, `refs/tags/v${pin}^{}`], { timeout: 30000, maxBuffer: 16384 });
+      const refs = stdout.trim().split('\n').map(line => line.split(/\s+/));
+      // Prefer the peeled commit of an annotated tag; freeze subsequent reads to
+      // this observed commit rather than refetching a mutable tag by name.
+      const byRef = new Map(refs.map(([sha, ref]) => [ref, sha]));
+      const commit = byRef.get(`refs/tags/v${pin}^{}`) ?? byRef.get(`refs/tags/v${pin}`);
+      checks.tag = { ok: /^[a-f0-9]{40}$/.test(commit ?? ''), tag: `v${pin}`, commit: /^[a-f0-9]{40}$/.test(commit ?? '') ? commit : null };
+    } catch { checks.tag = { ok: false, tag: `v${pin}`, error: 'PUBLIC_TAG_UNAVAILABLE' }; }
+    const expectedSkill = sha256(renderGuide('skill'));
+    const publicBase = checks.tag.ok ? `https://raw.githubusercontent.com/Melade-Inc/live-link-skill/${checks.tag.commit}` : null;
+    try {
+      if (!publicBase) throw new Error('PUBLIC_TAG_UNAVAILABLE');
+      const published = sha256(await fetchBounded(`${publicBase}/skills/live-link/SKILL.md`, { fetchImpl }));
+      checks.skill = { ok: published === expectedSkill, expected: expectedSkill, published };
+    } catch { checks.skill = { ok: false, expected: expectedSkill, error: 'PUBLIC_SKILL_UNAVAILABLE' }; }
+    checks.licenses = { ok: false, selected: releaseLicense, files: [] };
+    if (publicBase) {
+      for (const name of releaseLicenseNames) for (const prefix of ['', 'cli/']) {
+        const file = `${prefix}${name}`, expected = sha256(expectedFiles.get(name));
+        try {
+          const published = sha256(await fetchBounded(`${publicBase}/${file}`, { fetchImpl }));
+          checks.licenses.files.push({ file, ok: published === expected, expected, published });
+        } catch { checks.licenses.files.push({ file, ok: false, expected, error: 'PUBLIC_LICENSE_UNAVAILABLE' }); }
+      }
+      checks.licenses.ok = checks.licenses.files.every(file => file.ok);
+    }
+    try {
+      if (!checks.npm.ok) throw new Error('PACKAGE_METADATA_INVALID');
+      const compressed = await fetchBounded(tarball, { fetchImpl, limit: compressedPackageLimit });
+      checks.package = inspectPublishedPackage(compressed, metadata.dist.integrity, expectedFiles);
+    } catch (error) { checks.package = { ok: false, executed: false, error: /^(PACKAGE|REMOTE)_[A-Z_]+$/.test(error.message) ? error.message : 'PACKAGE_UNAVAILABLE' }; }
+    return { pin, mode: 'published', ok: Object.values(checks).every(check => check.ok), checks };
+  } finally { await rm(temporary, { recursive: true, force: true }); }
+}
+
+if (isMain(import.meta)) {
+  const args = process.argv.slice(2);
+  try {
+    let result;
+    if (args[0] === '--dry-run') {
+      if (!args[1] || !([2, 4].includes(args.length)) || (args.length === 4 && args[2] !== '--pin')) throw new Error('Usage: verify-distribution.mjs --dry-run <built-public-tree> [--pin x.y.z]');
+      const { verifyDistributionTree } = await import('./verify-distribution-tree.mjs');
+      result = await verifyDistributionTree(args[1], { pin: args[3] });
+    } else {
+      if (args.length > 1 || args[0]?.startsWith('-')) throw new Error('Usage: verify-distribution.mjs [x.y.z] or --dry-run <built-public-tree> [--pin x.y.z]');
+      result = await verifyDistribution(args[0] ?? (await readCliPackage()).version);
+    }
+    process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
+    process.exitCode = result.ok ? 0 : 1;
+  } catch {
+    process.stderr.write('Distribution verification failed. Usage: verify-distribution.mjs [x.y.z] or --dry-run <built-public-tree> [--pin x.y.z].\n');
+    process.exitCode = 1;
+  }
+}
