+import { gunzipSync, gzipSync } from 'node:zlib';
+import { fetchBounded, inspectPublishedPackage, unpackedPackageLimit } from '../../scripts/release/published-package.mjs';
+
+function archive(entries, trailing = Buffer.alloc(1024)) {
+  const parts = [];
+  for (const { name, body = Buffer.from('license'), type = '0', mode = 0o644, prefix = '' } of entries) {
+    const header = Buffer.alloc(512);
+    header.write(name); header.write(`${mode.toString(8).padStart(7, '0')}\0`, 100);
+    header.write(`${body.length.toString(8).padStart(11, '0')}\0`, 124);
+    header.fill(32, 148, 156); header.write(type, 156); header.write('ustar\0', 257); header.write(prefix, 345);
+    const sum = header.reduce((total, byte) => total + byte, 0);
+    header.write(`${sum.toString(8).padStart(6, '0')}\0 `, 148);
+    parts.push(header, body, Buffer.alloc(Math.ceil(body.length / 512) * 512 - body.length));
+  }
+  return gzipSync(Buffer.concat([...parts, trailing]));
+}
+const sri = bytes => `sha512-${createHash('sha512').update(bytes).digest('base64')}`;
+const expected = new Map([['LICENSE', Buffer.from('license')]]);
+
+test('published package inspection checks integrity and exact bytes without executing or extracting', () => {
+  const bytes = archive([{ name: 'package/LICENSE' }]);
