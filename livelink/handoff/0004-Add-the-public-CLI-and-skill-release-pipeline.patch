+    [[{ name: 'package/LICENSE' }, { name: 'package/extra' }], /FILE_MISMATCH/],
+    [[{ name: 'package/../LICENSE' }], /FILE_MISMATCH/],
+    [[{ name: '/package/LICENSE' }], /FILE_MISMATCH/],
+    [[{ name: 'package/LICENSE', prefix: '../private' }], /UNSAFE_ENTRY/],
+    [[{ name: 'package/LICENSE', type: '1' }], /UNSAFE_ENTRY/],
+    [[{ name: 'package/LICENSE', type: '2' }], /UNSAFE_ENTRY/],
