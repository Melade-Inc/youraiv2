+test('tar numeric fields reject high-bit and hidden octal encodings even with a valid checksum', () => {
+  for (const index of [100, 124, 125]) {
+    const tar = gunzipSync(archive([{ name: 'package/LICENSE' }]));
+    tar[index] |= 0x80;
+    tar.fill(32, 148, 156);
+    const checksum = tar.subarray(0, 512).reduce((sum, byte) => sum + byte, 0);
+    tar.write(`${checksum.toString(8).padStart(6, '0')}\0 `, 148);
+    const bytes = gzipSync(tar);
+    assert.throws(() => inspectPublishedPackage(bytes, sri(bytes), expected), /INVALID_TAR/);
+  }
+});
