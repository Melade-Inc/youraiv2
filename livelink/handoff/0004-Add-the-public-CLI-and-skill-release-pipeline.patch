diff --git a/packages/cli/src/node-version.mjs b/packages/cli/src/node-version.mjs
new file mode 100644
index 0000000..98e13b2
--- /dev/null
+++ b/packages/cli/src/node-version.mjs
@@ -0,0 +1,22 @@
+// Dependency-free on purpose: bin/live-link.mjs loads this module before anything
+// else, so an unsupported runtime still receives a clear message instead of a link error.
+export const minimumNode = '22.12.0';
+export const guideUrl = 'https://live.link/start';
+
+export function parseVersion(value) {
+  const match = /^v?(\d+)\.(\d+)\.(\d+)/.exec(String(value ?? '').trim());
+  return match ? [Number(match[1]), Number(match[2]), Number(match[3])] : null;
+}
+
+export function nodeSupported(actual, minimum = minimumNode) {
+  const found = parseVersion(actual), required = parseVersion(minimum);
+  if (!found || !required) return false;
+  for (let index = 0; index < 3; index++) if (found[index] !== required[index]) return found[index] > required[index];
+  return true;
+}
+
+export function unsupportedNodeMessage(actual) {
+  return `Live.link CLI needs Node ${minimumNode} or newer; this runtime is Node ${String(actual)}.\n` +
+    'Install a current Node from https://nodejs.org (or use nvm/fnm/volta), then repeat the command.\n' +
+    `Without a newer Node, publish over the HTTP API instead: ${guideUrl}\n`;
+}
