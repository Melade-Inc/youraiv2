@@ -0,0 +1,85 @@
+// Read-only inspection of the flat, dependency-free npm artifact. No extraction,
+// package hooks, subprocesses or uploaded code execute while verifying a release.
+import { createHash, timingSafeEqual } from 'node:crypto';
+import { gunzipSync } from 'node:zlib';
+
+export const compressedPackageLimit = 8 * 1024 * 1024;
+export const unpackedPackageLimit = 16 * 1024 * 1024;
+
+export async function fetchBounded(url, { fetchImpl = fetch, limit = 128 * 1024 } = {}) {
+  const response = await fetchImpl(url, { redirect: 'error', credentials: 'omit', signal: AbortSignal.timeout(30000) });
+  if (!response.ok) { await response.body?.cancel(); throw new Error('REMOTE_HTTP_ERROR'); }
+  const declared = response.headers.get('content-length');
+  if (declared !== null && (!/^\d+$/.test(declared) || Number(declared) > limit)) {
+    await response.body?.cancel();
+    throw new Error('REMOTE_BYTE_LIMIT');
+  }
+  if (!response.body) throw new Error('REMOTE_EMPTY_BODY');
+  const reader = response.body.getReader(), parts = [];
+  let bytes = 0;
+  try {
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      bytes += value.byteLength;
+      if (bytes > limit) throw new Error('REMOTE_BYTE_LIMIT');
+      parts.push(Buffer.from(value));
+    }
+  } finally { await reader.cancel(); }
+  return Buffer.concat(parts, bytes);
+}
+
+function octal(field) {
+  // Buffer's ascii decoder masks high bits; validate raw octal bytes first.
+  if (field.some(byte => byte !== 0 && byte !== 32 && (byte < 48 || byte > 55))) throw new Error('PACKAGE_INVALID_TAR');
+  const nul = field.indexOf(0);
+  if (nul !== -1 && field.subarray(nul).some(byte => byte !== 0 && byte !== 32)) throw new Error('PACKAGE_INVALID_TAR');
+  const value = field.toString('ascii').replace(/\0.*$/, '').trim();
+  if (!/^[0-7]+$/.test(value)) throw new Error('PACKAGE_INVALID_TAR');
+  const number = Number.parseInt(value, 8);
+  if (!Number.isSafeInteger(number)) throw new Error('PACKAGE_INVALID_TAR');
+  return number;
+}
+
+export function inspectPublishedPackage(compressed, integrity, expected) {
+  if (compressed.length > compressedPackageLimit) throw new Error('PACKAGE_BYTE_LIMIT');
+  if (!/^sha512-[A-Za-z0-9+/]{86}==$/.test(integrity ?? '')) throw new Error('PACKAGE_INVALID_INTEGRITY');
+  const recorded = Buffer.from(integrity.slice(7), 'base64'), actual = createHash('sha512').update(compressed).digest();
+  if (recorded.length !== actual.length || !timingSafeEqual(recorded, actual)) throw new Error('PACKAGE_INTEGRITY_MISMATCH');
