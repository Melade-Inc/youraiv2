+  { name: 'json-schema-traverse', version: '1.0.0', license: 'MIT', homepage: 'https://github.com/epoberezkin/json-schema-traverse', licenseSha256: '7bf9b2de73a6b356761c948d0e9eeb4be6c1270bd04c79cd489c1e400ffdfc1a' },
