+  try { tar = gunzipSync(compressed, { maxOutputLength: unpackedPackageLimit }); }
+  catch { throw new Error('PACKAGE_INVALID_ARCHIVE'); }
+  if (tar.length % 512 !== 0) throw new Error('PACKAGE_INVALID_TAR');
+  const files = new Map();
+  let offset = 0, entries = 0, terminated = false;
+  while (offset + 512 <= tar.length) {
+    const header = tar.subarray(offset, offset + 512);
+    if (header.every(byte => byte === 0)) {
+      // Require the two standard zero records, and reject hidden trailing entries.
+      if (offset + 1024 > tar.length || !tar.subarray(offset).every(byte => byte === 0)) throw new Error('PACKAGE_INVALID_TAR');
+      terminated = true; break;
+    }
+    if (++entries > 32) throw new Error('PACKAGE_ENTRY_LIMIT');
+    const checksum = octal(header.subarray(148, 156));
+    const calculated = header.reduce((sum, byte, index) => sum + (index >= 148 && index < 156 ? 32 : byte), 0);
+    if (checksum !== calculated) throw new Error('PACKAGE_INVALID_TAR');
+    const name = header.subarray(0, 100).toString('utf8').replace(/\0.*$/, '');
+    // This artifact has only short flat regular files. Reject extension/link
+    // records rather than interpreting alternate paths or trusting an extractor.
+    const type = header[156];
+    if ((type !== 0 && type !== 48) || header.subarray(157, 257).some(byte => byte !== 0) || header.subarray(345, 500).some(byte => byte !== 0)) throw new Error('PACKAGE_UNSAFE_ENTRY');
+    if (!/^package\/[A-Za-z0-9_.-]+$/.test(name) || !expected.has(name.slice(8)) || files.has(name)) throw new Error('PACKAGE_FILE_MISMATCH');
+    const size = octal(header.subarray(124, 136));
+    offset += 512;
+    const end = offset + size;
+    if (size > unpackedPackageLimit || end > tar.length) throw new Error('PACKAGE_INVALID_TAR');
+    const body = tar.subarray(offset, end), wanted = expected.get(name.slice(8));
+    if (!body.equals(wanted)) throw new Error('PACKAGE_CONTENT_MISMATCH');
+    const mode = octal(header.subarray(100, 108));
+    if (mode !== (name === 'package/live-link.mjs' ? 0o755 : 0o644)) throw new Error('PACKAGE_MODE_MISMATCH');
+    files.set(name, { path: name, bytes: size, sha256: createHash('sha256').update(body).digest('hex') });
+    offset += Math.ceil(size / 512) * 512;
+  }
+  if (!terminated || files.size !== expected.size) throw new Error('PACKAGE_FILE_MISMATCH');
+  return { ok: true, integrity: 'sha512-verified', executed: false, files: [...files.values()].sort((a, b) => a.path.localeCompare(b.path)) };
+}
