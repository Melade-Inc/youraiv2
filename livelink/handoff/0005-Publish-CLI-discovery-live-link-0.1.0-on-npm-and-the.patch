diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 142143e..bbd4123 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -6,6 +6,26 @@ on:
 permissions:
   contents: read
 jobs:
+  published-cli:
+    name: Published CLI matches this source (npm and public skill)
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+      - uses: pnpm/action-setup@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24
+          cache: pnpm
+      - run: pnpm install --frozen-lockfile
+      - name: Run the pinned public package from a clean directory
+        run: |
+          PIN="$(node -p 'require("./packages/cli/package.json").version')"
+          mkdir -p "$RUNNER_TEMP/clean" && cd "$RUNNER_TEMP/clean"
+          npx -y "live-link@${PIN}" --help >/dev/null
+          npx -y "live-link@${PIN}" doctor | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const d=JSON.parse(s);if(d.cliVersion!==process.argv[1]||d.distribution.status!=="published")process.exit(1)})' "${PIN}"
+      - name: Verify npm metadata, tarball bytes, public tag, skill and notices against this source
+        run: node scripts/release/verify-distribution.mjs "$(node -p 'require("./packages/cli/package.json").version')"
   verify:
     runs-on: ubuntu-latest
     steps:
